  bug-reports: "https://github.com/ocaml/dune/issues"
  depends: [
    "dune" {>= "3.24"}
    "ocaml" {>= "4.14"}
    "odoc" {with-doc}
  ]
  build: [
    ["dune" "subst"] {dev}
