open Bindings
open EntropySource

let sources = {
  let value = emptyObject()
  set(value, "userAgentData", UserAgentData.getUserAgentData)
  set(value, "fonts", Fonts.getFonts)
  set(value, "domBlockers", DomBlockers.getDomBlockers)
  set(value, "fontPreferences", FontPreferences.getFontPreferences)
  set(value, "audio", Audio.getAudioFingerprint)
  set(value, "screenFrame", ScreenFrame.getScreenFrame)
  set(value, "canvas", Canvas.getCanvasFingerprint)
  set(value, "osCpu", OsCpu.getOsCpu)
  set(value, "languages", Languages.getLanguages)
  set(value, "colorDepth", ColorDepth.getColorDepth)
  set(value, "deviceMemory", DeviceMemory.getDeviceMemory)
  set(value, "screenResolution", ScreenResolution.getScreenResolution)
  set(value, "hardwareConcurrency", HardwareConcurrency.getHardwareConcurrency)
  set(value, "timezone", Timezone.getTimezone)
  set(value, "sessionStorage", SessionStorage.getSessionStorage)
  set(value, "localStorage", LocalStorage.getLocalStorage)
  set(value, "indexedDB", IndexedDb.getIndexedDB)
  set(value, "openDatabase", OpenDatabase.getOpenDatabase)
  set(value, "cpuClass", CpuClass.getCpuClass)
  set(value, "platform", Platform.getPlatform)
  set(value, "plugins", Plugins.getPlugins)
  set(value, "touchSupport", TouchSupport.getTouchSupport)
  set(value, "vendor", Vendor.getVendor)
  set(value, "vendorFlavors", VendorFlavors.getVendorFlavors)
  set(value, "cookiesEnabled", CookiesEnabled.areCookiesEnabled)
  set(value, "colorGamut", ColorGamut.getColorGamut)
  set(value, "invertedColors", InvertedColors.areColorsInverted)
  set(value, "forcedColors", ForcedColors.areColorsForced)
  set(value, "monochrome", Monochrome.getMonochromeDepth)
  set(value, "contrast", Contrast.getContrastPreference)
  set(value, "reducedMotion", ReducedMotion.isMotionReduced)
  set(value, "reducedTransparency", ReducedTransparency.isTransparencyReduced)
  set(value, "hdr", Hdr.isHDR)
  set(value, "math", MathFingerprint.getMathFingerprint)
  set(value, "pdfViewerEnabled", PdfViewerEnabled.isPdfViewerEnabled)
  set(value, "architecture", Architecture.getArchitecture)
  set(value, "applePay", ApplePay.getApplePayState)
  set(value, "privateClickMeasurement", PrivateClickMeasurement.getPrivateClickMeasurement)
  set(value, "audioBaseLatency", AudioBaseLatency.getAudioContextBaseLatency)
  set(value, "dateTimeLocale", DateTimeLocale.getDateTimeLocale)
  set(value, "webGlBasics", Webgl.getWebGlBasics)
  set(value, "webGlExtensions", Webgl.getWebGlExtensions)
  value
}

let loadBuiltinSources = (options: any) => loadSources(sources, options, identity([]), jsUndefined)
