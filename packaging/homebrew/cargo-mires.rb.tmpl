class CargoMires < Formula
  desc "Cargo subcommand for compiling Rust crates directly to JavaScript ES modules"
  homepage "https://github.com/GoldStrikeArch/mires"
  version "{{VERSION}}"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    on_arm do
      url "https://github.com/GoldStrikeArch/mires/releases/download/v{{VERSION}}/cargo-mires-v{{VERSION}}-aarch64-apple-darwin.tar.gz"
      sha256 "{{SHA256_AARCH64_APPLE_DARWIN}}"
    end

    on_intel do
      url "https://github.com/GoldStrikeArch/mires/releases/download/v{{VERSION}}/cargo-mires-v{{VERSION}}-x86_64-apple-darwin.tar.gz"
      sha256 "{{SHA256_X86_64_APPLE_DARWIN}}"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/GoldStrikeArch/mires/releases/download/v{{VERSION}}/cargo-mires-v{{VERSION}}-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "{{SHA256_AARCH64_UNKNOWN_LINUX_GNU}}"
    end

    on_intel do
      url "https://github.com/GoldStrikeArch/mires/releases/download/v{{VERSION}}/cargo-mires-v{{VERSION}}-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "{{SHA256_X86_64_UNKNOWN_LINUX_GNU}}"
    end
  end

  def install
    bin.install "cargo-mires"
  end

  def caveats
    <<~EOS
      Download and configure the prebuilt mires compiler toolchain and sysroots:
        cargo mires setup

      Manage installed toolchains with:
        cargo mires toolchain list
        cargo mires toolchain clean
    EOS
  end

  test do
    system "#{bin}/cargo-mires", "--version"
  end
end
