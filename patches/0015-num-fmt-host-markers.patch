+#[inline(never)]
+fn rcgjs_pad_float(
+    fmt: &mut Formatter<'_>,
+    val: f64,
+    is_f32: u8,
+    mode: u8,
+    param: u16,
+) -> Result {
+    unsafe extern "C" {
+        fn rcgjs_fmt_float_parts(
+            val: f64,
+            is_f32: u8,
+            mode: u8,
+            param: u16,
+            force_sign: u8,
+            out: *mut u8,
+            meta: *mut usize,
+        );
+    }
+    let mut buf = [0u8; 800];
+    let mut meta = [0usize; 10];
+    let force_sign = if fmt.sign_plus() { 1u8 } else { 0u8 };
+    // SAFETY: `rcgjs_fmt_float_parts` writes valid ASCII into `buf[..800]` and at most 4 parts into `meta[..10]`.
+    unsafe {
+        rcgjs_fmt_float_parts(
+            val,
+            is_f32,
+            mode,
+            param,
+            force_sign,
+            buf.as_mut_ptr(),
+            meta.as_mut_ptr(),
+        );
+    }
+    let sign = match meta[0] {
+        1 => "-",
+        2 => "+",
+        _ => "",
+    };
+    let nparts = meta[1];
+    let mut parts = [numfmt::Part::Zero(0); 4];
+    let mut i = 0;
+    while i < nparts && i < 4 {
+        let kind = meta[2 + 2 * i];
+        let arg = meta[3 + 2 * i];
+        // SAFETY: `rcgjs_fmt_float_parts` guarantees `start + len <= buf.len()` and `i < 4`.
+        unsafe {
+            *parts.get_unchecked_mut(i) = if kind == 0 {
+                let start = arg >> 16;
+                let len = arg & 0xffff;
+                numfmt::Part::Copy(buf.get_unchecked(start..start + len))
+            } else {
+                numfmt::Part::Zero(arg)
+            };
         }
+        i += 1;
     }
+    let count = if nparts <= 4 { nparts } else { 4 };
+    let formatted = numfmt::Formatted { sign, parts: unsafe { parts.get_unchecked(..count) } };
+    // SAFETY: `rcgjs_fmt_float_parts` writes only ASCII bytes into `buf`.
+    unsafe { fmt.pad_formatted_parts(&formatted) }
 }
 
+macro_rules! floating_js {
+    ($(($ty:ident, $is_f32:expr))*) => {
+        $(
+            #[stable(feature = "rust1", since = "1.0.0")]
+            impl Debug for $ty {
+                fn fmt(&self, fmt: &mut Formatter<'_>) -> Result {
+                    if let Some(precision) = fmt.options.get_precision() {
+                        rcgjs_pad_float(fmt, *self as f64, $is_f32, 0, precision)
+                    } else if self.already_rounded_value_should_use_exponential() {
+                        rcgjs_pad_float(fmt, *self as f64, $is_f32, 4, 0)
+                    } else {
+                        rcgjs_pad_float(fmt, *self as f64, $is_f32, 1, 1)
+                    }
+                }
+            }
+
+            #[stable(feature = "rust1", since = "1.0.0")]
+            impl Display for $ty {
+                fn fmt(&self, fmt: &mut Formatter<'_>) -> Result {
+                    if let Some(precision) = fmt.options.get_precision() {
+                        rcgjs_pad_float(fmt, *self as f64, $is_f32, 0, precision)
+                    } else {
+                        rcgjs_pad_float(fmt, *self as f64, $is_f32, 1, 0)
+                    }
+                }
+            }
+
+            #[stable(feature = "rust1", since = "1.0.0")]
+            impl LowerExp for $ty {
+                fn fmt(&self, fmt: &mut Formatter<'_>) -> Result {
+                    if let Some(precision) = fmt.options.get_precision() {
+                        rcgjs_pad_float(fmt, *self as f64, $is_f32, 2, precision)
+                    } else {
+                        rcgjs_pad_float(fmt, *self as f64, $is_f32, 4, 0)
+                    }
+                }
+            }
+
+            #[stable(feature = "rust1", since = "1.0.0")]
+            impl UpperExp for $ty {
+                fn fmt(&self, fmt: &mut Formatter<'_>) -> Result {
+                    if let Some(precision) = fmt.options.get_precision() {
+                        rcgjs_pad_float(fmt, *self as f64, $is_f32, 3, precision)
+                    } else {
+                        rcgjs_pad_float(fmt, *self as f64, $is_f32, 5, 0)
+                    }
+                }
+            }
+        )*
+    };
+}
