+}
+
+#[doc(hidden)]
+#[inline(never)]
+#[rustc_diagnostic_item = "rcgjs_str_contains"]
+fn rcgjs_str_contains(haystack: &str, needle: &str) -> bool {
+    if needle.is_empty() {
+        return true;
+    }
+    if needle.len() > haystack.len() {
+        return false;
+    }
+    if needle.len() == haystack.len() {
+        return needle == haystack;
+    }
+    rcgjs_str_find_str(haystack, 0, haystack.len(), needle) != usize::MAX
+}
+
+#[doc(hidden)]
+#[inline(never)]
+#[rustc_diagnostic_item = "rcgjs_str_find_str"]
+fn rcgjs_str_find_str(haystack: &str, start: usize, end: usize, needle: &str) -> usize {
+    let nb = needle.as_bytes();
+    if nb.is_empty() || start > end || end > haystack.len() || end - start < nb.len() {
+        return usize::MAX;
+    }
+    let mut tw = TwoWaySearcher::new(nb, end);
+    tw.position = start;
+    let is_long = tw.memory == usize::MAX;
+    match tw.next::<MatchOnly>(haystack.as_bytes(), nb, is_long) {
+        Some((a, _)) => a,
+        None => usize::MAX,
+    }
+}
+
+#[doc(hidden)]
+#[inline(never)]
+#[rustc_diagnostic_item = "rcgjs_str_rfind_str"]
+fn rcgjs_str_rfind_str(haystack: &str, start: usize, end: usize, needle: &str) -> usize {
+    let nb = needle.as_bytes();
+    if nb.is_empty() || start > end || end > haystack.len() || end - start < nb.len() {
+        return usize::MAX;
+    }
+    let mut tw = TwoWaySearcher::new(nb, end);
+    tw.position = start;
+    let is_long = tw.memory == usize::MAX;
+    match tw.next_back::<MatchOnly>(haystack.as_bytes(), nb, is_long) {
+        Some((a, _)) => a,
+        None => usize::MAX,
+    }
+}
