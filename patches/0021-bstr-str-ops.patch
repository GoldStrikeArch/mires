+#[doc(hidden)]
+#[inline(never)]
+#[rustc_diagnostic_item = "rcgjs_str_rfind_char"]
+fn rcgjs_str_rfind_char(haystack: &str, start: usize, mut end: usize, needle: char) -> usize {
+    let mut utf8_encoded = [0u8; char::MAX_LEN_UTF8];
+    let utf8_size = needle.encode_utf8(&mut utf8_encoded).len();
+    let last_byte = utf8_encoded[utf8_size - 1];
+    let shift = utf8_size - 1;
+    let hbytes = haystack.as_bytes();
+    loop {
+        let Some(bytes) = hbytes.get(start..end) else {
+            return usize::MAX;
+        };
+        let Some(index) = memchr::memrchr(last_byte, bytes) else {
+            return usize::MAX;
+        };
+        let abs = start + index;
+        if abs >= start + shift {
+            let found_char = abs - shift;
+            if let Some(slice) = hbytes.get(found_char..found_char + utf8_size) {
+                if slice == &utf8_encoded[..utf8_size] {
+                    return found_char;
+                }
+            }
+        }
+        end = abs;
+    }
+}
