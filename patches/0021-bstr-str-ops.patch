+#[doc(hidden)]
+#[inline(never)]
+#[rustc_diagnostic_item = "rcgjs_str_find_char"]
+fn rcgjs_str_find_char(haystack: &str, mut start: usize, end: usize, needle: char) -> usize {
+    let mut utf8_encoded = [0u8; char::MAX_LEN_UTF8];
+    let utf8_size = needle.encode_utf8(&mut utf8_encoded).len();
+    let last_byte = utf8_encoded[utf8_size - 1];
+    let orig_start = start;
+    let hbytes = haystack.as_bytes();
+    loop {
+        let Some(bytes) = hbytes.get(start..end) else {
+            return usize::MAX;
+        };
+        let Some(index) = memchr::memchr(last_byte, bytes) else {
+            return usize::MAX;
+        };
+        start += index + 1;
+        if start >= orig_start + utf8_size {
+            let found_char = start - utf8_size;
+            let matched = match hbytes.get(found_char..start) {
+                Some([_]) => true,
+                Some([a, _]) => *a == utf8_encoded[0],
+                Some([a, b, _]) => *a == utf8_encoded[0] && *b == utf8_encoded[1],
+                Some([a, b, c, _]) => {
+                    *a == utf8_encoded[0] && *b == utf8_encoded[1] && *c == utf8_encoded[2]
+                }
+                _ => false,
+            };
+            if matched {
+                return found_char;
+            }
+        }
+    }
+}
