rustc_codegen_js: mark the exact Take and Skip adapter types.

The JIR producer already recognizes SliceIter and Enumerate through rustc diagnostic
items. Give the two bounded adapters the same semantic identity so the linker can
select a typed iterator-state lowering without consulting paths or emitted names.

--- a/library/core/src/iter/adapters/take.rs
+++ b/library/core/src/iter/adapters/take.rs
@@ -14,6 +14,7 @@ use crate::ops::{ControlFlow, Try};
 #[derive(Clone, Debug)]
 #[must_use = "iterators are lazy and do nothing unless consumed"]
 #[stable(feature = "rust1", since = "1.0.0")]
+#[rustc_diagnostic_item = "Take"]
 pub struct Take<I> {
     iter: I,
     n: usize,
--- a/library/core/src/iter/adapters/skip.rs
