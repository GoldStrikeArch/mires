+        capacity: usize,
+        _alloc: Self,
+    ) -> Result<Vec<T, Self>, TryReserveError> {
+        let mut v = rcgjs_vec_new();
+        if capacity > 0 && !rcgjs_vec_try_reserve_exact(&mut v, 0, capacity) {
+            return Err(crate::collections::TryReserveErrorKind::CapacityOverflow.into());
+        }
