+/// Compiler-recognized typed heap allocation for `Global` (`RawVec<T, Global>`, `Box<T, Global>`).
+/// Fallback body delegates to `Global` so custom `#[global_allocator]`, `byte_views`, and
+/// non-`ReleaseSpeed` profiles preserve exact standard semantics.
+#[doc(hidden)]
+#[inline(never)]
+#[rustc_diagnostic_item = "rcgjs_typed_alloc"]
+pub(crate) unsafe fn rcgjs_typed_alloc<T>(cap: usize, zeroed: bool) -> *mut T {
+    let Ok(layout) = Layout::array::<T>(cap) else {
+        return core::ptr::null_mut();
+    };
+    let res = if zeroed { Global.allocate_zeroed(layout) } else { Global.allocate(layout) };
+    match res {
+        Ok(ptr) => ptr.as_mut_ptr().cast::<T>(),
+        Err(_) => core::ptr::null_mut(),
+    }
+}
+
+#[doc(hidden)]
+#[inline(never)]
+#[rustc_diagnostic_item = "rcgjs_typed_realloc"]
+pub(crate) unsafe fn rcgjs_typed_realloc<T>(
+    ptr: *mut T,
+    old_cap: usize,
+    new_cap: usize,
+) -> *mut T {
+    let Ok(old_layout) = Layout::array::<T>(old_cap) else {
+        return core::ptr::null_mut();
+    };
+    let Ok(new_layout) = Layout::array::<T>(new_cap) else {
+        return core::ptr::null_mut();
+    };
+    let Some(nn) = NonNull::new(ptr.cast::<u8>()) else {
+        return core::ptr::null_mut();
+    };
+    let res = unsafe {
+        if new_cap >= old_cap {
+            Global.grow(nn, old_layout, new_layout)
+        } else {
+            Global.shrink(nn, old_layout, new_layout)
+        }
+    };
+    match res {
+        Ok(p) => p.as_mut_ptr().cast::<T>(),
+        Err(_) => core::ptr::null_mut(),
+    }
+}
+
+#[doc(hidden)]
+#[inline(never)]
+#[rustc_diagnostic_item = "rcgjs_typed_dealloc"]
+pub(crate) unsafe fn rcgjs_typed_dealloc<T>(ptr: *mut T, cap: usize) {
+    if cap == 0 || core::mem::size_of::<T>() == 0 {
+        return;
+    }
+    if let (Some(nn), Ok(layout)) = (NonNull::new(ptr.cast::<u8>()), Layout::array::<T>(cap)) {
+        unsafe { Global.deallocate(nn, layout) };
+    }
+}
+
+#[cfg(not(no_global_oom_handling))]
+#[doc(hidden)]
+#[inline(never)]
+#[rustc_diagnostic_item = "rcgjs_box_new"]
+pub(crate) unsafe fn rcgjs_box_new<T>(x: T) -> *mut T {
+    let layout = Layout::new::<T>();
+    let ptr = match Global.allocate(layout) {
+        Ok(ptr) => ptr.as_mut_ptr().cast::<T>(),
+        Err(_) => handle_alloc_error(layout),
+    };
+    unsafe { core::intrinsics::write_via_move(ptr, x) };
+    ptr
+}
+
+#[doc(hidden)]
+#[inline(never)]
+#[rustc_diagnostic_item = "rcgjs_typed_dealloc_raw"]
+pub(crate) unsafe fn rcgjs_typed_dealloc_raw(ptr: *mut u8, layout: Layout) {
+    if layout.size() == 0 {
+        return;
+    }
+    if let Some(nn) = NonNull::new(ptr) {
+        unsafe { Global.deallocate(nn, layout) };
+    }
+}
+
+#[rustc_const_unstable(feature = "const_heap", issue = "79597")]
+pub(crate) const trait ManagedAlloc<T>: [const] Allocator {
+    fn alloc_elems(
+        &self,
+        cap: usize,
+        zeroed: bool,
+        layout: Layout,
+    ) -> Result<NonNull<T>, AllocError>;
+
+    unsafe fn realloc_elems(
+        &self,
+        ptr: NonNull<T>,
+        old_cap: usize,
+        new_cap: usize,
+        old_layout: Layout,
+        new_layout: Layout,
+    ) -> Result<NonNull<T>, AllocError>;
+
+    unsafe fn dealloc_elems(&self, ptr: NonNull<T>, cap: usize, layout: Layout);
+}
+
+#[rustc_const_unstable(feature = "const_heap", issue = "79597")]
+const impl<T, A: [const] Allocator> ManagedAlloc<T> for A {
+    #[inline]
+    default fn alloc_elems(
+        &self,
+        _cap: usize,
+        zeroed: bool,
+        layout: Layout,
+    ) -> Result<NonNull<T>, AllocError> {
+        let res = if zeroed { self.allocate_zeroed(layout) } else { self.allocate(layout) };
+        match res {
+            Ok(ptr) => Ok(ptr.cast()),
+            Err(e) => Err(e),
+        }
+    }
+
+    #[inline]
+    default unsafe fn realloc_elems(
+        &self,
+        ptr: NonNull<T>,
+        old_cap: usize,
+        new_cap: usize,
+        old_layout: Layout,
+        new_layout: Layout,
+    ) -> Result<NonNull<T>, AllocError> {
+        let res = unsafe {
+            if new_cap >= old_cap {
+                self.grow(ptr.cast(), old_layout, new_layout)
+            } else {
+                self.shrink(ptr.cast(), old_layout, new_layout)
+            }
+        };
+        match res {
+            Ok(p) => Ok(p.cast()),
+            Err(e) => Err(e),
+        }
+    }
+
+    #[inline]
+    default unsafe fn dealloc_elems(&self, ptr: NonNull<T>, _cap: usize, layout: Layout) {
+        unsafe { self.deallocate(ptr.cast(), layout) }
+    }
+}
+
+#[rustc_const_unstable(feature = "const_heap", issue = "79597")]
+const impl<T> ManagedAlloc<T> for Global {
+    #[inline]
+    fn alloc_elems(
+        &self,
+        cap: usize,
+        zeroed: bool,
+        layout: Layout,
+    ) -> Result<NonNull<T>, AllocError> {
+        #[rustc_const_unstable(feature = "const_heap", issue = "79597")]
+        const fn ct<T>(
+            _cap: usize,
+            zeroed: bool,
+            layout: Layout,
+        ) -> Result<NonNull<T>, AllocError> {
+            match Global::alloc_impl_const(layout, zeroed) {
+                Ok(p) => Ok(p.cast()),
+                Err(e) => Err(e),
+            }
+        }
+        #[inline]
+        fn rt<T>(cap: usize, zeroed: bool, _layout: Layout) -> Result<NonNull<T>, AllocError> {
+            let ptr = unsafe { rcgjs_typed_alloc::<T>(cap, zeroed) };
+            NonNull::new(ptr).ok_or(AllocError)
+        }
+        core::intrinsics::const_eval_select((cap, zeroed, layout), ct::<T>, rt::<T>)
+    }
+
+    #[inline]
+    unsafe fn realloc_elems(
+        &self,
+        ptr: NonNull<T>,
+        old_cap: usize,
+        new_cap: usize,
+        old_layout: Layout,
+        new_layout: Layout,
+    ) -> Result<NonNull<T>, AllocError> {
+        #[rustc_const_unstable(feature = "const_heap", issue = "79597")]
+        const fn ct<T>(
+            slf: &Global,
+            ptr: NonNull<T>,
+            _old_cap: usize,
+            _new_cap: usize,
+            old_layout: Layout,
+            new_layout: Layout,
+        ) -> Result<NonNull<T>, AllocError> {
+            match slf.grow_shrink_impl_const(ptr.cast(), old_layout, new_layout, false) {
+                Ok(p) => Ok(p.cast()),
+                Err(e) => Err(e),
+            }
+        }
+        #[inline]
+        fn rt<T>(
+            _slf: &Global,
+            ptr: NonNull<T>,
+            old_cap: usize,
+            new_cap: usize,
+            _old_layout: Layout,
+            _new_layout: Layout,
+        ) -> Result<NonNull<T>, AllocError> {
+            let next = unsafe { rcgjs_typed_realloc::<T>(ptr.as_ptr(), old_cap, new_cap) };
+            NonNull::new(next).ok_or(AllocError)
+        }
+        core::intrinsics::const_eval_select(
+            (self, ptr, old_cap, new_cap, old_layout, new_layout),
+            ct::<T>,
+            rt::<T>,
+        )
+    }
+
+    #[inline]
+    unsafe fn dealloc_elems(&self, ptr: NonNull<T>, cap: usize, layout: Layout) {
+        #[rustc_const_unstable(feature = "const_heap", issue = "79597")]
+        const fn ct<T>(ptr: NonNull<T>, _cap: usize, layout: Layout) {
+            Global::deallocate_impl_const(ptr.cast(), layout);
+        }
+        #[inline]
+        fn rt<T>(ptr: NonNull<T>, cap: usize, _layout: Layout) {
+            unsafe { rcgjs_typed_dealloc::<T>(ptr.as_ptr(), cap) }
+        }
+        core::intrinsics::const_eval_select((ptr, cap, layout), ct::<T>, rt::<T>)
+    }
+}
+
+#[rustc_const_unstable(feature = "const_heap", issue = "79597")]
+const impl<T> ManagedAlloc<T> for &Global {
+    #[inline]
+    fn alloc_elems(
+        &self,
+        cap: usize,
+        zeroed: bool,
+        layout: Layout,
+    ) -> Result<NonNull<T>, AllocError> {
+        <Global as ManagedAlloc<T>>::alloc_elems(*self, cap, zeroed, layout)
+    }
+
+    #[inline]
+    unsafe fn realloc_elems(
+        &self,
+        ptr: NonNull<T>,
+        old_cap: usize,
+        new_cap: usize,
+        old_layout: Layout,
+        new_layout: Layout,
+    ) -> Result<NonNull<T>, AllocError> {
+        unsafe {
+            <Global as ManagedAlloc<T>>::realloc_elems(
+                *self, ptr, old_cap, new_cap, old_layout, new_layout,
+            )
+        }
+    }
+
+    #[inline]
+    unsafe fn dealloc_elems(&self, ptr: NonNull<T>, cap: usize, layout: Layout) {
+        unsafe { <Global as ManagedAlloc<T>>::dealloc_elems(*self, ptr, cap, layout) }
+    }
+}
+
+pub(crate) trait ManagedDealloc: Allocator {
+    unsafe fn deallocate_managed(&self, ptr: NonNull<u8>, layout: Layout);
+}
+
+impl<A: Allocator> ManagedDealloc for A {
+    #[inline]
+    default unsafe fn deallocate_managed(&self, ptr: NonNull<u8>, layout: Layout) {
+        unsafe { self.deallocate(ptr, layout) }
+    }
+}
+
+impl ManagedDealloc for Global {
+    #[inline]
+    unsafe fn deallocate_managed(&self, ptr: NonNull<u8>, layout: Layout) {
+        unsafe { rcgjs_typed_dealloc_raw(ptr.as_ptr(), layout) }
+    }
+}
+
+impl ManagedDealloc for &Global {
+    #[inline]
+    unsafe fn deallocate_managed(&self, ptr: NonNull<u8>, layout: Layout) {
+        unsafe { rcgjs_typed_dealloc_raw(ptr.as_ptr(), layout) }
+    }
+}
