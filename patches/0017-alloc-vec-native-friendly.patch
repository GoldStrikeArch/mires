diff -u -r a/library/alloc/src/vec/spec_from_elem.rs b/library/alloc/src/vec/spec_from_elem.rs
--- a/library/alloc/src/vec/spec_from_elem.rs
+++ b/library/alloc/src/vec/spec_from_elem.rs
@@ -1,10 +1,40 @@
 use core::ptr;
 
 use super::{IsZero, Vec};
-use crate::alloc::Allocator;
+use crate::alloc::{Allocator, Global};
 use crate::raw_vec::RawVec;
 
-// Specialization trait used for Vec::from_elem
+// Specialization trait for global `Vec::from_elem`: preserves O(1) `IsZero` / `()`
+// zeroed allocations for baseline Vecs while routing non-`IsZero` `Clone` elements
+// through `Vec::with_capacity` + `extend_with` with no dead `RawVec` branch in MIR.
+pub(super) trait SpecFromElemGlobal: Sized {
+    fn from_elem_global(elem: Self, n: usize) -> Vec<Self>;
+}
+
+impl<T: Clone> SpecFromElemGlobal for T {
+    #[inline]
+    default fn from_elem_global(elem: Self, n: usize) -> Vec<Self> {
+        let mut v = Vec::with_capacity(n);
+        v.extend_with(n, elem);
+        v
+    }
+}
+
+impl<T: Clone + IsZero> SpecFromElemGlobal for T {
+    #[inline]
+    default fn from_elem_global(elem: T, n: usize) -> Vec<T> {
+        <T as SpecFromElem>::from_elem(elem, n, Global)
+    }
+}
+
+impl SpecFromElemGlobal for () {
+    #[inline]
+    fn from_elem_global(elem: (), n: usize) -> Vec<()> {
+        <() as SpecFromElem>::from_elem(elem, n, Global)
+    }
+}
+
+// Specialization trait used for Vec::from_elem_in and IsZero/() fast paths
 pub(super) trait SpecFromElem: Sized {
     fn from_elem<A: Allocator>(elem: Self, n: usize, alloc: A) -> Vec<Self, A>;
 }
