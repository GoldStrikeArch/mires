-        }
-        // Fall back to other from_iter impls if an overflow occurred in the step merge/expansion
-        // tracking.
-        _ => false,
-    }
+    // rustc_codegen_js: never reuse the source allocation. Collecting in place reinterprets a
+    // heap block of `SRC` elements as one of `DEST` elements while the rest of the source is still
+    // being read, and a block on this target is a JavaScript array of one element
