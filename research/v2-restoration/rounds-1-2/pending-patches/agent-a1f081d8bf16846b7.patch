index 0000000000000000000000000000000000000000..b737508a3302697f6b37afc5b1bb60fd9c45d000
--- /dev/null
+++ b/examples/cross-crate-tests/cleanup_metadata_provider.rs
@@ -0,0 +1,29 @@
+//! A generic that keeps a destructor live across a call to its argument.
+//!
+//! `scripts/cleanup-transport-test.py` compiles `cleanup_metadata_middle.rs` against this crate's
+//! `.rmeta` alone, the way cargo compiles the sysroot's `alloc` against `core`. The middle crate
+//! instantiates `guarded` with its own closure, so its object holds the only copy of that
+//! instance, and the copy has to be lowered from the cleanup MIR in this crate's rlib: rustc's
+//! optimized MIR in the `.rmeta` lost the guard's cleanup path to `-Cpanic=abort`.
+//!
+//! `guarded::<fn() -> u32>` is instantiated in both the middle crate and the client, so two objects
+//! carry a copy of one item, and the link keeps one of them for both calls.
+
+#![no_std]
+
+unsafe extern "C" {
+    fn js_log_f64(value: f64);
+}
+
+pub struct Guard(pub u32);
+
+impl Drop for Guard {
+    fn drop(&mut self) {
+        unsafe { js_log_f64(f64::from(self.0)) }
+    }
+}
+
+pub fn guarded<F: FnOnce() -> u32>(value: u32, f: F) -> u32 {
+    let _guard = Guard(value);
+    f() + value
+}
diff --git a/examples/noop_landing_pads.rs b/examples/noop_landing_pads.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5b3a594cfb2e624d059938c451a332d26c6a3c72
--- /dev/null
+++ b/examples/noop_landing_pads.rs
@@ -0,0 +1,59 @@
+#![no_std]
+#![no_main]
+#![deny(unsafe_code)]
+
+use mires_js::{js_bindings, js_export};
+
+js_bindings! {
+    #[js(call = "noopPadNote")]
+    fn note(value: f64);
+}
+
+struct Guard(u32);
+
+impl Drop for Guard {
+    fn drop(&mut self) {
+        note(f64::from(self.0));
+    }
+}
+
+#[inline(never)]
+fn consume(guard: Guard) {
+    note(f64::from(guard.0 + 100));
+}
+
+/// The first call's landing pad only resumes. The second call's pad drops `_guard`.
+#[js_export]
+pub fn mixed() {
+    note(10.0);
+    let _guard = Guard(1);
+    note(11.0);
+}
+
+/// Every landing pad only resumes: the one local is `Copy`.
+#[js_export]
+pub fn copy_only(value: u32) -> u32 {
+    let next = value + 1;
+    note(20.0);
+    next
+}
+
+/// Drop elaboration removes the moved guard's drop from the second call's landing pad. MIR
+/// inlining copies `inner` into rustc's optimized body for this function.
+#[js_export]
+pub fn moved_then_inner() {
+    let guard = Guard(3);
+    consume(guard);
+    inner();
+}
+
+#[inline(always)]
+fn inner() {
+    let _guard = Guard(4);
+    note(40.0);
+}
+
+#[panic_handler]
+fn panic(_: &core::panic::PanicInfo<'_>) -> ! {
+    loop {}
+}
