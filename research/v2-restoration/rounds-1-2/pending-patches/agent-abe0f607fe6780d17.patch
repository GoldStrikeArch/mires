new file mode 100644
index 0000000000000000000000000000000000000000..bf63564208521aa70f8a25d2d8a145c31769459e
--- /dev/null
+++ b/examples/core-tests/242_niche_integer_constants.rs
@@ -0,0 +1,293 @@
+//! Integer niches in constant data: `NonZero`, `char`, `bool`, fieldless enums, nested `Option`s,
+//! enums with one data-carrying variant and several niche-encoded unit variants, niches at a
+//! non-zero offset inside a payload, niche ranges that wrap, and a niche range with an uninhabited
+//! variant inside it.
+//!
+//! The bytes decide these, so they were already right in memory; what this pins is the other two
+//! ways the same values arrive. A register-sized constant used directly (`ConstValue::Scalar`) is
+//! decoded by the link-time lowering from the type table, which used to stop at a transparent
+//! wrapper inside the payload (`Some(NonZero(77))` printed `Some({})`), and which rebuilds rustc's
+//! `niche_variants` from the variants: `Gap::Dead([u32; 0], Infallible)` is uninhabited but not a
+//! 1-ZST, so rustc still gives it a niche value and `Gap::After` takes the next one; the lowering
+//! used to skip it and read `After` as `Live('\u{110001}')`. `Wr`'s two unit variants take the
+//! niche values 255 and 0 (the range wraps past the top of a `u8`), and `Sg`'s and `Ordering`'s
+//! valid range itself wraps (`-1..=1`).
+
+#![no_std]
+#![no_main]
+
+#[path = "prelude.rs"]
+mod prelude;
+use prelude::*;
+
+use core::cmp::Ordering;
+use core::convert::Infallible;
+use core::hint::black_box;
+use core::num::{NonZeroU32, NonZeroU64, NonZeroU8};
+
+#[inline(never)]
+fn idx(i: usize) -> usize {
+    black_box(i)
+}
+
+#[derive(Clone, Copy)]
+enum Color {
+    Red,
+    Green,
+    Blue,
+}
+/// Valid range 200..=254: `Wr`'s two unit variants take the niche values 255 and 0, wrapping.
+#[derive(Clone, Copy)]
+#[repr(u8)]
+enum Hi {
+    A = 200,
+    B = 254,
+}
+#[derive(Clone, Copy)]
+enum Wr {
+    V(Hi),
+    N1,
+    N2,
+}
+/// Valid range -1..=1, i.e. 255..=1 as bits: the valid range itself wraps.
+#[derive(Clone, Copy)]
+#[repr(i8)]
+enum Sg {
+    M = -1,
+    Z = 0,
+    P = 1,
+}
+#[derive(Clone, Copy)]
+enum Multi {
+    Data { a: u32, flag: bool },
+    X,
+    Y,
+    Z,
+}
+#[derive(Clone, Copy)]
+enum Dir {
+    Go(char),
+    Up,
+    Down,
+}
+
+/// Uninhabited without being a 1-ZST, so rustc numbers it: `After` is the second niche value.
+#[derive(Clone, Copy)]
+#[allow(dead_code)]
+enum Gap {
+    Live(char),
+    Dead([u32; 0], Infallible),
+    After,
+}
+#[inline(never)]
+fn c_gap(g: Gap) -> u32 {
+    match g {
+        Gap::Live(c) => c as u32,
+        Gap::After => 7,
+        Gap::Dead(..) => 99,
+    }
+}
+const GAP_AFTER: Gap = Gap::After;
+const GAP_LIVE: Gap = Gap::Live('x');
+static GAPS: [Gap; 2] = [Gap::After, Gap::Live('y')];
+
+#[inline(never)]
+fn c_nz8(o: Option<NonZeroU8>) -> u32 {
+    o.map_or(1000, |v| v.get() as u32)
+}
+#[inline(never)]
+fn c_nz32(o: Option<NonZeroU32>) -> u32 {
+    o.map_or(1000, |v| v.get())
+}
+#[inline(never)]
+fn c_nz64(o: Option<NonZeroU64>) -> u64 {
+    o.map_or(1000, |v| v.get())
+}
+#[inline(never)]
+fn c_char(o: Option<char>) -> u32 {
+    o.map_or(1000, |v| v as u32)
+}
+#[inline(never)]
+fn c_bool(o: Option<bool>) -> u32 {
+    match o {
+        Some(true) => 1,
+        Some(false) => 0,
+        None => 9,
+    }
+}
+#[inline(never)]
+fn c_color(o: Option<Color>) -> u32 {
+    match o {
+        Some(Color::Red) => 1,
+        Some(Color::Green) => 2,
+        Some(Color::Blue) => 3,
+        None => 9,
+    }
+}
+#[inline(never)]
+fn c_ord(o: Option<Ordering>) -> i32 {
+    match o {
+        Some(v) => v as i32,
+        None => 9,
+    }
+}
+#[inline(never)]
+fn c_oob(o: Option<Option<bool>>) -> u32 {
+    match o {
+        Some(Some(true)) => 1,
+        Some(Some(false)) => 0,
+        Some(None) => 8,
+        None => 9,
+    }
+}
+#[inline(never)]
+fn c_ooob(o: Option<Option<Option<bool>>>) -> u32 {
+    match o {
+        Some(Some(Some(true))) => 1,
+        Some(Some(Some(false))) => 0,
+        Some(Some(None)) => 7,
+        Some(None) => 8,
+        None => 9,
+    }
+}
+#[inline(never)]
+fn c_wr(o: Wr) -> u32 {
+    match o {
+        Wr::V(Hi::A) => 1,
+        Wr::V(Hi::B) => 2,
+        Wr::N1 => 3,
+        Wr::N2 => 4,
+    }
+}
+#[inline(never)]
+fn c_owr(o: Option<Wr>) -> u32 {
+    o.map_or(9, c_wr)
+}
+#[inline(never)]
+fn c_sg(o: Option<Sg>) -> i32 {
+    match o {
+        Some(v) => v as i32,
+        None => 9,
+    }
+}
+#[inline(never)]
+fn c_multi(o: Multi) -> u32 {
+    match o {
+        Multi::Data { a, flag } => a * 10 + flag as u32,
+        Multi::X => 1,
+        Multi::Y => 2,
+        Multi::Z => 3,
+    }
+}
+#[inline(never)]
+fn c_dir(o: Dir) -> u32 {
+    match o {
+        Dir::Go(c) => c as u32,
+        Dir::Up => 1,
+        Dir::Down => 2,
+    }
+}
+
+const NZ8: [Option<NonZeroU8>; 2] = [NonZeroU8::new(200), None];
+static NZ32: [Option<NonZeroU32>; 2] = [None, NonZeroU32::new(70000)];
+const NZ64: [Option<NonZeroU64>; 2] = [NonZeroU64::new(1 << 40), None];
+const NZ32_C: Option<NonZeroU32> = NonZeroU32::new(77);
+const CHARS: [Option<char>; 3] = [Some('z'), None, Some('\u{10FFFF}')];
+static CHAR_S: Option<char> = Some('q');
+const BOOLS: [Option<bool>; 3] = [Some(true), Some(false), None];
+static COLORS: [Option<Color>; 4] = [Some(Color::Red), Some(Color::Green), Some(Color::Blue), None];
+const ORDS: [Option<Ordering>; 4] = [Some(Ordering::Less), Some(Ordering::Equal), Some(Ordering::Greater), None];
+const OOB: [Option<Option<bool>>; 4] = [Some(Some(true)), Some(Some(false)), Some(None), None];
+static OOOB: [Option<Option<Option<bool>>>; 5] =
+    [Some(Some(Some(true))), Some(Some(Some(false))), Some(Some(None)), Some(None), None];
+const WRS: [Wr; 4] = [Wr::V(Hi::A), Wr::V(Hi::B), Wr::N1, Wr::N2];
+static OWRS: [Option<Wr>; 5] = [Some(Wr::V(Hi::A)), Some(Wr::V(Hi::B)), Some(Wr::N1), Some(Wr::N2), None];
+const SGS: [Option<Sg>; 4] = [Some(Sg::M), Some(Sg::Z), Some(Sg::P), None];
+static MULTIS: [Multi; 5] = [Multi::Data { a: 4, flag: true }, Multi::X, Multi::Y, Multi::Z, Multi::Data { a: 5, flag: false }];
+const DIRS: [Dir; 3] = [Dir::Go('k'), Dir::Up, Dir::Down];
+const C_MULTI: Multi = Multi::Y;
+const C_DIR: Dir = Dir::Down;
+const C_WR: Wr = Wr::N2;
+const C_OOB: Option<Option<bool>> = Some(None);
+static mut SM_DIR: Dir = Dir::Up;
+
+struct Rec {
+    id: u8,
+    c: Option<char>,
+    m: Multi,
+}
+const RECS: &[Rec] = &[
+    Rec { id: 1, c: Some('a'), m: Multi::Z },
+    Rec { id: 2, c: None, m: Multi::Data { a: 6, flag: true } },
+];
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    for i in 0..2 {
+        print_u32(c_nz8(NZ8[idx(i)]));
+        print_u32(c_nz32(NZ32[idx(i)]));
+        print_u64(c_nz64(NZ64[idx(i)]));
+    }
+    print_u32(c_nz32(NZ32_C));
+    print_u32(c_nz32(black_box(NZ32_C)));
+    for i in 0..3 {
+        print_u32(c_char(CHARS[idx(i)]));
+        print_u32(c_bool(BOOLS[idx(i)]));
+    }
+    print_u32(c_char(CHAR_S));
+    for i in 0..4 {
+        print_u32(c_color(COLORS[idx(i)]));
+        print_i32(c_ord(ORDS[idx(i)]));
+        print_u32(c_oob(OOB[idx(i)]));
+        print_u32(c_wr(WRS[idx(i)]));
+        print_i32(c_sg(SGS[idx(i)]));
+    }
+    for i in 0..5 {
+        print_u32(c_ooob(OOOB[idx(i)]));
+        print_u32(c_owr(OWRS[idx(i)]));
+        print_u32(c_multi(MULTIS[idx(i)]));
+    }
+    for i in 0..3 {
+        print_u32(c_dir(DIRS[idx(i)]));
+    }
+    print_u32(c_multi(C_MULTI));
+    print_u32(c_dir(C_DIR));
+    print_u32(c_wr(C_WR));
+    print_u32(c_oob(C_OOB));
+    print_u32(c_multi(black_box(C_MULTI)));
+    print_u32(c_wr(black_box(C_WR)));
+    unsafe {
+        print_u32(c_dir(*black_box(&raw const SM_DIR)));
+        SM_DIR = Dir::Go('m');
+        print_u32(c_dir(*black_box(&raw const SM_DIR)));
+    }
+    for i in 0..2 {
+        let r = &RECS[idx(i)];
+        print_u32(r.id as u32);
+        print_u32(c_char(r.c));
+        print_u32(c_multi(r.m));
+    }
+    let promoted: &'static [Option<Wr>; 2] = &[Some(Wr::N1), None];
+    print_u32(c_owr(black_box(promoted)[idx(0)]));
+    print_u32(c_owr(black_box(promoted)[idx(1)]));
+    print_u32(c_gap(GAP_AFTER));
+    print_u32(c_gap(black_box(GAP_AFTER)));
+    print_u32(c_gap(GAP_LIVE));
+    print_bool(matches!(GAP_AFTER, Gap::After));
+    for i in 0..2 {
+        print_u32(c_gap(GAPS[idx(i)]));
+    }
+    // Run-time controls.
+    let lw = [Wr::V(Hi::B), Wr::N1, Wr::N2];
+    for i in 0..3 {
+        print_u32(c_wr(black_box(lw)[idx(i)]));
+    }
+    let lo: [Option<Option<Option<bool>>>; 3] = [Some(Some(None)), Some(None), None];
+    for i in 0..3 {
+        print_u32(c_ooob(black_box(lo)[idx(i)]));
+    }
+    let lg = [Gap::After, Gap::Live('z')];
+    for i in 0..2 {
+        print_u32(c_gap(black_box(lg)[idx(i)]));
+    }
+}
