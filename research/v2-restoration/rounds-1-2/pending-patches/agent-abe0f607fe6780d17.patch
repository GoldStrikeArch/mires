+    let tcx = cgu.tcx;
+    let refuse = |what: &str| {
+        zombie(
+            cgu,
+            log,
+            span,
+            format!("a `{ty}` into a `static` {what}, which rustc_codegen_js cannot name"),
+        )
+    };
+    let Some(length) = meta else {
+        return refuse("with no length");
+    };
+    let static_ty =
+        tcx.normalize_erasing_regions(typing_env(), tcx.type_of(def_id).instantiate_identity());
+    let binding = jsast::id(cgu.namer.static_name(def_id).into_string());
+    match pointee.kind() {
+        ty::Slice(element) => {
+            let element = *element;
+            let Ok(layout) = tcx.layout_of(typing_env().as_query_input(element)) else {
+                return refuse("whose element has no layout");
+            };
+            let (buf, count) = match static_ty.kind() {
+                ty::Array(array_element, count) if *array_element == element => {
