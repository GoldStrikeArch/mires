+++ b/examples/core-tests/249_dyn_constant_refused.rs
@@ -0,0 +1,31 @@
+//! A trait object in constant data is refused at compile time, plain or inside `Option`.
+//!
+//! A `&dyn Trait` is `{ ptr, meta }`, and a constant one would need its vtable decoded out of
+//! constant memory, which the constant readers do not do: a plain `&dyn Trait` constant has always
+//! been refused. `Option<&dyn Trait>` holding `Some` used to slip past the refusal — its niche
+//! decoded as `None`, so the program compiled and read `None` — and is now decoded as `Some` and
+//! refused the same way. `None` of that type has no pointer to decode and compiles (fixture 241).
+
+#![no_std]
+#![no_main]
+
+#[path = "prelude.rs"]
+mod prelude;
+use prelude::*;
+
+use core::hint::black_box;
+
+trait Speak {
+    fn n(&self) -> u32;
+}
+impl Speak for u32 {
+    fn n(&self) -> u32 {
+        *self
+    }
+}
+static DYN: Option<&(dyn Speak + Sync)> = Some(&5u32);
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    print_u32(black_box(&DYN).map_or(0, |d| d.n()));
+}
