+fn static_wide_pointer<'tcx>(
+    cgu: &CguCx<'tcx>,
+    log: &ZombieLog,
+    def_id: DefId,
+    offset: Size,
+    ty: Ty<'tcx>,
+    pointee: Ty<'tcx>,
+    meta: Option<u64>,
+    span: Span,
