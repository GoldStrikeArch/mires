+//! Verifier probe (A4+A6 combination): cycles through the A4 forms, split into two chunks.
+//! Option links, a slice into a static array that refers back (`{ buf, off, len }`), an
+//! `Option<&[T]>` static in a cycle, a single-variant-layout enum link, a `&str` into static bytes,
+//! and niche constants pointing into the cycles from both chunks.
+
+#![no_std]
+#![no_main]
+
+#[path = "prelude.rs"]
+mod prelude;
+use prelude::*;
+
+use core::convert::Infallible;
+use core::hint::black_box;
+use core::sync::atomic::{AtomicU32, Ordering};
+
+struct Node {
+    id: u32,
+    hits: AtomicU32,
+    name: &'static str,
+    next: Option<&'static Node>,
+    all: &'static [Node],
+}
+static BYTES: [u8; 4] = *b"both";
+/// Both chunks: an array that names itself through a slice, and a node that names the array.
+static SHARED: [Node; 2] = [
+    Node { id: 1, hits: AtomicU32::new(0), name: match core::str::from_utf8(&BYTES) { Ok(s) => s, Err(_) => "" }, next: Some(&SB), all: &SHARED },
+    Node { id: 2, hits: AtomicU32::new(0), name: "two", next: None, all: &SHARED },
+];
+static SB: Node = Node { id: 3, hits: AtomicU32::new(0), name: "sb", next: Some(&SB), all: &SHARED };
+const CA: Option<&'static Node> = Some(&SB);
+const CN: Option<&'static Node> = None;
+
+struct Row {
+    id: u32,
+    view: &'static Option<&'static [Row]>,
+}
+/// Chunk a only.
+static VIEW_A: Option<&'static [Row]> = Some(&ROWS_A);
+static ROWS_A: [Row; 2] = [Row { id: 5, view: &VIEW_A }, Row { id: 6, view: &VIEW_A }];
+
+enum L {
+    Never((), Infallible),
+    To(&'static LN),
+}
+struct LN {
+    id: u32,
+    l: L,
+}
+/// Chunk b only.
+static LB1: LN = LN { id: 7, l: L::To(&LB2) };
+static LB2: LN = LN { id: 8, l: L::To(&LB1) };
+
+#[inline(never)]
+fn to(n: &'static LN) -> &'static LN {
+    match n.l {
+        L::To(m) => m,
+        L::Never(..) => n,
+    }
+}
+
+#[unsafe(no_mangle)]
+pub fn chunk_a() {
+    print_str("chunk a");
+    print_str(SHARED[0].name);
+    SHARED[0].next.unwrap().hits.fetch_add(5, Ordering::Relaxed);
+    print_u32(SHARED[1].all.len() as u32);
+    print_u32(SHARED[0].all[1].all[0].next.unwrap().all[1].id);
+    print_bool(core::ptr::eq(SHARED[0].all.as_ptr(), SHARED.as_ptr()));
+    print_u32(VIEW_A.map_or(0, |v| v.len() as u32));
+    print_u32(ROWS_A[black_box(1)].view.unwrap()[0].id);
+    print_bool(core::ptr::eq(ROWS_A[0].view, &VIEW_A));
+    print_u32(CA.map_or(0, |n| n.id));
+    print_bool(core::ptr::eq(CA.unwrap(), &SB));
+    print_bool(black_box(CN).is_none());
+}
+
+#[unsafe(no_mangle)]
+pub fn chunk_b() {
+    print_str("chunk b");
+    print_u32(SB.hits.load(Ordering::Relaxed));
+    print_u32(black_box(CA).map_or(0, |n| n.next.unwrap().all[0].id));
+    SB.all[1].hits.fetch_add(2, Ordering::Relaxed);
+    print_u32(SHARED[1].hits.load(Ordering::Relaxed));
+    print_str(SB.all[0].name);
+    print_bool(core::ptr::eq(SB.next.unwrap(), &SB));
+    print_u32(to(&LB1).id * 10 + to(to(&LB1)).id);
+    print_bool(core::ptr::eq(to(&LB2), &LB1));
+}
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    chunk_a();
+    chunk_b();
+}
