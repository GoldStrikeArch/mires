+/// The variant rustc lays an enum out as when its layout is a single variant (`Variants::Single`,
+/// which the table spells as no niche and no physical tag on any variant): the first variant that
+/// is not [`absent_variant`] (`rustc_abi::layout::layout_of_enum`, `present_first`). Not
+/// necessarily variant 0: in `enum Parsed { Never((), Infallible), Char(char) }` it is `Char`.
+/// `None` when every variant is absent, which is the uninhabited layout.
+pub fn single_layout_variant(table: &TypeTable, variants: &[VariantDescriptor]) -> Option<usize> {
+    variants
+        .iter()
+        .position(|variant| !absent_variant(table, variant))
+}
