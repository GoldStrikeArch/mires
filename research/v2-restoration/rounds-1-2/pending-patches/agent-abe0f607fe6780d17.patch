diff --git a/examples/core-tests/244_niche_pointer_wrappers.rs b/examples/core-tests/244_niche_pointer_wrappers.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b126fdbed4b33c59c0b653991285a1ddaefa089a
--- /dev/null
+++ b/examples/core-tests/244_niche_pointer_wrappers.rs
@@ -0,0 +1,118 @@
+//! Pointer constants at types that hold a pointer without being one, and the edges of the pointer
+//! niche: zero-sized pointees, pointers into the middle of a promoted array, generic-position
+//! constants, and a const-generic choice between `Some` and `None`.
+//!
+//! A register-sized constant is a `ConstValue::Scalar`, and when the scalar is a pointer the type
+//! need not be a pointer type: `Option<&T>`, `NonNull<T>` (a transparent wrapper over a pattern
+//! type over `*const T`), a one-field struct, a one-element tuple. Each used to be treated as a
+//! pointer of its own type and refused (or, at a function, printed as the bare function); it is
+//! now put back into memory with its provenance and read at its type, by the same layout-driven
+//! reader as every other constant. `Some(&())` and `Some(&[])` point at zero-sized allocations,
+//! which are in bounds at offset zero and so not null.
+
+#![no_std]
+#![no_main]
+
+#[path = "prelude.rs"]
+mod prelude;
+use prelude::*;
+
+use core::hint::black_box;
+use core::ptr::NonNull;
+
+#[inline(never)]
+fn idx(i: usize) -> usize {
+    black_box(i)
+}
+
+// Zero-sized pointees and interior pointers.
+const ZU: Option<&()> = Some(&());
+const ZA: Option<&[u8; 0]> = Some(&[]);
+const ARR: [u32; 3] = [100, 200, 300];
+const MID: Option<&u32> = Some(&ARR[1]);
+static SMID: [Option<&u32>; 2] = [Some(&ARR[2]), Some(&ARR[0])];
+struct SyncEnd(Option<NonNull<u32>>);
+unsafe impl Sync for SyncEnd {}
+/// A `NonNull` one element into a promoted array: offset 4 of its allocation.
+static ENDS: SyncEnd = SyncEnd(Some(unsafe {
+    NonNull::new_unchecked((&ARR as *const [u32; 3]).cast::<u32>().cast_mut().wrapping_add(1))
+}));
+
+// Generic-position constants.
+trait Named {
+    const NAME: Option<&'static str>;
+    const SCALE: Option<&'static u32>;
+}
+struct A;
+struct B;
+impl Named for A {
+    const NAME: Option<&'static str> = Some("a-name");
+    const SCALE: Option<&'static u32> = Some(&12);
+}
+impl Named for B {
+    const NAME: Option<&'static str> = None;
+    const SCALE: Option<&'static u32> = None;
+}
+struct Pick<T>(T);
+impl<T: Named> Pick<T> {
+    const BOTH: (Option<&'static str>, Option<&'static u32>) = (T::NAME, T::SCALE);
+    const TABLE: [Option<&'static u32>; 2] = [T::SCALE, Some(&13)];
+}
+#[inline(never)]
+fn report<T: Named>() {
+    match T::NAME {
+        Some(s) => print_str(s),
+        None => print_str("<anon>"),
+    }
+    print_u32(T::SCALE.map_or(0, |s| *s));
+    let both = Pick::<T>::BOTH;
+    print_bool(both.0.is_some());
+    print_u32(both.1.map_or(1, |s| *s));
+    print_u32(Pick::<T>::TABLE[idx(0)].map_or(2, |s| *s));
+    print_u32(Pick::<T>::TABLE[idx(1)].map_or(3, |s| *s));
+}
+#[inline(never)]
+fn nth<const N: usize>() -> Option<&'static u32> {
+    if N < 3 { Some(&ARR[N]) } else { None }
+}
+
+// Pointer constants at types that hold a pointer but are not enums.
+static NN_T: u32 = 77;
+const NN: NonNull<u32> = NonNull::from_ref(&NN_T);
+#[derive(Clone, Copy)]
+struct Plain(&'static u32);
+#[derive(Clone, Copy)]
+#[repr(transparent)]
+struct Clear(&'static u32);
+const PLAIN: Plain = Plain(&78);
+const CLEAR: Clear = Clear(&79);
+const TUP: (&'static u32,) = (&80,);
+const FNW: Plain = Plain(&NN_T);
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    print_bool(ZU.is_some());
+    print_bool(black_box(ZU).is_some());
+    print_bool(ZA.is_some());
+    print_usize(ZA.map_or(9, |a| a.len()));
+    print_u32(*MID.unwrap());
+    print_u32(*black_box(MID).unwrap());
+    for i in 0..2 {
+        print_u32(SMID[idx(i)].map_or(0, |v| *v));
+    }
+    print_u32(unsafe { *black_box(&ENDS).0.unwrap().as_ptr() });
+    report::<A>();
+    report::<B>();
+    print_u32(nth::<1>().map_or(0, |v| *v));
+    print_u32(nth::<5>().map_or(0, |v| *v));
+    print_u32(unsafe { *NN.as_ptr() });
+    print_u32(unsafe { *black_box(NN).as_ptr() });
+    print_bool(core::ptr::eq(NN.as_ptr(), &NN_T));
+    print_u32(*PLAIN.0);
+    print_u32(*black_box(PLAIN).0);
+    print_u32(*CLEAR.0);
+    print_u32(*black_box(CLEAR).0);
+    print_u32(*TUP.0);
+    print_u32(*black_box(TUP).0);
+    print_bool(core::ptr::eq(FNW.0, &NN_T));
+}
