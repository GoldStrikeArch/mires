+/// One integer width the overflow tests sweep, with the types its pairs need.
+#[derive(Clone, Copy)]
+struct Width {
+    element: TypeId,
+    /// `(T, bool)`.
+    pair: TypeId,
+    /// `((T, bool),)`, a product holding a pair in a field.
+    nest: TypeId,
+    /// `&(T, bool)` and `*mut (T, bool)`.
+    reference: TypeId,
+    raw: TypeId,
+    signed: bool,
+    bits: u32,
