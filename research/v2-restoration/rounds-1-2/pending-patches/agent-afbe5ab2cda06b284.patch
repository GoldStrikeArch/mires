+  assert.equal(view.indexOf(5), 4)
+  view.copyWithin(2, 0, 2)
+  assert.deepEqual(rows, [[1, 2], [1, 2], [5, 6]])
+  view.fill(0, 4, 6)
+  assert.deepEqual(plain(rows[2]), [0, 0])
+  // The spare capacity of a `Vec<[u32; 2]>`, whose width comes from the type.
+  const block = [[1, 2], undefined, undefined]
+  const p = rt.unwindow({ buf: block, off: 0 }, 2)
+  assert.equal(read(p, 4), undefined)
+  p.buf[p.off + 3] = 9
+  assert.deepEqual(block[1].length, 2)
+  assert.equal(block[1][1], 9)
+  assert.equal(block[2], undefined)
+  const empty = [undefined, undefined]
+  const q = rt.unwindow({ buf: empty, off: 0 }, 3)
+  assert.equal(q.buf.length, 6)
+})
