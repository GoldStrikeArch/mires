+test('a heap block of exactly one array, cast from its elements, is that allocation\'s box', () => {
+  const rt = runtime()
+  // `Box<[u32]>` of three elements to `Box<[u32; 3]>`.
+  const raw = rt.alloc(12, 4)
+  const elements = rt.unscale_scalar(raw, 4, () => 0, 'u32')
+  for (let i = 0; i < 3; i++) elements.buf[i] = i + 1
+  const b = rt.window({ buf: elements.buf, off: 0, len: 3 }, 3)
+  assert.equal(b.w, undefined)
+  assert.equal(b.buf[b.off], raw.buf)
+  assert.equal(b.buf[b.off][2], 3)
+  assert.equal(rt.unwindow(b, 3).buf, raw.buf)
+  // A longer block, or an offset into it, is still a window.
+  assert.equal(rt.window({ buf: elements.buf, off: 1 }, 2).w, 2)
+  // The row of a block of one array goes back to the block's slot.
+  const one = rt.alloc(8, 4)
+  const box = u32rows(rt, one, 8, 2)
+  rt.write_array(box, [4, 5])
+  same(rt.window(rt.unwindow(box, 2), 2), { buf: one.buf, off: 0 })
+})
