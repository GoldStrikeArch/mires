+test('the way back from bytes climbs by nesting, so rows of one element are climbed too', () => {
+  const rt = runtime()
+  // `Box<[[u64; 1]; 2]>::clone`: the new box's byte pointer is the bytes of its row's elements.
+  const raw = rt.alloc(16, 8)
+  const box = rt.unscale_rows(raw, 16, 2, () => [0n], 8, rt.unscale, undefined, 1)
+  const grid = raw.buf[0]
+  assert.equal(rt._blocks.get(grid).n, 1, 'the row of a block of one array of rows is a block of rows')
+  const bytes = rt.scale(rt.unwindow(rt.unwindow(box, 2), 1), 8)
+  const back = rt.unscale_rows(bytes, 16, 2, () => [0n], 8, rt.unscale, undefined, 1)
+  assert.equal(back.buf[back.off], grid)
+  // Elements that are not arrays stop at their own size.
+  const flat = rt.unwindow({ buf: [[1n], [2n], [3n], [4n]], off: 0 }, 1)
+  const pairs = rt.unscale_rows(rt.scale(flat, 8), 16, 2, () => 0n, 8, rt.unscale_scalar, 'u64')
+  assert.deepEqual([pairs.buf === flat.buf, pairs.w], [true, 2])
+})
