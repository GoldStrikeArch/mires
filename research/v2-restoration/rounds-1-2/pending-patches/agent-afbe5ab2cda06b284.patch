+test('a byte view of rows of rows climbs back through both flattened views', () => {
+  const rt = runtime()
+  const cube = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]]
+  const bytes = rt.unwindow(rt.unwindow({ buf: cube, off: 0 }, 2), 2)
+  assert.equal(bytes.buf[5], 6)
+  same(rt.unscale_rows(bytes, 4, 2, () => [0, 0], 2, rt.unscale), { buf: cube, off: 0 })
+  same(rt.unscale_rows({ buf: bytes.buf, off: 4 }, 4, 2, () => [0, 0], 2, rt.unscale, undefined, 2), { buf: cube, off: 1 })
+})
