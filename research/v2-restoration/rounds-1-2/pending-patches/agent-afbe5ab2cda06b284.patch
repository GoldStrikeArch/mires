diff --git a/examples/core-tests/228_width_one_rows.rs b/examples/core-tests/228_width_one_rows.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ace6a81f579793b9caebd4b7838f5120d4b241d0
--- /dev/null
+++ b/examples/core-tests/228_width_one_rows.rs
@@ -0,0 +1,90 @@
+//! Rows of width one, and rows handed over to an owner of their elements.
+//!
+//! A `[u64; 1]` is the size of a `u64`, so the size of a block's elements cannot say whether it holds
+//! rows: the block records what it was made (`__rt.unscale_rows`). `Vec<[u64; 1]>` through
+//! `into_boxed_slice`, `into_vec`, `push` and `Rc::from`, a boxed grid of such rows cloned, and
+//! `Vec<[u8; 1]>` all read back what they hold.
+//!
+//! `Vec<[E; N]>::into_flattened` hands the rows to a `Vec<E>`, which casts them to `*mut E`: the block
+//! becomes those elements, in place (`__rt._unrow`), and the new vector is a plain buffer that grows,
+//! sorts and frees as any other. On the default lane rustc folds the cast chain and the `Vec<E>` keeps
+//! the rows' own byte pointer; the same first cast hands it over. Covered for `u32`, `bool` and `u8`
+//! elements, built by `push` past capacity and by `vec!`, and rows of byte arrays.
+
+#![no_std]
+#![no_main]
+
+extern crate alloc;
+
+#[path = "prelude.rs"]
+mod prelude;
+use prelude::*;
+
+use alloc::boxed::Box;
+use alloc::rc::Rc;
+use alloc::vec;
+use alloc::vec::Vec;
+use core::hint::black_box as bb;
+
+#[inline(never)] fn s(v: &[u64]) -> u64 { v.iter().fold(0u64, |x, y| x * 100 + *y) }
+#[inline(never)] fn s32(v: &[u32]) -> u32 { v.iter().fold(0u32, |x, y| x.wrapping_mul(10).wrapping_add(*y)) }
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    // Rows of width one: a row and its one element are the same size, and still different things.
+    let v: Vec<[u64; 1]> = (0..4u64).map(|i| [i + 30]).collect();
+    print_u64(s(v.as_flattened()));
+    let bs: Box<[[u64; 1]]> = v.into_boxed_slice();
+    print_u64(s(bs.as_flattened()));
+    let mut v2 = bs.into_vec();
+    print_u64(s(v2.as_flattened()));
+    v2.push([34]);
+    print_u64(s(v2.as_flattened()));
+    print_u64(v2[4][0] + v2.len() as u64 * 1000);
+    let rc: Rc<[[u64; 1]]> = Rc::from(v2);
+    print_u64(s(rc.as_flattened()));
+    let g: Box<[[u64; 1]; 2]> = Box::new(bb([[7], [8]]));
+    let h = g.clone();
+    print_u64(s(h.as_flattened()) + s(g.as_flattened()) * 10000);
+    let mut p: Vec<[u8; 1]> = Vec::new();
+    for i in 0..5u8 { p.push([i + 1]); }
+    let mut p2 = p.into_boxed_slice().into_vec();
+    p2.push([9]);
+    print_u64(p2.as_flattened().iter().fold(0u64, |x, y| x * 10 + *y as u64));
+    // `into_flattened` of vectors built by `push` and by `vec!`: the new vector owns plain elements,
+    // grows, sorts and is freed as any `Vec<E>`.
+    let mut a: Vec<[u32; 2]> = Vec::new();
+    a.push(bb([1, 2]));
+    a.push([3, 4]);
+    let mut f: Vec<u32> = a.into_flattened();
+    f.push(5);
+    print_u32(s32(&f) + f.len() as u32 * 100000);
+    let mut big: Vec<[u32; 4]> = Vec::with_capacity(3);
