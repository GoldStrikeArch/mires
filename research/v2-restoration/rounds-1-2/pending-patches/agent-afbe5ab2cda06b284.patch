+test('a slot into the view and one into the row it names are one place, in order', () => {
+  const rt = runtime()
+  const rows = [[1, 2], [3, 4], [5, 6]]
+  const p = rt.unwindow({ buf: rows, off: 0 }, 2)
+  const at = (i) => ({ buf: p.buf, off: i })
+  assert.equal(rt.ptr_eq(at(0), { buf: rows[0], off: 0 }), true)
+  assert.equal(rt.ptr_eq(at(3), { buf: rows[1], off: 1 }), true)
+  assert.equal(rt.ptr_eq({ buf: rows[1], off: 1 }, at(3)), true)
+  assert.equal(rt.ptr_eq(at(3), { buf: rows[1], off: 0 }), false)
+  assert.equal(rt.ptr_eq(at(2), { buf: rows[0], off: 0 }), false)
+  assert.equal(rt.ptr_eq({ buf: rows[0], off: 0 }, { buf: rows[1], off: 0 }), false)
+  assert.equal(rt.ptr_cmp(at(3), { buf: rows[1], off: 0 }, 8), 1)
+  assert.equal(rt.ptr_cmp({ buf: rows[1], off: 1 }, at(3), 8), 0)
+  assert.equal(rt.ptr_cmp({ buf: rows[2], off: 0 }, at(3), 8), 1)
+  assert.equal(rt.ptr_cmp(at(1), { buf: rows[2], off: 1 }, 8), -1)
+})
+
+test('the view is its rows\' storage: the cast keeps the address, and the elements are contiguous', () => {
+  const rt = runtime()
+  const rows = [[1n, 2n], [3n, 4n], [5n, 6n]]
+  const p = rt.unwindow({ buf: rows, off: 0 }, 2)
+  const base = rt.addr({ buf: rows, off: 0 }, 16)
+  assert.equal(rt.addr(p, 8), base)
+  assert.equal(rt.addr(rt.unwindow({ buf: rows, off: 2 }, 2), 8), base + 32)
+  assert.equal(rt.addr({ buf: p.buf, off: 5 }, 8), base + 40)
+  assert.equal(rt.addr(rt.scale({ buf: p.buf, off: 3 }, 8), 1), base + 24)
+  assert.equal(rt.addr(rt.erase({ buf: p.buf, off: 1 }, 8), 0), base + 8)
+})
+
+test('the cast back to rows: at the rows\' width the view gives the rows back, otherwise it stays a window', () => {
+  const rt = runtime()
+  const rows = [[1, 2], [3, 4], [5, 6]]
+  const p = rt.unwindow({ buf: rows, off: 0 }, 2)
+  same(rt.window({ buf: p.buf, off: 4 }, 2), { buf: rows, off: 2 })
+  const chunks = rt.chunk_slice({ buf: p.buf, off: 2, w: 2 }, 2, 2)
+  assert.deepEqual([chunks.buf === rows, chunks.off, chunks.len], [true, 1, 2])
+  assert.equal(rt.window({ buf: p.buf, off: 1 }, 2).w, 2)
+  assert.equal(rt.window({ buf: p.buf, off: 0 }, 3).w, 3)
+  // Chunks of another width, or from off a row boundary, are rows of the view's own elements.
+  const threes = rt.chunk_slice({ buf: p.buf, off: 0, w: 3 }, 2, 3)
+  assert.deepEqual(Array.from(rt.array_ref({ buf: threes.buf, off: 1 }, 3)), [4, 5, 6])
+  const odd = rt.chunk_slice({ buf: p.buf, off: 1, w: 2 }, 2, 2)
+  assert.deepEqual(Array.from(rt.array_ref({ buf: odd.buf, off: odd.off + 1 }, 2)), [4, 5])
+  // `[1i32, 2, 3, 4, 5].as_chunks::<2>()`, which used to be the pinned guard.
+  const five = [1, 2, 3, 4, 5]
+  const pairs = rt.chunk_slice({ buf: five, off: 0, w: 2 }, 2, 2)
+  assert.deepEqual(plain([...Array(2).keys()].map((i) => Array.from(rt.array_ref({ buf: pairs.buf, off: i }, 2)))), [[1, 2], [3, 4]])
+  // An empty chunk slice names no chunk, a row not written yet is a row, and a plain slot over bare
+  // elements holds no arrays at all.
+  const flat = [1, 2, 3]
+  assert.deepEqual(rt.chunk_slice({ buf: flat, off: 1, w: 2 }, 0, 2).len, 0)
+  assert.throws(() => rt.chunk_slice({ buf: flat, off: 0 }, 1, 2), aborts(rt, /chunk granularity/))
+  const slots = [undefined, undefined, undefined]
+  assert.deepEqual(rt.chunk_slice({ buf: slots, off: 0 }, 3, 4).len, 3)
+})
