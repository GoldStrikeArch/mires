+test('a byte view is never read as an array', () => {
+  const rt = runtime()
+  // `ptr::swap_nonoverlapping` of `u32`s casts a byte view of them to arrays of bytes.
+  assert.throws(() => rt.window({ buf: [1, 2, 3, 4], off: 0, sc: 4 }, 4), aborts(rt, /byte view read as an array/))
+  assert.throws(() => rt.window({ buf: [1, 2, 3, 4], off: 4, sc: 4 }, 2), aborts(rt, /byte view read as an array/))
+  // The inline cast of bytes to arrays of the same bytes keeps the scale, and every reader refuses it.
+  const words = [0x04030201, 0x08070605]
+  const w = { buf: words, off: 0, w: 4, sc: 4 }
+  for (const read of [() => rt.read_array(w, 4), () => rt.array_ref(w, 4), () => rt.write_array(w, [1, 2, 3, 4]),
+    () => rt.add_rows(w, 1), () => rt.chunk_slice(w, 2, 4)]) {
+    assert.throws(read, aborts(rt, /byte view read as an array/))
+  }
+  same(rt.unwindow(w, 4), { buf: words, off: 0, sc: 4 })
+})
