diff --git a/examples/core-tests/227_row_stores.rs b/examples/core-tests/227_row_stores.rs
new file mode 100644
index 0000000000000000000000000000000000000000..bcdc33751caf6cc49bb277cb58e3891868b2709d
--- /dev/null
+++ b/examples/core-tests/227_row_stores.rs
@@ -0,0 +1,96 @@
+//! A whole array stored through a `&mut [T; N]` that is a window into a longer run of elements.
+//!
+//! `try_into`, `first_chunk_mut`, `last_chunk_mut`, `split_first_chunk_mut` and `as_chunks_mut` hand
+//! out such a reference over a flat buffer or over the flattened view of rows; it is an array of
+//! accessors onto those elements (`__rt._element_view`). `*a = [..]` through it is `__rt.overwrite`,
+//! which emptied the array before assigning and so deleted the accessors: the store landed in the
+//! view, and every later element write through it was lost too. It now assigns element by element.
+//!
+//! Covered: stack rows, `Box<[[u32; 2]; 3]>`, `vec!` and `push`-built `Vec<[u32; 2]>`, each through
+//! row-aligned, straddling and wider references; flat stack arrays, a flat `Vec<u32>` and a `Vec<u8>`.
+
+#![no_std]
+#![no_main]
+
+extern crate alloc;
+
+#[path = "prelude.rs"]
+mod prelude;
+use prelude::*;
+
+use alloc::boxed::Box;
+use alloc::vec;
+use alloc::vec::Vec;
+use core::hint::black_box as bb;
+
+#[inline(never)] fn s(v: &[u32]) -> u32 { v.iter().fold(0u32, |x, y| x.wrapping_mul(10).wrapping_add(*y)) }
+#[inline(never)] fn set(a: &mut [u32; 2]) { *a = [8, 9]; }
+#[inline(never)] fn set3(a: &mut [u32; 3]) { *a = [7, 8, 9]; }
+
+#[inline(never)]
+fn go(rows: &mut [[u32; 2]]) {
+    // A whole row stored through a `&mut [u32; 2]` taken from the flattened view of the rows.
+    { let a: &mut [u32; 2] = (&mut rows.as_flattened_mut()[2..4]).try_into().unwrap(); set(a); }
+    print_u32(s(rows.as_flattened()));
+    { let a = rows.as_flattened_mut().first_chunk_mut::<2>().unwrap(); *a = [6, 7]; }
+    print_u32(s(rows.as_flattened()));
+    { let a = rows.as_flattened_mut().last_chunk_mut::<2>().unwrap(); *a = [4, 5]; }
+    print_u32(s(rows.as_flattened()));
+    // ...straddling two rows, and of another width.
+    { let a: &mut [u32; 2] = (&mut rows.as_flattened_mut()[1..3]).try_into().unwrap(); set(a); }
+    print_u32(s(rows.as_flattened()));
+    { let a: &mut [u32; 3] = (&mut rows.as_flattened_mut()[0..3]).try_into().unwrap(); set3(a); }
+    print_u32(s(rows.as_flattened()));
+    { let (c, _) = rows.as_flattened_mut().as_chunks_mut::<2>(); c[1] = [1, 1]; }
+    print_u32(s(rows.as_flattened()));
+    { let (h, t) = rows.as_flattened_mut().split_first_chunk_mut::<2>().unwrap(); *h = [2, 2]; t[0] = 3; }
+    print_u32(s(rows.as_flattened()));
+    // Element writes through the same kind of reference, after a whole-row store through it.
+    { let a: &mut [u32; 2] = (&mut rows.as_flattened_mut()[2..4]).try_into().unwrap(); *a = [0, 0]; a[0] = 5; a[1] += 1; }
+    print_u32(s(rows.as_flattened()));
+    set(&mut rows[0]);
+    { let r: &mut [u32; 2] = rows.last_mut().unwrap(); *r = [3, 3]; }
+    print_u32(s(rows.as_flattened()));
+}
+
+#[inline(never)]
+fn flat() {
+    let mut f = bb([1u32, 2, 3, 4, 5, 6]);
+    { let a: &mut [u32; 2] = (&mut f[2..4]).try_into().unwrap(); set(a); }
+    print_u32(s(&f));
+    { let a = f.first_chunk_mut::<2>().unwrap(); *a = [6, 7]; }
+    { let a = f.last_chunk_mut::<2>().unwrap(); *a = [4, 5]; }
+    print_u32(s(&f));
+    { let (h, t) = f.split_first_chunk_mut::<3>().unwrap(); *h = [2, 2, 2]; t[0] = 3; }
+    { let a: &mut [u32; 2] = (&mut f[4..6]).try_into().unwrap(); a[0] = 0; a.swap(0, 1); }
+    print_u32(s(&f));
+    { let a: &mut [u32; 6] = (&mut f[..]).try_into().unwrap(); *a = [1, 1, 2, 2, 3, 3]; }
+    print_u32(s(&f));
+    let mut fv = bb(vec![1u32, 2, 3, 4, 5, 6]);
+    { let a: &mut [u32; 2] = (&mut fv[2..4]).try_into().unwrap(); set(a); }
+    { let a: &mut [u32; 2] = (&mut fv[4..6]).try_into().unwrap(); *a = [1, 2]; a.swap(0, 1); }
+    print_u32(s(&fv));
+    { let a: &mut [u32; 6] = (&mut fv[..]).try_into().unwrap(); *a = [1, 1, 2, 2, 3, 3]; }
+    fv.push(4);
+    print_u32(s(&fv));
+    let mut b8 = bb(vec![1u8, 2, 3, 4]);
+    { let a: &mut [u8; 4] = (&mut b8[..]).try_into().unwrap(); *a = [4, 3, 2, 1]; }
+    { let a: &mut [u8; 2] = b8.last_chunk_mut::<2>().unwrap(); *a = [8, 8]; }
+    b8.push(9);
+    print_u32(b8.iter().fold(0u32, |x, y| x * 10 + *y as u32));
+}
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    let mut g = bb([[1u32, 2], [3, 4], [5, 6]]);
+    go(&mut g);
+    print_u32(s(&g[0]) * 10000 + s(&g[1]) * 100 + s(&g[2]));
+    let mut b = Box::new(bb([[1u32, 2], [3, 4], [5, 6]]));
+    go(&mut b[..]);
+    let mut v = bb(vec![[1u32, 2], [3, 4], [5, 6]]);
+    go(&mut v);
+    let mut p: Vec<[u32; 2]> = Vec::new();
+    for i in 0..3 { p.push([i * 2 + 1, i * 2 + 2]); }
+    go(&mut p);
+    flat();
+}
