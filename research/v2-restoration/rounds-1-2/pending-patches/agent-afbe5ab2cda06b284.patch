+test('a program that makes no view or row asks nothing more of its pointers', () => {
+  const rt = runtime()
+  const refuse = { get: () => assert.fail('consulted'), has: () => assert.fail('consulted') }
+  for (const map of ['_flat_of', '_rows_of', '_row_of']) rt[map] = refuse
+  const v = rt.alloc(16, 4)
+  const e = rt.unscale_scalar(v, 4, () => 0, 'u32')
+  e.buf[0] = 1
+  assert.equal(typeof rt.addr(e, 4), 'number')
+  assert.equal(typeof rt.addr({ buf: [1, 2, 3], off: 1 }, 4), 'number')
+  assert.equal(rt.ptr_eq({ buf: [1], off: 0 }, { buf: [1], off: 0 }), false)
+  assert.equal(rt.ptr_cmp(e, { buf: e.buf, off: 2 }, 4), -1)
+  assert.equal(rt.unwindow({ buf: { f: [1, 2] }, off: 'f' }, 2).off, 0)
+  assert.equal(rt.unwindow_slice({ buf: [[1, 2]], off: 0 }, 2).len, 2)
+  same(rt.unscale(rt.scale(e, 4), 4, null), { buf: v.buf, off: 0 })
+  rt.realloc(rt.scale(e, 4), 16, 4, 32)
+  rt.dealloc(rt.scale(e, 4), 32, 4)
+  assert.equal(rt._viewed, false)
+})
