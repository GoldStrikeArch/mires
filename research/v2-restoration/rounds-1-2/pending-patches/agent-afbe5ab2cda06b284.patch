+test('the element moves see the rows through the view', () => {
+  const rt = runtime()
+  const rows = [[1, 2], [3, 4], [5, 6]]
+  const p = rt.unwindow({ buf: rows, off: 0 }, 2)
+  const out = [0, 0, 0, 0]
+  rt.copy_nonoverlapping({ buf: out, off: 0 }, { buf: p.buf, off: 1 }, 4)
+  assert.deepEqual(out, [2, 3, 4, 5])
+  rt.copy({ buf: p.buf, off: 2 }, { buf: p.buf, off: 0 }, 4)
+  assert.deepEqual(rows, [[1, 2], [1, 2], [3, 4]])
+  rt.write_bytes({ buf: p.buf, off: 4 }, 0, 2, 0)
+  assert.deepEqual(plain(rows[2]), [0, 0])
+})
