+  zeroed.buf[1] = 5
+  assert.deepEqual(Array.from(rt.read_array(word, 4)), [0, 5, 0, 0])
+  assert.deepEqual(plain(zeroed.buf), [0, 5, 0, 0, 0, 0, 0, 0])
