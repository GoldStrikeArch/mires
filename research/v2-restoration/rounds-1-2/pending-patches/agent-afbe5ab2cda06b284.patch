+test('rows handed to an owner of their elements become those elements, in place', () => {
+  // `Vec<[u32; 2]>::into_flattened` on the lane that keeps the cast chain: the `Vec<u32>` keeps a
+  // byte view of the flattened view and casts it back to `u32`s on every access.
+  const rt = runtime()
+  const raw = rt.alloc(32, 4)
+  const rows = u32rows(rt, raw, 8, 2)
+  for (let i = 0; i < 3; i++) rt.write_array({ buf: rows.buf, off: i }, [i, i + 10])
+  const at = rt.addr(raw, 1)
+  const flat = rt.unwindow(rows, 2)
+  const bytes = rt.scale(flat, 4)
+  const elements = rt.unscale_scalar(bytes, 4, () => 0, 'u32')
+  assert.equal(elements.buf, raw.buf, 'a plain buffer, not the view')
+  assert.deepEqual(plain(raw.buf.slice(0, 6)), [0, 10, 1, 11, 2, 12])
+  assert.equal(raw.buf.length, 8)
+  // The view reads the block straight through from now on, and so does a later cast of it.
+  assert.equal(flat.buf[3], 11)
+  flat.buf[7] = 99
+  assert.equal(raw.buf[7], 99)
+  same(rt.unscale_scalar(bytes, 4, () => 0, 'u32'), { buf: raw.buf, off: 0 })
+  // The block keeps its address, grows and is freed through the byte view the owner keeps.
+  assert.equal(rt.addr(elements, 4), at)
+  const grown = rt.realloc(bytes, 32, 4, 48)
+  same(grown, { buf: raw.buf, off: 0 })
+  assert.equal(raw.buf.length, 12)
+  rt.dealloc(bytes, 48, 4)
+  assert.equal(raw.buf.length, 0)
+  // On the lane that folds the cast chain, the `Vec<u32>` keeps the rows' own byte pointer.
+  const folded = rt.alloc(16, 4)
+  const r2 = u32rows(rt, folded, 8, 2)
+  rt.write_array(r2, [1, 2])
+  rt.write_array({ buf: r2.buf, off: 1 }, [3, 4])
+  same(rt.unscale_scalar(folded, 4, () => 0, 'u32'), { buf: folded.buf, off: 0 })
+  assert.deepEqual(plain(folded.buf), [1, 2, 3, 4])
+  const flags = rt.alloc(6, 1)
+  const b = rt.unscale_rows(flags, 3, 3, () => false, 1, rt.unscale)
+  rt.write_array(b, [true, false, true])
+  rt.write_array({ buf: b.buf, off: 1 }, [false, true, true])
+  rt.retype(flags, 1, () => false)
+  assert.deepEqual(plain(flags.buf), [true, false, true, false, true, true])
+  // Rows of byte arrays handed to a `Vec<[u8; 2]>`, whose casts are windows over bytes: the block
+  // becomes the bytes, a level at a time.
+  const grid = rt.alloc(8, 1)
+  const g = rt.unscale_rows(grid, 4, 2, () => [0, 0], 2, rt.unscale, undefined, 2)
+  rt.write_array(g, [[1, 2], [3, 4]])
+  rt.write_array({ buf: g.buf, off: 1 }, [[5, 6], [7, 8]])
+  const second = rt.add_rows({ buf: grid.buf, off: 0, w: 2 }, 1)
+  assert.deepEqual(plain(grid.buf), [1, 2, 3, 4, 5, 6, 7, 8])
+  assert.deepEqual(Array.from(rt.array_ref(second, 2)), [3, 4])
+  // Rows handed over and then read as rows again are refused, not read.
+  assert.throws(() => u32rows(rt, folded, 8, 2), aborts(rt, /read as rows again/))
+})
+
+test('nothing to flatten: an empty buffer of rows and a zero-sized array keep a real buffer', () => {
+  const rt = runtime()
+  const dangling = rt._dangling(8)
+  const p = rt.unwindow({ buf: dangling.buf, off: 0 }, 2)
+  assert.equal(p.buf, dangling.buf)
+  assert.equal(rt.addr(p, 8), 8)
+  const none = []
+  assert.equal(rt.unwindow({ buf: none, off: 0 }, 2).buf, none)
+  const zst = rt.unwindow({ buf: undefined, off: 0, len: 0 }, 0)
+  assert.equal(rt.addr(zst, 4), rt._zst_addr)
+  const slice = rt.slice_from_parts(undefined, 0)
+  assert.deepEqual([slice.len, rt.addr(slice, 1)], [0, rt._zst_addr])
+  // The dangling pointer of a `Vec<[u32; 3]>` that never allocated is a plain slot.
+  const never = u32rows(rt, 4, 12, 3)
+  assert.deepEqual([never.w, never.off, rt.addr(never, 12)], [undefined, 0, 4])
+})
