+// Arrays of arrays in the runtime: heap blocks typed as rows (`__rt.unscale_rows`), the
+// flattened view of a buffer of rows (`__rt.unwindow` over several rows, `_flat_view`), the row
+// view of a buffer of elements (`_row_view`, which a window over bytes becomes), the hand-over of a
+// block of rows to an owner of its elements (`_unrow`), and the cast back (`__rt.window`,
+// `__rt.chunk_slice`). Each test drives the runtime the way the emitted code does: a slot is
+// `{ buf, off }`, a read is `p.buf[p.off + i]`, an array pointer is a plain slot whose element is
+// the array, or a window `{ buf, off, w }` over a run of elements.
+import assert from 'node:assert/strict'
+import { readFile } from 'node:fs/promises'
+import test from 'node:test'
+import vm from 'node:vm'
+
+const source = await readFile(new URL('../runtime/shim.js', import.meta.url), 'utf8')
+function runtime() {
+  const context = vm.createContext({})
+  vm.runInContext(source, context)
+  return context.__rt
+}
+const read = (p, i) => p.buf[p.off + i]
+const slot = (p) => [p.buf, p.off, p.w, p.sc]
+const same = (actual, expected) => assert.deepEqual(slot(actual), slot(expected))
+const plain = (value) => JSON.parse(JSON.stringify(value))
+const aborts = (rt, pattern) => (error) => rt.is_abort(error) && pattern.test(error.message)
+const u32rows = (rt, p, size, n) => rt.unscale_rows(p, size, n, () => 0, 4, rt.unscale_scalar, 'u32')
+
+test('a fresh heap block cast to an array of several is a buffer of rows', () => {
+  const rt = runtime()
+  const raw = rt.alloc(4 * 12, 4)
+  const p = u32rows(rt, raw, 12, 3)
+  assert.equal(p.buf, raw.buf)
+  assert.equal(p.off, 0)
+  assert.equal(p.buf.length, 4)
+  // `ptr.add(len).write(row)`: the plain slot of row 2, and the row is its own array.
+  rt.write_array({ buf: p.buf, off: 2 }, [7, 8, 9])
+  assert.deepEqual(plain(p.buf[2]), [7, 8, 9])
+  assert.equal(p.buf[2][1], 8)
+  // Every later cast of the same byte pointer names the same rows, and a byte view of a row is one.
+  same(u32rows(rt, raw, 12, 3), { buf: raw.buf, off: 0 })
+  const back = u32rows(rt, { buf: raw.buf, off: 24, sc: 12 }, 12, 3)
+  assert.deepEqual([back.buf === raw.buf, back.off], [true, 2])
+  // Growing it grows the rows.
+  rt.realloc(raw, 48, 4, 96)
+  assert.equal(raw.buf.length, 8)
+  assert.deepEqual(plain(raw.buf[2]), [7, 8, 9])
+})
+
+test('rows are what the block says it was made: the same size of something else is not rows', () => {
+  const rt = runtime()
+  // `Box<u64>` holds one 8-byte element; `[u64; 1]` is 8 bytes too, and is not what it holds.
+  const word = rt.alloc(8, 8)
+  const w = rt.unscale_scalar(word, 8, () => 0n, 'u64')
+  w.buf[w.off] = 9n
+  // It is read as the one array its element is: the box of the block.
+  const a = rt.unscale_rows(word, 8, 1, () => 0n, 8, rt.unscale_scalar, 'u64')
+  assert.equal(a.buf[a.off], word.buf)
+  assert.equal(word.buf[0], 9n, 'the element is not overwritten by a row')
+  // An offset into a longer block of such elements is a window over them.
+  const two = rt.alloc(16, 8)
+  const t = rt.unscale_scalar(two, 8, () => 0n, 'u64')
+  t.buf[1] = 4n
+  const b = rt.unscale_rows({ buf: two.buf, off: 8, sc: 8 }, 8, 1, () => 0n, 8, rt.unscale_scalar, 'u64')
+  assert.deepEqual([b.buf === two.buf, b.off, b.w], [true, 1, 1])
+  assert.deepEqual(Array.from(rt.read_array(b, 1)), [4n])
+  // Rows of width one are rows, and are answered as rows.
+  const block = rt.alloc(24, 8)
+  const rows = rt.unscale_rows(block, 8, 1, () => 0n, 8, rt.unscale_scalar, 'u64')
+  rt.write_array({ buf: rows.buf, off: 1 }, [5n])
+  same(rt.unscale_rows(block, 8, 1, () => 0n, 8, rt.unscale_scalar, 'u64'), { buf: block.buf, off: 0 })
+  assert.deepEqual(plain(block.buf[1].map(String)), ['5'])
+})
+
+test('a zeroed block is filled with zero rows, and a block of one array keeps its row as its flat face', () => {
+  const rt = runtime()
+  const zeroed = rt.alloc_zeroed(16, 8)
+  u32rows(rt, zeroed, 8, 2)
+  assert.deepEqual(plain(zeroed.buf), [[0, 0], [0, 0]])
+  assert.notEqual(zeroed.buf[0], zeroed.buf[1])
+  const one = rt.alloc(12, 4)
+  const b = u32rows(rt, one, 12, 3)
+  rt.write_array(b, [1, 2, 3])
+  const row = one.buf[0]
+  assert.deepEqual(plain(row), [1, 2, 3])
+  // `Box<[u32; 3]>` to `Box<[u32]>`: the slice is over the row, which is a heap block of `u32`s that
+  // a `Vec<u32>` grows and frees as its own.
+  const slice = rt.unwindow_slice(b, 3)
+  assert.equal(slice.buf, row)
+  rt.realloc(rt.scale({ buf: row, off: 0 }, 4), 12, 4, 24)
+  assert.equal(row.length, 6)
+  rt.dealloc(rt.scale({ buf: row, off: 0 }, 4), 24, 4)
+  assert.equal(row.length, 0)
+  // `&*b as *const [u32; 3]` is the block's slot, and its address is the row's.
+  same(rt.box(one.buf[0]), { buf: one.buf, off: 0 })
+})
+
+test('a block whose address was taken before it was typed hands that address to its row', () => {
+  const rt = runtime()
+  const raw = rt.alloc(8, 4)
+  const before = rt.addr(raw, 1)
+  const b = u32rows(rt, raw, 8, 2)
+  rt.write_array(b, [5, 6])
+  assert.equal(rt.addr(b, 8), before)
+  assert.equal(rt.addr(rt.unwindow(b, 2), 4), before)
+  // The row reached as the array a reference is (`b.as_ptr()` unsizes `&[u32; 2]`), before any
+  // cast hands it the address, is at the block's address too.
+  const other = rt.alloc(8, 4)
+  const first = rt.addr(other, 1)
+  const ob = u32rows(rt, other, 8, 2)
+  assert.equal(rt.addr({ buf: other.buf[0], off: 1 }, 4), first + 4)
+  assert.equal(rt.addr(rt.box(other.buf[0]), 8), first)
+  assert.equal(rt.addr(rt.unwindow(ob, 2), 4), first)
+  assert.equal(rt.addr(ob, 8), first)
+  // Freeing the row gives the granule back, so a later block can have it.
+  rt.dealloc(rt.scale(rt.unwindow(b, 2), 4), 8, 4)
+  const next = rt.alloc(8, 4)
+  assert.equal(rt.addr(next, 1), before)
+})
+
+test('a block of one array freed as rows gives its own granule back', () => {
+  const rt = runtime()
+  // `Vec<[u32; 1024]>` allocates one row at a time and frees the block through its `*mut u8`.
+  for (let round = 0; round < 3; round++) {
+    const raw = rt.alloc(4096, 4)
+    const at = rt.addr(raw, 1)
+    const rows = u32rows(rt, raw, 4096, 1024)
+    rt.write_array(rows, new Array(1024).fill(round))
+    assert.equal(rt.addr(rows, 4096), at)
+    rt.dealloc(raw, 4096, 4)
+    const next = rt.alloc(4096, 4)
+    assert.equal(rt.addr(next, 1), at, 'the next block of the size reuses the granule')
+    rt.dealloc(next, 4096, 4)
+  }
+})
+
+test('a written byte block is never retyped into rows of something else', () => {
+  const rt = runtime()
+  // A `Vec<u8>` written through raw pointers is still fresh: a byte is its own element.
+  const raw = rt.alloc(8, 1)
+  for (let i = 0; i < 8; i++) raw.buf[i] = i + 1
+  const p = rt.unscale_rows({ buf: raw.buf, off: 0 }, 4, 2, () => 0, 2, rt.unscale_scalar, 'u16')
+  assert.equal(p.w, 2)
+  assert.deepEqual(plain(raw.buf), [1, 2, 3, 4, 5, 6, 7, 8])
+  // Sealed as bytes, so a word read of it is the aliasing view rather than a retype.
+  const words = rt.unscale_scalar({ buf: raw.buf, off: 4 }, 4, () => 0, 'u32')
+  assert.equal(words.buf[words.off], 0x08070605)
+})
+
+test('bytes read as arrays of the same bytes stay bytes, and are rows through their row view', () => {
+  const rt = runtime()
+  // `vec![0u8; 8]` read a word at a time through `p as *const [u8; 4]`, then written as bytes:
+  // the cast is a window (`ptr.rs::cast_pointer`), so nothing about the block changes.
+  const zeroed = rt.alloc_zeroed(8, 1)
