diff --git a/examples/core-tests/223_array_row_drops.rs b/examples/core-tests/223_array_row_drops.rs
new file mode 100644
index 0000000000000000000000000000000000000000..335fd6ff30330e0a7dab69611212965189fed950
--- /dev/null
+++ b/examples/core-tests/223_array_row_drops.rs
@@ -0,0 +1,126 @@
+//! Destructors of elements inside heap blocks of rows run exactly once.
+//!
+//! The elements of a `Box<[D; N]>`, a `Box<[[D; N]; M]>` and a `Vec<[D; N]>` are dropped by drop
+//! glue that walks the rows through `&raw mut (*slice)[i]` and then each row's elements, which
+//! needs the rows to be the arrays they are (`__rt.unscale_rows`). The block is freed through the
+//! row a `Box<[D]>` or `Vec<D>` owns. Each drop below is counted and its order hashed.
+//!
+//! `rows_host_throw` is the exceptional path: with its host call made to throw, cleanup must still
+//! drop every element of the boxes and the vector of rows, in the order the normal path does,
+//! before the exception leaves Rust. `rust_entry` runs it without the throw.
+
+#![no_std]
+#![no_main]
+
+extern crate alloc;
+
+#[path = "prelude.rs"]
+mod prelude;
+use prelude::*;
+
+use alloc::boxed::Box;
+use alloc::vec::Vec;
+use alloc::vec;
+use core::cell::Cell;
+use core::hint::black_box as bb;
+
+struct D<'a> { id: u32, log: &'a Cell<u32>, n: &'a Cell<u32> }
+impl Drop for D<'_> {
+    fn drop(&mut self) {
+        self.log.set(self.log.get().wrapping_mul(31).wrapping_add(self.id));
+        self.n.set(self.n.get() + 1);
+    }
+}
+#[derive(Clone)]
+struct C<'a> { id: u32, n: &'a Cell<u32> }
+impl Drop for C<'_> { fn drop(&mut self) { self.n.set(self.n.get() + self.id); } }
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    let log = Cell::new(0u32);
+    let n = Cell::new(0u32);
+    let d = |id| D { id, log: &log, n: &n };
+    {
+        let b: Box<[D; 3]> = bb(Box::new([d(1), d(2), d(3)]));
+        print_u32(b[1].id);
+    }
+    print_u32(n.get());
+    print_u32(log.get());
+    {
+        let g: Box<[[D; 2]; 2]> = bb(Box::new([[d(1), d(2)], [d(3), d(4)]]));
+        print_u32(g[1][1].id);
+    }
+    print_u32(n.get());
+    {
+        let mut v: Vec<[D; 2]> = Vec::new();
+        for i in 0..5 { v.push([d(i * 2), d(i * 2 + 1)]); }
+        let r = v.remove(1);
+        print_u32(r[0].id + r[1].id);
+        drop(r);
+        v.truncate(3);
+        print_u32(n.get());
+        let p = v.pop();
+        drop(p);
+        print_u32(n.get());
+        v.insert(0, [d(50), d(51)]);
+        let s: Box<[[D; 2]]> = v.into_boxed_slice();
+        print_usize(s.len());
+    }
+    print_u32(n.get());
+    {
+        let v = vec![[d(1), d(2)], [d(3), d(4)], [d(5), d(6)]];
+        let f: Vec<D> = v.into_flattened();
+        print_u32(f[4].id);
+    }
+    print_u32(n.get());
+    {
+        let b: Box<[D]> = Box::new([d(7), d(8)]);
+        let mut v = b.into_vec();
+        v.push(d(9));
+        print_usize(v.len());
+    }
+    print_u32(n.get());
+    print_u32(log.get());
+    let k = Cell::new(0u32);
+    {
+        let v = vec![[C { id: 1, n: &k }, C { id: 10, n: &k }]; 3];
+        print_usize(v.len());
+        let w = v.clone();
+        drop(v);
+        print_u32(k.get());
+        drop(w);
+    }
+    print_u32(k.get());
+    {
+        let mut v: Vec<[C; 1]> = Vec::with_capacity(1);
+        v.push([C { id: 100, n: &k }]);
+        v.push([C { id: 1000, n: &k }]);
+        v.retain(|r| r[0].id > 500);
+        print_u32(k.get());
+    }
+    print_u32(k.get());
+    print_u32(rows_host_throw(false));
+}
+
+// The exceptional path: with `throwing` the host call throws, and cleanup must still drop every
+// element of the heap blocks of rows below exactly once, before the exception leaves Rust.
+unsafe extern "C" {
+    fn host_throw();
+}
+struct Loud(u32);
+impl Drop for Loud { fn drop(&mut self) { print_u32(self.0); } }
+#[unsafe(no_mangle)]
+pub fn rows_host_throw(throwing: bool) -> u32 {
+    let boxed: Box<[Loud; 2]> = Box::new([Loud(1), Loud(2)]);
+    let mut rows: Vec<[Loud; 2]> = Vec::new();
+    rows.push([Loud(3), Loud(4)]);
+    rows.push([Loud(5), Loud(6)]);
+    let grid: Box<[[Loud; 1]; 2]> = Box::new([[Loud(7)], [Loud(8)]]);
+    if throwing {
+        unsafe { host_throw() };
+    }
+    drop(grid);
+    drop(rows);
+    drop(boxed);
+    9
+}
