diff --git a/examples/core-tests/226_byte_rows.rs b/examples/core-tests/226_byte_rows.rs
new file mode 100644
index 0000000000000000000000000000000000000000..31ec99cd2933ff4b7c53313e176464bb716a2a2c
--- /dev/null
+++ b/examples/core-tests/226_byte_rows.rs
@@ -0,0 +1,106 @@
+//! Bytes read as arrays of the same bytes, and arrays of bytes on the heap.
+//!
+//! `core::array::from_ref`, `try_into`, `first_chunk` and `as_chunks` cast a `*const u8` to a
+//! `*const [u8; N]` over bytes that go on being read as bytes, and `Vec<[u8; N]>` makes the very same
+//! cast over its own buffer. Nothing at the cast tells the two apart, so it retypes nothing: it is a
+//! window over the bytes, and a window moved or sliced as arrays reads them as rows through a view
+//! (`__rt._row_view`). Before, a one-byte `Box<u8>`, a `Vec<u8>` of capacity one, a one-character
+//! `String` and a zeroed `Vec<u8>` read through `*const [u8; 4]` were retyped into rows and lost their
+//! bytes.
+//!
+//! Covered: one-byte blocks seen as `&[u8; 1]`; zeroed and fresh `Vec<u8>` read a word at a time
+//! through a raw cast, then written and pushed as bytes; `as_chunks_mut` and `first_chunk` of a
+//! `Vec<u8>` written through; `Vec<[u8; 4]>` pushed, indexed, inserted into, removed from, sorted,
+//! swapped, reversed, cloned, flattened and `into_flattened`; `Box<[u8; 4]>` and `Box<[[u8; 2]; 3]>`
+//! to `Vec`; `collect` of rows, `iter().flatten()` and `concat`.
+
+#![no_std]
+#![no_main]
+
+extern crate alloc;
+
+#[path = "prelude.rs"]
+mod prelude;
+use prelude::*;
+
+use alloc::boxed::Box;
+use alloc::string::String;
+use alloc::vec;
+use alloc::vec::Vec;
+use core::hint::black_box as bb;
+
+#[inline(never)] fn one(x: &u8) -> &[u8; 1] { core::array::from_ref(x) }
+#[inline(never)] fn first(v: &[u8]) -> u8 { let a: &[u8; 1] = v[..1].try_into().unwrap(); a[0] }
+#[inline(never)] fn word(p: *const u8) -> u32 { u32::from_le_bytes(unsafe { *(p as *const [u8; 4]) }) }
+#[inline(never)] fn s(v: &[u8]) -> u32 { v.iter().fold(0u32, |x, y| x.wrapping_mul(10).wrapping_add(*y as u32)) }
+#[inline(never)] fn rows(v: &[[u8; 4]]) -> u32 { v.iter().fold(0u32, |x, r| x.wrapping_mul(7).wrapping_add(s(r))) }
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    // One byte on the heap seen as `&[u8; 1]`: the byte is still there afterwards.
+    let b = Box::new(bb(9u8));
+    let a = one(&b);
+    print_u32(a[0] as u32 * 10 + *b as u32);
+    let mut v: Vec<u8> = Vec::with_capacity(1);
+    v.push(bb(7));
+    print_u32(one(&v[0])[0] as u32 + first(&v) as u32 * 10 + v[0] as u32 * 100);
+    v.push(8);
+    print_u32(s(&v));
+    let z = bb(vec![0u8; 1]);
+    print_u32(one(&z[0])[0] as u32 + z[0] as u32 + 1);
+    let st = bb(String::from("x"));
+    print_u32(one(&st.as_bytes()[0])[0] as u32);
+    print_str(&st);
+    let f = bb(vec![true]);
+    print_bool(core::array::from_ref(&f[0])[0] && f[0]);
+    // A zeroed and a fresh `Vec<u8>` read a word at a time through `*const [u8; 4]`, then as bytes.
+    let mut w = bb(vec![0u8; 8]);
+    print_u32(word(w.as_ptr()));
+    w[1] = 5;
+    print_u32(word(w.as_ptr()) + w[1] as u32 + w[0] as u32);
+    let mut u: Vec<u8> = Vec::with_capacity(8);
+    let p = u.as_mut_ptr() as *mut [u8; 4];
+    unsafe { p.write([1, 2, 3, 4]); u.set_len(4); }
+    print_u32(s(&u));
+    for i in 0..20u8 { u.push(i + 5); }
+    print_u32(u.iter().map(|x| *x as u32).sum());
+    // `as_chunks` and `first_chunk` of a `Vec<u8>`, written through, and the bytes after.
+    let mut c = bb(vec![1u8, 2, 3, 4, 5, 6, 7, 8, 9]);
+    {
+        let (chunks, rest) = c.as_chunks_mut::<4>();
+        chunks[1][0] = 50;
+        chunks[0] = [4, 3, 2, 1];
+        rest[0] = 90;
+        print_u32(chunks.len() as u32 * 1000 + rows(chunks));
+    }
+    print_u32(s(&c));
+    print_u32(u32::from_le_bytes(*c.first_chunk::<4>().unwrap()) % 100000);
+    // `Vec<[u8; 4]>` and `Box<[u8; 4]>`: the bytes are the storage, read as rows.
+    let mut px: Vec<[u8; 4]> = Vec::new();
+    for i in 0..6u8 { px.push([i, i + 1, i + 2, 255 - i]); }
+    px[2][3] = 7;
+    px.insert(1, [9, 9, 9, 9]);
+    px.remove(4);
+    print_u32(rows(&px) + px.len() as u32);
+    px.sort_by_key(|r| r[3]);
+    print_u32(rows(&px));
+    px.swap(0, 2);
+    px.reverse();
+    print_u32(rows(&px) ^ s(px.as_flattened()));
+    let copy = px.clone();
+    px.as_flattened_mut()[5] = 42;
+    print_u32(rows(&copy) * 3 + rows(&px));
+    let mut flat: Vec<u8> = px.into_flattened();
+    flat.push(1);
+    print_u32(s(&flat) ^ flat.len() as u32);
+    let mut bx: Box<[u8; 4]> = Box::new(bb([1, 2, 3, 4]));
+    bx[2] = 30;
+    let back: Vec<u8> = (bx as Box<[u8]>).into_vec();
+    print_u32(s(&back));
+    let grid: Box<[[u8; 2]; 3]> = Box::new(bb([[1, 2], [3, 4], [5, 6]]));
+    let mut gv: Vec<[u8; 2]> = (grid as Box<[[u8; 2]]>).into_vec();
+    gv.push([7, 8]);
+    print_u32(s(gv.as_flattened()) % 1000000);
+    let built: Vec<[u8; 3]> = (0..4u8).map(|i| [i, i * 2, i * 3]).collect();
+    print_u32(built.iter().flatten().map(|x| *x as u32).sum::<u32>() + built.concat().len() as u32);
+}
