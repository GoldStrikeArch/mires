+
+/// `entry(x) { r = work(x) [unwind: c] ; return r }`, `c: goto d`, `d: rethrow`.
+fn goto_chain(interns: &mut Interns) -> Func {
+    let mut b = FuncBuilder::new(item(1), signature(1, I32));
+    let x = b.param(I32, O);
+    let entry = FuncBuilder::ENTRY;
+    let normal = b.block();
+    let chain = b.block();
+    let rethrow = b.block();
+    let result = b.op(entry, call(interns, "work", vec![x]), I32, O);
+    b.terminate(
+        entry,
+        RTerm::Invoke {
+            normal: (normal, vec![]),
+            unwind: (chain, vec![]),
+        },
+    );
+    b.terminate(normal, RTerm::Return(Some(result)));
+    let one = constant(&mut b, chain, 1);
+    let _ = b.op(
+        chain,
+        OpKind::Binary {
+            op: BinaryOp::Add,
+            l: one,
+            r: one,
+            ty: I32,
+        },
+        I32,
+        O,
+    );
+    b.terminate(chain, RTerm::Goto(rethrow, vec![]));
+    b.terminate(rethrow, RTerm::Throw(None));
+    b.finish()
+}
+
+const WORK_HARNESS: &str = r#"
+let trace, thrown;
+function work(x) { trace.push(['work', x]); if (thrown !== null) throw inputs[thrown]; return x + 1; }
+function observe(entry) {
+  const out = [];
+  for (thrown of [null, ...inputs.keys()]) {
+    trace = [];
+    try { out.push(['ret', entry(41), trace]); }
+    catch (error) {
+      out.push(['threw', describe(error), __rt.is_abort(error), trace]);
+    }
+  }
+  return out;
+}
+"#;
+
+#[test]
+fn an_empty_goto_chain_is_removed_and_the_rethrow_is_unchanged() {
+    let mut interns = world();
+    let func = goto_chain(&mut interns);
+    let mut program = Program::new(interns);
+    program.add("entry", func, &[]);
+    let (funcs, stats) = program.run(false);
+    assert_eq!(reasons(&stats), ["empty-chain"]);
+    assert_eq!(stats.retained_edges, 0);
+    let after = funcs[&JsName::new("entry".to_owned())].as_ref().unwrap();
+    assert!(!after.has_invoke());
+    assert_eq!(after.blocks.len(), 2, "the orphaned chain is pruned");
+    check_same_as_baseline(
+        &program.interns,
+        program.func("entry"),
+        after,
+        &[],
+        WORK_HARNESS,
+        0,
+    )
+    .unwrap();
+}
+
+/// `entry(x)`: a guard cell, `r = work(x) [unwind: c]`, and the chain `c` given by `chain`.
+fn guarded(
+    interns: &mut Interns,
+    chain_op: impl FnOnce(&mut Interns, crate::jir::repr::CellId, ValueId) -> OpKind,
+) -> Func {
+    let mut b = FuncBuilder::new(item(1), signature(1, I32));
+    let x = b.param(I32, O);
+    let entry = FuncBuilder::ENTRY;
+    let normal = b.block();
+    let chain = b.block();
+    let guard = b.cell(I32, true, O);
+    b.effect(entry, OpKind::CellAlloc(guard), O);
+    b.effect(entry, OpKind::CellStore { cell: guard, v: x }, O);
+    let result = b.op(entry, call(interns, "work", vec![x]), I32, O);
+    b.terminate(
+        entry,
+        RTerm::Invoke {
+            normal: (normal, vec![]),
+            unwind: (chain, vec![]),
+        },
+    );
+    b.terminate(normal, RTerm::Return(Some(result)));
+    let seven = constant(&mut b, chain, 7);
+    let kind = chain_op(interns, guard, seven);
+    b.effect(chain, kind, O);
+    b.terminate(chain, RTerm::Throw(None));
+    b.finish()
+}
+
+const GUARD_HARNESS: &str = r#"
+let trace, thrown;
+function work(x) { trace.push('work'); if (thrown !== null) throw inputs[thrown]; return x + 1; }
+function drop_guard(slot) { trace.push(['drop', slot.buf[slot.off]]); }
+function observe(entry) {
+  const out = [];
+  for (thrown of [null, ...inputs.keys()]) {
+    trace = [];
+    try { out.push(['ret', entry(5), trace]); }
+    catch (error) { out.push(['threw', describe(error), trace]); }
+  }
+  return out;
+}
+"#;
+
+#[test]
+fn a_chain_that_drops_is_retained() {
+    let mut interns = world();
+    let func = guarded(&mut interns, |interns, cell, _| drop_guard(interns, cell));
+    let mut program = Program::new(interns);
+    program.add("entry", func, &[]);
+    let (funcs, stats) = program.run(false);
+    assert!(stats.removed.is_empty());
+    assert_eq!(stats.retained_edges, 1);
+    assert_eq!(stats.retained[CHAIN_OBSERVABLE], 1);
+    // `work` has no body in the program: nothing is known about what it throws.
+    assert_eq!(stats.retained[MISSING_SUMMARY], 1);
+    assert_eq!(stats.retained_sole_causes["missing-summary"], 1);
+    assert_eq!(stats.retained_callees["work"], 1);
+    assert_eq!(stats.retained_leaves["missing-summary work"], 1);
+    assert_eq!(stats.chain_observable["Drop"], 1);
+    assert_eq!(
+        funcs[&JsName::new("entry".to_owned())].as_ref().unwrap(),
+        program.func("entry")
+    );
+}
