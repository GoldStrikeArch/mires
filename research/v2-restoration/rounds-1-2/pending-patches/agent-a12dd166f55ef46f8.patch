+//! Byte buffers crossing the host boundary in bulk: `mires_js::JsUint8Array`.
+//!
+//! A Rust `Vec<u8>` is a JavaScript array of numbers (or a `{ buf, off, len }` view over one), not
+//! a `Uint8Array`, so handing bytes to the host is a conversion. `JsUint8Array::from_slice` is one
+//! host operation that copies the whole range into a fresh `Uint8Array`; `copy_to_slice` and
+//! `to_vec` are the one operation back. `scripts/extern-check.mjs` drives every entry point below
+//! and checks exact byte values, exact lengths, slices that do not start at their buffer's first
+//! element, `i8` storage read as its bytes, and copy semantics in both directions: a write on
+//! either side after a crossing is never visible on the other.
+//!
+//! The panic handler throws, so a length mismatch in `copy_to_slice` is observable from the check
+//! as an exception rather than as a hang.
+//!
+//! The last entry points hand the operations what no sound program can: a host object retyped as
+//! a byte slice by a declaration that lies, and storage that is not bytes viewed as bytes through
+//! `unsafe`. The export must answer each with a registered compiler abort and never an ordinary
+//! exception, because the compiler classifies it as unable to throw.
+
+#![no_std]
+#![no_main]
+
+extern crate alloc;
+
+use alloc::vec;
+use alloc::vec::Vec;
+
+use mires_js::{invoke, js_bindings, js_export, throw_value, JsUint8Array, JsValue};
+
+#[panic_handler]
+fn panic(_: &core::panic::PanicInfo) -> ! {
+    throw_value(JsValue::erase("rust panic"))
+}
+
+/// `length` bytes of a pattern that reaches every value 0..=255.
+fn pattern(length: usize) -> Vec<u8> {
+    (0..length).map(|index| (index * 7 + 3) as u8).collect()
+}
+
+/// The bytes of `pattern(length)`, exported.
+#[js_export]
+pub fn bytes_pattern(length: u32) -> JsValue {
+    JsUint8Array::from_slice(&pattern(length as usize)).as_value()
+}
+
+/// The two ends of the byte range and their neighbours.
+#[js_export]
+pub fn bytes_extremes() -> JsValue {
+    JsUint8Array::from_slice(&[0, 255, 1, 254, 127, 128]).as_value()
+}
+
+/// An empty literal: a slice over an empty array constant (`{ buf: [], off: 0, len: 0 }`).
+#[js_export]
+pub fn bytes_empty_literal() -> JsValue {
+    JsUint8Array::from_slice(&[]).as_value()
+}
+
+/// An empty `Vec` that never allocated: its slice is over the dangling pointer.
+#[js_export]
+pub fn bytes_empty_vec() -> JsValue {
+    let bytes: Vec<u8> = Vec::new();
+    JsUint8Array::from_slice(&bytes).as_value()
+}
+
+/// `pattern(300)[start..end]`: a slice whose first element is not its buffer's.
+#[js_export]
+pub fn bytes_middle(start: u32, end: u32) -> JsValue {
+    let bytes = pattern(300);
+    JsUint8Array::from(&bytes[start as usize..end as usize]).as_value()
+}
+
+/// A `Vec` that grew past its capacity and was then truncated: only `[0, len)` crosses, never the
+/// capacity behind it.
+#[js_export]
+pub fn bytes_push_truncate() -> JsValue {
+    let mut bytes = Vec::with_capacity(2);
+    for value in 1..=10u8 {
+        bytes.push(value * 25);
+    }
+    bytes.truncate(5);
+    bytes.push(255);
+    JsUint8Array::from_slice(&bytes).as_value()
+}
+
+/// `i8` storage read through a byte slice: each element crosses as its byte.
+#[js_export]
+pub fn bytes_signed() -> JsValue {
+    let signed: Vec<i8> = vec![-128, -1, 0, 1, 127];
+    // SAFETY: `i8` and `u8` have the same size and alignment and every bit pattern is valid for
+    // both; the slice borrows `signed` for no longer than this call.
+    let bytes = unsafe { core::slice::from_raw_parts(signed.as_ptr().cast::<u8>(), signed.len()) };
+    JsUint8Array::from_slice(bytes).as_value()
+}
+
+/// A static byte string and a `&str`'s UTF-8 bytes.
+#[js_export]
+pub fn bytes_static_and_str(which: u32) -> JsValue {
+    let bytes: &[u8] = match which {
+        0 => b"\x00\xffstatic",
+        _ => "h\u{e9}llo \u{1f600}".as_bytes(),
+    };
+    JsUint8Array::from_slice(bytes).as_value()
+}
+
+/// Rust to JavaScript to Rust: `pattern(length)` exported, imported back, compared.
+#[js_export]
+pub fn bytes_round_trip(length: u32) -> bool {
+    let bytes = pattern(length as usize);
+    let view = JsUint8Array::from_slice(&bytes);
+    let back: Vec<u8> = Vec::from(view);
+    let mut middle = vec![0; bytes.len() / 2];
+    if !middle.is_empty() {
+        let quarter = bytes.len() / 4;
+        JsUint8Array::from_slice(&bytes[quarter..quarter + middle.len()])
+            .copy_to_slice(&mut middle);
+    }
+    back == bytes && middle[..] == bytes[bytes.len() / 4..bytes.len() / 4 + middle.len()]
+}
+
+/// JavaScript to Rust to JavaScript: a host `Uint8Array` copied into a `Vec` and exported again.
+#[js_export]
+pub fn bytes_echo(input: JsValue) -> JsValue {
+    let view = input.read::<JsUint8Array>();
+    JsUint8Array::from_slice(&view.to_vec()).as_value()
+}
+
+/// A host `Uint8Array` copied into the middle of a larger Rust buffer of `0xee` bytes, which is
+/// exported whole so the check can see both the copied range and the untouched bytes around it.
+#[js_export]
+pub fn bytes_copy_into_middle(input: JsValue, offset: u32) -> JsValue {
+    let view = input.read::<JsUint8Array>();
+    let offset = offset as usize;
+    let mut bytes = vec![0xee; view.len() + 2 * offset];
+    view.copy_to_slice(&mut bytes[offset..offset + view.len()]);
+    JsUint8Array::from_slice(&bytes).as_value()
+}
+
+/// `copy_to_slice` into a destination of the wrong length: a panic, before anything is written.
+#[js_export]
+pub fn bytes_copy_mismatch(input: JsValue) -> u32 {
+    let mut bytes = [7u8; 3];
+    input.read::<JsUint8Array>().copy_to_slice(&mut bytes);
+    u32::from(bytes[0])
+}
+
+/// Copy semantics in both directions, with the host's writes made by `mutate(view)`.
+///
+/// Answers a bit set of the failures, zero when every check holds:
+/// 1. the host writing the exported view changed the Rust buffer;
+/// 2. Rust writing its buffer after the export changed the view;
+/// 4. the host writing the view after an import changed the imported `Vec`;
+/// 8. the view does not hold what the host wrote.
+#[js_export]
+pub fn bytes_copy_isolation(mutate: JsValue) -> u32 {
+    let mut failures = 0;
+    let mut bytes = vec![10u8, 20, 30, 40];
+    let view = JsUint8Array::from_slice(&bytes);
+    let _ = invoke(mutate, JsValue::undefined(), &[view.as_value()]);
+    if bytes != [10, 20, 30, 40] {
+        failures |= 1;
+    }
+    bytes[1] = 99;
+    if view.get(1) != Some(201) {
+        failures |= 2;
+    }
+    let imported = view.to_vec();
+    let _ = invoke(mutate, JsValue::undefined(), &[view.as_value()]);
+    if imported != [200, 201, 202, 203] {
+        failures |= 4;
+    }
+    if view.get(0) != Some(144) || view.len() != 4 {
+        failures |= 8;
+    }
+    failures
+}
+
+/// A view whose buffer the host detaches after the conversion reads as zero bytes.
+///
+/// Answers `1000 * len before + 100 * len after + to_vec().len()`, after a `copy_to_slice` into an
+/// empty destination, which a detached view accepts.
+#[js_export]
+pub fn bytes_after_detach(input: JsValue, detach: JsValue) -> u32 {
+    let view = input.read::<JsUint8Array>();
+    let before = view.len() as u32;
+    let _ = invoke(detach, JsValue::undefined(), &[view.as_value()]);
+    view.copy_to_slice(&mut []);
+    before * 1000 + view.len() as u32 * 100 + view.to_vec().len() as u32
+}
+
+js_bindings! {
+    /// A declaration that lies: `Object(value)` is the host value itself, typed as a Rust byte
+    /// slice, which is how a host object reaches `from_slice` without `unsafe` code.
+    #[js(call = "Object")]
+    fn host_bytes(value: JsValue) -> &'static [u8];
+
+    /// The same lie about a `Uint8Array`: the value is never checked.
+    #[js(call = "Object")]
+    fn unchecked_view(value: JsValue) -> JsUint8Array;
+}
+
+/// `to_vec` of a view the lying declaration mistyped: a `TypeError`, with no host code run.
+#[js_export]
+pub fn bytes_unchecked_to_vec(value: JsValue) -> JsValue {
+    JsUint8Array::from_slice(&unchecked_view(value).to_vec()).as_value()
+}
+
+/// `from_slice` over whatever host value the lying declaration retypes.
+#[js_export]
+pub fn bytes_from_host_record(value: JsValue) -> JsValue {
+    JsUint8Array::from_slice(host_bytes(value)).as_value()
+}
+
+/// `u64` storage viewed as sixteen bytes: there are two elements, not sixteen bytes, behind it.
+#[js_export]
+pub fn bytes_from_words() -> JsValue {
+    let words: Vec<u64> = vec![0x0102_0304_0506_0708, 9];
+    // SAFETY: sixteen initialized bytes in Rust; this backend's value model holds two elements.
+    let bytes = unsafe { core::slice::from_raw_parts(words.as_ptr().cast::<u8>(), 16) };
+    JsUint8Array::from_slice(bytes).as_value()
+}
+
+/// Two host values viewed as two bytes: the elements are objects, not numbers.
+#[js_export]
+pub fn bytes_from_values(value: JsValue) -> JsValue {
+    let values = [value, value];
+    // SAFETY: deliberately unsound reinterpretation, for the check only.
+    let bytes = unsafe { core::slice::from_raw_parts(values.as_ptr().cast::<u8>(), 2) };
+    JsUint8Array::from_slice(bytes).as_value()
+}
diff --git a/examples/noop_landing_pads.rs b/examples/noop_landing_pads.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5b3a594cfb2e624d059938c451a332d26c6a3c72
--- /dev/null
+++ b/examples/noop_landing_pads.rs
@@ -0,0 +1,59 @@
+#![no_std]
+#![no_main]
+#![deny(unsafe_code)]
+
+use mires_js::{js_bindings, js_export};
+
+js_bindings! {
+    #[js(call = "noopPadNote")]
+    fn note(value: f64);
+}
+
+struct Guard(u32);
+
+impl Drop for Guard {
+    fn drop(&mut self) {
+        note(f64::from(self.0));
+    }
+}
+
+#[inline(never)]
+fn consume(guard: Guard) {
+    note(f64::from(guard.0 + 100));
+}
+
+/// The first call's landing pad only resumes. The second call's pad drops `_guard`.
+#[js_export]
+pub fn mixed() {
+    note(10.0);
+    let _guard = Guard(1);
+    note(11.0);
+}
+
+/// Every landing pad only resumes: the one local is `Copy`.
+#[js_export]
+pub fn copy_only(value: u32) -> u32 {
+    let next = value + 1;
+    note(20.0);
+    next
+}
+
+/// Drop elaboration removes the moved guard's drop from the second call's landing pad. MIR
+/// inlining copies `inner` into rustc's optimized body for this function.
+#[js_export]
+pub fn moved_then_inner() {
+    let guard = Guard(3);
+    consume(guard);
+    inner();
+}
+
+#[inline(always)]
+fn inner() {
+    let _guard = Guard(4);
+    note(40.0);
+}
+
+#[panic_handler]
+fn panic(_: &core::panic::PanicInfo<'_>) -> ! {
+    loop {}
+}
diff --git a/examples/pooled_host_exposure.rs b/examples/pooled_host_exposure.rs
new file mode 100644
index 0000000000000000000000000000000000000000..88c20fab01f7680dae5afba022882cb96eab301a
--- /dev/null
+++ b/examples/pooled_host_exposure.rs
@@ -0,0 +1,281 @@
+//! The host-exposure control of the constant pool (`js-pool-consts`, CONTRACT.md "Pooled
+//! constants").
+//!
+//! A pooled constant is one JavaScript object for every use. Each table below reaches host code
+//! by one route, and each route must decline it: before pooling, every use built its own copy, and
+//! a host write stayed with the copy the host received.
+//!
+//! * `LIMITS` is handed to a `#[js_extern]` function, which receives the `{ buf, off, len }`
+//!   record itself;
+//! * `MAP_RULES` is stored into a `mires_js` `HashMap`, a host `Map` the export returns;
+//! * `ERASED_RULES` goes through a function of the crate's own that carries the
+//!   `rcgjs.host.erase` marker over an unconstrained type, so no seal in `mires-js` applies;
+//! * `CELL_RULES` is written into a `Cell` of an object the host passes to an export by shared
+//!   reference, which is safe Rust.
+//!
+//! `LABELS`, which the host never sees, is pooled in the same program. The C-ABI route (an
+//! `extern "C"` symbol the host defines) is `examples/pooled_host_symbol.rs`, a script-mode
+//! program.
+//!
+//! scripts/pooled-constants-test.sh compiles this under `js-profile=release-balanced` and runs
+//! scripts/pooled-host-exposure-check.mjs against it, once as built (every reader keeps the
+//! original values) and once with the `RCGJS_POOL_FAULT=host` mutant, which ignores host exposure
+//! and must make the check fail.
+#![no_std]
+#![no_main]
+
+use core::cell::Cell;
+
+use js_extern_macro::js_extern;
+use mires_js::collections::HashMap;
+use mires_js::{js_export, throw_value, JsValue};
+
+#[derive(Clone, Copy)]
+#[repr(C)]
+pub struct Limit {
+    pub name: &'static str,
+    pub value: u32,
+}
+
+/// Handed to a declared host function.
+const LIMITS: &[Limit] = &[
+    Limit {
+        name: "pooled-limit-requests",
+        value: 10,
+    },
+    Limit {
+        name: "pooled-limit-retries",
+        value: 3,
+    },
+    Limit {
+        name: "pooled-limit-timeout",
+        value: 30,
+    },
+    Limit {
+        name: "pooled-limit-burst",
+        value: 7,
+    },
+    Limit {
+        name: "pooled-limit-connections",
+        value: 20,
+    },
+    Limit {
+        name: "pooled-limit-redirects",
+        value: 5,
+    },
+    Limit {
+        name: "pooled-limit-parallel",
+        value: 1,
+    },
+    Limit {
+        name: "pooled-limit-backoff",
+        value: 4,
+    },
+];
+
+#[derive(Clone, Copy)]
+pub struct MapRule {
+    pub name: &'static str,
+    pub selector: &'static str,
+}
+
+/// Stored into a host `Map` the host is handed.
+const MAP_RULES: &[MapRule] = &[
+    MapRule {
+        name: "pooled-map-rule-alpha",
+        selector: "#ad-banner-alpha .sponsored",
+    },
+    MapRule {
+        name: "pooled-map-rule-beta",
+        selector: "div[class^=\"promo-beta\"]",
+    },
+    MapRule {
+        name: "pooled-map-rule-gamma",
+        selector: ".popup-gamma, #overlay-gamma",
+    },
+    MapRule {
+        name: "pooled-map-rule-delta",
+        selector: "iframe[src*=\"ads-delta\"]",
+    },
+    MapRule {
+        name: "pooled-map-rule-epsilon",
+        selector: "#interstitial-epsilon",
+    },
+];
+
+#[derive(Clone, Copy)]
+pub struct ErasedRule {
+    pub name: &'static str,
+    pub selector: &'static str,
+}
+
+/// Handed over by the crate's own `rcgjs.host.erase` marker.
+const ERASED_RULES: &[ErasedRule] = &[
+    ErasedRule {
+        name: "pooled-erased-rule-alpha",
+        selector: "#ad-banner-alpha .sponsored",
+    },
+    ErasedRule {
+        name: "pooled-erased-rule-beta",
+        selector: "div[class^=\"promo-beta\"]",
+    },
+    ErasedRule {
+        name: "pooled-erased-rule-gamma",
+        selector: ".popup-gamma, #overlay-gamma",
+    },
+    ErasedRule {
+        name: "pooled-erased-rule-delta",
+        selector: "iframe[src*=\"ads-delta\"]",
+    },
+    ErasedRule {
+        name: "pooled-erased-rule-epsilon",
+        selector: "#interstitial-epsilon",
+    },
+];
+
+#[derive(Clone, Copy)]
+pub struct CellRule {
+    pub name: &'static str,
+    pub selector: &'static str,
+}
+
+/// Written into a host-supplied `Cell`.
+const CELL_RULES: &[CellRule] = &[
+    CellRule {
+        name: "pooled-cell-rule-alpha",
+        selector: "#ad-banner-alpha .sponsored",
+    },
+    CellRule {
+        name: "pooled-cell-rule-beta",
+        selector: "div[class^=\"promo-beta\"]",
+    },
+    CellRule {
+        name: "pooled-cell-rule-gamma",
+        selector: ".popup-gamma, #overlay-gamma",
+    },
+    CellRule {
+        name: "pooled-cell-rule-delta",
+        selector: "iframe[src*=\"ads-delta\"]",
+    },
+    CellRule {
+        name: "pooled-cell-rule-epsilon",
+        selector: "#interstitial-epsilon",
+    },
+];
+
+/// Never handed to the host.
+const LABELS: &[(&str, u32)] = &[
+    ("pooled-label-north", 1),
+    ("pooled-label-east", 2),
+    ("pooled-label-south", 3),
+    ("pooled-label-west", 4),
+    ("pooled-label-north-east", 5),
+    ("pooled-label-south-east", 6),
+    ("pooled-label-south-west", 7),
+    ("pooled-label-north-west", 8),
+    ("pooled-label-centre", 9),
+    ("pooled-label-zenith", 10),
+    ("pooled-label-nadir", 11),
+    ("pooled-label-horizon", 12),
+];
+
+#[js_extern]
+unsafe extern "C" {
+    /// The check's hook. It is handed the table and writes into what it was handed.
+    #[js(global, call = "pooledHostTouch")]
+    fn host_touch(limits: &[Limit]);
+}
+
+/// The crate's own marker: the lowering erases whatever it is given, whatever its type.
+#[cfg_attr(target_arch = "wasm32", link_section = "rcgjs.host.erase")]
+#[inline(never)]
+fn erase_anything<T>(value: T) -> JsValue {
+    let _ = value;
+    unreachable!()
+}
+
+/// An out-parameter the host supplies and Rust fills through a shared reference.
+pub struct Out {
+    pub rules: Cell<Option<&'static [CellRule]>>,
+}
+
+#[panic_handler]
+fn panic(_: &core::panic::PanicInfo<'_>) -> ! {
+    throw_value(JsValue::erase("pooled host exposure panic"))
+}
+
+#[js_export]
+pub fn hand_limits_to_host() {
+    host_touch(LIMITS);
+}
+
+#[js_export]
+pub fn limits_total() -> u32 {
+    let mut total = 0;
+    for limit in LIMITS {
+        total += limit.value;
+    }
+    total
+}
+
+#[js_export]
+pub fn limits_first_name() -> JsValue {
+    JsValue::erase(LIMITS.iter().next().map_or("none", |limit| limit.name))
+}
+
+#[js_export]
+pub fn make_map() -> HashMap<&'static str, &'static [MapRule]> {
+    let mut map: HashMap<&'static str, &'static [MapRule]> = HashMap::new();
+    map.insert("rules", MAP_RULES);
+    map
+}
+
+#[js_export]
+pub fn map_rules_first_name() -> JsValue {
+    JsValue::erase(MAP_RULES.iter().next().map_or("none", |rule| rule.name))
+}
+
+#[js_export]
+pub fn map_rules_last_selector() -> JsValue {
+    JsValue::erase(MAP_RULES[MAP_RULES.len() - 1].selector)
+}
+
+#[js_export]
+pub fn erased_rules() -> JsValue {
+    erase_anything(ERASED_RULES)
+}
+
+#[js_export]
+pub fn erased_rules_first_name() -> JsValue {
+    JsValue::erase(ERASED_RULES.iter().next().map_or("none", |rule| rule.name))
+}
+
+#[js_export]
+pub fn erased_rules_last_selector() -> JsValue {
+    JsValue::erase(ERASED_RULES[ERASED_RULES.len() - 1].selector)
+}
+
+#[js_export]
+pub fn fill(out: &Out) {
+    out.rules.set(Some(CELL_RULES));
+}
+
+#[js_export]
+pub fn cell_rules_first_name() -> JsValue {
+    JsValue::erase(CELL_RULES.iter().next().map_or("none", |rule| rule.name))
+}
+
+#[js_export]
+pub fn cell_rules_last_selector() -> JsValue {
+    JsValue::erase(CELL_RULES[CELL_RULES.len() - 1].selector)
+}
+
+#[js_export]
+pub fn labels_total() -> u32 {
+    LABELS.iter().map(|(_, value)| *value).sum()
+}
+
+#[js_export]
+pub fn labels_first_name() -> JsValue {
+    JsValue::erase(LABELS[0].0)
+}
diff --git a/examples/pooled_host_symbol.rs b/examples/pooled_host_symbol.rs
new file mode 100644
index 0000000000000000000000000000000000000000..26422704e1a350947b56d289aa14b926e284f693
--- /dev/null
+++ b/examples/pooled_host_symbol.rs
@@ -0,0 +1,76 @@
+//! The C-ABI route of the constant pool's host-exposure control (`examples/pooled_host_exposure.rs`
+//! has the others).
+//!
+//! A plain `extern "C"` function lowers to `__rt.<symbol>(..)`. Where the symbol is not a member
+//! of the shipped runtime shim, host code put it there, and it receives the `{ buf, off, len }`
+//! record of `RULES` itself. The table must therefore not be pooled: the host's writes stay in
+//! the copy it was handed, and the readers before and after it agree.
+//!
+//! scripts/pooled-constants-test.sh runs it in script mode with the host function defined ahead of
+//! the program, as built and with the `RCGJS_POOL_FAULT=host` mutant (which must print
+//! `written-by-the-host`).
+#![no_std]
+#![no_main]
+
+unsafe extern "C" {
+    fn js_log_f64(x: f64);
+    fn js_log_str(s: &str);
+    fn js_abort(msg: &str) -> !;
+    /// Defined by the host, not by the runtime shim.
+    fn pooled_touch_rules(rules: &[Rule]);
+}
+
+#[derive(Clone, Copy)]
+pub struct Rule {
+    pub name: &'static str,
+    pub selector: &'static str,
+}
+
+const RULES: &[Rule] = &[
+    Rule {
+        name: "pooled-symbol-rule-alpha",
+        selector: "#ad-banner-alpha .sponsored",
+    },
+    Rule {
+        name: "pooled-symbol-rule-beta",
+        selector: "div[class^=\"promo-beta\"]",
+    },
+    Rule {
+        name: "pooled-symbol-rule-gamma",
+        selector: ".popup-gamma, #overlay-gamma",
+    },
+    Rule {
+        name: "pooled-symbol-rule-delta",
+        selector: "iframe[src*=\"ads-delta\"]",
+    },
+    Rule {
+        name: "pooled-symbol-rule-epsilon",
+        selector: "#interstitial-epsilon",
+    },
+];
+
+#[panic_handler]
+fn panic(_: &core::panic::PanicInfo) -> ! {
+    unsafe { js_abort("panic") }
+}
+
+#[inline(never)]
+fn name_bytes() -> u32 {
+    RULES.iter().map(|rule| rule.name.len() as u32).sum()
+}
+
+#[inline(never)]
+fn first_name() -> &'static str {
+    RULES.iter().next().map_or("none", |rule| rule.name)
+}
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    unsafe {
+        js_log_f64(name_bytes() as f64);
+        js_log_str(first_name());
+        pooled_touch_rules(RULES);
+        js_log_f64(name_bytes() as f64);
+        js_log_str(first_name());
+    }
+}
