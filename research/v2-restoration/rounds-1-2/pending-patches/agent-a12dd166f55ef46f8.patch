+#[derive(Clone, Copy, Debug, Default)]
+pub struct ThrowFacts<'a> {
+    /// Each body's baseline references (`ItemSummary::deps`): where a failed `Assert`'s panic
+    /// lang function is found, exactly as `lower/js/emit.rs::assert_failure` finds it.
+    pub deps: Option<&'a BTreeMap<JsName, &'a [String]>>,
+    /// `js-cleanup-trust-host-contract=on`: a `#[js_extern]` declared non-fallible with no
+    /// `throws` slot is taken at its word.
+    pub trust_host_contract: bool,
