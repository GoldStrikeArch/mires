+/// The footprint the host side computes for values it is handed and values it supplies.
+fn host(interns: &Interns, handed: &[TypeId], received: &[TypeId]) -> Exposure {
+    let mut walk = Walk::new(&interns.types, interns, true);
+    for ty in handed {
+        walk.handed(*ty);
+    }
+    for ty in received {
+        walk.received(*ty);
+    }
+    match walk.unbounded {
+        Some(reason) => Exposure::unbounded(reason),
+        None => Exposure {
+            footprint: walk.footprint,
+            unbounded: None,
+        },
+    }
+}
