+/// Resolves a failed `Assert`'s panic function among `deps`, as `emit.rs::assert_failure` does:
+/// the one reference named `<lang_fn>$h<16 hex>` or `...$<lang_fn>$h<16 hex>`.
+pub fn panic_path(msg: &RAssertMessage, deps: Option<&[String]>) -> PanicPath {
+    let Some(lang_fn) = panic_lang_fn(msg) else {
+        return PanicPath::Silent;
+    };
+    let names = |dep: &&String| {
+        dep.rsplit_once("$h").is_some_and(|(stem, hash)| {
+            hash.len() == 16
+                && hash.bytes().all(|b| b.is_ascii_hexdigit())
+                && (stem == lang_fn
+                    || stem
+                        .strip_suffix(lang_fn)
+                        .is_some_and(|prefix| prefix.ends_with('$')))
+        })
+    };
+    let mut candidates = deps.into_iter().flatten().filter(names);
+    match (candidates.next(), candidates.next()) {
+        (Some(name), None) => PanicPath::Function(JsName::new(name.clone())),
+        _ => PanicPath::Unknown,
+    }
+}
