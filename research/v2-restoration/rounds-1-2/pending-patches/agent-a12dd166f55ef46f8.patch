+    /// (only the outermost eligible node of a tree is pooled).
+    Inline,
+    /// Spell a node the selection names as its binding, everything else as before.
+    Emit(&'p PoolSelection),
+    /// The link step's scan: record every outermost eligible node, spell everything inline.
+    Collect(&'p RefCell<Vec<PoolCandidate>>),
+}
