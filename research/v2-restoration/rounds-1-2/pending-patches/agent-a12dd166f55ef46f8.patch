+#[test]
+fn a_loop_in_the_chain_is_unbounded_and_an_exit_is_observable() {
+    let mut interns = world();
+    let func = goto_chain(&mut interns);
+    let mut looping = func.clone();
+    // c: goto c.
+    looping.blocks[2].term = RTerm::Goto(RBlockId(2), vec![]);
+    assert_eq!(
+        empty_chain(&looping, &looping.blocks[0]),
+        Err(ChainBlocked::Unbounded)
+    );
+    let mut returning = func.clone();
+    returning.blocks[3].term = RTerm::Return(Some(returning.params[0]));
+    assert_eq!(
+        empty_chain(&returning, &returning.blocks[0]),
+        Err(ChainBlocked::Observable("Return"))
+    );
+    let mut dividing = func;
+    if let OpKind::Binary { op, .. } = &mut dividing.blocks[2].ops[1].kind {
+        *op = BinaryOp::Div;
+    }
+    assert_eq!(
+        empty_chain(&dividing, &dividing.blocks[0]),
+        Err(ChainBlocked::Observable("Binary"))
+    );
+}
