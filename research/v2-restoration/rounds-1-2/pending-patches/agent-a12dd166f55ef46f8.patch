+    let blocker = Footprint::of_value(&interns.types, &interns, SLICE_ENTRY);
+    // `fn run(hooks: &Hooks) { (hooks.call)(TABLE) }`: the host's function receives the table.
+    assert!(host(&interns, &[], &[REF_HOOKS]).reaches(&blocker));
