+    let uses = [
+        candidate("pool$ha", SLICE_ENTRY, &long),
+        candidate("pool$ha", SLICE_ENTRY, &long),
+        candidate("pool$hb", SLICE_U32, &long),
+        candidate("pool$hb", SLICE_U32, &long),
+    ];
+    let mut plan = PoolPlan {
+        enabled: true,
+        exposure: host(&interns, &[REF_SLICE_STR], &[]),
+        ..PoolPlan::default()
