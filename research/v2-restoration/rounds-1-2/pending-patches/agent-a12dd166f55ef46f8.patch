+//! Pooled constants (P13): immutable constant data that only shared references reach, emitted
+//! once as a module level `const` and named at every use.
+//!
+//! # Why one table was printed four times
+//!
+//! `pub const T: &[(&str, &[&str])] = &[..]` is a constant of *reference* type: every use is a MIR
+//! constant operand whose value points into one promoted, immutable allocation, and
+//! `FOO.iter()` on a by-value `const FOO: [_; N]` borrows a promoted `&FOO` the same way. The JIR
+//! encoder decodes the allocation behind each such operand into a [`ConstTree`], and the lowering
+//! used to spell the decoded tree as a fresh literal wherever the operand appeared, so a table read
+//! by four functions was four literals of the same 7 KB of data.
+//!
+//! # The rule
+//!
+//! A node is pooled when all of the following hold. The first three are structural and live
+//! beside the lowering (`lower/js/constant.rs::poolable`); the rest are this module's.
+//!
+//! 1. **Immutable memory.** It is a [`ConstTree::Reference`] or [`ConstTree::Slice`] node, which
+//!    the producer only emits for memory rustc interned immutable
+//!    (`backend/src/jir/encode.rs::check_const_memory`, which declines `static mut` memory and
+//!    interior-mutable allocations, nested ones included). Under Rust's rules nothing may write
+//!    it; a write through a pointer derived from it is undefined behaviour in the native program
+//!    as well.
+//! 2. **Shared-reference use.** The node sits at a `&T` position. A `&mut T` (only ever an empty
+//!    array) and a raw pointer, which may be cast to a writable one, are never pooled. A by-value
+//!    constant — a `const` copied into a local — is a fresh value per use by Rust's rules and is
+//!    never pooled either; only the shared data it points at can be.
+//! 3. **No initialization order, no drop.** The node names no `static` (a `let` with an order of
+//!    its own), so the binding reads only literals and hoisted function declarations. Data behind a
+//!    shared reference is never dropped.
+//! 4. **Not reachable by host code, by any route.** A pooled object is one object for every use,
+//!    so host code that could reach one could mutate what every other use reads, where it used to
+//!    mutate a copy of its own. [`Exposure`] is the footprint of what host code can reach: every
+//!    argument and result of every intercepted call (all [`HostPayload`] kinds, `rcgjs.map.*`
+//!    collections included, since they store into a host `Map`), of every C-ABI foreign call whose
+//!    symbol the runtime shim does not define, and of every marker that arrived without a payload,
+//!    with the exceptions [`classify`] documents from what the lowering emits; an export's or a
+//!    root's result and the arguments its body reads, as host-supplied data Rust may write into
+//!    (through ownership, `&mut`, a raw pointer, or a shared reference to a type that is not
+//!    `Freeze`) or call through. A candidate whose own footprint it meets is declined, and a
+//!    footprint the walk cannot bound (a `dyn`, an opaque type, a raw pointer to an erased pointee
+//!    handed over, a body the program lacks) declines every candidate in the program. No marker's Rust
+//!    signature is trusted: a function of the program's own may carry any marker's section.
+//! 5. **Economics.** The definition is at least [`POOL_MIN_BYTES`] printed compact, and the scan
+//!    finds at least two uses. A single use would only add a declaration.
+//!
+//! Pointer identity is not a constraint: Rust guarantees neither distinct addresses for two
+//! promoted constants nor equal addresses for two uses of one `const`, so one object for every use
+//! is a legal answer, and identical data of the *same type* may share it. Data of two different
+//! types never shares a binding even when it prints alike, because the binding's name hashes the
+//! type with the text ([`crate::lower::js::constant::pool_name`]).
+//!
+//! # How it is wired
+//!
+//! [`PoolPlan::of`] scans the functions phase C is about to print (and the static initializers),
+//! prices every candidate and selects. The lane driver installs [`PoolPlan::scope`] around that
+//! pass only, so the cost trials and representation probes before it print every constant inline
+//! exactly as before. After the pass, [`PoolPlan::items`] turns every selected binding some
+//! printed item names into an [`ItemKind::Const`] item: a module level binding, ordered before the
+//! bindings that read it by `link::order`, kept alive by the `refs` of its users, owned by one
+//! chunk or the shared one like any other item, renamed short by the item minifier, and carrying
+//! the function references of its data in its own `refs` so the reachability walk still sees them.
+//! The JIR analyses ran on the constant trees before any of this, so call graphs and escape facts
+//! are unchanged.
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::fmt::Write as _;
+use std::rc::Rc;
+
+use crate::item::{ItemKind, ItemMap, JsName, LinkItem, Linkage};
+use crate::jir::decline::Decline;
+use crate::jir::interns::StrId;
+use crate::jir::repr::{Func, OpKind};
+use crate::jir::semantic::{
+    Body, BodyKind, Call, CallSemantic, Callee, DirectItemRef, HostPayload, ItemId, Terminator,
+};
+use crate::jir::types::{NominalForm, TypeId, TypeKind, TypeTable};
+use crate::jir::Interns;
+use crate::jsast;
+use crate::lower::js::constant::{PoolCandidate, PoolScope, PoolSelection};
+use crate::opts::Opts;
+
+/// The smallest definition, in compact printed bytes, that is worth a binding.
+///
+/// DEFLATE's longest match is 258 bytes: a repeat no longer than that, within the 32 KB window,
+/// costs gzip one back-reference, and Brotli less, which a declaration plus a name at every use
+/// does not beat. Measured on the compact FingerprintJS package (CONTRACT.md "Pooled
+/// constants"): pooling its 218-byte font table as well saved 210 bytes minified but cost 11 bytes
+/// gzipped and 73 bytes Brotli; at 64 and at 256 bytes the browser-workload corpus came out
+/// byte-identical.
+pub(crate) const POOL_MIN_BYTES: usize = 256;
+
+/// The fewest scanned uses that are worth a binding. Pooling single uses as well cost the compact
+/// package 194 bytes gzipped and 59 Brotli for 12 bytes minified.
+const POOL_MIN_USES: u32 = 2;
+
+/// What became of one candidate.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum Decision {
+    Pooled,
+    /// Two different values hash to one binding name; neither is pooled.
+    Collision,
+    /// The host may reach an object of the candidate's footprint (rule 4).
+    HostExposed,
+    /// Shorter than [`POOL_MIN_BYTES`].
+    Small,
+    /// Fewer than [`POOL_MIN_USES`] uses.
+    SingleUse,
+}
+
+/// One distinct candidate value, by binding name.
+#[derive(Clone, Debug)]
+struct Entry {
+    ty: TypeId,
+    type_name: String,
+    text: String,
+    value: jsast::Expr,
+    /// How many constant operands the scan found it in.
+    uses: u32,
+    /// The objects and places the value consists of, for rule 4.
+    footprint: Footprint,
+    /// Another value hashed to the same name.
+    collision: bool,
+    decision: Decision,
+}
+
+/// By-value aggregate constants (case b), which are never pooled: what sharing them would save.
+#[derive(Clone, Debug, Default)]
+struct ByValue {
+    /// Distinct `(type, text)` values of at least [`POOL_MIN_BYTES`].
+    groups: BTreeMap<(TypeId, String), u32>,
+}
+
+/// The program's pooling decision for one phase-C pass.
+#[derive(Debug, Default)]
+pub(crate) struct PoolPlan {
+    enabled: bool,
+    exposure: Exposure,
+    entries: BTreeMap<String, Entry>,
+    selection: Rc<PoolSelection>,
+    by_value: ByValue,
+    /// The emitted uses of every binding the program ended up printing, filled by [`Self::items`].
+    emitted: BTreeMap<String, usize>,
+}
+
+impl PoolPlan {
+    /// Scans `names` (the items phase C lowers, `funcs` their JIR-R) and selects.
+    ///
+    /// `live` is every item the program prints, the host scan's domain: an item the lane does not
+    /// lower can still hand the host an object a lowered one returned to it.
+    pub(crate) fn of(
+        table: &BTreeMap<JsName, LinkItem>,
+        live: &BTreeSet<JsName>,
+        names: &[JsName],
+        funcs: &BTreeMap<JsName, Result<Func, Decline>>,
+        opts: &Opts,
+    ) -> PoolPlan {
+        // A rewrite of what is printed, so it takes effect under `js-opt=on` only: `off` keeps the
+        // lowering as it was and `report` prints what `off` prints.
+        if !opts.pool_consts || opts.optimizer != crate::opts::OptimizerMode::On {
+            return PoolPlan::default();
+        }
+        let mut plan = PoolPlan {
+            enabled: true,
+            exposure: Exposure::of(table, live, funcs),
+            ..PoolPlan::default()
+        };
+        let lowering = crate::lower::plan::Plan::default();
+        for name in names {
+            let Some(item) = table.get(name) else {
+                continue;
+            };
+            let (Some(summary), Some(interns), Some(body)) = (
+                item.jir.summary.as_ref(),
+                item.jir.interns(),
+                item.jir.body.as_ref(),
+            ) else {
+                continue;
+            };
+            let types = &interns.types;
+            let origins = item.jir.origins.as_ref();
+            match funcs.get(name) {
+                Some(Ok(func)) => {
+                    let cx = crate::lower::js::JsCx::new(
+                        func, &lowering, types, interns, opts, summary, origins,
+                    );
+                    for op in func.blocks.iter().flat_map(|block| &block.ops) {
+                        let (OpKind::Const(tree), Some(result)) = (&op.kind, op.result) else {
+                            continue;
+                        };
+                        let Some(ty) = func.values.get(result.0 as usize).map(|value| value.ty)
+                        else {
+                            continue;
+                        };
+                        // `emit.rs::op_expr` prints every zero-sized value as `undefined`.
+                        if types.is_zst(ty) {
+                            continue;
+                        }
+                        if let Ok((value, found)) = cx.pool_scan(tree, ty) {
+                            plan.record(found, types, interns);
+                            plan.record_by_value(types, ty, &value, opts);
+                        }
+                    }
+                }
+                // A declined function prints its baseline text, which pools nothing.
+                Some(Err(_)) => {}
+                None => {
+                    if let BodyKind::Static { init, .. } = &body.kind {
+                        let func = Func {
+                            item: body.item,
+                            sig: body.signature.clone(),
+                            params: Vec::new(),
+                            values: Vec::new(),
+                            cells: Vec::new(),
+                            blocks: Vec::new(),
+                        };
+                        let cx = crate::lower::js::JsCx::new(
+                            &func, &lowering, types, interns, opts, summary, origins,
+                        );
+                        if let Ok((_, found)) = cx.pool_scan(init, body.signature.result) {
+                            plan.record(found, types, interns);
+                        }
+                    }
+                }
+            }
+        }
+        plan.decide();
+        plan
+    }
+
+    fn record(&mut self, found: Vec<PoolCandidate>, types: &TypeTable, interns: &Interns) {
+        for candidate in found {
+            match self.entries.get_mut(&candidate.name) {
+                Some(entry) => {
+                    if entry.ty == candidate.ty && entry.text == candidate.text {
+                        entry.uses += 1;
+                    } else {
+                        entry.collision = true;
+                    }
+                }
+                None => {
+                    let footprint = Footprint::of_value(types, interns, candidate.ty);
+                    // The producer records a type's printed path only where `type_name` needs
+                    // it; the stable id names every other type.
+                    let type_name = types
+                        .get(candidate.ty)
+                        .and_then(|descriptor| descriptor.name)
+                        .and_then(|name| interns.str(name))
+                        .map_or_else(|| format!("{:032x}", candidate.ty.0), str::to_owned);
+                    self.entries.insert(
+                        candidate.name,
+                        Entry {
+                            ty: candidate.ty,
+                            type_name,
+                            text: candidate.text,
+                            value: candidate.value,
+                            uses: 1,
+                            footprint,
+                            collision: false,
+                            decision: Decision::Pooled,
+                        },
+                    );
+                }
+            }
+        }
+    }
+
+    /// Counts a by-value aggregate constant, for the report's measure of case b.
+    fn record_by_value(&mut self, types: &TypeTable, ty: TypeId, value: &jsast::Expr, opts: &Opts) {
+        if !types.needs_clone(ty) {
+            return;
+        }
+        let text =
+            jsast::expr_to_string_styled_for_target(value, jsast::Style::Compact, opts.ecma_target);
+        if text.len() >= POOL_MIN_BYTES {
+            *self.by_value.groups.entry((ty, text)).or_default() += 1;
+        }
+    }
+
+    fn decide(&mut self) {
+        // The `host` mutant (`constant::pool_fault`): pool whatever the host can reach.
+        let host_blind = crate::lower::js::constant::pool_fault() == Some("host");
+        let mut selected = BTreeSet::new();
+        for (name, entry) in &mut self.entries {
+            entry.decision = if entry.collision {
+                Decision::Collision
+            } else if !host_blind && self.exposure.reaches(&entry.footprint) {
+                Decision::HostExposed
+            } else if entry.text.len() < POOL_MIN_BYTES {
+                Decision::Small
+            } else if entry.uses < POOL_MIN_USES {
+                Decision::SingleUse
+            } else {
+                Decision::Pooled
+            };
+            if entry.decision == Decision::Pooled {
+                selected.insert(name.clone());
+            }
+        }
+        self.selection = Rc::new(PoolSelection { names: selected });
+    }
+
+    /// The bindings the lowering may name, which the lane driver adds to what it has prepared.
+    pub(crate) fn selected(&self) -> impl Iterator<Item = JsName> + '_ {
+        self.selection
+            .names
+            .iter()
+            .map(|name| JsName::new(name.clone()))
+    }
+
+    /// Pools the selection in every lowering while the returned scope is alive; `None` when
+    /// pooling is off, so the lowering does not even look for candidates.
+    pub(crate) fn scope(&self) -> Option<PoolScope> {
+        self.enabled
+            .then(|| PoolScope::install(Rc::clone(&self.selection)))
+    }
+
+    /// The `const` item of every selected binding some item in `table` prints, counting the uses.
+    ///
+    /// A binding nothing names is not an item: a lowering the driver refused, or a use the
+    /// per-item passes deleted, leaves it out of the program rather than dead in it.
+    pub(crate) fn items(&mut self, table: &BTreeMap<JsName, LinkItem>) -> Vec<LinkItem> {
+        let mut emitted: BTreeMap<String, usize> = BTreeMap::new();
+        for item in table.values() {
+            if !item
+                .refs
+                .iter()
+                .any(|name| self.selection.names.contains(name.as_str()))
+            {
+                continue;
+            }
+            crate::minify::for_each_ident(&item.js, |_, ident| {
+                if self.selection.names.contains(ident) {
+                    *emitted.entry(ident.to_owned()).or_default() += 1;
+                }
+            });
+        }
+        let style = match crate::opts::get().minify {
+            true => jsast::Style::Compact,
+            false => jsast::Style::Readable,
+        };
+        let target = crate::opts::get().ecma_target;
+        let items = emitted
+            .keys()
+            .filter_map(|name| {
+                let entry = self.entries.get(name)?;
+                Some(binding_item(name, entry, style, target))
+            })
+            .collect();
+        self.emitted = emitted;
+        items
+    }
+
+    /// The sidecar's `pool` block, or `None` when pooling is off.
+    pub(crate) fn json(&self) -> Option<String> {
+        if !self.enabled {
+            return None;
+        }
+        let mut out = String::new();
+        let _ = write!(
+            out,
+            "{{\"min_bytes\":{POOL_MIN_BYTES},\"min_uses\":{POOL_MIN_USES},\"host\":"
+        );
+        match &self.exposure.unbounded {
+            Some(reason) => {
+                out.push_str("{\"bounded\":false,\"reason\":");
+                push_json_string(&mut out, reason);
+                out.push('}');
+            }
+            None => {
+                let _ = write!(
+                    out,
+                    "{{\"bounded\":true,\"objects\":{},\"slots\":{}}}",
+                    self.exposure.footprint.objects.len(),
+                    self.exposure.footprint.slots.len()
+                );
+            }
+        }
+        out.push_str(",\"pooled\":[");
+        let mut first = true;
+        for (name, entry) in &self.entries {
+            if entry.decision != Decision::Pooled {
+                continue;
+            }
+            let Some(emitted) = self.emitted.get(name) else {
+                continue;
+            };
+            if !first {
+                out.push(',');
+            }
+            first = false;
+            out.push_str("{\"name\":");
+            push_json_string(&mut out, name);
+            out.push_str(",\"type\":");
+            push_json_string(&mut out, &entry.type_name);
+            let _ = write!(
+                out,
+                ",\"bytes\":{},\"scanned_uses\":{},\"emitted_uses\":{emitted}}}",
+                entry.text.len(),
+                entry.uses
+            );
+        }
+        let count = |decision| {
+            self.entries
+                .values()
+                .filter(|entry| entry.decision == decision)
+                .count()
+        };
+        let (repeated, saved) = self
+            .by_value
+            .groups
+            .iter()
+            .filter(|(_, uses)| **uses >= POOL_MIN_USES)
+            .fold((0usize, 0usize), |(groups, bytes), ((_, text), uses)| {
+                (groups + 1, bytes + text.len() * (*uses as usize - 1))
+            });
+        let _ = write!(
+            out,
+            "],\"declined\":{{\"collision\":{},\"host_exposed\":{},\"small\":{},\
+             \"single_use\":{}}},\"by_value\":{{\"groups\":{},\"repeated\":{repeated},\
+             \"repeated_bytes\":{saved}}}}}",
+            count(Decision::Collision),
+            count(Decision::HostExposed),
+            count(Decision::Small),
+            count(Decision::SingleUse),
+            self.by_value.groups.len(),
+        );
+        Some(out)
+    }
+}
+
+/// `const <name> = <value>;`, a module level binding with no header comment (`JsItem::to_js_mapped`
+/// prints none for a [`ItemKind::Const`]) and no source mapping.
+fn binding_item(
+    name: &str,
+    entry: &Entry,
+    style: jsast::Style,
+    target: crate::opts::EcmaTarget,
+) -> LinkItem {
+    let decl = jsast::const_(name, entry.value.clone());
+    let mut refs = BTreeSet::new();
+    jsast::visit_free_idents(&decl, &mut |ident| {
+        if ident != name {
+            refs.insert(JsName::new(ident.to_owned()));
+        }
+    });
+    LinkItem {
+        name: JsName::new(name.to_owned()),
+        kind: ItemKind::Const,
+        js: jsast::program_to_string_styled_for_target(std::slice::from_ref(&decl), style, target),
+        refs,
+        zombies: Vec::new(),
+        linkage: Linkage::internal(),
+        debug_path: format!("pooled constant of type {}", entry.type_name),
+        crate_name: "generated".to_owned(),
+        order: None,
+        map: ItemMap::default(),
+        dts: None,
+        optimization: Default::default(),
+        late_ir: Default::default(),
+        baseline_shadow: Default::default(),
+        jir: Default::default(),
+    }
+}
+
+fn push_json_string(out: &mut String, text: &str) {
+    out.push('"');
+    for c in text.chars() {
+        match c {
+            '"' => out.push_str("\\\""),
+            '\\' => out.push_str("\\\\"),
+            c if (c as u32) < 0x20 => {
+                let _ = write!(out, "\\u{:04x}", c as u32);
+            }
+            c => out.push(c),
+        }
+    }
+    out.push('"');
+}
+
+// -------------------------------------------------------------------------------------------
+// Rule 4: what the host can reach
+// -------------------------------------------------------------------------------------------
+
+/// The JavaScript objects a value of some type consists of, the places inside them, and the
+/// containers its slot pointers expose.
+///
+/// `objects` are the types of the aggregate JavaScript values reachable from the root by structure
+/// — fields, elements, variant payloads, captures, the pointee of a reference to an aggregate (which
+/// *is* that object), the backing array of a slice. `places` are the types of the fields and
+/// elements of those objects. `slots` are the pointee types of every pointer whose JavaScript form
+/// is a container plus a key: a slot `{ buf, off }` (a pointer to a primitive or any raw pointer)
+/// or a slice's `{ buf, off, len }`. Whoever holds one holds the container behind it, whatever its
+/// type, and the only thing known about that container is that it holds a place of that type.
+#[derive(Clone, Debug, Default, Eq, PartialEq)]
+pub(crate) struct Footprint {
+    pub(crate) objects: BTreeSet<TypeId>,
+    pub(crate) places: BTreeSet<TypeId>,
+    pub(crate) slots: BTreeSet<TypeId>,
+}
+
+impl Footprint {
+    /// The footprint of a pooled value of type `ty`.
+    pub(crate) fn of_value(types: &TypeTable, interns: &Interns, ty: TypeId) -> Footprint {
+        let mut walk = Walk::new(types, interns, false);
+        walk.handed(ty);
+        walk.footprint
+    }
+
+    /// Whether a holder of `self` (the host) can reach part of a value whose footprint is
+    /// `candidate`: one of its objects directly, or the container of one of its places (or the
+    /// value itself) through a slot.
+    pub(crate) fn reaches(&self, candidate: &Footprint) -> bool {
+        !self.objects.is_disjoint(&candidate.objects)
+            || !self.slots.is_disjoint(&candidate.places)
+            || !self.slots.is_disjoint(&candidate.objects)
+    }
+
+    fn extend(&mut self, other: Footprint) {
+        self.objects.extend(other.objects);
+        self.places.extend(other.places);
+        self.slots.extend(other.slots);
+    }
+}
+
+/// The footprint of everything host code can reach: every value the program hands to JavaScript
+/// it did not compile, and everything Rust may write into, or pass back through, a value such
+/// JavaScript handed in.
+#[derive(Clone, Debug, Default)]
+pub(crate) struct Exposure {
+    footprint: Footprint,
+    /// Why the footprint could not be bounded, which declines every candidate.
+    unbounded: Option<String>,
+}
+
+/// What one call hands to host code, by how the lowering spells it (see [`classify`]).
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum HostCall<'a> {
+    /// Not a host boundary: an ordinary Rust call, or a member of the shipped runtime shim.
+    Internal,
+    /// Every argument reaches host code and the result comes from it.
+    Full,
+    /// A closure (or function item) becomes a JavaScript function the host calls. The arrow closes
+    /// over the environment, which is out of reach; what the host gets is the body's result, and
+    /// what it passes in are the body's arguments.
+    Closure,
+    /// A future the runtime drives. The driver keeps the future in its own closure state; what the
+    /// host gets is the output the `poll_*` helpers return, which settles its Promise.
+    Future(&'a [(StrId, DirectItemRef)]),
+    /// `__rt.u8array_from_bytes(s)` / `__rt.u8array_into_bytes(src, dst)`: the runtime copies
+    /// numbers between a fresh `Uint8Array` and Rust storage. The argument at the index is never
+    /// seen by host code when it is a slice of byte elements (no element is an object, so no
+    /// coercion hook runs either); any other type there is handed over like a `Full` argument.
+    ByteCopy(usize),
+}
+
+/// Every `rcgjs.host.*` marker whose argument is a closure (`lower/js/host.rs::host_marker`).
+const CLOSURE_MARKERS: [&str; 11] = [
+    "callback0",
+    "callback1",
+    "callback2",
+    "callback3",
+    "callback4",
+    "promise",
+    "localwaker",
+    "microtask",
+    "task",
+    "try",
+    "settled",
+];
+
+impl Exposure {
+    /// Scans every live item: its host calls and, for an export or a root, its signature.
+    ///
+    /// `funcs` are the lane's JIR-R functions, which say which parameters a body reads: one it
+    /// never reads cannot be written through or called through.
+    pub(crate) fn of(
+        table: &BTreeMap<JsName, LinkItem>,
+        live: &BTreeSet<JsName>,
+        funcs: &BTreeMap<JsName, Result<Func, Decline>>,
+    ) -> Exposure {
+        let runtime: BTreeSet<String> = crate::plan::cost::helper_bytes().into_keys().collect();
+        let mut bodies: BTreeMap<ItemId, (&Body, &Interns)> = BTreeMap::new();
+        for name in live {
+            if let Some(item) = table.get(name) {
+                if let (Some(body), Some(interns)) = (item.jir.body.as_ref(), item.jir.interns()) {
+                    bodies.insert(body.item, (body, interns));
+                }
+            }
+        }
+        let mut exposure = Exposure::default();
+        for name in live {
+            let Some(item) = table.get(name) else {
+                continue;
+            };
+            let (Some(body), Some(interns)) = (item.jir.body.as_ref(), item.jir.interns()) else {
+                // Synthesized items carry no body: the allocator shim, imports, spill registers,
+                // hoisted constants. A *function* without one could do anything with a value.
+                if item.kind == ItemKind::Fn {
+                    return Exposure::unbounded(format!(
+                        "`{}` is a function with no JIR body to scan",
+                        name.as_str()
+                    ));
+                }
+                continue;
+            };
+            let context = name.as_str();
+            if item.linkage.exported || item.linkage.root {
+                // The caller is JavaScript: it receives the result, and holds what it passed in,
+                // which the body may write into or call through.
+                let used = used_arguments(funcs.get(name), body);
+                exposure.seed(interns, context, |walk| {
+                    walk.handed(body.signature.result);
+                    match body.kind {
+                        BodyKind::Function => {
+                            for (index, argument) in body.signature.arguments.iter().enumerate() {
+                                if used.as_ref().is_none_or(|used| used.contains(&index)) {
+                                    walk.received(*argument);
+                                }
+                            }
+                        }
+                        // A script can also assign an exported binding.
+                        BodyKind::Static { .. } => walk.received(body.signature.result),
+                        BodyKind::Vtable { .. } => {}
+                    }
+                });
+            }
+            for block in &body.blocks {
+                let Terminator::Call(call) = &block.terminator else {
+                    continue;
+                };
+                match classify(call, interns, &runtime) {
+                    HostCall::Internal => {}
+                    HostCall::Full => exposure.seed(interns, context, |walk| {
+                        for argument in &call.arguments {
+                            walk.handed(argument.ty);
+                        }
+                        walk.received(call.destination.ty);
+                    }),
+                    HostCall::ByteCopy(exempt) => exposure.seed(interns, context, |walk| {
+                        for (index, argument) in call.arguments.iter().enumerate() {
+                            if index != exempt || !byte_slice(&interns.types, argument.ty) {
+                                walk.handed(argument.ty);
+                            }
+                        }
+                        walk.received(call.destination.ty);
+                    }),
+                    HostCall::Closure => {
+                        for argument in &call.arguments {
+                            match closure_body(&interns.types, argument.ty) {
+                                Some((item, environment)) => {
+                                    let Some((callee, callee_interns)) = bodies.get(&item) else {
+                                        return Exposure::unbounded(format!(
+                                            "in `{context}`: a closure handed to the host has no \
+                                             body in this program"
+                                        ));
+                                    };
+                                    exposure.seed(callee_interns, context, |walk| {
+                                        walk.handed(callee.signature.result);
+                                        let skip = usize::from(environment);
+                                        for argument in callee.signature.arguments.iter().skip(skip)
+                                        {
+                                            walk.received(*argument);
+                                        }
+                                    });
+                                }
+                                None => {
+                                    exposure.seed(interns, context, |walk| walk.handed(argument.ty))
+                                }
+                            }
+                        }
+                        exposure.seed(interns, context, |walk| walk.received(call.destination.ty));
+                    }
+                    HostCall::Future(helpers) => {
+                        for (_, helper) in helpers {
+                            let Some((poll, poll_interns)) = bodies.get(&helper.item) else {
+                                return Exposure::unbounded(format!(
+                                    "in `{context}`: a future driver's helper has no body in this \
+                                     program"
+                                ));
+                            };
+                            exposure.seed(poll_interns, context, |walk| {
+                                walk.handed(poll.signature.result)
+                            });
+                        }
+                        exposure.seed(interns, context, |walk| {
+                            for argument in call.arguments.iter().skip(1) {
+                                walk.handed(argument.ty);
+                            }
+                            walk.received(call.destination.ty);
+                        });
+                    }
+                }
+            }
+            if exposure.unbounded.is_some() {
+                return exposure;
+            }
+        }
+        exposure
+    }
+
+    /// Runs one walk over `interns`' type table and folds it in.
+    fn seed(&mut self, interns: &Interns, context: &str, walk: impl FnOnce(&mut Walk<'_>)) {
+        let mut each = Walk::new(&interns.types, interns, true);
+        walk(&mut each);
+        if let Some(reason) = each.unbounded {
+            if self.unbounded.is_none() {
+                self.unbounded = Some(format!("in `{context}`: {reason}"));
+            }
+        }
+        self.footprint.extend(each.footprint);
+    }
+
+    fn unbounded(reason: String) -> Exposure {
+        Exposure {
+            footprint: Footprint::default(),
+            unbounded: Some(reason),
+        }
+    }
+
+    /// Whether the host may reach part of a value whose footprint is `candidate`.
+    pub(crate) fn reaches(&self, candidate: &Footprint) -> bool {
+        self.unbounded.is_some() || self.footprint.reaches(candidate)
+    }
+}
+
+/// How a call reaches host code (see `CONTRACT.md` "Pooled constants" for the audit this encodes).
+///
+/// Every call with a host payload hands its arguments to host code except where the lowering is
+/// known not to: a payload names what is *emitted*, and anything stored into a host-held object
+/// (a `rcgjs.map.*` collection, a `#[js_extern]` argument, a template's row) is reachable from it.
+/// Nothing here trusts a marker's Rust signature: a user function may carry any marker's
+/// `link_section`, so the walk follows the argument types the call actually has.
+fn classify<'a>(call: &'a Call, interns: &Interns, runtime: &BTreeSet<String>) -> HostCall<'a> {
+    let marker = |section: &str| -> HostCall<'a> {
+        let Some(marker) = section.strip_prefix(crate::lower::js::host::HOST_PREFIX) else {
+            return HostCall::Full;
+        };
+        match marker {
+            _ if CLOSURE_MARKERS.contains(&marker) => HostCall::Closure,
+            "u8arrayfrombytes" => HostCall::ByteCopy(0),
+            "u8arrayintobytes" => HostCall::ByteCopy(1),
+            _ => HostCall::Full,
+        }
+    };
+    match &call.host {
+        Some(HostPayload::Marker {
+            section, helpers, ..
+        }) => {
+            let section = interns.str(*section).unwrap_or("");
+            match section.strip_prefix(crate::lower::js::host::HOST_PREFIX) {
+                Some(name) if crate::lower::js::host::is_async_marker(name) => {
+                    HostCall::Future(helpers)
+                }
+                _ => marker(section),
+            }
+        }
+        Some(_) => HostCall::Full,
+        None => match &call.callee {
+            // A C-ABI foreign function is `__rt.<symbol>(..)`: the shipped runtime's own member,
+            // or something host code put there.
+            Callee::Runtime { member } => match interns.str(*member) {
+                Some(member) if runtime.contains(member) => HostCall::Internal,
+                _ => HostCall::Full,
+            },
+            // A marker that reached the encoder without a payload is still intercepted by its
+            // link name (`lower/js/host.rs::family`).
+            Callee::Direct { link_name, .. } => match interns.str(*link_name) {
+                Some(name) if crate::lower::js::host::is_marker_name(name) => {
+                    if crate::lower::js::host::is_async_marker(
+                        name.strip_prefix(crate::lower::js::host::HOST_PREFIX)
+                            .unwrap_or(""),
+                    ) {
+                        // No helpers were recorded, so nothing bounds the output.
+                        HostCall::Full
+                    } else {
+                        marker(name)
+                    }
+                }
+                _ if host_semantic(call.semantic) => HostCall::Full,
+                _ => HostCall::Internal,
+            },
+            _ if host_semantic(call.semantic) => HostCall::Full,
+            _ => HostCall::Internal,
+        },
+    }
+}
+
+fn host_semantic(semantic: CallSemantic) -> bool {
+    matches!(
+        semantic,
+        CallSemantic::Host | CallSemantic::ViewAbi | CallSemantic::RawJavaScript
+    )
+}
+
+/// The body a closure-taking marker turns `ty` into, and whether that body takes the environment
+/// first (`lower/js/host.rs::closure_item`).
+fn closure_body(types: &TypeTable, ty: TypeId) -> Option<(ItemId, bool)> {
+    let peeled = types.peeled(ty);
+    let (definition, environment) = match &types.get(peeled)?.kind {
+        TypeKind::Closure { def, .. } => (*def, true),
+        TypeKind::FnDef { def, .. } => (*def, false),
+        _ => return None,
+    };
+    Some((
+        ItemId {
+            definition,
+            instantiation: peeled.0,
+        },
+        environment,
+    ))
+}
+
+/// The argument positions `body` reads, when the lane's `Func` for it says so.
+fn used_arguments(func: Option<&Result<Func, Decline>>, body: &Body) -> Option<BTreeSet<usize>> {
+    let Some(Ok(func)) = func else {
+        return None;
+    };
+    if func.params.len() != body.signature.arguments.len() {
+        return None;
+    }
+    let uses: BTreeSet<_> = func
+        .blocks
+        .iter()
+        .flat_map(|block| {
+            block
+                .ops
+                .iter()
+                .flat_map(|op| op.kind.uses())
+                .chain(block.term.uses())
+        })
+        .collect();
+    Some(
+        func.params
+            .iter()
+            .enumerate()
+            .filter(|(_, parameter)| uses.contains(parameter))
+            .map(|(index, _)| index)
+            .collect(),
+    )
+}
+
+/// Whether `ty` is a pointer to a slice of byte elements.
+fn byte_slice(types: &TypeTable, ty: TypeId) -> bool {
+    let Some(TypeKind::Reference { pointee, .. } | TypeKind::RawPointer { pointee, .. }) = types
+        .get(types.peeled(ty))
+        .map(|descriptor| &descriptor.kind)
+    else {
+        return false;
+    };
+    match types
+        .get(types.peeled(*pointee))
+        .map(|descriptor| &descriptor.kind)
+    {
+        Some(TypeKind::Slice(element)) => types
+            .get(*element)
+            .is_some_and(|descriptor| descriptor.js.byte_element),
+        _ => false,
+    }
+}
+
+/// One footprint walk over one object's type table.
+struct Walk<'t> {
+    types: &'t TypeTable,
+    interns: &'t Interns,
+    footprint: Footprint,
+    handed_seen: BTreeSet<TypeId>,
+    received_seen: BTreeSet<(TypeId, bool)>,
+    /// Whether this is the host's side, where a walk that cannot be bounded must say so.
+    host: bool,
+    unbounded: Option<String>,
+}
+
+impl<'t> Walk<'t> {
+    fn new(types: &'t TypeTable, interns: &'t Interns, host: bool) -> Walk<'t> {
+        Walk {
+            types,
+            interns,
+            footprint: Footprint::default(),
+            handed_seen: BTreeSet::new(),
+            received_seen: BTreeSet::new(),
+            host,
+            unbounded: None,
+        }
+    }
+
+    fn give_up(&mut self, reason: impl FnOnce() -> String) {
+        if self.host && self.unbounded.is_none() {
+            self.unbounded = Some(reason());
+        }
+    }
+
+    /// A field or element of type `ty`.
+    fn place(&mut self, ty: TypeId) {
+        self.footprint.places.insert(ty);
+    }
+
+    /// A container holding a place of type `ty`, reached through a pointer.
+    fn slot(&mut self, ty: TypeId) {
+        self.footprint.slots.insert(ty);
+    }
+
+    /// A value of type `ty` that JavaScript holds from now on: it can read and write every part of
+    /// it, and call every function in it.
+    fn handed(&mut self, ty: TypeId) {
+        if !self.handed_seen.insert(ty) {
+            return;
+        }
+        let types = self.types;
+        let Some(descriptor) = types.get(ty) else {
+            self.give_up(|| format!("type {:032x} is not described", ty.0));
+            return;
+        };
+        if descriptor.js.transparent.is_some() && descriptor.js.peeled != ty {
+            self.handed(descriptor.js.peeled);
+            return;
+        }
+        if descriptor.layout.zst {
+            return;
+        }
+        match &descriptor.kind {
+            TypeKind::Bool
+            | TypeKind::Char
+            | TypeKind::Integer { .. }
+            | TypeKind::Float { .. }
+            | TypeKind::Str
+            | TypeKind::Never
+            | TypeKind::FnDef { .. } => {}
+            TypeKind::Pattern(base) => self.handed(*base),
+            TypeKind::Tuple(elements) => self.object(ty, elements.clone()),
+            TypeKind::Array { element, .. } | TypeKind::Slice(element) => {
+                self.object(ty, vec![*element])
+            }
+            TypeKind::Adt { form, variants, .. } => match form {
+                NominalForm::Opaque => self.give_up(|| "an opaque nominal type".to_owned()),
+                _ if descriptor.js.is_primitive_enum => {}
+                _ => {
+                    let fields = variants
+                        .iter()
+                        .flat_map(|variant| variant.fields.iter().map(|field| field.ty))
+                        .collect();
+                    self.object(ty, fields);
+                }
+            },
+            TypeKind::Closure { upvars, .. } | TypeKind::CoroutineClosure { upvars, .. } => {
+                self.object(ty, upvars.clone())
+            }
+            TypeKind::Coroutine {
+                upvars,
+                saved_locals,
+                ..
+            } => {
+                let mut fields = upvars.clone();
+                fields.extend(saved_locals.iter().map(|(_, ty)| *ty));
+                self.object(ty, fields);
+            }
+            TypeKind::Reference { pointee, .. } => self.pointer(*pointee, false),
+            TypeKind::RawPointer { pointee, .. } => self.pointer(*pointee, true),
+            // A Rust function the host can call returns its result to the host and receives what
+            // the host passes it.
+            TypeKind::FnPtr { sig } => match self.interns.sig(*sig) {
+                Some(signature) => {
+                    let (inputs, output) = (signature.inputs.clone(), signature.output);
+                    self.handed(output);
+                    for input in inputs {
+                        self.received(input);
+                    }
+                }
+                None => self.give_up(|| "a function pointer with no signature".to_owned()),
+            },
+            TypeKind::Dynamic { .. } => self.give_up(|| "a `dyn` value".to_owned()),
+            TypeKind::Opaque | TypeKind::Foreign(_) => {
+                self.give_up(|| "a type the table does not describe further".to_owned())
+            }
+        }
+    }
+
+    fn object(&mut self, ty: TypeId, fields: Vec<TypeId>) {
+        self.footprint.objects.insert(ty);
+        for field in fields {
+            self.place(field);
+            self.handed(field);
+        }
+    }
+
+    /// A pointer to `pointee`: a string, a fat slice over a backing array, the pointee's own object
+    /// (a reference to an aggregate), or a slot over an unknown container.
+    fn pointer(&mut self, pointee: TypeId, raw: bool) {
+        let types = self.types;
+        let Some(descriptor) = types.get(types.peeled(pointee)) else {
+            self.give_up(|| format!("pointee {:032x} is not described", pointee.0));
+            return;
+        };
+        match &descriptor.kind {
+            TypeKind::Str => {}
+            TypeKind::Slice(element) => {
+                // `{ buf, off, len }`: the buffer may be any container of the element type, an
+                // array inside a bigger object included.
+                self.slot(*element);
+                self.handed(pointee);
+            }
+            TypeKind::Dynamic { .. } => self.give_up(|| "a pointer to a `dyn` value".to_owned()),
+            _ if raw && erased(types, pointee) => {
+                self.give_up(|| "a raw pointer to an erased pointee".to_owned())
+            }
+            _ if !raw && descriptor.js.is_indirect => self.handed(pointee),
+            _ => {
+                self.slot(pointee);
+                self.handed(pointee);
+            }
+        }
+    }
+
+    /// A value of type `ty` that JavaScript supplied and still holds (an export's argument, a host
+    /// call's result): whatever Rust may write into it reaches the host, and so does whatever
+    /// Rust passes to a host function found in it.
+    fn received(&mut self, ty: TypeId) {
+        self.read(ty, false);
+    }
+
+    /// Rust's view of host-supplied data of type `ty`, `shared` when it is reached through a
+    /// shared reference.
+    ///
+    /// Through a shared reference only interior mutability writes, and `TypeMeta::freeze` (rustc's
+    /// `Freeze`, schema 16) says where there is none; a type that is not `Freeze` is treated as
+    /// written whole, whichever of its fields holds the cell. A value owned outright — a by-value
+    /// argument, the pointee of a `&mut` or of a raw pointer — may be written anywhere.
+    fn read(&mut self, ty: TypeId, shared: bool) {
+        if !self.received_seen.insert((ty, shared)) {
+            return;
+        }
+        let types = self.types;
+        let Some(descriptor) = types.get(ty) else {
+            self.give_up(|| format!("type {:032x} is not described", ty.0));
+            return;
+        };
+        // Asked before peeling: `UnsafeCell` is itself a transparent wrapper.
+        if shared && !descriptor.meta.freeze {
+            self.handed(ty);
+        }
+        if descriptor.js.transparent.is_some() && descriptor.js.peeled != ty {
+            self.read(descriptor.js.peeled, shared);
+            return;
+        }
+        if descriptor.layout.zst {
+            return;
+        }
+        let fields: Vec<TypeId> = match &descriptor.kind {
+            TypeKind::Bool
+            | TypeKind::Char
+            | TypeKind::Integer { .. }
+            | TypeKind::Float { .. }
+            | TypeKind::Str
+            | TypeKind::Never
+            | TypeKind::FnDef { .. } => return,
+            TypeKind::Pattern(base) => return self.read(*base, shared),
+            TypeKind::Reference { pointee, mutable } => {
+                if *mutable && !shared {
+                    self.handed(*pointee);
+                    self.read(*pointee, false);
+                } else {
+                    self.read(*pointee, true);
+                }
+                return;
+            }
+            TypeKind::RawPointer { pointee, .. } => {
+                // Writing through a raw pointer to an erased pointee reinterprets the memory, which
+                // is the documented residual; anything else is a place Rust may write.
+                if !erased(types, *pointee) {
+                    self.handed(*pointee);
+                    self.read(*pointee, false);
+                }
+                return;
+            }
+            // A host function Rust may call: it is handed every argument Rust passes.
+            TypeKind::FnPtr { sig } => {
+                match self.interns.sig(*sig) {
+                    Some(signature) => {
+                        let (inputs, output) = (signature.inputs.clone(), signature.output);
+                        for input in inputs {
+                            self.handed(input);
+                        }
+                        self.read(output, false);
+                    }
+                    None => self.give_up(|| "a function pointer with no signature".to_owned()),
+                }
+                return;
+            }
+            TypeKind::Dynamic { .. } => {
+                self.give_up(|| "a host-supplied `dyn` value".to_owned());
+                return;
+            }
+            TypeKind::Opaque | TypeKind::Foreign(_) => {
+                self.give_up(|| "a type the table does not describe further".to_owned());
+                return;
+            }
+            TypeKind::Adt {
+                form: NominalForm::Opaque,
+                ..
+            } => {
+                self.give_up(|| "an opaque nominal type".to_owned());
+                return;
+            }
+            TypeKind::Adt { variants, .. } => {
+                if descriptor.js.is_primitive_enum {
+                    return;
+                }
+                variants
+                    .iter()
+                    .flat_map(|variant| variant.fields.iter().map(|field| field.ty))
+                    .collect()
+            }
+            TypeKind::Tuple(elements) => elements.clone(),
+            TypeKind::Array { element, .. } | TypeKind::Slice(element) => vec![*element],
+            TypeKind::Closure { upvars, .. } | TypeKind::CoroutineClosure { upvars, .. } => {
+                upvars.clone()
+            }
+            TypeKind::Coroutine {
+                upvars,
+                saved_locals,
+                ..
+            } => {
+                let mut fields = upvars.clone();
+                fields.extend(saved_locals.iter().map(|(_, ty)| *ty));
+                fields
+            }
+        };
+        if !shared {
+            self.handed(ty);
+        }
+        for field in fields {
+            self.read(field, shared);
+        }
+    }
+}
+
+/// Whether a raw pointer to `pointee` says nothing about what it points into: a byte, a unit, an
+/// opaque or foreign type, a fieldless enum (`c_void`). Such a pointer is how an arbitrary buffer is
+/// viewed as bytes.
+fn erased(types: &TypeTable, pointee: TypeId) -> bool {
+    let Some(descriptor) = types.get(types.peeled(pointee)) else {
+        return true;
+    };
+    if descriptor.layout.zst {
+        return true;
+    }
+    match &descriptor.kind {
+        TypeKind::Integer { bits: 8, .. }
+        | TypeKind::Opaque
+        | TypeKind::Foreign(_)
+        | TypeKind::Never => true,
+        TypeKind::Adt {
+            form: NominalForm::Enum,
+            variants,
+            ..
+        } => variants.iter().all(|variant| variant.fields.is_empty()),
+        _ => false,
+    }
+}
