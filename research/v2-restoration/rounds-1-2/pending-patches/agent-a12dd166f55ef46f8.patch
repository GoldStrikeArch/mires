+/// Whether any node of `tree` is a pointer to a `static`.
+pub fn names_static(tree: &ConstTree) -> bool {
+    let mut work = vec![tree];
+    while let Some(tree) = work.pop() {
+        match tree {
+            ConstTree::Global {
+                target: GlobalReference::Static { .. },
+                ..
+            } => return true,
+            ConstTree::Aggregate(fields)
+            | ConstTree::Slice(fields)
+            | ConstTree::Variant { fields, .. } => work.extend(fields),
+            ConstTree::Reference(inner) => work.push(inner),
+            ConstTree::Global { .. }
+            | ConstTree::Unit
+            | ConstTree::Scalar { .. }
+            | ConstTree::Str(_)
+            | ConstTree::Address(_) => {}
+        }
+    }
+    false
+}
