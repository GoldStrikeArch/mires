+#[test]
+fn the_selection_is_independent_of_the_order_the_uses_are_read_in() {
+    let interns = world();
+    let long = "x".repeat(POOL_MIN_BYTES);
+    let table = candidate("pool$ha", SLICE_U32, &long);
+    let other = candidate("pool$hb", SLICE_ENTRY, &long);
+    let once = candidate("pool$hc", SLICE_U32, &format!("{long}1"));
+    let small = candidate("pool$hd", SLICE_U32, "[1]");
+    let uses = [
+        table.clone(),
+        other.clone(),
+        table.clone(),
+        once,
+        small.clone(),
+        other,
+        small,
+    ];
+    let forward = decided(&interns, &uses);
+    let mut reversed_uses = uses.to_vec();
+    reversed_uses.reverse();
+    let reversed = decided(&interns, &reversed_uses);
+    assert_eq!(forward.selection, reversed.selection);
+    assert_eq!(forward.json(), reversed.json());
+    let names: Vec<&str> = forward.selection.names.iter().map(String::as_str).collect();
+    assert_eq!(names, ["pool$ha", "pool$hb"]);
+    assert_eq!(forward.entries["pool$hc"].decision, Decision::SingleUse);
+    assert_eq!(forward.entries["pool$hd"].decision, Decision::Small);
+}
