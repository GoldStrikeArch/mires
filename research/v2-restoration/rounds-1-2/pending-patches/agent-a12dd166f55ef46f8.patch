+/// The `by-value` mutant of [`poolable`]: a by-value aggregate is treated as its own pointee.
+fn by_value_fault<'t>(table: &TypeTable, tree: &'t ConstTree, ty: TypeId) -> Option<PoolShape<'t>> {
+    if pool_fault() != Some("by-value") || !matches!(tree, ConstTree::Aggregate(_)) {
+        return None;
+    }
