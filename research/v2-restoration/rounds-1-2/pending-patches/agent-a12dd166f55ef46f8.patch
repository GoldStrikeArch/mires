index 0000000000000000000000000000000000000000..e5a29873b37108d08d6c7df3a4129fb72d5e7c19
--- /dev/null
+++ b/scripts/noop-landing-pads-test.sh
@@ -0,0 +1,27 @@
+#!/usr/bin/env bash
+# No-op landing pad removal: exact drops and thrown-value identity with MIR inlining and the
+# optimizer each on and off.
+set -euo pipefail
+root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
+cd "$root"
+work="$root/build/noop-landing-pads"
+mkdir -p "$work/proc-macro"
+if [ "${SKIP_BUILD:-0}" != 1 ]; then bash scripts/build.sh --locked >/dev/null; fi
+cargo build -p js-extern-macro --locked >"$work/macro.log" 2>&1
+case "$(uname -s)" in Darwin) ext=dylib ;; *) ext=so ;; esac
+macro="$root/target/debug/libjs_extern_macro.$ext"
+ln -sf "$macro" "$work/proc-macro/libjs_extern_macro.$ext"
+node scripts/make-esm-shim.mjs "$work/shim.mjs"
+for mode in on off; do
+  export JS_EXTRA_ARGS="js-profile=release-balanced js-cleanup=on js-opt=$mode"
+  SKIP_BUILD=1 bash scripts/build_sysroot.sh >"$work/sysroot-$mode.log" 2>&1
+  bash scripts/compile_core.sh mires-js/src/lib.rs "$work/libmires_js-$mode.rlib" --crate-type rlib --crate-name mires_js --extern "js_extern_macro=$macro" >"$work/lib-$mode.log" 2>&1
+  for inline in off on; do
+    program="$work/program-$mode-inline-$inline.mjs"
+    JSC_RUST_MIR_INLINE=$inline JS_EXTRA_ARGS="$JS_EXTRA_ARGS js-lane=jir js-modules=esm js-shim-module=./shim.mjs" \
+      bash scripts/compile_core.sh examples/noop_landing_pads.rs "$program" \
+        --extern "mires_js=$work/libmires_js-$mode.rlib" --search "$work/proc-macro" >"$program.log" 2>&1
+    node scripts/noop-landing-pads-check.mjs "$program" >"$program.json"
+    echo "optimizer $mode / MIR inlining $inline: no-op landing pad cases passed"
+  done
+done
diff --git a/scripts/pooled-constants-test.sh b/scripts/pooled-constants-test.sh
new file mode 100755
index 0000000000000000000000000000000000000000..ca2732d3c7a20b1a79d53bb596914a61012d3843
--- /dev/null
+++ b/scripts/pooled-constants-test.sh
@@ -0,0 +1,283 @@
+#!/usr/bin/env bash
+#
+# Pooled constants (`js-pool-consts`, CONTRACT.md "Pooled constants"):
+# examples/core-tests/121_pooled_constants.rs, examples/pooled_host_exposure.rs and
+# examples/pooled_host_symbol.rs.
+#
+#   scripts/pooled-constants-test.sh        # SKIP_BUILD=1 reuses the backend
+#
+# Under js-profile=release-balanced, which turns pooling on:
+#
+#   1. pooled: the fixture prints its native .expected, every pooled table's data is in the
+#      program exactly once, the raw-pointer and static-naming tables once per use, and the lane
+#      sidecar's `pool` block names the bindings with their emitted uses;
+#   2. control: `js-pool-consts=off` prints the same output with every table once per use and a
+#      `pool` block of null;
+#   3. mutants, with the debug `jsc-link` (only a debug build reads `RCGJS_POOL_FAULT`): `by-value`
+#      pools a written by-value copy and must change what the fixture prints; `mut-ref` and
+#      `static` pool the raw-pointer and the static-naming table and must change their copy
+#      count (neither is observable in a program without undefined behaviour or a cyclic static);
+#   4. source map: `js-source-map=on` still prints .expected and the map checks;
+#   5. chunks: two chunks over two entry points that both read a pooled table, one of which also
+#      reads a static of its own initialized from the pooled table and another static of its own
+#      initialized from a static the shared chunk owns: the binding is in the shared chunk only,
+#      no chunk declares a name it imports, and the chunks run;
+#   6. host exposure: a table that reaches host code by any route is declined, a table the host
+#      never sees is pooled, and the host's writes reach no other reader; with the `host` mutant
+#      the checks must fail.
+#
+# Every check runs; the script fails at the end if any did. Every artifact is retained under
+# build/pooled-constants.XXXXXX.
+set -uo pipefail
+script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
+root=$(cd -- "$script_dir/.." && pwd)
+# shellcheck source=integration-lock.sh
+source "$script_dir/integration-lock.sh"
+if [ "${SKIP_BUILD:-0}" != 1 ]; then "$script_dir/build.sh" >/dev/null || exit 1; fi
+mkdir -p "$root/build"
+work=$(mktemp -d "$root/build/pooled-constants.XXXXXX")
+echo "pooled constants: retained output at $work"
+
+fixture="$root/examples/core-tests/121_pooled_constants.rs"
+expected="$root/examples/core-tests/121_pooled_constants.expected"
+shim="$root/runtime/shim.js"
+entry="$script_dir/entry.js"
+export JS_EXTRA_ARGS="js-profile=release-balanced"
+SKIP_BUILD=1 "$script_dir/build_sysroot.sh" >"$work/sysroot.log" 2>&1 || {
+	echo "pooled constants: the sysroot does not build" >&2
+	exit 1
+}
+# The mutants run with the debug linker: a release `jsc-link` ignores `RCGJS_POOL_FAULT`.
+(cd "$root" && cargo build -p jsc-link --locked) >"$work/debug-linker.log" 2>&1 || {
+	echo "pooled constants: the debug jsc-link does not build" >&2
+	exit 1
+}
+debug_linker="$root/target/debug/jsc-link"
+
+failed=0
+fail() {
+	echo "pooled constants: FAIL: $*" >&2
+	failed=$((failed + 1))
+}
+
+# compile <name> <source> <out file> <extra JS_EXTRA_ARGS> [env assignment...]
+compile() {
+	local name=$1 source=$2 out=$3 extra=$4
+	shift 4
+	mkdir -p "$work/$name"
+	if ! env "$@" JS_EXTRA_ARGS="$JS_EXTRA_ARGS $extra" "$script_dir/compile_core.sh" "$source" \
+		"$work/$name/$out" "${extern_args[@]+"${extern_args[@]}"}" >"$work/$name/compile.log" 2>&1; then
+		sed 's/^/    /' "$work/$name/compile.log" | tail -n 20 >&2
+		fail "$name: compile failed"
+		return 1
+	fi
+}
+
+# run <name> [prefix.js]: runs a script-mode program, stdout to <work>/<name>/stdout.
+run() {
+	cat "$shim" ${2:+"$2"} "$work/$1/program.js" "$entry" | node - >"$work/$1/stdout" 2>"$work/$1/stderr" || true
+}
+
+# occurrences <file> <text>: how many times <text> appears in <file> (0 included).
+occurrences() {
+	{ grep -o -F -- "$2" "$1" || true; } | wc -l | tr -d ' '
+}
+
+# The rows, filters and operations tables each have a name only their data spells.
+markers="pooled-row-alpha pooled-filter-two pooled-op-square"
+# The tail both byte tables print, `[1,2,..,96]` as `[u8]` and as `[u32]`: one binding each.
+bytes_tail="94,95,96]"
+# Never pooled: a raw pointer constant, and data that names statics.
+raw_marker="pooled-raw-north-west-corner"
+static_marker="pooled-anchor-low-water-mark"
+
+# 1. pooled
+if compile pooled "$fixture" program.js ""; then
+	run pooled
+	diff -u "$expected" "$work/pooled/stdout" >"$work/pooled/diff" || {
+		sed 's/^/    /' "$work/pooled/diff" "$work/pooled/stderr" >&2
+		fail "pooled: output differs from the native expectation"
+	}
+	for marker in $markers; do
+		count=$(occurrences "$work/pooled/program.js" "$marker")
+		[ "$count" = 1 ] || fail "pooled: \"$marker\" is in the program $count times, not once"
+	done
+	count=$(occurrences "$work/pooled/program.js" "$bytes_tail")
+	[ "$count" = 2 ] || fail "pooled: the two byte tables are $count bindings, not two"
+	# `GRID` is copied by value three times; each copy stays a literal of its own.
+	count=$(occurrences "$work/pooled/program.js" pooled-grid-north)
+	[ "$count" -ge 3 ] || fail "pooled: the by-value copies of GRID are $count literals, not one each"
+	raw_count=$(occurrences "$work/pooled/program.js" "$raw_marker")
+	[ "$raw_count" -ge 2 ] || fail "pooled: the raw-pointer table is $raw_count literals, not one per use"
+	static_count=$(occurrences "$work/pooled/program.js" "$static_marker")
+	[ "$static_count" -ge 2 ] || fail "pooled: the static-naming table is $static_count literals, not one per use"
+	sidecar="$work/pooled/program.js.lane.json"
+	if jq -e '
+	  .schema == 18 and
+	  .pool.host.bounded == true and
+	  (.pool.pooled | length) >= 5 and
+	  ([.pool.pooled[].emitted_uses] | max) >= 6 and
+	  ([.pool.pooled[] | select(.emitted_uses < 2)] | length) == 0 and
+	  .pool.declined.collision == 0 and
+	  .pool.by_value.repeated >= 1
+	' "$sidecar" >/dev/null; then
+		echo "pooled: $(jq '.pool.pooled | length' "$sidecar") bindings, uses $(jq -c '[.pool.pooled[].emitted_uses]' "$sidecar")"
+	else
+		jq '.pool' "$sidecar" >&2
+		fail "pooled: the sidecar pool block does not describe the pooled tables"
+	fi
+fi
+
+# 2. control
+if compile control "$fixture" program.js "js-pool-consts=off"; then
+	run control
+	cmp -s "$expected" "$work/control/stdout" || fail "control: output differs from the native expectation"
+	for marker in $markers; do
+		count=$(occurrences "$work/control/program.js" "$marker")
+		[ "$count" -ge 2 ] || fail "control: \"$marker\" is in the unpooled program only $count times"
+	done
+	count=$(occurrences "$work/control/program.js" "$bytes_tail")
+	[ "$count" -ge 3 ] || fail "control: the byte tables are only $count literals unpooled"
+	jq -e '.pool == null' "$work/control/program.js.lane.json" >/dev/null ||
+		fail "control: a build without js-pool-consts reports a pool"
+	echo "control: every table once per use"
+fi
+
+# 3. mutants. Against the unmutated pooled build, so a known failure there cannot hide one.
+if compile mutant-by-value "$fixture" program.js "" JSC_LINK_BIN="$debug_linker" RCGJS_POOL_FAULT=by-value; then
+	run mutant-by-value
+	if cmp -s "$work/pooled/stdout" "$work/mutant-by-value/stdout"; then
+		fail "mutation: pooling the written by-value copy went unnoticed"
+	else
+		echo "mutation (by-value): caught"
+	fi
+fi
+if compile mutant-mut-ref "$fixture" program.js "" JSC_LINK_BIN="$debug_linker" RCGJS_POOL_FAULT=mut-ref; then
+	run mutant-mut-ref
+	count=$(occurrences "$work/mutant-mut-ref/program.js" "$raw_marker")
+	if [ "$count" = "$raw_count" ] && cmp -s "$work/pooled/stdout" "$work/mutant-mut-ref/stdout"; then
+		fail "mutation: pooling a raw-pointer position went unnoticed"
+	else
+		echo "mutation (mut-ref): caught ($raw_count -> $count copies)"
+	fi
+fi
+if compile mutant-static "$fixture" program.js "" JSC_LINK_BIN="$debug_linker" RCGJS_POOL_FAULT=static; then
+	run mutant-static
+	count=$(occurrences "$work/mutant-static/program.js" "$static_marker")
+	if [ "$count" = "$static_count" ] && cmp -s "$work/pooled/stdout" "$work/mutant-static/stdout"; then
+		fail "mutation: pooling data that names a static went unnoticed"
+	else
+		echo "mutation (static): caught ($static_count -> $count copies)"
+	fi
+fi
+
+# 4. source map
+if compile mapped "$fixture" program.js "js-source-map=on"; then
+	run mapped
+	cmp -s "$work/pooled/stdout" "$work/mapped/stdout" || fail "source map: output differs from the pooled build"
+	node "$script_dir/check-sourcemap.js" "$work/mapped/program.js" >"$work/mapped/map.log" 2>&1 || {
+		sed 's/^/    /' "$work/mapped/map.log" >&2
+		fail "source map: the map does not check"
+	}
+	echo "source map: checked"
+fi
+
+# 5. chunks
+if compile chunks "$fixture" program.js "js-modules=esm js-chunk=a:pooled_chunk_a js-chunk=b:pooled_chunk_b"; then
+	if "$script_dir/run-chunks.sh" "$work/chunks/program.js" pooled-constants \
+		a:pooled_chunk_a b:pooled_chunk_b >"$work/chunks/stdout" 2>"$work/chunks/stderr"; then
+		head -n 7 "$expected" | cmp -s - "$work/chunks/stdout" || fail "chunks: output differs"
+	else
+		sed 's/^/    /' "$work/chunks/stderr" >&2
+		fail "chunks: the chunks do not run"
+	fi
+	[ "$(occurrences "$work/chunks/shared.js" pooled-row-alpha)" = 1 ] ||
+		fail "chunks: the rows binding is not in the shared chunk exactly once"
+	for chunk in a b; do
+		[ "$(occurrences "$work/chunks/$chunk.js" pooled-row-alpha)" = 0 ] ||
+			fail "chunks: chunk $chunk carries its own copy of the rows"
+		# A name a chunk imports is never declared in it again.
+		imported=$(sed -n 's/^import *{\([^}]*\)} *from *"\.\/shared\.js";$/\1/p' "$work/chunks/$chunk.js" | tr ',' '\n' | sed 's/ //g')
+		for name in $imported; do
+			if grep -qE "^(const|let|function) ${name//$/\\$}[=( ]" "$work/chunks/$chunk.js"; then
+				fail "chunks: chunk $chunk imports \`$name\` and declares it too"
+			fi
+		done
+	done
+	echo "chunks: one binding, in shared.js; no chunk redeclares an import"
+fi
+
+# 6. host exposure
+(cd "$root" && cargo build -p js-extern-macro --locked) >"$work/macro.log" 2>&1
+case "$(uname -s)" in
+Darwin) macro="$root/target/debug/libjs_extern_macro.dylib" ;;
+*) macro="$root/target/debug/libjs_extern_macro.so" ;;
+esac
+mkdir -p "$work/proc-macro" "$work/host"
+ln -sf "$macro" "$work/proc-macro/$(basename -- "$macro")"
+node "$script_dir/make-esm-shim.mjs" "$work/shim.mjs"
+if "$script_dir/compile_core.sh" "$root/mires-js/src/lib.rs" "$work/host/libmires_js.rlib" \
+	--crate-type rlib --crate-name mires_js --extern "js_extern_macro=$macro" >"$work/host/mires-js.log" 2>&1; then
+	extern_args=(--extern "mires_js=$work/host/libmires_js.rlib" --extern "js_extern_macro=$macro"
+		--search "$work/proc-macro")
+	host_check() {
+		local name=$1
+		shift
+		compile "$name" "$root/examples/pooled_host_exposure.rs" program.mjs \
+			"js-modules=esm js-shim-module=../shim.mjs" "$@" || return 2
+		node "$script_dir/pooled-host-exposure-check.mjs" "$work/$name/program.mjs" >"$work/$name/check.log" 2>&1
+	}
+	if host_check host-pooled; then
+		if jq -e '.pool.declined.host_exposed >= 4 and (.pool.pooled | length) >= 1' \
+			"$work/host-pooled/program.mjs.lane.json" >/dev/null; then
+			echo "host: $(tail -n 1 "$work/host-pooled/check.log")"
+		else
+			jq '.pool' "$work/host-pooled/program.mjs.lane.json" >&2
+			fail "host: the exposed tables were not declined, or the other one not pooled"
+		fi
+		[ "$(occurrences "$work/host-pooled/program.mjs" pooled-label-horizon)" = 1 ] ||
+			fail "host: the table the host never sees is not pooled"
+	else
+		sed 's/^/    /' "$work/host-pooled/check.log" >&2
+		fail "host: a write by the host reached another reader"
+	fi
+	host_check host-mutant JSC_LINK_BIN="$debug_linker" RCGJS_POOL_FAULT=host
+	case $? in
+	0) fail "mutation: pooling host-exposed tables went unnoticed" ;;
+	1) echo "mutation (host): caught ($(grep -c '^FAIL' "$work/host-mutant/check.log") checks fail)" ;;
+	esac
+	unset extern_args
+else
+	fail "host: mires-js does not compile"
+fi
+
+# The C-ABI route: a script-mode program whose `extern "C"` symbol the host defines.
+printf '%s\n' 'globalThis.__rt.pooled_touch_rules = (rules) => {' \
+	'  for (const row of rules.buf) for (const key of Object.keys(row)) row[key] = "written-by-the-host";' \
+	'};' >"$work/host-symbol.js"
+for mode in symbol symbol-mutant; do
+	env=()
+	[ "$mode" = symbol-mutant ] && env=(JSC_LINK_BIN="$debug_linker" RCGJS_POOL_FAULT=host)
+	compile "$mode" "$root/examples/pooled_host_symbol.rs" program.js "" "${env[@]+"${env[@]}"}" || continue
+	run "$mode" "$work/host-symbol.js"
+	before=$(sed -n '1,2p' "$work/$mode/stdout")
+	after=$(sed -n '3,4p' "$work/$mode/stdout")
+	if [ "$mode" = symbol ]; then
+		if [ -n "$before" ] && [ "$before" = "$after" ]; then
+			echo "host (C ABI): the host's writes stayed in its copy"
+		else
+			sed 's/^/    /' "$work/$mode/stdout" "$work/$mode/stderr" >&2
+			fail "host (C ABI): a write by the host reached another reader"
+		fi
+	elif [ "$before" = "$after" ]; then
+		fail "mutation: pooling a table handed to a host symbol went unnoticed"
+	else
+		echo "mutation (host, C ABI): caught"
+	fi
+done
+
+if [ "$failed" -ne 0 ]; then
+	echo "pooled constants: $failed check(s) FAILED" >&2
+	exit 1
+fi
+echo 'pooled constants: PASS'
diff --git a/scripts/pooled-host-exposure-check.mjs b/scripts/pooled-host-exposure-check.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..846206af139bf4e729f36215142c399e6d209435
--- /dev/null
+++ b/scripts/pooled-host-exposure-check.mjs
@@ -0,0 +1,87 @@
+// Checks examples/pooled_host_exposure.rs: a constant that reaches host code stays the host's own
+// copy, so what the host writes into it is never seen by any other reader of the constant.
+//
+//   node scripts/pooled-host-exposure-check.mjs <program.mjs>
+//
+// Each route hands the host a table: a `#[js_extern]` argument, a `HashMap` the program returns,
+// the crate's own `rcgjs.host.erase` marker, and a `Cell` the program fills in a host object. The
+// host overwrites every string and number it can reach from what it got. Every reader asked
+// afterwards must still answer the constant's own values. Exits non-zero on any disagreement,
+// which is what the `RCGJS_POOL_FAULT=host` mutant run requires.
+
+import { resolve } from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+// Overwrites every string and number reachable from `value`; returns how many it overwrote.
+function overwrite(value, seen = new Set()) {
+  if (value === null || typeof value !== 'object' || seen.has(value)) return 0;
+  seen.add(value);
+  let count = 0;
+  const entries = value instanceof Map ? [...value.values()].map((v) => [null, v]) : Object.entries(value);
+  for (const [key, child] of entries) {
+    if (key !== null && typeof child === 'string' && key !== 'TAG') {
+      value[key] = 'written-by-the-host';
+      count += 1;
+    } else if (key !== null && typeof child === 'number' && key !== 'off' && key !== 'len') {
+      value[key] = child + 1000;
+      count += 1;
+    } else {
+      count += overwrite(child, seen);
+    }
+  }
+  return count;
+}
+
+const program = resolve(process.argv[2]);
+let received = 0;
+globalThis.pooledHostTouch = (limits) => {
+  received += 1;
+  if (!limits || !Array.isArray(limits.buf)) throw new Error('the host was not handed a slice record');
+  overwrite(limits);
+  limits.buf.push({ name: 'appended-by-the-host', value: 5000 });
+};
+const api = await import(pathToFileURL(program));
+
+let failures = 0;
+let checks = 0;
+const check = (label, actual, expected) => {
+  checks += 1;
+  const ok = actual === expected;
+  console.log(`${ok ? 'ok  ' : 'FAIL'}  ${label}: ${JSON.stringify(actual)}${ok ? '' : ` (expected ${JSON.stringify(expected)})`}`);
+  if (!ok) failures += 1;
+};
+const wrote = (label, count) => check(`${label}: the host reached the table`, count > 0, true);
+
+// A declared host function.
+check('limits before the host', api.limits_total(), 80);
+api.hand_limits_to_host();
+check('the host was called', received, 1);
+check('limits after the host', api.limits_total(), 80);
+check('first limit after the host', api.limits_first_name(), 'pooled-limit-requests');
+api.hand_limits_to_host();
+check('the host was called again', received, 2);
+check('limits after the second write', api.limits_total(), 80);
+
+// A host Map the program returns.
+wrote('map', overwrite(api.make_map()));
+check('first map rule after the host', api.map_rules_first_name(), 'pooled-map-rule-alpha');
+check('last map selector after the host', api.map_rules_last_selector(), '#interstitial-epsilon');
+
+// The crate's own erase marker.
+wrote('erase', overwrite(api.erased_rules()));
+check('first erased rule after the host', api.erased_rules_first_name(), 'pooled-erased-rule-alpha');
+check('last erased selector after the host', api.erased_rules_last_selector(), '#interstitial-epsilon');
+
+// A Cell in a host object, written through a shared reference.
+const out = { rules: { TAG: 'None' } };
+api.fill(out);
+wrote('cell', overwrite(out));
+check('first cell rule after the host', api.cell_rules_first_name(), 'pooled-cell-rule-alpha');
+check('last cell selector after the host', api.cell_rules_last_selector(), '#interstitial-epsilon');
+
+// The table the host never sees.
+check('labels after the host', api.labels_total(), 78);
+check('first label after the host', api.labels_first_name(), 'pooled-label-north');
+
+console.log(`${checks - failures}/${checks} host exposure checks pass`);
+process.exit(failures === 0 ? 0 : 1);
