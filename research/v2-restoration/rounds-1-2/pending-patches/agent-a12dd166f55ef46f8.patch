+    JS_EXTRA_ARGS="$JS_EXTRA_ARGS js-lane=jir js-modules=esm js-shim-module=./shim.mjs" \
+    bash scripts/compile_core.sh examples/active_poll_cleanup.rs "$program" \
+    --extern "mires_js=$work/libmires_js.rlib" --search "$work/proc-macro" >"$program.compile.log" 2>&1
+  node scripts/active-poll-cleanup-check.mjs "$program" >"$program.result.json"
+  echo "active_poll_cleanup/$pass: active-call/drop cases passed"
+
+  program="$work/$core_fixture-$pass.js"
+  env ${passes:+RCGJS_JIR_PASSES=$passes} JS_EXTRA_ARGS="$JS_EXTRA_ARGS js-lane=jir" \
+    bash scripts/compile_core.sh "examples/core-tests/$core_fixture.rs" "$program" \
+    --extern "mires_js=$work/libmires_js.rlib" --search "$work/proc-macro" >"$program.compile.log" 2>&1
+  cat runtime/shim.js "$program" scripts/entry.js | node - >"$program.out"
+  diff -u "examples/core-tests/$core_fixture.expected" "$program.out"
+  echo "$core_fixture/$pass: output matches its expectation"
+done
+
+check active_poll_cleanup "$work/active_poll_cleanup-on.mjs" "$work/active_poll_cleanup-off.mjs"
+check "$core_fixture" "$work/$core_fixture-on.js" "$work/$core_fixture-off.js"
+test "$failures" = 0
+echo "cleanup edges: sidecar blocks match, both fixtures behave with the pass on and off"
