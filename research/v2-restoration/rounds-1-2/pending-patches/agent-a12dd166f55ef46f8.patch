+// ---------------------------------------------------------------------------------------------
+// Verification, witnesses, and the sidecar block
+// ---------------------------------------------------------------------------------------------
+
+#[test]
+fn every_removal_carries_a_witness_the_independent_check_accepts() {
+    let program = panic_program(false);
+    let interns: BTreeMap<JsName, &Interns> = program
+        .funcs
+        .keys()
+        .map(|name| (name.clone(), &program.interns))
+        .collect();
+    let deps: BTreeMap<JsName, &[String]> = program
+        .deps
+        .iter()
+        .map(|(name, deps)| (name.clone(), &deps[..]))
+        .collect();
+    let graph = callgraph::build(&program.funcs, &interns);
+    let facts = ThrowFacts {
+        deps: Some(&deps),
+        trust_host_contract: false,
+    };
+    let summaries = effects::compute_with(&program.funcs, &interns, &graph, facts);
+    let cx = Context {
+        graph: &graph,
+        interns: &interns,
+        summaries: &summaries,
+        facts,
+        untrusted: None,
+    };
+    let mut reasons = ThrowReasons::of(&cx, &program.funcs);
+    let entry = program.func("entry");
+    let decisions = classify(&cx, &mut reasons, &JsName::new("entry".to_owned()), entry);
+    let (after, witnesses) = rewrite(entry, &decisions).expect("a removal");
+    assert_eq!(witnesses.len(), 1);
+    crate::opt::witness::check_all(&witnesses, &after, &program.interns.types).unwrap();
+    // The check is independent of the classifier: a host call or dynamic glue is refused.
+    for protected in [
+        ProtectedOp::Host {
+            trusted_contract: false,
+        },
+        ProtectedOp::Drop {
+            glue: None,
+            dynamic: true,
+        },
+        ProtectedOp::Intrinsic("ctpop".to_owned()),
+    ] {
+        let forged = Witness::CleanupEdge {
+            block: RBlockId(0),
+            proof: CleanupProof::NoThrow { protected },
+        };
+        assert!(forged.check(&after, &program.interns.types).is_err());
+    }
+    let forged = Witness::CleanupEdge {
+        block: RBlockId(0),
+        proof: CleanupProof::EmptyChain {
+            ops: vec![],
+            terms: vec![RTerm::Return(None)],
+        },
+    };
+    assert!(forged.check(&after, &program.interns.types).is_err());
+}
