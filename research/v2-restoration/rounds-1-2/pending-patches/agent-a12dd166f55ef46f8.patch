+fn call(callee: Callee, host: Option<HostPayload>, arguments: &[TypeId]) -> Call {
+    use rcgjs_object::jir::semantic::{Constant, LocalId, Operand, OperandKind, Place, Unwind};
+    let operand = |ty| Operand {
+        ty,
+        kind: OperandKind::Constant(Constant::ZeroSized),
+    };
+    Call {
+        function: operand(U32),
+        callee,
+        semantic: if host.is_some() {
+            CallSemantic::Host
+        } else {
+            CallSemantic::Ordinary
+        },
+        arguments: arguments.iter().map(|ty| operand(*ty)).collect(),
+        destination: Place {
+            local: LocalId(0),
+            projection: Vec::new(),
+            ty: U32,
+        },
+        target: None,
+        unwind: Unwind::Continue,
+        track_caller: None,
+        host,
+    }
+}
