+fn decided(interns: &Interns, order: &[PoolCandidate]) -> PoolPlan {
+    let mut plan = PoolPlan {
+        enabled: true,
+        ..PoolPlan::default()
+    };
+    for found in order {
+        plan.record(vec![found.clone()], &interns.types, interns);
+    }
+    plan.decide();
+    plan
+}
