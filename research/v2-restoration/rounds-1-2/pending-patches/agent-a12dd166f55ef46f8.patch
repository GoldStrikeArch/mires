+//! The pooling rule on hand-built type tables: the structural predicate, the emitted spelling,
+//! the host footprint, and the order independence of the selection.
+
+use std::rc::Rc;
+
+use rcgjs_object::jir::interns::{Interns, StrId};
+use rcgjs_object::jir::repr::Func;
+use rcgjs_object::jir::semantic::{
+    AbiSignature, ConstTree, DefinitionId, GlobalReference, ItemId, Signature,
+};
+use rcgjs_object::jir::summary::{Availability, ItemClass, ItemSummary, SemanticKey};
+use rcgjs_object::jir::types::{
+    FieldDescriptor, FieldKey, IntFacts, IntRepr, JsFacts, LayoutFacts, NominalForm,
+    TypeDescriptor, TypeId, TypeKind, TypeMeta, VariantDescriptor,
+};
+use rcgjs_object::jsast;
+use rcgjs_object::object::{BlobRef, ItemKind, Linkage};
+use rcgjs_object::opts::Opts;
+
+use super::*;
+use crate::lower::js::constant::{self, PoolShape};
+use crate::lower::js::JsCx;
+
+const U8: TypeId = TypeId(1);
+const U32: TypeId = TypeId(2);
+const STR: TypeId = TypeId(3);
+const STR_REF: TypeId = TypeId(4);
+const SLICE_STR: TypeId = TypeId(5);
+const REF_SLICE_STR: TypeId = TypeId(6);
+const ENTRY: TypeId = TypeId(7);
+const SLICE_ENTRY: TypeId = TypeId(8);
+const REF_SLICE_ENTRY: TypeId = TypeId(9);
+const MUT_SLICE_ENTRY: TypeId = TypeId(10);
+const RAW_SLICE_ENTRY: TypeId = TypeId(11);
+const POINT: TypeId = TypeId(12);
+const REF_POINT: TypeId = TypeId(13);
+const REF_U32: TypeId = TypeId(14);
+const RAW_U8: TypeId = TypeId(15);
+const SLICE_U32: TypeId = TypeId(16);
+const REF_SLICE_U32: TypeId = TypeId(17);
+const MUT_REF_SLICE_STR: TypeId = TypeId(18);
+/// `[u32; 2]`, which prints exactly like a `&[u32]`'s two-element backing array.
+const ARRAY_U32: TypeId = TypeId(19);
+const REF_ARRAY_U32: TypeId = TypeId(20);
+/// `Cell<&[Entry]>`: a transparent wrapper that is not `Freeze`.
+const CELL_ROWS: TypeId = TypeId(21);
+/// `struct Out { rows: Cell<&[Entry]> }`, filled through `&Out` (the verifier's `hr1`).
+const OUT: TypeId = TypeId(22);
+const REF_OUT: TypeId = TypeId(23);
+/// `fn(&[Entry])`: a host function Rust may be handed and call.
+const FN_ROWS: TypeId = TypeId(24);
+/// `struct Hooks { call: fn(&[Entry]) }` behind a shared reference.
+const HOOKS: TypeId = TypeId(25);
+const REF_HOOKS: TypeId = TypeId(26);
+
+fn descriptor(id: TypeId, kind: TypeKind, size: Option<u64>) -> TypeDescriptor {
+    TypeDescriptor {
+        id,
+        name: None,
+        kind,
+        layout: LayoutFacts {
+            size,
+            unsized_prefix: None,
+            align: Some(4),
+            sized: size.is_some(),
+            zst: size == Some(0),
+            one_zst: size == Some(0),
+            needs_drop: false,
+            has_own_drop: false,
+        },
+        // Every test type is `Freeze` unless a test says otherwise.
+        meta: TypeMeta {
+            freeze: true,
+            ..TypeMeta::default()
+        },
+        js: JsFacts {
+            int: None,
+            is_indirect: false,
+            needs_clone: false,
+            crosses_transparent_union: false,
+            transparent: None,
+            peeled: id,
+            unsized_tail: None,
+            enum_repr: None,
+            is_primitive_enum: false,
+            pointer_form: None,
+            byte_element: false,
+            fields: Vec::new(),
+        },
+    }
+}
+
+fn int(id: TypeId, bits: u32) -> TypeDescriptor {
+    let mut d = descriptor(
+        id,
+        TypeKind::Integer {
+            signed: false,
+            bits,
+        },
+        Some(u64::from(bits / 8)),
+    );
+    d.js.int = Some(IntFacts {
+        signed: false,
+        bits,
+        repr: IntRepr::Number,
+    });
+    d
+}
+
+fn aggregate(id: TypeId, kind: TypeKind, size: Option<u64>) -> TypeDescriptor {
+    let mut d = descriptor(id, kind, size);
+    d.js.is_indirect = true;
+    d.js.needs_clone = size.is_some();
+    d
+}
+
+fn reference(id: TypeId, pointee: TypeId, mutable: bool) -> TypeDescriptor {
+    descriptor(id, TypeKind::Reference { pointee, mutable }, Some(4))
+}
+
+fn raw(id: TypeId, pointee: TypeId) -> TypeDescriptor {
+    descriptor(
+        id,
+        TypeKind::RawPointer {
+            pointee,
+            mutable: false,
+        },
+        Some(4),
+    )
+}
+
+fn field(key: FieldKey, ty: TypeId) -> FieldDescriptor {
+    FieldDescriptor { key, ty, offset: 0 }
+}
+
+fn world() -> Interns {
+    let mut interns = Interns::new();
+    let point = interns.intern_str("Point");
+    let (x, y) = (interns.intern_str("x"), interns.intern_str("y"));
+    interns.intern_type(int(U8, 8));
+    interns.intern_type(int(U32, 32));
+    interns.intern_type(aggregate(STR, TypeKind::Str, None));
+    interns.intern_type(reference(STR_REF, STR, false));
+    interns.intern_type(aggregate(SLICE_STR, TypeKind::Slice(STR_REF), None));
+    interns.intern_type(reference(REF_SLICE_STR, SLICE_STR, false));
+    interns.intern_type(reference(MUT_REF_SLICE_STR, SLICE_STR, true));
+    // `(&str, &[&str])`, a blocker table row.
+    interns.intern_type(aggregate(
+        ENTRY,
+        TypeKind::Tuple(vec![STR_REF, REF_SLICE_STR]),
+        Some(16),
+    ));
+    interns.intern_type(aggregate(SLICE_ENTRY, TypeKind::Slice(ENTRY), None));
+    interns.intern_type(reference(REF_SLICE_ENTRY, SLICE_ENTRY, false));
+    interns.intern_type(reference(MUT_SLICE_ENTRY, SLICE_ENTRY, true));
+    interns.intern_type(raw(RAW_SLICE_ENTRY, SLICE_ENTRY));
+    interns.intern_type(aggregate(
+        POINT,
+        TypeKind::Adt {
+            def: DefinitionId {
+                crate_id: 1,
+                local_hash: 1,
+            },
+            args: Vec::new(),
+            form: NominalForm::Struct,
+            variants: vec![VariantDescriptor {
+                name: point,
+                fields: vec![field(FieldKey::Name(x), U32), field(FieldKey::Name(y), U32)],
+                logical_discr: 0,
+                physical_tag: None,
+                result_ok: false,
+                saved_local_keys: Vec::new(),
+            }],
+            niche: None,
+        },
+        Some(8),
+    ));
+    interns.intern_type(reference(REF_POINT, POINT, false));
+    interns.intern_type(reference(REF_U32, U32, false));
+    interns.intern_type(raw(RAW_U8, U8));
+    interns.intern_type(aggregate(SLICE_U32, TypeKind::Slice(U32), None));
+    interns.intern_type(reference(REF_SLICE_U32, SLICE_U32, false));
+    interns.intern_type(aggregate(
+        ARRAY_U32,
+        TypeKind::Array {
+            element: U32,
+            length: 2,
+        },
+        Some(8),
+    ));
+    interns.intern_type(reference(REF_ARRAY_U32, ARRAY_U32, false));
+
+    let value = interns.intern_str("value");
+    let cell_name = interns.intern_str("Cell");
+    let out_name = interns.intern_str("Out");
+    let rows = interns.intern_str("rows");
+    let adt = |hash, name, key, ty| TypeKind::Adt {
+        def: DefinitionId {
+            crate_id: 1,
+            local_hash: hash,
+        },
+        args: Vec::new(),
+        form: NominalForm::Struct,
+        variants: vec![VariantDescriptor {
+            name,
+            fields: vec![field(FieldKey::Name(key), ty)],
+            logical_discr: 0,
+            physical_tag: None,
+            result_ok: false,
+            saved_local_keys: Vec::new(),
+        }],
+        niche: None,
+    };
+    let mut cell = descriptor(
+        CELL_ROWS,
+        adt(2, cell_name, value, REF_SLICE_ENTRY),
+        Some(8),
+    );
+    cell.js.transparent = Some(rcgjs_object::jir::types::TransparentField {
+        field: 0,
+        ty: REF_SLICE_ENTRY,
+    });
+    cell.js.peeled = REF_SLICE_ENTRY;
+    cell.meta.freeze = false;
+    interns.intern_type(cell);
+    let mut out = aggregate(OUT, adt(3, out_name, rows, CELL_ROWS), Some(8));
+    out.meta.freeze = false;
+    interns.intern_type(out);
+    interns.intern_type(reference(REF_OUT, OUT, false));
+
+    let sig = interns.intern_sig(rcgjs_object::jir::types::SigDescriptor {
+        inputs: vec![REF_SLICE_ENTRY],
+        output: STR_REF,
+        abi: rcgjs_object::jir::types::SigAbi::Rust,
+        spread_arity: None,
+        track_caller: false,
+        unwind: false,
+    });
+    interns.intern_type(descriptor(FN_ROWS, TypeKind::FnPtr { sig }, Some(4)));
+    let hooks_name = interns.intern_str("Hooks");
+    let call = interns.intern_str("call");
+    interns.intern_type(aggregate(HOOKS, adt(4, hooks_name, call, FN_ROWS), Some(4)));
+    interns.intern_type(reference(REF_HOOKS, HOOKS, false));
+    interns
+}
+
+fn text(interns: &mut Interns, value: &str) -> ConstTree {
+    ConstTree::Str(interns.intern_str(value))
+}
+
+fn scalar(bits: u128) -> ConstTree {
+    ConstTree::Scalar { bits, bytes: 4 }
+}
+
+/// `&[("abpIndo", &["#Iklan-Melayang", ..]), ..]` with `rows` rows.
+fn table(interns: &mut Interns, rows: usize) -> ConstTree {
+    ConstTree::Slice(
+        (0..rows)
+            .map(|row| {
+                let selectors = (0..4)
+                    .map(|index| text(interns, &format!("#selector-{row}-{index}")))
+                    .collect();
+                ConstTree::Aggregate(vec![
+                    text(interns, &format!("filter{row}")),
+                    ConstTree::Slice(selectors),
+                ])
+            })
+            .collect(),
+    )
+}
+
+fn summary() -> ItemSummary {
+    ItemSummary {
+        key: SemanticKey {
+            link_name: "f".to_owned(),
+            item: None,
+        },
+        body_hash: None,
+        semantic_hash: None,
+        availability: Availability::Available,
+        deps: Vec::new(),
+        abi: None,
+        physical: None,
+        kind: ItemKind::Fn,
+        linkage: Linkage::internal(),
+        order: None,
+        dts: false,
+        fallback: BlobRef {
+            offset: 0,
+            clen: 0,
+            ulen: 0,
+        },
+        body: None,
+        origin: None,
+        estimated_bytes: 0,
+        class: ItemClass::default(),
+    }
+}
+
+fn empty_func() -> Func {
+    Func {
+        item: ItemId {
+            definition: DefinitionId {
+                crate_id: 1,
+                local_hash: 9,
+            },
+            instantiation: 9,
+        },
+        sig: Signature {
+            arguments: Vec::new(),
+            result: U32,
+            abi: AbiSignature::default(),
+        },
+        params: Vec::new(),
+        values: Vec::new(),
+        cells: Vec::new(),
+        blocks: Vec::new(),
+    }
+}
+
+/// Lowers `tree` at `ty` and prints it compact, with pooling on and `selection` in scope.
+fn lowered(
+    interns: &Interns,
+    tree: &ConstTree,
+    ty: TypeId,
+    pool: bool,
+    selection: Option<&[String]>,
+) -> String {
+    let opts = Opts {
+        pool_consts: pool,
+        ..Opts::default()
+    };
+    let func = empty_func();
+    let plan = crate::lower::plan::Plan::default();
+    let summary = summary();
+    let cx = JsCx::new(&func, &plan, &interns.types, interns, &opts, &summary, None);
+    let _scope = selection.map(|names| {
+        PoolScope::install(Rc::new(PoolSelection {
+            names: names.iter().cloned().collect(),
+        }))
+    });
+    let expr = cx.const_expr(tree, ty).expect("the constant lowers");
+    jsast::expr_to_string_styled(&expr, jsast::Style::Compact)
+}
+
+fn scan(interns: &Interns, tree: &ConstTree, ty: TypeId) -> Vec<PoolCandidate> {
+    let opts = Opts {
+        pool_consts: true,
+        ..Opts::default()
+    };
+    let func = empty_func();
+    let plan = crate::lower::plan::Plan::default();
+    let summary = summary();
+    let cx = JsCx::new(&func, &plan, &interns.types, interns, &opts, &summary, None);
+    cx.pool_scan(tree, ty).expect("the constant scans").1
+}
+
+#[test]
+fn only_the_pointee_of_a_shared_reference_is_poolable() {
+    let mut interns = world();
+    let rows = table(&mut interns, 3);
+    let types = &interns.types;
+    assert!(matches!(
+        constant::poolable(types, &rows, REF_SLICE_ENTRY),
+        Some(PoolShape::Slice {
+            slice: SLICE_ENTRY,
+            element: ENTRY,
+            ..
+        })
+    ));
+    // `&mut [T]` (only ever an empty promoted array) and a raw pointer, which may be cast to a
+    // writable one, are not.
+    assert!(constant::poolable(types, &rows, MUT_SLICE_ENTRY).is_none());
+    assert!(constant::poolable(types, &rows, RAW_SLICE_ENTRY).is_none());
+    // A reference to an aggregate is its object, and that object is poolable; a reference to a
+    // primitive is a fresh one-element slot, and a `&str` is already a string.
+    let point = ConstTree::Reference(Box::new(ConstTree::Aggregate(vec![scalar(1), scalar(2)])));
+    assert!(matches!(
+        constant::poolable(types, &point, REF_POINT),
+        Some(PoolShape::Object { pointee: POINT, .. })
+    ));
+    let one = ConstTree::Reference(Box::new(scalar(1)));
+    assert!(constant::poolable(types, &one, REF_U32).is_none());
+    let name = ConstTree::Reference(Box::new(ConstTree::Str(StrId(0))));
+    assert!(constant::poolable(types, &name, STR_REF).is_none());
+    // A by-value aggregate is a fresh value per use, never a pooled one.
+    let by_value = ConstTree::Aggregate(vec![scalar(1), scalar(2)]);
+    assert!(constant::poolable(types, &by_value, POINT).is_none());
+}
+
+#[test]
+fn data_that_names_a_static_is_never_poolable() {
+    let mut interns = world();
+    let link_name = interns.intern_str("COUNTER");
+    let tree = ConstTree::Slice(vec![ConstTree::Aggregate(vec![
+        text(&mut interns, "counter"),
+        ConstTree::Slice(vec![ConstTree::Global {
+            target: GlobalReference::Static {
+                definition: DefinitionId {
+                    crate_id: 1,
+                    local_hash: 2,
+                },
+                link_name,
+            },
+            offset: 0,
+        }]),
+    ])]);
+    assert!(constant::names_static(&tree));
+    assert!(constant::poolable(&interns.types, &tree, REF_SLICE_ENTRY).is_none());
+}
+
+#[test]
+fn the_binding_name_is_a_function_of_type_and_text() {
+    let a = constant::pool_name(SLICE_U32, "[1,2]");
+    assert_eq!(a, constant::pool_name(SLICE_U32, "[1,2]"));
+    assert!(a.starts_with("pool$h"));
+    // The same text at another type is another binding: `[1,2]` as `[u32]` and as `[u32; 2]`.
+    assert_ne!(a, constant::pool_name(ARRAY_U32, "[1,2]"));
+    assert_ne!(a, constant::pool_name(SLICE_U32, "[1,3]"));
+}
+
+#[test]
+fn a_selected_slice_is_its_binding_inside_a_record_built_per_use() {
+    let mut interns = world();
+    let rows = table(&mut interns, 2);
+    let inline = lowered(&interns, &rows, REF_SLICE_ENTRY, false, None);
+    assert!(inline.starts_with("{buf:[[\"filter0\""), "{inline}");
+
+    let found = scan(&interns, &rows, REF_SLICE_ENTRY);
+    // Only the outermost node is a candidate: the rows' own selector slices are inside it.
+    assert_eq!(found.len(), 1, "{found:?}");
+    let candidate = &found[0];
+    assert_eq!(candidate.ty, SLICE_ENTRY);
+    assert_eq!(
+        candidate.name,
+        constant::pool_name(SLICE_ENTRY, &candidate.text)
+    );
+    assert!(inline.contains(&candidate.text));
+
+    // Pooling on but no scope (every lowering but the final pass): inline, byte for byte.
+    assert_eq!(
+        lowered(&interns, &rows, REF_SLICE_ENTRY, true, None),
+        inline
+    );
+    // The scope names it: the record stays, its buffer is the binding.
+    let selected = [candidate.name.clone()];
+    assert_eq!(
+        lowered(&interns, &rows, REF_SLICE_ENTRY, true, Some(&selected)),
+        format!("{{buf:{},off:0,len:2}}", candidate.name)
+    );
+    // The scope is ignored with the option off, and gone once dropped.
+    assert_eq!(
+        lowered(&interns, &rows, REF_SLICE_ENTRY, false, Some(&selected)),
+        inline
+    );
+    assert_eq!(
+        lowered(&interns, &rows, REF_SLICE_ENTRY, true, None),
+        inline
+    );
+    // A scope that does not name it changes nothing.
+    assert_eq!(
+        lowered(
+            &interns,
+            &rows,
+            REF_SLICE_ENTRY,
+            true,
+            Some(&["pool$h0000000000000000".to_owned()])
+        ),
+        inline
+    );
+}
+
+#[test]
+fn an_unselected_outer_node_still_pools_a_selected_inner_one() {
+    let mut interns = world();
+    let rows = table(&mut interns, 1);
+    let ConstTree::Slice(row) = &rows else {
+        unreachable!()
+    };
+    let ConstTree::Aggregate(fields) = &row[0] else {
+        unreachable!()
+    };
+    let selectors = &fields[1];
+    let inner = scan(&interns, selectors, REF_SLICE_STR);
+    assert_eq!(inner.len(), 1);
+    let selected = [inner[0].name.clone()];
+    let printed = lowered(&interns, &rows, REF_SLICE_ENTRY, true, Some(&selected));
+    assert_eq!(
+        printed,
+        format!(
+            "{{buf:[[\"filter0\",{{buf:{},off:0,len:4}}]],off:0,len:1}}",
+            inner[0].name
+        )
+    );
+}
+
+#[test]
+fn a_reference_to_an_aggregate_pools_the_object_itself() {
+    let interns = world();
+    let point = ConstTree::Reference(Box::new(ConstTree::Aggregate(vec![scalar(1), scalar(2)])));
+    let found = scan(&interns, &point, REF_POINT);
+    assert_eq!(found.len(), 1);
+    assert_eq!(found[0].text, "{x:1,y:2}");
+    let selected = [found[0].name.clone()];
+    assert_eq!(
+        lowered(&interns, &point, REF_POINT, true, Some(&selected)),
+        found[0].name
+    );
+}
