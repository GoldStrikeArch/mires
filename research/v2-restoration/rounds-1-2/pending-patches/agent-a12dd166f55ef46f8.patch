+/// The names of the constants the link step decided to pool, by [`pool_name`].
+#[derive(Clone, Debug, Default, Eq, PartialEq)]
+pub struct PoolSelection {
+    pub names: BTreeSet<String>,
+}
+
+thread_local! {
+    /// The selection [`JsCx::const_expr`] pools by, while a [`PoolScope`] is alive.
+    static SELECTION: RefCell<Option<Rc<PoolSelection>>> = const { RefCell::new(None) };
+}
+
+/// Pools the selected constants in every lowering run while it is alive, and nothing after.
+///
+/// The lane driver holds one for exactly the duration of its final phase-C pass. Scopes nest: the
+/// previous selection is restored on drop.
+pub struct PoolScope {
+    previous: Option<Rc<PoolSelection>>,
+}
+
+impl PoolScope {
+    pub fn install(selection: Rc<PoolSelection>) -> PoolScope {
+        let previous = SELECTION.with(|slot| slot.borrow_mut().replace(selection));
+        PoolScope { previous }
+    }
+}
+
+impl Drop for PoolScope {
+    fn drop(&mut self) {
+        let previous = self.previous.take();
+        SELECTION.with(|slot| *slot.borrow_mut() = previous);
+    }
