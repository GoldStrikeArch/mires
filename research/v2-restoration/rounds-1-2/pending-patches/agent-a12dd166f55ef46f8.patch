+#[test]
+fn every_host_payload_and_every_foreign_symbol_is_a_host_boundary() {
+    let mut interns = world();
+    let marker = |interns: &mut Interns, section: &str| HostPayload::Marker {
+        section: interns.intern_str(section),
+        def: DefinitionId {
+            crate_id: 1,
+            local_hash: 9,
+        },
+        template: None,
+        helpers: Vec::new(),
+    };
+    let set = interns.intern_str("set");
+    let runtime: BTreeSet<String> = ["js_log_str".to_owned()].into_iter().collect();
+    let shim_member = Callee::Runtime {
+        member: interns.intern_str("js_log_str"),
+    };
+    let host_symbol = Callee::Runtime {
+        member: interns.intern_str("probe_touch_rules"),
+    };
+    let user = Callee::Direct {
+        item: ItemId {
+            definition: DefinitionId {
+                crate_id: 1,
+                local_hash: 8,
+            },
+            instantiation: 8,
+        },
+        link_name: interns.intern_str("user$hdeadbeef"),
+    };
+    let erase = marker(&mut interns, "rcgjs.host.erase");
+    let callback = marker(&mut interns, "rcgjs.host.callback1");
+    let bytes = marker(&mut interns, "rcgjs.host.u8arrayfrombytes");
+    let calls = [
+        // A collection stores its values in a host Map the host can be handed.
+        (
+            call(user.clone(), Some(HostPayload::Map { marker: set }), &[]),
+            HostCall::Full,
+        ),
+        // A seal in `mires-js` is not the linker's to rely on: any type can carry the section.
+        (
+            call(user.clone(), Some(erase), &[REF_SLICE_ENTRY]),
+            HostCall::Full,
+        ),
+        (call(user.clone(), Some(callback), &[]), HostCall::Closure),
+        (call(user.clone(), Some(bytes), &[]), HostCall::ByteCopy(0)),
+        // A C-ABI foreign function is `__rt.<symbol>`: the shim's own member, or host code.
+        (call(shim_member, None, &[]), HostCall::Internal),
+        (call(host_symbol, None, &[]), HostCall::Full),
+        (call(user, None, &[]), HostCall::Internal),
+    ];
+    for (call, expected) in &calls {
+        assert_eq!(classify(call, &interns, &runtime), *expected, "{call:?}");
+    }
+}
