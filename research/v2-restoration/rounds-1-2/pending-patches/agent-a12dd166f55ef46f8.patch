+#[test]
+fn an_export_exposes_its_result_and_what_it_may_write_not_what_it_only_reads() {
+    let interns = world();
+    let blocker = Footprint::of_value(&interns.types, &interns, SLICE_ENTRY);
+    let rows = Footprint::of_value(&interns.types, &interns, SLICE_STR);
+    // A shared parameter is read only: the panic handler's `&PanicInfo` shape.
+    assert!(!host(&interns, &[], &[REF_SLICE_ENTRY]).reaches(&blocker));
+    // A `&mut` parameter is written: the body may store a pooled pointer into it.
+    assert!(host(&interns, &[], &[MUT_REF_SLICE_STR]).reaches(&rows));
+    // The result is handed over whole.
+    assert!(host(&interns, &[REF_SLICE_ENTRY], &[]).reaches(&blocker));
