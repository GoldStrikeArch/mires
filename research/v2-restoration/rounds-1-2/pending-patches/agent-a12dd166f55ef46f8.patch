+//! Cleanup-edge removal, through classification and through Node.
+//!
+//! The emission harness mirrors `lower/js/tests/invoke.rs::check_emission` (every cell of the
+//! structure x optimizer x rename x style matrix), which is private to the emitter's test module:
+//! each case prints the original and the rewritten body in every cell and runs them all in one
+//! Node process against the same host stubs, so "equal to baseline" is checked cell by cell.
+
+use std::collections::BTreeMap;
+
+use std::io::Write as _;
+use std::process::{Command, Stdio};
+
+use rcgjs_object::jir::summary::{Availability, ItemClass, ItemSummary, SemanticKey};
+use rcgjs_object::object::{BlobRef, ItemKind, Linkage};
+
+use super::*;
+use crate::analysis::{callgraph, effects};
+use crate::descriptor::{Descriptor, Shape};
+use crate::jir::interns::Interns;
+use crate::jir::origin::OriginId;
+use crate::jir::repr::{FuncBuilder, RAssertMessage, Root};
+use crate::jir::semantic::{
+    AbiSignature, Body, BodyKind, BodySemantic, CallSemantic, Callee, ConstTree, DefinitionId,
+    DropGlue, HostPayload, ItemId, Signature,
+};
+use crate::jir::types::{
+    IntFacts, IntRepr, JsFacts, LayoutFacts, TypeDescriptor, TypeId, TypeKind, TypeMeta,
+};
+use crate::jsast;
+use crate::opts::Opts;
+
+const RUNTIME: &str = include_str!("../../../../runtime/shim.js");
+const O: OriginId = OriginId(0);
+const UNIT: TypeId = TypeId(1);
+const BOOL: TypeId = TypeId(2);
+const I32: TypeId = TypeId(3);
+const PANIC: &str = "core$panicking$panic_bounds_check$h0123456789abcdef";
+
+fn descriptor(id: TypeId, kind: TypeKind, size: u64) -> TypeDescriptor {
+    TypeDescriptor {
+        id,
+        name: None,
+        kind,
+        layout: LayoutFacts {
+            size: Some(size),
+            unsized_prefix: None,
+            align: Some(size.clamp(1, 4)),
+            sized: true,
+            zst: size == 0,
+            one_zst: size == 0,
+            needs_drop: false,
+            has_own_drop: false,
+        },
+        meta: TypeMeta::default(),
+        js: JsFacts {
+            int: None,
+            is_indirect: size == 0,
+            needs_clone: false,
+            crosses_transparent_union: false,
+            transparent: None,
+            peeled: id,
+            unsized_tail: None,
+            enum_repr: None,
+            is_primitive_enum: false,
+            pointer_form: None,
+            byte_element: false,
+            fields: Vec::new(),
+        },
+    }
+}
