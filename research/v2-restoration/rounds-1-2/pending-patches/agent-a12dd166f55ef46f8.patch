+    /// A registry operation whose contract says it can throw.
+    Registry,
+    /// A call through a function pointer.
+    Indirect,
+    /// A call through a vtable.
+    Virtual,
+    /// Drop glue through a vtable.
+    DynamicDrop,
+    /// A foreign symbol, a runtime member, or an intrinsic named as a callee.
+    Foreign,
+    /// A direct callee or drop glue whose name the interns cannot spell.
