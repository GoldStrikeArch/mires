+#[test]
+fn sharing_a_field_type_with_what_the_host_holds_is_not_exposure() {
+    let interns = world();
+    // The host holds a table of `(&str, &[&str])` rows: it can write any field of any row, and
+    // reach any container of rows through the slice record, but the fields are places of *those*
+    // rows. A struct of `u32`s and a table of numbers are no part of it.
+    let rows = host(&interns, &[REF_SLICE_ENTRY], &[]);
+    assert!(rows.reaches(&Footprint::of_value(&interns.types, &interns, SLICE_ENTRY)));
+    assert!(!rows.reaches(&Footprint::of_value(&interns.types, &interns, POINT)));
+    assert!(!rows.reaches(&Footprint::of_value(&interns.types, &interns, SLICE_U32)));
+    // Holding a `Point` object exposes points, not every container of a `u32`.
+    let point = host(&interns, &[REF_POINT], &[]);
+    assert!(point.reaches(&Footprint::of_value(&interns.types, &interns, POINT)));
+    assert!(!point.reaches(&Footprint::of_value(&interns.types, &interns, SLICE_U32)));
+}
