+#[test]
+fn the_host_reaches_what_it_is_handed_and_the_containers_of_its_slots() {
+    let interns = world();
+    let blocker = Footprint::of_value(&interns.types, &interns, SLICE_ENTRY);
+    let numbers = Footprint::of_value(&interns.types, &interns, SLICE_U32);
+    let point = Footprint::of_value(&interns.types, &interns, POINT);
+
+    // A host that only ever sees numbers and strings reaches no table.
+    let primitives = host(&interns, &[U32, STR_REF], &[]);
+    assert!(!primitives.reaches(&blocker));
+    assert!(!primitives.reaches(&point));
+
+    // A host handed `&[&str]` holds a backing array of string slots: every table of rows that
+    // holds `&[&str]` is out, and an unrelated table of numbers is not.
+    let selectors = host(&interns, &[REF_SLICE_STR], &[]);
+    assert!(selectors.reaches(&blocker));
+    assert!(!selectors.reaches(&numbers));
+
+    // A slot is a container plus a key: a host handed `&u32` may hold any container of a `u32`
+    // place, a struct's object included.
+    let slot = host(&interns, &[REF_U32], &[]);
+    assert!(slot.reaches(&point));
+    assert!(slot.reaches(&numbers));
+    assert!(!slot.reaches(&blocker));
+
+    // An erased raw pointer can view any buffer: nothing is bounded.
+    let erased = host(&interns, &[RAW_U8], &[]);
+    assert!(erased.unbounded.is_some());
+    assert!(erased.reaches(&numbers));
+}
