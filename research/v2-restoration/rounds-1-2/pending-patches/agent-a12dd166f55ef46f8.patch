+pub struct PoolCandidate {
+    /// [`pool_name`] of `ty` and `text`.
+    pub name: String,
+    /// The type of the pooled JavaScript value: the slice type for a slice's backing array, the
+    /// pointee for a reference to an aggregate.
+    pub ty: TypeId,
+    /// `value`, printed compact: the identity of the binding together with `ty`.
+    pub text: String,
+    /// What the binding is initialized to.
+    pub value: Expr,
+}
+
+/// The shape of an eligible node (see [`poolable`]).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum PoolShape<'t> {
+    /// `&[T]`: the backing array of `elements` is pooled; the `{ buf, off, len }` record each use
+    /// builds around it is the pointer, and stays per use.
+    Slice {
+        elements: &'t [ConstTree],
+        slice: TypeId,
+        element: TypeId,
+    },
+    /// `&T` for an aggregate `T`: the reference *is* the aggregate's object, so the object is
+    /// pooled.
+    Object {
+        inner: &'t ConstTree,
+        pointee: TypeId,
+    },
+}
+
+impl PoolShape<'_> {
+    /// The type of the value the binding holds.
+    pub fn pooled_ty(&self) -> TypeId {
+        match self {
+            PoolShape::Slice { slice, .. } => *slice,
+            PoolShape::Object { pointee, .. } => *pointee,
+        }
+    }
