+/// The `may_throw` bit, re-derived: whether any operation of `func` may raise a JavaScript
+/// exception other than a registered abort. Written apart from the publisher's per-op causes: one
+/// boolean per op, published summaries at call sites, an absent summary throwing.
+fn throws(
+    func: &Func,
+    interns: Option<&Interns>,
+    summaries: &Summaries,
+    deps: Option<&[String]>,
+    trust_host_contract: bool,
+) -> bool {
+    let spelled = |id: StrId| {
+        interns
+            .and_then(|interns| interns.str(id))
+            .map(|name| JsName::new(name.to_owned()))
+    };
+    let body_throws = |name: Option<JsName>| {
+        name.and_then(|name| summaries.get(&name))
+            .is_none_or(|summary| summary.may_throw)
+    };
+    let op_throws = |kind: &OpKind| -> bool {
+        match kind {
+            OpKind::Zombie(_) | OpKind::Host { .. } => true,
+            // Aborts, hints and compile-time queries: nothing but a registered abort, nothing at
+            // all, the operand, or a literal.
+            OpKind::Intrinsic { name, .. } => !matches!(
+                interns.and_then(|interns| interns.str(*name)),
+                Some(
+                    "abort"
+                        | "unreachable"
+                        | "assume"
+                        | "cold_path"
+                        | "likely"
+                        | "unlikely"
+                        | "black_box"
+                        | "forget"
+                        | "breakpoint"
+                        | "prefetch_read_data"
+                        | "prefetch_write_data"
+                        | "prefetch_read_instruction"
+                        | "prefetch_write_instruction"
+                        | "is_val_statically_known"
+                        | "ub_checks"
+                        | "contract_checks"
+                        | "overflow_checks"
+                )
+            ),
+            OpKind::Drop { glue, .. } => match glue {
+                DropGlue::None => false,
+                DropGlue::Direct { link_name, .. } => body_throws(spelled(*link_name)),
+                DropGlue::Dynamic => true,
+            },
+            OpKind::Assert { msg, .. } => {
+                let Some(lang_fn) = crate::analysis::effects::panic_lang_fn(msg) else {
+                    return false;
+                };
+                let suffix = format!("${lang_fn}");
+                let found: Vec<&String> = deps
+                    .unwrap_or_default()
+                    .iter()
+                    .filter(|dep| match dep.rsplit_once("$h") {
+                        Some((stem, hash)) => {
+                            hash.len() == 16
+                                && hash.chars().all(|c| c.is_ascii_hexdigit())
+                                && (stem == lang_fn || stem.ends_with(&suffix))
+                        }
+                        None => false,
+                    })
+                    .collect();
+                match found.as_slice() {
+                    [name] => body_throws(Some(JsName::new((*name).clone()))),
+                    _ => true,
+                }
+            }
+            OpKind::Call {
+                callee,
+                semantic,
+                host,
+                ..
+            } => {
+                // A host marker, by payload or by link name: only the value-only operations are
+                // quiet (literals, strict comparisons, `typeof`, `!!`, `Number.isInteger`, erase).
+                let marker = match (host, callee) {
+                    (Some(HostPayload::Marker { section, .. }), _) => {
+                        interns.and_then(|interns| interns.str(*section))
+                    }
+                    (None, Callee::Direct { link_name, .. }) => interns
+                        .and_then(|interns| interns.str(*link_name))
+                        .filter(|name| {
+                            ["rcgjs.host.", "rcgjs.tc.", "rcgjs.map."]
+                                .iter()
+                                .any(|prefix| name.starts_with(prefix))
+                        }),
+                    _ => None,
+                };
+                if let Some(marker) = marker {
+                    return !matches!(
+                        marker.strip_prefix("rcgjs.host."),
+                        Some(
+                            "undefined"
+                                | "null"
+                                | "isundefined"
+                                | "isnull"
+                                | "truthy"
+                                | "stricteq"
+                                | "isboolean"
+                                | "isnumber"
+                                | "isbigint"
+                                | "isstring"
+                                | "isfunction"
+                                | "isobject"
+                                | "isinteger"
+                                | "erase"
