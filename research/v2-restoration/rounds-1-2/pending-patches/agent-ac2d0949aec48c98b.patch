index 0000000000000000000000000000000000000000..d054916099c7572f9be154207405cced125253bc
--- /dev/null
+++ b/examples/core-tests/250_track_caller_chains.rs
@@ -0,0 +1,92 @@
+//! `#[track_caller]` functions calling `#[track_caller]` functions, two, three and four deep.
+//!
+//! Every level reads `Location::caller()` and prints its file, line and column: a chain of
+//! tracked calls hands the *outermost* caller's location down, so every level of one chain prints
+//! the same location, the line of the call in `rust_entry`. An untracked function in the middle
+//! cuts the chain, and the levels below it see that function's own call site instead.
+//!
+//! Every level is also taken as a `fn` pointer (`pointers`), so the program carries rustc's
+//! `ReifyShim` of each one next to the function itself. The shim shares the function's definition
+//! and type but takes no caller location, and the link step once gave the two one identity: the
+//! function's entry in the item index could be the shim's, and a tracked caller then forwarded no
+//! location to it (`TypeError` reading `line` of `undefined` on the JIR lane, in every release
+//! profile, for whichever levels the hash order made collide).
+
+#![no_std]
+#![no_main]
+
+#[path = "prelude.rs"]
+mod prelude;
+use prelude::*;
+
+use core::hint::black_box;
+use core::panic::Location;
+
+fn show(l: &Location<'static>) -> u32 {
+    print_str(l.file());
+    print_u32(l.line());
+    print_u32(l.column());
+    l.line()
+}
+
+#[track_caller]
+fn d1() -> u32 {
+    show(Location::caller())
+}
+#[track_caller]
+fn d2() -> u32 {
+    show(Location::caller());
+    d1()
+}
+#[track_caller]
+fn d3() -> u32 {
+    let a = show(Location::caller());
+    a + d2()
+}
+#[track_caller]
+fn d4() -> u32 {
+    let a = show(Location::caller());
+    a + d3()
+}
+// Recursion keeps forwarding the same location.
+#[track_caller]
+fn d4r(x: u32) -> u32 {
+    let a = show(Location::caller());
+    if black_box(x) > 1 { a + d4r(x - 1) } else { a + d3() }
+}
+fn untracked_mid() -> u32 {
+    d2()
+}
+#[track_caller]
+fn tracked_over_untracked() -> u32 {
+    show(Location::caller());
+    untracked_mid()
+}
+// The location is the trailing argument after every other one, a tuple and a `&str` included.
+#[track_caller]
+fn tracked_args(a: u32, b: &str, c: (u8, u16)) -> u32 {
+    show(Location::caller());
+    a + b.len() as u32 + c.0 as u32 + c.1 as u32 + d1()
+}
+
+fn pointers() -> u32 {
+    let ps: [fn() -> u32; 4] = [d1, d2, d3, d4];
+    let mut s = 0;
+    for p in ps.iter() {
+        s += p();
+    }
+    s
+}
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    print_u32(d1());
+    print_u32(d2());
+    print_u32(d3());
+    print_u32(d4());
+    print_u32(d4r(3));
+    print_u32(untracked_mid());
+    print_u32(tracked_over_untracked());
+    print_u32(tracked_args(black_box(1), "xy", (3, 4)));
+    print_u32(pointers());
+}
