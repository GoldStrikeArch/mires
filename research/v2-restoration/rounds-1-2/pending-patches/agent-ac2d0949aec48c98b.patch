+
+    let mut interns = world();
+    for (ty, definition) in [(COLLECTION_CLOSURE, def(40)), (ROW_CLOSURE, def(42))] {
+        interns.intern_type(descriptor(
+            ty,
+            TypeKind::Closure {
+                def: definition,
+                upvars: Vec::new(),
+                fn_pointer_shim: None,
+            },
+            0,
+        ));
+    }
+    let marker_name = interns.intern_str("keyed_list_v1$h90");
+    let collection_name = interns.intern_str("collection$h40");
+    let row_name = interns.intern_str("row$h42");
+    let shim_name = interns.intern_str("key$h5e");
+    // The function `key` is its definition and type; its shim shares the definition only.
+    let function = item(43);
+    let shim = ItemId {
+        definition: def(43),
+        instantiation: 0x5e,
+    };
+    interns.intern_type(descriptor(
+        KEY_FN,
+        TypeKind::FnDef {
+            def: def(43),
+            sig: rcgjs_object::jir::interns::SigId(0),
+            instance: Some(DirectItemRef {
+                item: shim,
+                link_name: shim_name,
+            }),
+        },
+        0,
+    ));
+    let callable = |ty, item, link_name| KeyedListCallable {
+        ty,
+        body: Some(DirectItemRef { item, link_name }),
+        cleanup: DropGlue::None,
+        source: None,
+    };
+    let payload = KeyedListPayload {
+        format: KEYED_LIST_FORMAT_V1,
+        site: None,
+        def: def(90),
+        collection_ty: ARRAY,
+        item_ty: I32,
+        key_ty: I32,
+        row_ty: POINT,
+        collection: callable(COLLECTION_CLOSURE, item(40), collection_name),
+        key: callable(KEY_FN, shim, shim_name),
+        row: callable(ROW_CLOSURE, item(42), row_name),
+    };
+
+    let entry = FuncBuilder::ENTRY;
+    let mut builder = FuncBuilder::new(
+        item(1),
+        signature(vec![COLLECTION_CLOSURE, KEY_FN, ROW_CLOSURE], POINT),
+    );
+    let collection = builder.param(COLLECTION_CLOSURE, NO_ORIGIN);
+    let key = builder.param(KEY_FN, NO_ORIGIN);
+    let row = builder.param(ROW_CLOSURE, NO_ORIGIN);
+    let result = builder.op(
+        entry,
+        OpKind::Call {
+            callee: Callee::Direct {
+                item: item(90),
+                link_name: marker_name,
+            },
+            function: None,
+            args: vec![collection, key, row],
+            track_caller: None,
+            semantic: CallSemantic::ViewAbi,
+            host: Some(HostPayload::KeyedList(Box::new(payload))),
+        },
+        POINT,
+        NO_ORIGIN,
+    );
+    builder.terminate(entry, RTerm::Return(Some(result)));
+    let func = builder.finish();
+    let plan = plan_of(&func, &[(0, "collection"), (1, "key"), (2, "row")]);
+    let body = body_of(BodyKind::Function, func.sig.clone());
+    let opts = Opts::default();
+    let item_summary = summary(&[]);
+    let entry_of = |name: &str,
+                    params: usize,
+                    result: TypeId,
+                    caller_location: bool,
+                    purity: super::host::KeyedPurity,
+                    reads: BTreeSet<u16>,
+                    may_unwind: bool| super::host::ItemEntry {
+        abi_known: true,
+        name: name.to_owned(),
+        params,
+        result: Some(result),
+        caller_location,
+        used_params: BTreeSet::new(),
+        standard: None,
+        keyed_purity: Some(purity),
+        keyed_read_params: Some(reads),
+        keyed_may_unwind: Some(may_unwind),
+        keyed_row_capture: Some(super::host::KeyedRowCapture::Static),
+        keyed_proxy_safe_params: Some(BTreeSet::new()),
+    };
+    let mut items = super::host::ItemIndex::new();
+    items.insert(
+        item(40),
+        entry_of(
+            "collection$h40",
+            1,
+            ARRAY,
+            false,
+            super::host::KeyedPurity::Const,
+            BTreeSet::new(),
+            false,
+        ),
+    );
+    items.insert(
+        item(42),
+        entry_of(
+            "row$h42",
+            3,
+            POINT,
+            false,
+            super::host::KeyedPurity::Const,
+            BTreeSet::new(),
+            false,
+        ),
+    );
+    // What the effects summary says of the shim: a call it cannot see through.
+    items.insert(
+        shim,
+        entry_of(
+            "key$h5e",
+            1,
+            I32,
+            false,
+            super::host::KeyedPurity::Effect,
+            BTreeSet::new(),
+            true,
+        ),
+    );
+    // The tracked function reads its row (parameter 0) and nothing else; `$loc` is parameter 1.
+    items.insert(
+        function,
+        entry_of(
+            "key$h43",
+            2,
+            I32,
+            true,
+            super::host::KeyedPurity::Read,
+            BTreeSet::from([0]),
+            false,
+        ),
+    );
+    let lower = |items: &super::host::ItemIndex| {
+        let input = LowerInput {
+            name: &JsName::new("f".to_owned()),
+            summary: &item_summary,
+            body: &body,
+            origins: None,
+            interns: &interns,
+            table: &interns.types,
+            opts: &opts,
+            items,
+            drop_glue: super::host::EMPTY_DROP_GLUE,
+            vtables: &super::unsize::EMPTY_VTABLES,
+            spills: &[],
+            abi: None,
+            physical: None,
+            call_retargets: crate::lower::EMPTY_CALL_RETARGETS,
+        };
+        function::lower(&input, &func, &plan, straight(&func))
+            .map(|lowered| jsast::stmt_to_string(&lowered.decl))
+            .map_err(|decline| decline.to_string())
+    };
+    let js = lower(&items).expect("a tracked key that reads only its row lowers");
+    assert!(
+        js.contains("($a0) => key$h5e($a0)"),
+        "the runtime calls the shim, as a pointer call would: {js}"
+    );
+    assert!(!js.contains("key$h43"), "never the function itself: {js}");
+
+    // A key that reads its location reads more than its row.
+    items.get_mut(&function).unwrap().keyed_read_params = Some(BTreeSet::from([0, 1]));
+    assert!(lower(&items)
+        .expect_err("a key reading its location declines")
+        .contains("keyed.key-extractor-reads-state"));
+
+    // The function's summary answers only for a shim around a function that takes a location: an
+    // untracked function under the same definition says nothing about this body.
+    items.get_mut(&function).unwrap().keyed_read_params = Some(BTreeSet::from([0]));
+    items.get_mut(&function).unwrap().caller_location = false;
+    items.get_mut(&function).unwrap().params = 1;
+    assert!(lower(&items)
+        .expect_err("the shim's own summary decides")
+        .contains("keyed.key-extractor-effectful"));
+}
