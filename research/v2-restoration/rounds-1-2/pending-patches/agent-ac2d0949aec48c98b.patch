+//! An out-of-bounds index inside a chain of `#[track_caller]` functions.
+//!
+//! A bounds check is an `Assert` that calls the `#[track_caller]` `panic_bounds_check` lang item,
+//! and inside a tracked function it passes that function's own caller location: the panic reports
+//! the call that entered the chain, here the call in `rust_entry`, not the indexing expression.
+
+#![no_std]
+#![no_main]
+
+#[path = "prelude.rs"]
+mod prelude;
+use prelude::*;
+
+use core::hint::black_box;
+
+#[track_caller]
+fn at(v: &[u32], i: usize) -> u32 {
+    v[i]
+}
+#[track_caller]
+fn at2(v: &[u32], i: usize) -> u32 {
+    at(v, i) * 2
+}
+#[track_caller]
+fn at3(v: &[u32], i: usize) -> u32 {
+    at2(v, i) + 1
+}
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    let v = [5u32, 6, 7];
+    // Taking a pointer puts each level's `ReifyShim` into the program beside the function.
+    let fs: [fn(&[u32], usize) -> u32; 3] = [at, at2, at3];
+    for f in fs.iter() {
+        print_u32(f(&v, black_box(1)));
+    }
+    print_u32(at3(&v, black_box(2)));
+    // Not reached past this.
+    print_u32(at3(&v, black_box(3)));
+    print_u32(999);
+}
