new file mode 100644
index 0000000000000000000000000000000000000000..056f74d3db8c8951fd01d083901aa5e2f1e96c29
--- /dev/null
+++ b/examples/core-tests/255_track_caller_host_callbacks.rs
@@ -0,0 +1,84 @@
+//! `#[track_caller]` function items handed to the host as callbacks, and called by it.
+//!
+//! The host calls a callback with its arguments alone, as a `fn` pointer is called, so a tracked
+//! function item is the function a pointer to it names: rustc's `ReifyShim`, which supplies the
+//! location of the function's own definition. Each callback below reports that line, the same line
+//! the pointer call `p()` reports.
+//!
+//! Before, both lanes called the function itself and passed no location, so reading it threw
+//! (`Cannot read properties of undefined (reading 'line')`); a JIR-lane lookup of the shim by the
+//! function's identity then found the function instead. Every value here is printed by the host's
+//! `console.log`, so the output is the callbacks' own results.
+
+#![no_std]
+#![no_main]
+#![deny(unsafe_code)]
+
+use core::panic::Location;
+use mires_js::{callback0, callback1, invoke, js_bindings, js_export, try_host, JsValue};
+
+#[panic_handler]
+fn panic(_: &core::panic::PanicInfo) -> ! {
+    loop {}
+}
+
+js_bindings! {
+    #[js(call = "console.log")]
+    fn log(label: &str, value: JsValue);
+}
+
+// Handed to the host and never coerced to a pointer: the program has no shim but the one the
+// callback asks for.
+#[track_caller]
+fn tracked_reads() -> JsValue {
+    JsValue::erase(Location::caller().line())
+}
+
+// Handed to the host and also taken as a pointer elsewhere.
+#[track_caller]
+fn tracked_reified() -> JsValue {
+    JsValue::erase(Location::caller().line())
+}
+
+#[track_caller]
+fn tracked_column(value: JsValue) -> JsValue {
+    JsValue::erase(value.read::<u32>() * 1000 + Location::caller().column())
+}
+
+#[track_caller]
+fn tracked_quiet(value: JsValue) -> JsValue {
+    value
+}
+
+trait Source {
+    #[track_caller]
+    fn at() -> JsValue;
+}
+struct S;
+impl Source for S {
+    fn at() -> JsValue {
+        JsValue::erase(Location::caller().line())
+    }
+}
+
+fn plain() -> JsValue {
+    JsValue::erase(7u32)
+}
+
+#[js_export]
+pub fn rust_entry() {
+    let none = JsValue::undefined();
+    log("reads", invoke(callback0(tracked_reads), none, &[]));
+    log("reified", invoke(callback0(tracked_reified), none, &[]));
+    let p: fn() -> JsValue = tracked_reified;
+    log("pointer", p());
+    let five = JsValue::erase(5u32);
+    log("column", invoke(callback1(tracked_column), none, &[five]));
+    log("quiet", invoke(callback1(tracked_quiet), none, &[five]));
+    log("trait", invoke(callback0(<S as Source>::at), none, &[]));
+    match try_host(tracked_reads) {
+        Ok(value) => log("try", value),
+        Err(error) => log("try-error", error),
+    }
+    log("plain", invoke(callback0(plain), none, &[]));
+}
