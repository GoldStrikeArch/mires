+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    owned();
+    borrowed();
+    closures();
+    vectors();
+    empties();
+    partial();
+    replaced();
+    many();
+    print_u32(zst_host_throw(false));
+}
