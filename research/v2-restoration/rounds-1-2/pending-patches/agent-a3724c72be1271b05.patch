+/// A register-sized enum constant names its variant by the layout's rules (`jir::niche`), the same
+/// rules the link-time printer and dead-code elimination use: under a niche, `bits - niche_start`
+/// counts from the first niche variant, not from discriminant 0, so the bit pattern 2 below is `A`
+/// although `B`'s discriminant is 2. A fieldless variant is evaluated; a variant whose payload the
+/// bits are is not modelled and is unsupported rather than a variant without its payload, and so is
+/// every constant of a single-variant layout, whose bits are always the laid-out variant's payload.
+#[test]
+fn scalar_constants_name_variants_by_the_layout_rules() {
+    let mut interns = world();
+    let live = interns.intern_str("Live");
+    let dead = interns.intern_str("Dead");
+    let a = interns.intern_str("A");
+    let b = interns.intern_str("B");
+    let field_0 = interns.intern_str("_0");
+    const NICHED: TypeId = TypeId(900);
+    const SINGLE: TypeId = TypeId(901);
+    const NEVER: TypeId = TypeId(902);
+    let def = |n| DefinitionId {
+        crate_id: 1,
+        local_hash: n,
+    };
+    interns.intern_type(descriptor(NEVER, TypeKind::Never, 0));
+    interns.intern_type(descriptor(
+        NICHED,
+        TypeKind::Adt {
+            def: def(900),
+            args: Vec::new(),
+            form: NominalForm::Enum,
+            variants: vec![
+                variant(live, vec![(FieldKey::Name(field_0), BOOL)], 0),
+                variant(a, Vec::new(), 1),
+                variant(b, Vec::new(), 2),
+            ],
+            niche: Some(Niche {
+                untagged_variant: 0,
+                niche_field: vec![0],
+                niche_start: 2,
+                valid_range: (0, 1),
+            }),
+        },
+        1,
+    ));
+    interns.intern_type(descriptor(
+        SINGLE,
+        TypeKind::Adt {
+            def: def(901),
+            args: Vec::new(),
+            form: NominalForm::Enum,
+            variants: vec![
+                variant(dead, vec![(FieldKey::Index(0), NEVER)], 0),
+                variant(live, vec![(FieldKey::Name(field_0), BOOL)], 1),
+            ],
+            niche: None,
+        },
+        1,
+    ));
+    let variant_of = |bits, ty| match eval::scalar(bits, ty, &interns.types) {
+        Ok(Value::Aggregate { variant, .. }) => Ok(variant),
+        Ok(other) => panic!("{other:?}"),
+        Err(trap) => Err(trap),
+    };
+    assert_eq!(variant_of(2, NICHED), Ok(1), "the first niche value is `A`");
+    assert_eq!(variant_of(3, NICHED), Ok(2), "the second is `B`");
+    for (bits, ty) in [(1, NICHED), (0, NICHED), (1, SINGLE), (0, SINGLE)] {
+        assert!(
+            matches!(variant_of(bits, ty), Err(Trap::Unsupported(_))),
+            "{bits} at {ty:?} is a payload"
+        );
+    }
+    // The control: a `Number` enum is still its discriminant.
+    assert!(eval::scalar(1, ORDERING, &interns.types).is_ok());
+}
