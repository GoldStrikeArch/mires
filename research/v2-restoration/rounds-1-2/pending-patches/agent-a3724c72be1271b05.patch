+                // An aggregate static's one slot, `__rt.box(S)`: the buffer the run-time
+                // `slice::from_ref(&S)` and a raw pointer constant to `S` use, so that identity
+                // and whole-element stores agree with them.
+                _ if static_ty == element && is_indirect(tcx, element) => (
+                    crate::ptr::slot_buf(jsast::rt_call("box", vec![binding])),
+                    Some(1),
+                ),
+                _ if static_ty == element => (binding, Some(1)),
+                _ => return refuse(&format!("of type `{static_ty}`")),
+            };
+            let stride = layout.size.bytes();
+            let start = match stride {
+                0 if offset == Size::ZERO => 0,
+                0 => return refuse("past a zero-sized element"),
+                _ if !offset.bytes().is_multiple_of(stride) => {
+                    return refuse("between two elements")
+                }
+                _ => offset.bytes() / stride,
+            };
+            match count {
+                Some(count) if start.saturating_add(length) <= count => {
+                    crate::ptr::fat_slice(buf, jsast::num(start as f64), jsast::num(length as f64))
+                }
+                _ => refuse("running past the end of it"),
+            }
