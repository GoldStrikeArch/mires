+/// The closure type whose reification as a `fn` pointer `instance` is, when it is a closure's
+/// `FnOnce` instance (`Instance::resolve_closure(.., FnOnce)`): the closure's own body, or the
+/// `call_once` shim of a `Fn`/`FnMut` closure, whose first type argument is the closure. Both take
+/// the environment first. That closure type's `fn_pointer_shim` in the JIR type table names this
+/// same instance, which is how the link-time lowering recognizes the target.
+pub(crate) fn reified_closure_type<'tcx>(
+    tcx: rustc_middle::ty::TyCtxt<'tcx>,
+    instance: Instance<'tcx>,
+) -> Option<Ty<'tcx>> {
+    match instance.def {
+        ty::InstanceKind::Shim(ty::ShimKind::ClosureOnce { .. }) => {
+            Some(instance.args.type_at(0)).filter(|ty| matches!(ty.kind(), ty::Closure(..)))
+        }
+        ty::InstanceKind::Item(def_id)
+            if tcx.def_kind(def_id) == rustc_hir::def::DefKind::Closure
+                && matches!(tcx.type_of(def_id).skip_binder().kind(), ty::Closure(..)) =>
+        {
+            Some(Ty::new_closure(tcx, def_id, instance.args))
+        }
+        _ => None,
+    }
+}
