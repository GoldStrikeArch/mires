+/// A slice is `{ buf, off, len }` over the static's own storage, so that it aliases the static as
+/// the pointer does. An array static is emitted as the JavaScript array of its elements, which is
+/// the buffer; a static of the element type itself is one element: a primitive one is emitted
+/// boxed, `[value]`, which is that buffer already, and an aggregate one's buffer is its one slot,
+/// `__rt.box(S).buf`, the same buffer the run-time `slice::from_ref(&S)` builds, which makes
+/// `ptr::eq` and whole-element stores through the slice agree with it. `offset` names the first
+/// element, at the element's stride.
+///
+/// A `str` is a JavaScript string, a value with no place of its own, so it is the text of the
+/// bytes the pointer names, read from the static's initializer. That is the static's value only
+/// while nothing can write it, so a `static mut` or a static with interior mutability is refused.
+///
+/// The binding is only named — except for an aggregate static's one slot, which `__rt.box` makes
+/// when the slice is initialised, as a raw pointer constant to that static already does — so the
+/// pointer depends on the order of initialisation only as a reference to the static does.
+#[allow(clippy::too_many_arguments)]
+fn static_wide_pointer<'tcx>(
+    cgu: &CguCx<'tcx>,
+    log: &ZombieLog,
+    def_id: DefId,
+    offset: Size,
+    ty: Ty<'tcx>,
+    pointee: Ty<'tcx>,
+    meta: Option<u64>,
+    span: Span,
+) -> Expr {
+    let tcx = cgu.tcx;
+    let refuse = |what: &str| {
+        zombie(
+            cgu,
+            log,
+            span,
+            format!("a `{ty}` into a `static` {what}, which rustc_codegen_js cannot name"),
+        )
+    };
+    let Some(length) = meta else {
+        return refuse("with no length");
+    };
+    let static_ty =
+        tcx.normalize_erasing_regions(typing_env(), tcx.type_of(def_id).instantiate_identity());
+    let binding = jsast::id(cgu.namer.static_name(def_id).into_string());
+    match pointee.kind() {
+        ty::Slice(element) => {
+            let element = *element;
+            let Ok(layout) = tcx.layout_of(typing_env().as_query_input(element)) else {
+                return refuse("whose element has no layout");
+            };
+            let (buf, count) = match static_ty.kind() {
+                ty::Array(array_element, count) if *array_element == element => {
+                    (binding, count.try_to_target_usize(tcx))
