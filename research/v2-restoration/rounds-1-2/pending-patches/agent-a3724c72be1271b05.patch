diff --git a/examples/core-tests/247_static_wide_pointers.rs b/examples/core-tests/247_static_wide_pointers.rs
new file mode 100644
index 0000000000000000000000000000000000000000..45fe9feb8b0ef4923d01bda805a09fcb0a9175fb
--- /dev/null
+++ b/examples/core-tests/247_static_wide_pointers.rs
@@ -0,0 +1,102 @@
+//! Wide pointers into statics: `&[T]` and `&str`, plain, inside `Option`, inside a struct and in
+//! a table.
+//!
+//! A slice is `{ buf, off, len }`, and a pointer into a static used to become the static's binding
+//! alone: `static SL: &[u32] = &ARR` had no length (`SL.len()` was `undefined`), and once
+//! `Some(&ARR)` decoded as `Some` the same slice made indexing panic. The buffer is the static's
+//! own array, so `ptr::eq` with the static holds, `ARR.split_at(1).1` starts one element in, and
+//! `slice::from_ref` of a primitive or an aggregate static is one element of it. A `&str` built
+//! from a static's bytes by `str::from_utf8` is the text of those bytes. (A `const` that names a
+//! static, `const C: &[u32] = &ARR`, is a wide pointer constant inside the body that uses it; the
+//! JIR lane cannot carry its length, so it is left out here: see CONTRACT.md.)
+
+#![no_std]
+#![no_main]
+
+#[path = "prelude.rs"]
+mod prelude;
+use prelude::*;
+
+use core::hint::black_box;
+
+static ARR: [u32; 3] = [100, 200, 300];
+static SL: &[u32] = &ARR;
+static TAIL: &[u32] = ARR.split_at(1).1;
+static OPT: Option<&[u32]> = Some(&ARR);
+static NONE: Option<&[u32]> = None;
+struct Holder {
+    name: &'static str,
+    data: &'static [u32],
+    more: Option<&'static [u32]>,
+}
+static H: Holder = Holder { name: "h", data: &ARR, more: Some(TAIL) };
+static BYTES: [u8; 5] = *b"hello";
+static TEXT: &str = match core::str::from_utf8(&BYTES) {
+    Ok(s) => s,
+    Err(_) => "bad",
+};
+static OTEXT: Option<&str> = match core::str::from_utf8(&BYTES) {
+    Ok(s) => Some(s),
+    Err(_) => None,
+};
+static ONE: u32 = 7;
+static ONE_SL: &[u32] = core::slice::from_ref(&ONE);
+#[derive(Clone, Copy)]
+struct Pt {
+    x: u32,
+    y: u32,
+}
+static PT: Pt = Pt { x: 1, y: 2 };
+static PT_SL: &[Pt] = core::slice::from_ref(&PT);
+static TABLE: [Option<&[u32]>; 3] = [Some(&ARR), None, Some(TAIL)];
+
+#[inline(never)]
+fn sum(s: &[u32]) -> u32 {
+    let mut t = 0;
+    for v in s {
+        t += *v;
+    }
+    t
+}
+#[inline(never)]
+fn show(o: Option<&[u32]>) {
+    match o {
+        Some(s) => {
+            print_usize(s.len());
+            print_u32(sum(s));
+        }
+        None => print_str("none"),
+    }
+}
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    print_usize(SL.len());
+    print_u32(black_box(SL)[1]);
+    print_u32(sum(SL));
+    print_bool(core::ptr::eq(SL.as_ptr(), ARR.as_ptr()));
+    print_usize(TAIL.len());
+    print_u32(TAIL[0]);
+    print_bool(core::ptr::eq(TAIL.as_ptr(), &ARR[1]));
+    show(OPT);
+    show(black_box(OPT));
+    show(NONE);
+    print_str(H.name);
+    print_u32(sum(black_box(&H).data));
+    show(H.more);
+    print_str(TEXT);
+    print_usize(TEXT.len());
+    match OTEXT {
+        Some(s) => print_str(s),
+        None => print_str("<none>"),
+    }
+    print_usize(ONE_SL.len());
+    print_u32(ONE_SL[0]);
+    print_bool(core::ptr::eq(&ONE_SL[0], &ONE));
+    print_usize(PT_SL.len());
+    print_u32(PT_SL[0].x + PT_SL[0].y);
+    print_bool(core::ptr::eq(&PT_SL[0], &PT));
+    for i in 0..3 {
+        show(TABLE[black_box(i)]);
+    }
+}
