diff --git a/examples/core-tests/249_dyn_constant_refused.rs b/examples/core-tests/249_dyn_constant_refused.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a19780272fe740a01e68231f2b2f48b0baeb7364
--- /dev/null
+++ b/examples/core-tests/249_dyn_constant_refused.rs
@@ -0,0 +1,62 @@
+//! A trait object in constant data is refused at compile time, plain or inside `Option`, whether
+//! its data pointer names a promoted value or a `static`.
+//!
+//! A `&dyn Trait` is `{ ptr, meta }`, and a constant one would need its vtable decoded out of
+//! constant memory, which the constant readers do not do. `Option<&dyn Trait>` holding `Some` used
+//! to slip past the refusal — its niche decoded as `None`, so the program compiled and read
+//! `None` — and a `&dyn Trait` whose data pointer named a `static` was printed as the static's
+//! object without its vtable, so a call through it threw a `TypeError` at run time. All three are
+//! now refused with one diagnostic; each uses its own trait so that each refusal shows in the
+//! output. `None` of that type has no pointer to decode and compiles (fixture 241).
+
+#![no_std]
+#![no_main]
+
+#[path = "prelude.rs"]
+mod prelude;
+use prelude::*;
+
+use core::hint::black_box;
+
+trait Speak {
+    fn n(&self) -> u32;
+}
+impl Speak for u32 {
+    fn n(&self) -> u32 {
+        *self
+    }
+}
+trait Named: Sync {
+    fn id(&self) -> u32;
+}
+trait Labeled: Sync {
+    fn label(&self) -> u32;
+}
+struct N {
+    id: u32,
+}
+impl Named for N {
+    fn id(&self) -> u32 {
+        self.id
+    }
+}
+impl Labeled for N {
+    fn label(&self) -> u32 {
+        self.id * 10
+    }
+}
+static B: N = N { id: 2 };
+
+/// A promoted target.
+static DYN: Option<&(dyn Speak + Sync)> = Some(&5u32);
+/// A `static` target, inside `Option`.
+static OD: Option<&dyn Named> = Some(&B);
+/// A `static` target, plain.
+static PD: &dyn Labeled = &B;
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    print_u32(black_box(&DYN).map_or(0, |d| d.n()));
+    print_u32(black_box(&OD).map_or(0, |d| d.id()));
+    print_u32(black_box(&PD).label());
+}
