+                return refuse("that can be written");
+            }
+            match tcx.eval_static_initializer(def_id) {
+                Ok(alloc) => str_expr(cgu, log, alloc.inner(), offset, Some(length), span),
+                Err(_) => refuse("whose initializer could not be evaluated"),
+            }
+        }
+        _ => refuse("of this kind"),
+    }
+}
