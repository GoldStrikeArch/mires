new file mode 100644
index 0000000000000000000000000000000000000000..5f6c935d782750a25986ec2e2d1c0c4a20d8b4c6
--- /dev/null
+++ b/examples/core-tests/291_static_one_element_slices.rs
@@ -0,0 +1,125 @@
+//! A slice constant of one element over an aggregate `static` aliases the static as the same
+//! slice built at run time does.
+//!
+//! `slice::from_ref(&S)` and `slice::from_mut(&mut S)` in a static initializer make a one-element
+//! slice whose buffer must be the static's own one slot, `__rt.box(S).buf`, which is what the
+//! run-time `from_ref` and a raw pointer constant to `S` name. It used to be a fresh array holding
+//! the static's object: `ptr::eq(ONE.as_ptr(), &S)` was false, a whole-element store through the
+//! slice never reached `S`, and a later store to `S` was not seen through the slice. The modules are
+//! the A4 round-2 verifier's probes: `from_ref` of an aggregate and of a primitive static (with the
+//! run-time slices as controls), a `static mut` slice written whole in both directions, and its
+//! neighbours (a raw `*mut [T]`, `Option<&mut [(u32, u8)]>`, a slice of `Option<u64>`, `fill`,
+//! `copy_from_slice`, `iter_mut`, and the array static as the control).
+
+#![no_std]
+#![no_main]
+#![allow(static_mut_refs)]
+
+#[path = "prelude.rs"]
+mod prelude;
+
+mod from_ref {
+    use super::prelude::*;
+    use core::hint::black_box;
+    struct N { id: u32 }
+    static B: N = N { id: 2 };
+    static ONE: &[N] = core::slice::from_ref(&B);
+    static P: u32 = 7;
+    static ONEP: &[u32] = core::slice::from_ref(&P);
+    pub fn run() {
+        print_u32(ONE.len() as u32);
+        print_u32(ONE[0].id);
+        print_bool(core::ptr::eq(&ONE[0], &B));
+        print_bool(core::ptr::eq(ONE.as_ptr(), &B));
+        print_u32(ONEP.len() as u32);
+        print_u32(ONEP[0]);
+        print_bool(core::ptr::eq(&ONEP[0], &P));
+        print_bool(core::ptr::eq(ONEP.as_ptr(), &P));
+        // The same slices built at run time.
+        let s = core::slice::from_ref(black_box(&B));
+        print_bool(core::ptr::eq(s.as_ptr(), &B));
+        let t = core::slice::from_ref(black_box(&P));
+        print_bool(core::ptr::eq(t.as_ptr(), &P));
+    }
+}
+
+mod static_mut {
+    use super::prelude::*;
+    // A constant `&mut [T]` over ONE aggregate `static mut` (what `slice::from_mut` makes of it).
+    // The round-2 emission is `{ buf: [ONE], off: 0, len: 1 }`: a fresh JavaScript array holding the
+    // static's object, so storing a whole element through the slice replaces the array's slot and
+    // never reaches the static. Native: 15 20. Round 2: 3 7 (silently). Main: aborts at run time
+    // (the slice had no length, so the bounds check panics).
+    #[derive(Clone, Copy)]
+    struct Pt { x: u32, y: u32 }
+    static mut ONE: Pt = Pt { x: 1, y: 2 };
+    static mut ONE_SL: &mut [Pt] = unsafe { core::slice::from_mut(&mut *(&raw mut ONE)) };
+
+    pub fn run() {
+        unsafe {
+            (*(&raw mut ONE_SL))[0] = Pt { x: 7, y: 8 };
+            print_u32(ONE.x + ONE.y);
+            ONE = Pt { x: 20, y: 30 };
+            print_u32((*(&raw const ONE_SL))[0].x);
+        }
+    }
+}
+
+mod variants {
+    use super::prelude::*;
+    use core::hint::black_box;
+
+    // Neighbours of fail_r2_1: the same one-element constant slice over an aggregate `static mut`,
+    // through a raw wide pointer, inside Option, a tuple element type, an enum element type, with
+    // `swap`/`copy_from_slice`/`fill`/`iter_mut`, and the array control (which is right).
+    #[derive(Clone, Copy)]
+    struct Pt { x: u32, y: u32 }
+    static mut A: Pt = Pt { x: 1, y: 2 };
+    struct Raw(*mut [Pt]);
+    unsafe impl Sync for Raw {}
+    static A_RAW: Raw = Raw(unsafe { core::slice::from_mut(&mut *(&raw mut A)) } as *mut [Pt]);
+
+    static mut B: (u32, u8) = (1, 2);
+    static mut B_SL: Option<&mut [(u32, u8)]> = Some(unsafe { core::slice::from_mut(&mut *(&raw mut B)) });
+
+    static mut C: Option<u64> = Some(5);
+    static mut C_SL: &mut [Option<u64>] = unsafe { core::slice::from_mut(&mut *(&raw mut C)) };
+
+    static mut D: Pt = Pt { x: 1, y: 2 };
+    static mut D_SL: &mut [Pt] = unsafe { core::slice::from_mut(&mut *(&raw mut D)) };
+
+    static mut ARR: [Pt; 2] = [Pt { x: 1, y: 2 }, Pt { x: 3, y: 4 }];
+    static mut ARR_SL: &mut [Pt] = unsafe { &mut *(&raw mut ARR) };
+
+    pub fn run() {
+        unsafe {
+            (*A_RAW.0)[0] = Pt { x: 7, y: 8 };
+            print_u32(A.x + A.y);
+            if let Some(s) = &mut *(&raw mut B_SL) { s[black_box(0)] = (40, 2); }
+            print_u32(B.0 + B.1 as u32);
+            (*(&raw mut C_SL))[0] = None;
+            print_bool(C.is_none());
+            C = Some(9);
+            print_u64((*(&raw const C_SL))[0].unwrap_or(0));
+            (*(&raw mut D_SL)).fill(Pt { x: 50, y: 5 });
+            print_u32(D.x + D.y);
+            (*(&raw mut D_SL)).copy_from_slice(&[Pt { x: 60, y: 6 }]);
+            print_u32(D.x + D.y);
+            for p in (*(&raw mut D_SL)).iter_mut() { *p = Pt { x: 70, y: 7 }; }
+            print_u32(D.x + D.y);
+            (*(&raw mut ARR_SL))[1] = Pt { x: 80, y: 8 };
+            print_u32(ARR[1].x + ARR[1].y);
+            ARR = [Pt { x: 9, y: 9 }, Pt { x: 90, y: 9 }];
+            print_u32((*(&raw const ARR_SL))[1].x + (*(&raw const ARR_SL))[1].y);
+            (*(&raw mut ARR_SL)).swap(0, 1);
+            print_u32(ARR[0].x);
+        }
+    }
+}
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    from_ref::run();
+    static_mut::run();
+    variants::run();
+}
