diff --git a/examples/core-tests/246_niche_single_variant_payloads.rs b/examples/core-tests/246_niche_single_variant_payloads.rs
new file mode 100644
index 0000000000000000000000000000000000000000..72fffa862c52119b49cffe8527379187eed515c3
--- /dev/null
+++ b/examples/core-tests/246_niche_single_variant_payloads.rs
@@ -0,0 +1,209 @@
+//! A niche that lives inside an enum rustc lays out as a single variant other than variant 0, and
+//! constants of such enums themselves.
+//!
+//! `enum Parsed { Never((), Infallible), Char(char) }` has one present variant, `Char`, so its
+//! layout is that variant alone and `Option<Parsed>` keeps its `None` in the `char`. The niche is
+//! recorded as a path of field indices through the layout, and the link-time decoder used to
+//! follow it through the enum's *first* variant: it landed on the `()` of `Never`, read the niche
+//! as zero bits wide, and decoded every bit pattern as the first niche variant (`Some('w')` read
+//! as `None`; `W::P(..)`, `W::R` and `W::S` all read as `W::Q`). `WW` puts the same single-variant
+//! payload under niche values that wrap past `u8::MAX` (254, 255, 0), so a decoder that lost the
+//! scalar's width and subtracted at another width would read `WW::S` as `WW::P`. The same walk
+//! passes through transparent wrappers, `ManuallyDrop`, tuples, plain one-field structs and named
+//! structs, which the `fam!` rows pin over that wrapping range. A constant of such an enum used
+//! directly (`const P: Parsed = Parsed::Char('w')`) is decoded by the same layout rule.
+
+#![no_std]
+#![no_main]
+
+#[path = "prelude.rs"]
+mod prelude;
+use prelude::*;
+
+use core::convert::Infallible;
+use core::hint::black_box;
+use core::mem::ManuallyDrop;
+
+trait HasOut {
+    type Out;
+}
+impl<T> HasOut for fn() -> T {
+    type Out = T;
+}
+type Never = <fn() -> ! as HasOut>::Out;
+
+macro_rules! suite {
+    ($f:ident, $T:ty, [$($k:expr),* $(,)?], |$e:ident| $body:expr) => {
+        #[inline(never)]
+        fn $f() {
+            #[inline(never)]
+            fn cls($e: $T) -> u32 { $body }
+            static TABLE: &[$T] = &[$($k),*];
+            $(
+                {
+                    const K: $T = $k;
+                    { let $e = K; print_u32($body); }
+                    print_u32(cls(K));
+                    print_u32(cls(black_box(K)));
+                }
+            )*
+            let mut i = 0;
+            while i < TABLE.len() {
+                print_u32(cls(TABLE[black_box(i)]));
+                i += 1;
+            }
+        }
+    };
+}
+
+#[derive(Clone, Copy)]
+enum Parsed {
+    Never((), Infallible),
+    Char(char),
+}
+suite!(parsed, Option<Parsed>, [Some(Parsed::Char('w')), None],
+    |e| match e { Some(Parsed::Char(c)) => c as u32, Some(Parsed::Never(..)) => 99, None => 0 });
+suite!(bare, Parsed, [Parsed::Char('v')], |e| match e { Parsed::Char(c) => c as u32, Parsed::Never(..) => 99 });
+suite!(never_ok, Option<Result<Never, char>>, [Some(Err('x')), None],
+    |e| match e { Some(Err(c)) => c as u32, Some(Ok(_)) => 99, None => 0 });
+suite!(infallible_ok, Option<Result<Infallible, char>>, [Some(Err('y')), None],
+    |e| match e { Some(Err(c)) => c as u32, Some(Ok(_)) => 99, None => 0 });
+
+#[derive(Clone, Copy)]
+enum Third {
+    A(Infallible),
+    B((), Infallible),
+    C(bool),
+}
+suite!(third, Option<Third>, [Some(Third::C(true)), Some(Third::C(false)), None],
+    |e| match e { Some(Third::C(b)) => 10 + b as u32, Some(_) => 99, None => 0 });
+
+/// Discriminants 2 and 254: rustc takes the valid range 254..=2, which wraps, and the three niche
+/// values after it are 3, 4 and 5.
+#[derive(Clone, Copy)]
+#[repr(u8)]
+enum Small {
+    X = 2,
+    Y = 0xFE,
+}
+#[derive(Clone, Copy)]
+enum Inner {
+    Dead((), Infallible),
+    Live(Small),
+}
+#[derive(Clone, Copy)]
+enum W {
+    P(Inner),
+    Q,
+    R,
+    S,
+}
+suite!(wrapping, W, [W::P(Inner::Live(Small::X)), W::P(Inner::Live(Small::Y)), W::Q, W::R, W::S],
+    |e| match e { W::P(Inner::Live(s)) => s as u32, W::P(_) => 99, W::Q => 1000, W::R => 1001, W::S => 1002 });
+#[derive(Clone, Copy)]
+enum W2 {
+    P(Result<Never, Small>),
+    Q,
+    R,
+    S,
+}
+suite!(wrapping_result, W2, [W2::P(Err(Small::X)), W2::P(Err(Small::Y)), W2::Q, W2::R, W2::S],
+    |e| match e { W2::P(Err(s)) => s as u32, W2::P(Ok(_)) => 99, W2::Q => 1000, W2::R => 1001, W2::S => 1002 });
+
+/// Valid range 200..=253: three niche values are 254, 255 and 0, wrapping past `u8::MAX`.
+#[derive(Clone, Copy)]
+#[repr(u8)]
+enum Hi {
+    A = 200,
+    B = 253,
+}
+#[derive(Clone, Copy)]
+enum InnerHi {
+    Dead((), Infallible),
+    Live(Hi),
+}
+#[derive(Clone, Copy)]
+enum WW {
+    P(InnerHi),
+    Q,
+    R,
+    S,
+}
+suite!(wrapping_hi, WW, [WW::P(InnerHi::Live(Hi::A)), WW::P(InnerHi::Live(Hi::B)), WW::Q, WW::R, WW::S],
+    |e| match e { WW::P(InnerHi::Live(h)) => h as u32, WW::P(_) => 99, WW::Q => 1000, WW::R => 1001, WW::S => 1002 });
+#[derive(Clone, Copy)]
+enum WW2 {
+    P(Result<Never, Hi>),
+    Q,
+    R,
+    S,
+}
+suite!(wrapping_hi_result, WW2, [WW2::P(Err(Hi::B)), WW2::Q, WW2::R, WW2::S],
+    |e| match e { WW2::P(Err(h)) => h as u32, WW2::P(Ok(_)) => 99, WW2::Q => 1000, WW2::R => 1001, WW2::S => 1002 });
+
+#[derive(Clone, Copy)]
+#[repr(transparent)]
+struct Tr<T>(T);
+#[derive(Clone, Copy)]
+struct Wrap<T>(T);
+#[derive(Clone, Copy)]
+struct Named {
+    z: (),
+    s: Hi,
+}
+
+macro_rules! fam {
+    ($f:ident, $W:ident, $P:ty, $mk:expr, |$p:ident| $get:expr) => {
+        #[derive(Clone, Copy)]
+        enum $W {
+            P($P),
+            Q,
+            R,
+            S,
+        }
+        suite!($f, $W, [$W::P($mk), $W::Q, $W::R, $W::S],
+            |e| match e { $W::P($p) => $get as u32, $W::Q => 1000, $W::R => 1001, $W::S => 1002 });
+    };
+}
+fam!(direct, W0, Hi, Hi::B, |p| p);
+fam!(transparent, W1, Tr<Hi>, Tr(Hi::B), |p| p.0);
+fam!(manually, W2m, ManuallyDrop<Hi>, ManuallyDrop::new(Hi::B), |p| *p);
+fam!(tuple, W3, (Hi,), (Hi::B,), |p| p.0);
+fam!(wrap, W4, Wrap<Hi>, Wrap(Hi::B), |p| p.0);
+fam!(named, W5, Named, Named { z: (), s: Hi::B }, |p| p.s);
+fam!(nested, W6, Wrap<Tr<(Hi,)>>, Wrap(Tr((Hi::B,))), |p| ((p.0).0).0);
+fam!(through_enum, W7, Wrap<InnerHi>, Wrap(InnerHi::Live(Hi::B)),
+    |p| (match p.0 { InnerHi::Live(h) => h as u32, InnerHi::Dead(..) => 99 }));
+
+#[inline(never)]
+fn direct_single_layout() {
+    // Register-sized constants of a single-variant layout, used directly.
+    const P: Parsed = Parsed::Char('u');
+    const R: Result<Never, char> = Err('t');
+    print_u32(match P { Parsed::Char(c) => c as u32, Parsed::Never(..) => 99 });
+    print_u32(match black_box(P) { Parsed::Char(c) => c as u32, Parsed::Never(..) => 99 });
+    print_u32(match R { Err(c) => c as u32, Ok(_) => 99 });
+    print_u32(match black_box(R) { Err(c) => c as u32, Ok(_) => 99 });
+}
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    parsed();
+    bare();
+    never_ok();
+    infallible_ok();
+    third();
+    wrapping();
+    wrapping_result();
+    wrapping_hi();
+    wrapping_hi_result();
+    direct();
+    transparent();
+    manually();
+    tuple();
+    wrap();
+    named();
+    nested();
+    through_enum();
+    direct_single_layout();
+}
