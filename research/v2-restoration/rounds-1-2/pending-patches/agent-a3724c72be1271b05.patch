@@ -0,0 +1,449 @@
+//! Reading a register-sized enum constant out of the type table by rustc's layout rules.
+//!
+//! A register-sized constant at an enum type reaches the JIR as bits (`Constant::Scalar`), and the
+//! type table carries the layout facts needed to name its variant: the niche (untagged variant,
+//! `niche_start`, and the path of field indices the producer walked down rustc's layout to the
+//! niche scalar), each variant's fields with their 1-ZST and layout facts, and the physical tags.
+//! The link-time printer (`jsc-link` `lower/js/constant.rs`), dead-code elimination's switch folding
+//! and the JIR interpreter all read such constants, and all of them read them here, so they cannot
+//! disagree about which variant a bit pattern names.
+
+use super::types::{EnumRepr, NominalForm, TypeId, TypeKind, TypeTable, VariantDescriptor};
+
+/// The variant a niche-encoded enum holds when its niche scalar reads `bits`
+/// (`rustc_abi::TagEncoding::Niche`): the variant `niche_variants.start + (bits - niche_start)`
+/// when that lands on a niche variant, the untagged variant otherwise.
+///
+/// The table records the untagged variant and `niche_start`; `niche_variants` is rebuilt by
+/// rustc's own rule (`rustc_abi::layout`, `needs_disc`): it runs from the first to the last variant
+/// that is neither the untagged one nor [`absent_variant`] (rustc numbers the niche values from its
+/// start, the untagged variant's own slot in that numbering unused). A variant that is uninhabited
+/// but has a field that is not a 1-ZST — `Dead([u32; 0], Infallible)` — still takes a niche value.
+///
+/// The subtraction wraps at the width of the niche scalar ([`niche_width`]); `None` when that width
+/// cannot be worked out, so that a caller refuses instead of decoding at the wrong width.
+pub fn niche_variant(
+    table: &TypeTable,
+    variants: &[VariantDescriptor],
+    niche: &super::types::Niche,
+    bits: u128,
+) -> Option<u32> {
+    let present = |index: usize| !absent_variant(table, &variants[index]);
+    let Some(start) = (0..variants.len())
+        .find(|index| *index as u32 != niche.untagged_variant && present(*index))
+    else {
+        return Some(niche.untagged_variant);
+    };
+    let Some(end) = (0..variants.len())
+        .rev()
+        .find(|index| *index as u32 != niche.untagged_variant && present(*index))
+    else {
+        return Some(niche.untagged_variant);
+    };
+    let width = niche_width(table, variants, niche)?;
+    let mask = match width {
+        0 => return None,
+        128.. => u128::MAX,
+        _ => (1u128 << width) - 1,
+    };
+    let relative = bits.wrapping_sub(niche.niche_start) & mask;
+    let count = (end - start + 1) as u128;
+    if relative < count {
+        let variant = start as u128 + relative;
+        if variant as u32 != niche.untagged_variant {
+            return Some(variant as u32);
+        }
+    }
+    Some(niche.untagged_variant)
+}
+
+/// Whether rustc leaves a variant out of an enum's layout (`rustc_abi::layout::absent`): it is
+/// uninhabited and every field is a 1-ZST, so it has no values and takes no niche value.
+pub fn absent_variant(table: &TypeTable, variant: &VariantDescriptor) -> bool {
+    let one_zst = |ty: TypeId| table.get(ty).is_some_and(|d| d.layout.one_zst);
+    variant
+        .fields
+        .iter()
+        .any(|field| uninhabited_layout(table, field.ty, 0))
+        && variant.fields.iter().all(|field| one_zst(field.ty))
+}
+
+/// Whether rustc's layout of `ty` is uninhabited (`LayoutData::is_uninhabited`): `!`, a struct,
+/// tuple or closure with an uninhabited field, a non-empty array of an uninhabited element, and an
+/// enum every variant of which is uninhabited (one with no variants included). A union, a pointer
+/// and a primitive never are; a type the table does not describe is taken to be inhabited, which
+/// keeps its variant in the niche numbering as rustc does for every variant with a sized field.
+fn uninhabited_layout(table: &TypeTable, ty: TypeId, depth: u32) -> bool {
+    if depth > 64 {
+        return false;
+    }
+    let any_field = |variant: &VariantDescriptor| {
+        variant
+            .fields
+            .iter()
+            .any(|field| uninhabited_layout(table, field.ty, depth + 1))
+    };
+    match table.get(ty).map(|d| &d.kind) {
+        Some(TypeKind::Never) => true,
+        Some(TypeKind::Adt {
+            form: NominalForm::Struct,
+            variants,
+            ..
+        }) => variants.first().is_some_and(any_field),
+        Some(TypeKind::Adt {
+            form: NominalForm::Enum,
+            variants,
+            ..
+        }) => variants.iter().all(any_field),
+        Some(
+            TypeKind::Tuple(elements)
+            | TypeKind::Closure {
+                upvars: elements, ..
+            },
+        ) => elements
+            .iter()
+            .any(|element| uninhabited_layout(table, *element, depth + 1)),
+        Some(TypeKind::Array { element, length }) => {
+            *length != 0 && uninhabited_layout(table, *element, depth + 1)
+        }
+        Some(TypeKind::Pattern(base)) => uninhabited_layout(table, *base, depth + 1),
+        _ => false,
+    }
+}
+
+/// The variant rustc lays an enum out as when its layout is a single variant (`Variants::Single`,
+/// which the table spells as no niche and no physical tag on any variant): the first variant that
+/// is not [`absent_variant`] (`rustc_abi::layout::layout_of_enum`, `present_first`). Not
+/// necessarily variant 0: in `enum Parsed { Never((), Infallible), Char(char) }` it is `Char`.
+/// `None` when every variant is absent, which is the uninhabited layout.
+pub fn single_layout_variant(table: &TypeTable, variants: &[VariantDescriptor]) -> Option<usize> {
+    variants
+        .iter()
+        .position(|variant| !absent_variant(table, variant))
+}
+
+/// Whether the table describes `ty` as an enum whose layout is a single variant: no niche, no
+/// physical tag, and not a `Number` enum (which keeps its discriminant as its value).
+pub fn is_single_layout_enum(table: &TypeTable, ty: TypeId) -> bool {
+    let Some(descriptor) = table.get(ty) else {
+        return false;
+    };
+    let TypeKind::Adt {
+        form: NominalForm::Enum,
+        variants,
+        niche: None,
+        ..
+    } = &descriptor.kind
+    else {
+        return false;
+    };
+    variants
+        .iter()
+        .all(|variant| variant.physical_tag.is_none())
+        && !matches!(descriptor.js.enum_repr, Some(EnumRepr::Number { .. }))
+}
+
+/// The width in bits of the scalar a niche lives in, or `None` when the table cannot follow the
+/// niche to it (the caller then refuses rather than guess a width).
+///
+/// The producer records the niche as a path of field indices down the untagged variant, taken by
+/// walking rustc's layout (`jir/types.rs::niche_facts`), and this walks the same path through the
+/// table: a step into a struct or union takes the field at that index, into a tuple or closure
+/// the element, into an array the element at any index, into a pattern type its base (rustc's
+/// field 0 of one, as in `NonNull`'s `*const T is !null`), and into an enum a field of the
+/// variant rustc lays out ([`single_layout_variant`]; the producer's walk stops at a multi-variant
+/// enum, so only single-variant layouts are passed through). The walk ends at the niche's scalar, at a
+/// nested multi-variant enum whose tag the niche is, or at a pointer (a wide pointer's niche is its
+/// data pointer, and the path's last step into it names no field the table describes).
+pub fn niche_width(
+    table: &TypeTable,
+    variants: &[VariantDescriptor],
+    niche: &super::types::Niche,
+) -> Option<u32> {
+    let untagged = variants.get(niche.untagged_variant as usize)?;
+    let mut ty: Option<TypeId> = None;
+    for step in &niche.niche_field {
+        let index = *step as usize;
+        let next = match ty {
+            None => untagged.fields.get(index)?.ty,
+            Some(current) => match &table.get(current)?.kind {
+                TypeKind::Reference { .. }
+                | TypeKind::RawPointer { .. }
+                | TypeKind::FnPtr { .. } => break,
+                kind => layout_field(table, current, kind, index)?,
+            },
+        };
+        ty = Some(next);
+    }
+    scalar_bits(table, ty?, 0)
+}
+
+/// The type of field `index` of `ty`'s layout, for [`niche_width`]'s walk.
+fn layout_field(table: &TypeTable, ty: TypeId, kind: &TypeKind, index: usize) -> Option<TypeId> {
+    match kind {
+        TypeKind::Adt {
+            form: NominalForm::Struct | NominalForm::Union,
+            variants,
+            ..
+        } => Some(variants.first()?.fields.get(index)?.ty),
+        TypeKind::Adt {
+            form: NominalForm::Enum,
+            variants,
+            ..
+        } if is_single_layout_enum(table, ty) => Some(
+            variants
+                .get(single_layout_variant(table, variants)?)?
+                .fields
+                .get(index)?
+                .ty,
+        ),
+        TypeKind::Tuple(elements)
+        | TypeKind::Closure {
+            upvars: elements, ..
+        } => elements.get(index).copied(),
+        TypeKind::Array { element, length } => ((index as u64) < *length).then_some(*element),
+        // A pattern type's layout is its base's, which rustc's walk steps into as field 0.
+        TypeKind::Pattern(base) if index == 0 => Some(*base),
+        _ => None,
+    }
+}
+
+/// The width in bits of the scalar a niche walk ended at: an integer, `bool`, `char` or pointer;
+/// a pattern type's or transparent wrapper's base; and for an enum, its own niche scalar or its
+/// direct tag.
+fn scalar_bits(table: &TypeTable, ty: TypeId, depth: u32) -> Option<u32> {
+    if depth > 64 {
+        return None;
+    }
+    if let Some((_, bits)) = table.int_info(ty) {
+        return Some(bits);
+    }
+    let descriptor = table.get(ty)?;
+    if let Some(inner) = descriptor.js.transparent {
+        return scalar_bits(table, inner.ty, depth + 1);
+    }
+    match &descriptor.kind {
+        TypeKind::Bool => Some(8),
+        TypeKind::Char => Some(32),
+        // `isize`/`usize` and pointers are 32 bits on `wasm32-unknown-unknown`.
+        TypeKind::Reference { .. } | TypeKind::RawPointer { .. } | TypeKind::FnPtr { .. } => {
+            Some(32)
+        }
+        TypeKind::Pattern(base) => scalar_bits(table, *base, depth + 1),
+        TypeKind::Adt {
+            form: NominalForm::Enum,
+            variants,
+            niche: Some(niche),
+            ..
+        } => niche_width(table, variants, niche),
+        TypeKind::Adt {
+            form: NominalForm::Enum,
+            variants,
+            niche: None,
+            ..
+        } => variants
+            .iter()
+            .find_map(|variant| variant.physical_tag)
+            .map(|tag| u32::from(tag.bytes) * 8),
+        _ => None,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    //! The walk to the niche scalar, step by step, over hand-built tables shaped like the ones the
+    //! producer writes (`backend/src/jir/types.rs`), and the refusal when the walk cannot be
+    //! followed. End-to-end fixtures cover most steps; these pin the ones a program can reach only
+    //! through a zeroed heap value or a path the producer does not describe.
+
+    use super::*;
+    use crate::jir::interns::StrId;
+    use crate::jir::semantic::DefinitionId;
+    use crate::jir::types::{
+        FieldDescriptor, FieldKey, JsFacts, LayoutFacts, Niche, NominalDiscriminant,
+        TypeDescriptor, TypeMeta,
+    };
+
+    const HI: TypeId = TypeId(1);
+    const ARRAY1: TypeId = TypeId(2);
+    const TUPLE1: TypeId = TypeId(3);
+    const BY_ARRAY: TypeId = TypeId(4);
+    const BY_TUPLE: TypeId = TypeId(5);
+    const LOST: TypeId = TypeId(6);
+    const MISSING: TypeId = TypeId(99);
+
+    fn descriptor(id: TypeId, kind: TypeKind, size: u64) -> TypeDescriptor {
+        TypeDescriptor {
+            id,
+            name: None,
+            kind,
+            layout: LayoutFacts {
+                size: Some(size),
+                unsized_prefix: None,
+                align: Some(1),
+                sized: true,
+                zst: size == 0,
+                one_zst: size == 0,
+                needs_drop: false,
+                has_own_drop: false,
+            },
+            meta: TypeMeta::default(),
+            js: JsFacts {
+                int: None,
+                is_indirect: true,
+                needs_clone: false,
+                crosses_transparent_union: false,
+                transparent: None,
+                peeled: id,
+                unsized_tail: None,
+                enum_repr: None,
+                is_primitive_enum: false,
+                pointer_form: None,
+                byte_element: false,
+                fields: Vec::new(),
+            },
+        }
+    }
+
+    fn variant(fields: Vec<TypeId>, discr: i128, tag: Option<u128>) -> VariantDescriptor {
+        VariantDescriptor {
+            name: StrId(0),
+            fields: fields
+                .into_iter()
+                .enumerate()
+                .map(|(index, ty)| FieldDescriptor {
+                    key: FieldKey::Index(index as u32),
+                    ty,
+                    offset: 0,
+                })
+                .collect(),
+            logical_discr: discr,
+            physical_tag: tag.map(|bits| NominalDiscriminant { bits, bytes: 1 }),
+            result_ok: false,
+            saved_local_keys: Vec::new(),
+        }
+    }
+
+    fn adt(
+        id: TypeId,
+        form: NominalForm,
+        variants: Vec<VariantDescriptor>,
+        niche: Option<Niche>,
+    ) -> TypeDescriptor {
+        descriptor(
+            id,
+            TypeKind::Adt {
+                def: DefinitionId {
+                    crate_id: 1,
+                    local_hash: id.0 as u64,
+                },
+                args: Vec::new(),
+                form,
+                variants,
+                niche,
+            },
+            1,
+        )
+    }
+
+    /// `enum W { P(<payload>), Q, R }` over `Hi { A = 200, B = 254 }`: niche values 255 and 0.
+    fn wrapping(id: TypeId, payload: TypeId, path: Vec<u32>) -> TypeDescriptor {
+        adt(
+            id,
+            NominalForm::Enum,
+            vec![
+                variant(vec![payload], 0, None),
+                variant(Vec::new(), 1, None),
+                variant(Vec::new(), 2, None),
+            ],
+            Some(Niche {
+                untagged_variant: 0,
+                niche_field: path,
+                niche_start: 255,
+                valid_range: (200, 254),
+            }),
+        )
+    }
+
+    fn table() -> TypeTable {
+        let mut table = TypeTable::new();
+        // `Hi` is a fieldless enum with a one-byte direct tag.
+        table.insert(adt(
+            HI,
+            NominalForm::Enum,
+            vec![
+                variant(Vec::new(), 200, Some(200)),
+                variant(Vec::new(), 254, Some(254)),
+            ],
+            None,
+        ));
+        table.insert(descriptor(
+            ARRAY1,
+            TypeKind::Array {
+                element: HI,
+                length: 1,
+            },
+            1,
+        ));
+        table.insert(descriptor(TUPLE1, TypeKind::Tuple(vec![HI]), 1));
+        // The producer's paths: the payload field, then its element 0, which is `Hi`.
+        table.insert(wrapping(BY_ARRAY, ARRAY1, vec![0, 0]));
+        table.insert(wrapping(BY_TUPLE, TUPLE1, vec![0, 0]));
+        // A path into a type the table does not describe.
+        table.insert(wrapping(LOST, MISSING, vec![0, 0]));
+        table
+    }
+
+    fn decode(table: &TypeTable, ty: TypeId, bits: u128) -> Option<u32> {
+        let Some(TypeKind::Adt {
+            variants,
+            niche: Some(niche),
+            ..
+        }) = table.get(ty).map(|descriptor| &descriptor.kind)
+        else {
+            panic!("not a niche enum");
+        };
+        niche_variant(table, variants, niche, bits)
+    }
+
+    #[test]
+    fn the_walk_steps_through_an_array_element() {
+        let table = table();
+        assert_eq!(
+            niche_width(&table, table.variants(BY_ARRAY), niche_of(&table, BY_ARRAY)),
+            Some(8)
+        );
+        assert_eq!(decode(&table, BY_ARRAY, 255), Some(1), "Q");
+        assert_eq!(decode(&table, BY_ARRAY, 0), Some(2), "R wraps past u8::MAX");
+        assert_eq!(decode(&table, BY_ARRAY, 200), Some(0), "P");
+    }
+
+    #[test]
+    fn the_walk_steps_through_a_tuple_element() {
+        let table = table();
+        assert_eq!(decode(&table, BY_TUPLE, 255), Some(1), "Q");
+        assert_eq!(decode(&table, BY_TUPLE, 0), Some(2), "R wraps past u8::MAX");
+        assert_eq!(decode(&table, BY_TUPLE, 254), Some(0), "P");
+    }
+
+    #[test]
+    fn a_walk_that_cannot_be_followed_is_refused_not_guessed() {
+        let table = table();
+        assert_eq!(
+            niche_width(&table, table.variants(LOST), niche_of(&table, LOST)),
+            None
+        );
+        // A guess at any width would name a variant for these bits; the decoder names none.
+        assert_eq!(decode(&table, LOST, 0), None);
+        assert_eq!(decode(&table, LOST, 255), None);
+    }
+
+    fn niche_of(table: &TypeTable, ty: TypeId) -> &Niche {
+        match table.get(ty).map(|descriptor| &descriptor.kind) {
+            Some(TypeKind::Adt {
+                niche: Some(niche), ..
+            }) => niche,
+            _ => panic!("not a niche enum"),
+        }
+    }
+}
