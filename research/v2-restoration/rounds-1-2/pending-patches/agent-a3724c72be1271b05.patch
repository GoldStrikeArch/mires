@@ -0,0 +1,267 @@
+//! Every pointer that carries a niche, in constant data: fat pointers, function pointers,
+//! `NonNull`, `Box`, and a pointer niche nested inside another enum or at a non-zero offset inside
+//! a struct payload.
+//!
+//! `Option<&str>` and `Option<&[T]>` keep their niche in the data pointer of a two-word value,
+//! `Option<fn()>` in a pointer into a *function* allocation, `Option<NonNull<T>>` in a pointer
+//! behind a transparent wrapper and a pattern type, and `Result<(), &str>` spells the variant that
+//! carries data as the pointer and the unit one as null. Each of these used to read back as the
+//! null variant whenever its pointer named the start of an allocation, and `Option<fn()>` used
+//! directly was the bare function, which the `Option` it stood for could not match. `Cow` keeps its
+//! niche in an integer field while the borrowed pointer sits elsewhere, and
+//! `NonNull::dangling()` is an address with no provenance at all: the two controls for the case
+//! where the bytes alone do decide. `Option<&dyn Trait>` holding `None` compiles and reads back as
+//! `None`; holding `Some` it is refused (fixture 249).
+
+#![no_std]
+#![no_main]
+
+#[path = "prelude.rs"]
+mod prelude;
+use prelude::*;
+
+extern crate alloc;
+use alloc::borrow::Cow;
+use alloc::boxed::Box;
+use core::hint::black_box;
+use core::ptr::NonNull;
+
+#[inline(never)]
+fn idx(i: usize) -> usize {
+    black_box(i)
+}
+#[inline(never)]
+fn show_str(o: Option<&str>) {
+    match o {
+        Some(s) => print_str(s),
+        None => print_str("<none>"),
+    }
+}
+#[inline(never)]
+fn show_slice(o: Option<&[u16]>) {
+    match o {
+        Some(s) => {
+            print_usize(s.len());
+            print_u32(s.iter().map(|v| *v as u32).sum());
+        }
+        None => print_str("<none>"),
+    }
+}
+fn seven() -> u32 {
+    7
+}
+fn eight() -> u32 {
+    8
+}
+#[inline(never)]
+fn show_fn(o: Option<fn() -> u32>) {
+    match o {
+        Some(f) => print_u32(f()),
+        None => print_str("<none>"),
+    }
+}
+#[inline(never)]
+fn show_nn(o: Option<NonNull<u32>>) {
+    match o {
+        Some(p) => print_u32(unsafe { *p.as_ptr() }),
+        None => print_str("<none>"),
+    }
+}
+#[inline(never)]
+fn show_box(o: &Option<Box<u32>>) {
+    match o {
+        Some(b) => print_u32(**b),
+        None => print_str("<none>"),
+    }
+}
+#[inline(never)]
+fn show_oo(o: Option<Option<&u32>>) {
+    match o {
+        Some(Some(v)) => print_u32(*v),
+        Some(None) => print_str("some-none"),
+        None => print_str("none"),
+    }
+}
+#[inline(never)]
+fn show_res(o: Result<&u32, ()>) {
+    match o {
+        Ok(v) => print_u32(*v),
+        Err(()) => print_str("err"),
+    }
+}
+#[inline(never)]
+fn show_check(o: Result<(), &str>) {
+    match o {
+        Ok(()) => print_str("ok"),
+        Err(e) => print_str(e),
+    }
+}
+
+const STR_S: Option<&str> = Some("alpha");
+const STR_N: Option<&str> = None;
+static SSTR: [Option<&str>; 3] = [Some("beta"), None, Some("")];
+const SL_S: Option<&[u16]> = Some(&[1, 2, 3]);
+const SL_E: Option<&[u16]> = Some(&[]);
+static SSL: [Option<&[u16]>; 2] = [None, Some(&[10, 20])];
+const F_S: Option<fn() -> u32> = Some(seven);
+const F_N: Option<fn() -> u32> = None;
+static FS: [Option<fn() -> u32>; 3] = [Some(eight), None, Some(seven)];
+static NN_TARGET: u32 = 55;
+const NN_S: Option<NonNull<u32>> = Some(NonNull::from_ref(&NN_TARGET));
+struct SyncNonNull([Option<NonNull<u32>>; 2]);
+unsafe impl Sync for SyncNonNull {}
+static NNS: SyncNonNull = SyncNonNull([None, Some(NonNull::from_ref(&56))]);
+const NN_D: Option<NonNull<u32>> = Some(NonNull::dangling());
+static BOX_N: Option<Box<u32>> = None;
+const OO: [Option<Option<&u32>>; 3] = [Some(Some(&61)), Some(None), None];
+static ROO: [Result<&u32, ()>; 2] = [Ok(&62), Err(())];
+const CHECKS: [Result<(), &str>; 3] = [Ok(()), Err("bad input"), Err("")];
+const C_CHECK: Result<(), &str> = Err("direct");
+static COWS: [Cow<'static, str>; 2] = [Cow::Borrowed("cow"), Cow::Borrowed("")];
+
+trait Speak {
+    fn n(&self) -> u32;
+}
+impl Speak for u32 {
+    fn n(&self) -> u32 {
+        *self
+    }
+}
+/// `None` of a trait-object option has no pointer to decode; `Some` is refused (fixture 249).
+static DYN_N: Option<&(dyn Speak + Sync)> = None;
+const CDYN_N: Option<&(dyn Speak + Sync)> = None;
+
+#[derive(Clone, Copy)]
+struct Pair {
+    n: u32,
+    tag: u8,
+    r: &'static u32,
+}
+#[derive(Clone, Copy)]
+struct Wrap {
+    a: u16,
+    inner: (u8, Pair),
+    name: &'static str,
+}
+const PAIRS: &[Option<Pair>] = &[
+    Some(Pair { n: 1, tag: 2, r: &3 }),
+    None,
+    Some(Pair { n: 4, tag: 5, r: &6 }),
+];
+static WRAPS: [Option<Wrap>; 2] = [
+    Some(Wrap { a: 7, inner: (8, Pair { n: 9, tag: 10, r: &11 }), name: "w" }),
+    None,
+];
+#[inline(never)]
+fn show_pair(o: Option<Pair>) {
+    match o {
+        Some(p) => {
+            print_u32(p.n);
+            print_u32(p.tag as u32);
+            print_u32(*p.r);
+        }
+        None => print_str("<none>"),
+    }
+}
+
+/// `Option<fn()>` constants used directly, alone in their item: the only pointers here name a
+/// function, so nothing else in the body forces it out of the JIR lane.
+#[inline(never)]
+fn direct_fn_constants() {
+    show_fn(F_S);
+    show_fn(F_N);
+    show_fn(black_box(F_S));
+    print_bool(F_S.is_some());
+}
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    print_str("str");
+    show_str(STR_S);
+    show_str(STR_N);
+    show_str(black_box(STR_S));
+    for i in 0..3 {
+        show_str(SSTR[idx(i)]);
+    }
+    let promoted: &'static Option<&'static str> = &Some("gamma");
+    show_str(*black_box(promoted));
+
+    print_str("slice");
+    show_slice(SL_S);
+    show_slice(SL_E);
+    for i in 0..2 {
+        show_slice(SSL[idx(i)]);
+    }
+
+    print_str("fn");
+    direct_fn_constants();
+    for i in 0..3 {
+        show_fn(FS[idx(i)]);
+    }
+
+    print_str("nonnull");
+    show_nn(NN_S);
+    show_nn(black_box(NN_S));
+    for i in 0..2 {
+        show_nn(NNS.0[idx(i)]);
+    }
+    print_bool(black_box(NN_D).is_some());
+    print_bool(NN_D == Some(NonNull::dangling()));
+
+    print_str("box");
+    show_box(&BOX_N);
+    let b = Some(Box::new(63u32));
+    show_box(black_box(&b));
+
+    print_str("nested");
+    for i in 0..3 {
+        show_oo(OO[idx(i)]);
+    }
+    for i in 0..2 {
+        show_res(ROO[idx(i)]);
+    }
+    for i in 0..3 {
+        show_check(CHECKS[idx(i)]);
+    }
+    show_check(C_CHECK);
+    show_check(black_box(C_CHECK));
+    for i in 0..2 {
+        let c = &COWS[idx(i)];
+        print_bool(matches!(c, Cow::Borrowed(_)));
+        print_str(c);
+    }
+
+    print_str("payload offset");
+    for i in 0..3 {
+        show_pair(PAIRS[idx(i)]);
+    }
+    for i in 0..2 {
+        match WRAPS[idx(i)] {
+            Some(w) => {
+                print_u32(w.a as u32);
+                print_u32(w.inner.0 as u32);
+                show_pair(Some(w.inner.1));
+                print_str(w.name);
+            }
+            None => print_str("<none>"),
+        }
+    }
+
+    print_str("dyn");
+    print_bool(black_box(&DYN_N).is_none());
+    print_u32(DYN_N.map_or(9, |d| d.n()));
+    print_bool(CDYN_N.is_none());
+    print_u32(black_box(CDYN_N).map_or(8, |d| d.n()));
+
+    print_str("run time");
+    let x: &'static u32 = Box::leak(Box::new(64u32));
+    let lp = [Some(Pair { n: 65, tag: 66, r: x }), None];
+    show_pair(black_box(lp)[idx(0)]);
+    show_pair(black_box(lp)[idx(1)]);
+    let ls: [Option<&str>; 2] = [Some("delta"), None];
+    show_str(black_box(ls)[idx(0)]);
+    show_str(black_box(ls)[idx(1)]);
+    let lf: [Option<fn() -> u32>; 2] = [None, Some(eight)];
+    show_fn(black_box(lf)[idx(0)]);
+    show_fn(black_box(lf)[idx(1)]);
+}
