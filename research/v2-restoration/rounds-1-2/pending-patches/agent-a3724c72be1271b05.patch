diff --git a/examples/core-tests/292_closure_fn_constants.rs b/examples/core-tests/292_closure_fn_constants.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5c31083de04d269159f75a614a3d55d089cc8919
--- /dev/null
+++ b/examples/core-tests/292_closure_fn_constants.rs
@@ -0,0 +1,106 @@
+//! A closure stored as a `fn` pointer in constant data calls the closure.
+//!
+//! Const evaluation stores a non-capturing closure reified as a `fn` pointer as the closure's
+//! `FnOnce` instance (its body, or the `call_once` shim of a `Fn`/`FnMut` closure), which takes the
+//! closure's environment first; a `fn` pointer is called without one. Printed as the bare
+//! function, as it used to be, `C1(1)` handed `1` to the environment slot (main read `0`), and
+//! `Some(|x| x + 7)` did not match `Some`. The constant is now the wrapper the run-time
+//! coercion builds, `($a0, ..) => shim(undefined, $a0, ..)`, in both lanes: plain, in `Option`, in
+//! tables and struct fields, at arities 0 to 3 with integer, `u64`, `bool`, `&str`, unit and tuple
+//! results. Named functions in the same positions are the controls, and stay the function itself,
+//! and so does the same closure instance reified through the trait method
+//! (`<F as Fn<(u32,)>>::call`, `FnOnce::call_once`), an `extern "rust-call"` pointer that takes the
+//! environment explicitly (main was right there; a wrapper would shift its arguments).
+//! `core::task::Waker::noop()` builds its vtable the same way, which is what `26_async` reaches.
+
+#![no_std]
+#![no_main]
+#![feature(unboxed_closures, fn_traits)]
+
+#[path = "prelude.rs"]
+mod prelude;
+use prelude::*;
+
+use core::hint::black_box;
+
+fn named(x: u32) -> u32 {
+    x * 3
+}
+fn named0() -> u32 {
+    42
+}
+
+const C0: fn() -> u32 = || 5;
+const C1: fn(u32) -> u32 = |x| x + 7;
+const C2: fn(u32, u32) -> u32 = |a, b| a * 10 + b;
+const C3: fn(u8, u16, u32) -> u64 = |a, b, c| a as u64 + b as u64 * 100 + c as u64 * 10000;
+const CB: fn(u32) -> bool = |x| x > 3;
+const CS: fn(bool) -> &'static str = |b| if b { "yes" } else { "no" };
+const CU: fn(u32) = |x| print_u32(x + 1000);
+const CT: fn(u32) -> (u32, bool) = |x| (x * 2, x % 2 == 0);
+const OC0: Option<fn() -> u32> = Some(|| 6);
+const OC1: Option<fn(u32) -> u32> = Some(|x| x + 8);
+const ON: Option<fn(u32) -> u32> = None;
+const ONAMED: Option<fn(u32) -> u32> = Some(named);
+const NAMED: fn(u32) -> u32 = named;
+static TABLE: [fn(u32) -> u32; 3] = [|x| x + 1, named, |x| x * x];
+static OTABLE: [Option<fn(u32) -> u32>; 3] = [Some(|x| x + 2), None, Some(named)];
+struct Op {
+    name: &'static str,
+    run: fn(u32, u32) -> u32,
+}
+static OPS: [Op; 2] = [Op { name: "add", run: |a, b| a + b }, Op { name: "mul", run: |a, b| a * b }];
+static NAMED0: fn() -> u32 = named0;
+
+struct Method<F>(F);
+impl<F: Fn(u32) -> u32> Method<F> {
+    const CALL: extern "rust-call" fn(&F, (u32,)) -> u32 = <F as Fn<(u32,)>>::call;
+    const ONCE: extern "rust-call" fn(F, (u32,)) -> u32 = <F as FnOnce<(u32,)>>::call_once;
+}
+
+#[inline(never)]
+fn methods<F: Fn(u32) -> u32 + Copy>(f: F) {
+    print_u32(Method::<F>::CALL(&f, (5,)));
+    print_u32(black_box(Method::<F>::ONCE)(f, (6,)));
+}
+
+#[inline(never)]
+fn idx(i: usize) -> usize {
+    black_box(i)
+}
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    print_u32(C0());
+    print_u32(C1(1));
+    print_u32(black_box(C1)(2));
+    print_u32(C2(3, 4));
+    print_u64(C3(1, 2, 3));
+    print_bool(CB(5));
+    print_str(CS(true));
+    print_str(black_box(CS)(false));
+    CU(1);
+    let (a, b) = CT(7);
+    print_u32(a);
+    print_bool(b);
+    print_u32(OC0.map_or(0, |f| f()));
+    print_u32(OC1.map_or(0, |f| f(1)));
+    print_u32(black_box(OC1).map_or(0, |f| f(2)));
+    print_u32(ON.map_or(99, |f| f(1)));
+    print_u32(ONAMED.map_or(0, |f| f(4)));
+    print_u32(NAMED(5));
+    print_u32(NAMED0());
+    for i in 0..3 {
+        print_u32(TABLE[idx(i)](6));
+        print_u32(OTABLE[idx(i)].map_or(77, |f| f(6)));
+    }
+    for i in 0..2 {
+        let op = &OPS[idx(i)];
+        print_str(op.name);
+        print_u32((op.run)(3, 4));
+    }
+    let rt: fn(u32) -> u32 = |x| x + 1;
+    print_u32(black_box(rt)(1));
+    methods(|x| x + 7);
+    methods(|x| x * 3);
+}
