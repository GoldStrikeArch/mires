diff --git a/examples/core-tests/243_niche_static_references.rs b/examples/core-tests/243_niche_static_references.rs
new file mode 100644
index 0000000000000000000000000000000000000000..096481f3935857082215f0f341b801cf1c531824
--- /dev/null
+++ b/examples/core-tests/243_niche_static_references.rs
@@ -0,0 +1,76 @@
+//! Statics that name other statics through a pointer niche keep the identity and the order of
+//! initialisation a plain reference has.
+//!
+//! `static HEAD: Node = Node { next: Some(&MID), .. }` holds a pointer whose provenance is the
+//! static `MID`, at offset zero, so its bytes are those of `None`: the list used to stop at its
+//! first node. Decoded by provenance, `Some(&MID)` is the binding `MID` itself — the same object
+//! `&MID` names anywhere else, so `ptr::eq` holds — and naming it is what orders `MID` before
+//! `HEAD`, exactly as a field of type `&'static Node` already did. The chain is declared consumer
+//! first, a `static mut` cursor is read, rewritten to `None` and to another static, and a
+//! primitive static is reached through its boxed slot.
+
+#![no_std]
+#![no_main]
+
+#[path = "prelude.rs"]
+mod prelude;
+use prelude::*;
+
+use core::hint::black_box;
+use core::ptr;
+
+struct Node {
+    id: u32,
+    next: Option<&'static Node>,
+}
+// A chain declared tail-last, so a consumer is declared before what it names.
+static HEAD: Node = Node { id: 1, next: Some(&MID) };
+static MID: Node = Node { id: 2, next: Some(&TAIL) };
+static TAIL: Node = Node { id: 3, next: None };
+static ALIAS: Option<&Node> = Some(&HEAD);
+const CALIAS: Option<&Node> = Some(&MID);
+static TABLE: [Option<&Node>; 3] = [Some(&TAIL), None, Some(&HEAD)];
+static mut CURSOR: Option<&'static Node> = Some(&MID);
+static COUNTER: u32 = 40;
+static PCOUNT: Option<&u32> = Some(&COUNTER);
+static PSTR: Option<&&str> = Some(&NAME);
+static NAME: &str = "named";
+
+#[inline(never)]
+fn walk(mut n: Option<&'static Node>) -> u32 {
+    let mut t = 0;
+    while let Some(node) = n {
+        t = t * 10 + node.id;
+        n = node.next;
+    }
+    t
+}
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    print_u32(walk(Some(&HEAD)));
+    print_u32(walk(ALIAS));
+    print_u32(walk(CALIAS));
+    print_u32(walk(black_box(CALIAS)));
+    for i in 0..3 {
+        print_u32(walk(TABLE[black_box(i)]));
+    }
+    print_bool(ptr::eq(ALIAS.unwrap(), &HEAD));
+    print_bool(ptr::eq(CALIAS.unwrap(), &MID));
+    print_bool(ptr::eq(HEAD.next.unwrap(), &MID));
+    print_bool(ptr::eq(MID.next.unwrap(), &TAIL));
+    print_bool(ptr::eq(TABLE[black_box(2)].unwrap(), &HEAD));
+    print_bool(ptr::eq(TABLE[black_box(0)].unwrap(), MID.next.unwrap()));
+    unsafe {
+        print_u32(walk(*black_box(&raw const CURSOR)));
+        print_bool(ptr::eq((*black_box(&raw const CURSOR)).unwrap(), &MID));
+        CURSOR = TAIL.next;
+        print_u32(walk(*black_box(&raw const CURSOR)));
+        CURSOR = Some(&HEAD);
+        print_u32(walk(*black_box(&raw const CURSOR)));
+    }
+    print_u32(*PCOUNT.unwrap());
+    print_bool(ptr::eq(PCOUNT.unwrap(), &COUNTER));
+    print_str(*PSTR.unwrap());
+    print_bool(ptr::eq(PSTR.unwrap(), &NAME));
+}
