diff --git a/examples/core-tests/248_single_variant_discriminant.rs b/examples/core-tests/248_single_variant_discriminant.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ef61f0d495cc15067e982dc555da34a1bc9937f6
--- /dev/null
+++ b/examples/core-tests/248_single_variant_discriminant.rs
@@ -0,0 +1,87 @@
+//! The run-time discriminant of an enum rustc lays out as a single variant other than the first.
+//!
+//! Such a layout stores no tag, so the discriminant is a constant: the variant rustc lays out,
+//! which is the first one that is not *absent* (uninhabited with only 1-ZST fields). The lowering
+//! and dead-code elimination used to take the first variant a shallow uninhabitedness test leaves
+//! standing, and `(Infallible, ())`, `Wrap<Infallible>` or `[Void; 1]` hide their `Infallible` from
+//! that test: `match r { Ok(_) => .., Err(c) => .. }` on `Result<(Infallible, ()), char>` took the
+//! `Ok` arm, which is unreachable, and threw. The controls are variants whose `Infallible` the
+//! shallow test does see, and a `Result` with two live variants.
+
+#![no_std]
+#![no_main]
+
+#[path = "prelude.rs"]
+mod prelude;
+use prelude::*;
+
+use core::convert::Infallible;
+use core::hint::black_box;
+
+#[derive(Clone, Copy)]
+struct Wrap<T>(T);
+#[derive(Clone, Copy)]
+enum Void {}
+
+#[inline(never)]
+fn tuple(r: Result<(Infallible, ()), char>) -> u32 {
+    match r {
+        Ok(_) => 99,
+        Err(c) => c as u32,
+    }
+}
+#[derive(Clone, Copy)]
+enum Second {
+    Dead(Wrap<Infallible>),
+    Live(u32),
+}
+#[inline(never)]
+fn second(s: Second) -> u32 {
+    match s {
+        Second::Dead(_) => 99,
+        Second::Live(n) => n,
+    }
+}
+#[derive(Clone, Copy)]
+enum Third {
+    A([Void; 1]),
+    B((), Wrap<(Void,)>),
+    C(u16),
+}
+#[inline(never)]
+fn third(t: Third) -> u32 {
+    match t {
+        Third::C(n) => n as u32,
+        _ => 99,
+    }
+}
+#[inline(never)]
+fn plain(r: Result<Infallible, char>) -> u32 {
+    match r {
+        Ok(_) => 99,
+        Err(c) => c as u32,
+    }
+}
+#[inline(never)]
+fn both(r: Result<u8, char>) -> u32 {
+    match r {
+        Ok(n) => n as u32,
+        Err(c) => c as u32,
+    }
+}
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    print_u32(tuple(black_box(Err('z'))));
+    print_u32(tuple(Err('y')));
+    print_u32(second(Second::Live(black_box(5))));
+    print_u32(second(black_box(Second::Live(6))));
+    print_u32(third(Third::C(black_box(7))));
+    print_u32(third(black_box(Third::C(8))));
+    print_u32(plain(black_box(Err('x'))));
+    print_u32(both(black_box(Ok(9))));
+    print_u32(both(black_box(Err('w'))));
+    let local: Result<(Infallible, ()), char> = Err(black_box('v'));
+    print_bool(local.is_err());
+    print_bool(matches!(black_box(local), Err('v')));
+}
