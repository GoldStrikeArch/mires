diff --git a/examples/core-tests/224_flattened_pointers.rs b/examples/core-tests/224_flattened_pointers.rs
new file mode 100644
index 0000000000000000000000000000000000000000..035290813d133513c6db07c9952c79b2f100d018
--- /dev/null
+++ b/examples/core-tests/224_flattened_pointers.rs
@@ -0,0 +1,83 @@
+//! The pointer side of arrays of arrays: what a `*const [T; N]` cast to `*const T` names, and how
+//! pointers into the rows and into their flattened view compare.
+//!
+//! A pointer to a row cast to a pointer to its first element keeps the provenance of the whole
+//! buffer of rows, so offsetting it past the row reaches the next one, for reads and for writes.
+//! The flattened view is the rows' own storage rather than a buffer of its own: `ptr::eq` and the
+//! pointer order agree with a pointer taken into the row directly (`&flat[3]` and `&rows[1][1]` are
+//! one place), and the cast keeps the address, so `rows.as_ptr()` and `flat.as_ptr()` are one
+//! address and the elements are `size_of::<T>()` apart all the way through. The same holds for the
+//! rows of a `Vec` and for a `Box<[T; N]>`, whose `&*b` and `b.as_ptr()` are one address.
+
+#![no_std]
+#![no_main]
+
+extern crate alloc;
+
+#[path = "prelude.rs"]
+mod prelude;
+use prelude::*;
+
+use alloc::boxed::Box;
+use alloc::vec::Vec;
+use alloc::vec;
+use core::hint::black_box as bb;
+
+#[inline(never)] fn read_at(p: *const u64, i: usize) -> u64 { unsafe { *p.add(i) } }
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    let rows = bb([[1u64, 2], [3, 4], [5, 6]]);
+    let first = rows.as_ptr().cast::<u64>();
+    print_u64(read_at(first, 3) * 10 + read_at(first, 5));
+    let middle = (&raw const rows[1]).cast::<u64>();
+    print_u64(read_at(middle, 0) * 10 + read_at(middle, 2));
+    let mut grid = bb([[0u32; 2]; 3]);
+    let cells = grid.as_mut_ptr().cast::<u32>();
+    for i in 0..6 { unsafe { *cells.add(i) = i as u32 * 3 } }
+    print_u32(grid[2][0] * 100 + grid[2][1]);
+    let flat = rows.as_flattened();
+    print_bool(core::ptr::eq(&flat[0], &rows[0][0]));
+    print_bool(core::ptr::eq(&flat[3], &rows[1][1]));
+    print_bool(core::ptr::eq(&flat[3], &rows[1][0]));
+    print_bool(core::ptr::eq(flat.as_ptr(), rows.as_ptr().cast()));
+    let (inside, direct) = (&flat[3] as *const u64, &rows[1][0] as *const u64);
+    print_bool(inside > direct);
+    print_bool(direct < inside);
+    print_bool(inside >= &rows[1][1] as *const u64);
+    print_bool(&rows[2][0] as *const u64 > inside);
+    print_bool(flat.as_ptr() as usize == rows.as_ptr() as usize);
+    let base = flat.as_ptr() as usize;
+    for x in flat { print_usize((x as *const u64 as usize - base) / 8); }
+    print_bool(flat.as_ptr().is_aligned());
+    unsafe { print_i32(flat.as_ptr_range().end.offset_from(flat.as_ptr()) as i32); }
+    print_bool((&raw const rows[1]).cast::<u64>() as usize == base + 16);
+    // A write through the flattened view is the row's, and a write to the row is seen by the view.
+    let mut m = bb([[1u32, 2], [3, 4]]);
+    {
+        let f = m.as_flattened_mut();
+        f[2] = 30;
+    }
+    print_u32(m[1][0]);
+    m[1][1] = 40;
+    print_u32(m.as_flattened()[3]);
+    // Heap rows: Vec and Box.
+    let mut v: Vec<[u32; 2]> = bb(vec![[1, 2], [3, 4]]);
+    v.push([5, 6]);
+    print_bool(v.as_ptr() as usize == v.as_flattened().as_ptr() as usize);
+    print_bool(core::ptr::eq(&v.as_flattened()[5], &v[2][1]));
+    let vb = v.as_flattened().as_ptr() as usize;
+    print_usize((&v.as_flattened()[4] as *const u32 as usize - vb) / 4);
+    print_usize((v.as_ptr().wrapping_add(2) as usize - vb) / 4);
+    v.as_flattened_mut()[1] = 20;
+    print_u32(v[0][1]);
+    let b: Box<[u64; 3]> = bb(Box::new([7, 8, 9]));
+    print_bool(&*b as *const [u64; 3] as usize == b.as_ptr() as usize);
+    print_bool(core::ptr::eq(&b[1], b.as_ptr().wrapping_add(1)));
+    let bs: Box<[u64]> = b;
+    print_u64(bs[2]);
+    let mut one: Vec<[u64; 2]> = Vec::with_capacity(1);
+    one.push([1, 2]);
+    print_bool(one.as_ptr() as usize == one.as_flattened().as_ptr() as usize);
+    print_bool(one.as_ptr() as usize % 8 == 0);
+}
