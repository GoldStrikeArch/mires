+// Arrays of arrays in the runtime: heap blocks typed as rows (`__rt.unscale_rows`), the
+// flattened view of a buffer of rows (`__rt.unwindow` over several rows, `_flat_view`), and the
+// cast back (`__rt.window`, `__rt.chunk_slice`). Each test drives the runtime the way the emitted
+// code does: a slot is `{ buf, off }`, a read is `p.buf[p.off + i]`, an array pointer is a plain
+// slot whose element is the array.
+import assert from 'node:assert/strict'
+import { readFile } from 'node:fs/promises'
+import test from 'node:test'
+import vm from 'node:vm'
