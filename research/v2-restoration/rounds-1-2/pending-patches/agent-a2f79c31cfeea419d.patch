diff --git a/examples/core-tests/221_boxed_arrays.rs b/examples/core-tests/221_boxed_arrays.rs
new file mode 100644
index 0000000000000000000000000000000000000000..6cb018bfc23c7081aa2acd652822ddcab2fa3d80
--- /dev/null
+++ b/examples/core-tests/221_boxed_arrays.rs
@@ -0,0 +1,109 @@
+//! Arrays on the heap behind a `Box`: `Box<[T; N]>`, `Box<[[T; N]; M]>` and their conversions.
+//!
+//! `Box::new` casts the block it allocates from `*mut u8` to `*mut [T; N]`, and that cast is now
+//! `__rt.unscale_rows`: the block is typed as rows of the array, one JavaScript array per row, so a
+//! `Box<[T; N]>` is a plain slot whose element is the array and `b[i]` is `b.buf[b.off][i]`. It used
+//! to be a window over the block's elements, which the place projection read as a plain slot, so
+//! `x[0]` of a `Box<[u32; 8]>` printed `undefined`. The block of exactly one array also registers
+//! its row as a heap block of `T`s, its flat face, because the unsizing every `vec![..]` does turns
+//! the box into a `Box<[T]>` and then a `Vec<T>` that frees and grows that row.
+//!
+//! Covered: indexing, writes through the box and through `&mut [T; N]`, a whole-array store, every
+//! element type, raw pointers into the box and its address, a box of rows and its flattened view,
+//! `Box<[T; N]>` to `Box<[T]>` to `Vec<T>` and back (`TryFrom<Box<[T]>>`, `TryFrom<Vec<T>>`,
+//! `[T; N]::try_from(Vec<T>)`), a boxed slice of rows, and `Box::<[T; N]>::new_uninit` written
+//! through `MaybeUninit::write`, whose `&mut MaybeUninit<[T; N]>` is a slot rather than the array.
+
+#![no_std]
+#![no_main]
+
+extern crate alloc;
+
+#[path = "prelude.rs"]
+mod prelude;
+use prelude::*;
+
+use alloc::boxed::Box;
+use alloc::vec::Vec;
+use alloc::vec;
+use core::hint::black_box as bb;
+
+#[derive(Clone, Copy, PartialEq)]
+struct P { a: i32, b: u8 }
+
+#[inline(never)] fn s_u32(v: &[u32]) -> u32 { v.iter().fold(0u32, |x, y| x * 10 + y) }
+#[inline(never)] fn s_u64(v: &[u64]) -> u64 { v.iter().fold(0u64, |x, y| x * 10 + y) }
+#[inline(never)] fn mk8() -> Box<[u32; 8]> { Box::new([7; 8]) }
+#[inline(never)] fn first(b: &Box<[u64; 3]>) -> u64 { b[0] }
+#[inline(never)] fn set(b: &mut [u32; 8], i: usize, v: u32) { b[i] = v; }
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    let mut x: Box<[u32; 8]> = bb(Box::new([7; 8]));
+    x[0] += 1;
+    print_u32(x[0]);
+    print_u32(x[1]);
+    let mut y = mk8();
+    y[bb(3)] = 30;
+    set(&mut y, 5, 50);
+    print_u32(s_u32(&*y));
+    print_u32(y.iter().sum());
+    *y = [1, 2, 3, 4, 5, 6, 7, 8];
+    print_u32(y[7]);
+    let b64: Box<[u64; 3]> = bb(Box::new([9, 8, 7]));
+    print_u64(first(&b64) * 100 + b64[2]);
+    let bi: Box<[i64; 2]> = bb(Box::new([-5, 6]));
+    print_i64(bi[0] * bi[1]);
+    let bf: Box<[f64; 2]> = bb(Box::new([1.25, 2.5]));
+    print_f64(bf[0] + bf[1]);
+    let mut bp: Box<[P; 2]> = bb(Box::new([P { a: 1, b: 2 }, P { a: 3, b: 4 }]));
+    bp[1].a = 30;
+    print_i32(bp[0].a + bp[1].a + bp[1].b as i32);
+    let bu8: Box<[u8; 4]> = bb(Box::new([1, 2, 3, 4]));
+    print_u32(bu8[3] as u32 * 10 + bu8[0] as u32);
+    let (r1, r2) = (5u32, 6u32);
+    let br: Box<[&u32; 2]> = bb(Box::new([&r1, &r2]));
+    print_u32(*br[0] * 10 + *br[1]);
+    // Raw pointers into a boxed array.
+    let mut z: Box<[u32; 4]> = bb(Box::new([1, 2, 3, 4]));
+    let p = z.as_mut_ptr();
+    unsafe { *p.add(2) = 33; }
+    print_u32(z[2]);
+    print_bool(&*z as *const [u32; 4] as usize == z.as_ptr() as usize);
+    // A box of rows.
+    let mut g: Box<[[u32; 2]; 3]> = bb(Box::new([[1, 2], [3, 4], [5, 6]]));
+    g[1][0] = 30;
+    print_u32(s_u32(g.as_flattened()));
+    g.as_flattened_mut()[5] = 60;
+    print_u32(g[2][1]);
+    let g64: Box<[[u64; 2]; 2]> = bb(Box::new([[1, 2], [3, 4]]));
+    print_u64(s_u64(g64.as_flattened()));
+    // Box<[T; N]> to Box<[T]> to Vec<T>, and back.
+    let s: Box<[u32]> = bb(Box::new([1u32, 2, 3]));
+    print_usize(s.len());
+    let mut v: Vec<u32> = s.into_vec();
+    v.push(4);
+    v.push(5);
+    print_u32(s_u32(&v));
+    let v2: Vec<u32> = bb(vec![9, 8, 7]);
+    let back: Box<[u32; 3]> = v2.into_boxed_slice().try_into().ok().unwrap();
+    print_u32(back[0] * 100 + back[1] * 10 + back[2]);
+    let v3: Vec<u64> = bb(vec![4, 5]);
+    let mut b3: Box<[u64; 2]> = v3.try_into().ok().unwrap();
+    b3[1] += 10;
+    print_u64(b3[0] * 100 + b3[1]);
+    let arr: [u32; 3] = bb(vec![6u32, 7, 8]).try_into().ok().unwrap();
+    print_u32(s_u32(&arr));
+    let from_arr: Vec<u32> = bb(Vec::from([3u32, 2, 1]));
+    print_u32(s_u32(&from_arr));
+    let boxed_rows: Box<[[u32; 2]]> = bb(vec![[9u32, 8], [7, 6], [5, 4]].into_boxed_slice());
+    print_u32(boxed_rows[1][0] * 10 + boxed_rows[2][1]);
+    print_u32(s_u32(boxed_rows.as_flattened()));
+    // Box::new_uninit of an array, written then read.
+    let mut u = Box::<[u32; 3]>::new_uninit();
+    u.write([4, 5, 6]);
+    let u = unsafe { u.assume_init() };
+    print_u32(s_u32(&*u));
+    let zz: Box<[u32; 4]> = bb(Box::new([0; 4]));
+    print_u32(zz.iter().sum::<u32>() + zz.len() as u32);
+}
