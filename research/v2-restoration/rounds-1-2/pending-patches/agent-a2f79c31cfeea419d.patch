+  if (block !== undefined && block.fresh && !p.buf.every((byte) => byte === (block.zeroed ? 0 : undefined))) {
+    block.fresh = false;
+  }
+  if (p.sc === size && Array.isArray(p.buf[p.off / size])) return __rt.unscale(p, size, null);
+  // The byte view of an array of arrays is the byte view of its innermost
+  // elements (`unwindow` all the way down, then `scale`, which is nothing for
+  // bytes), so the way back climbs from those elements through the flattened
+  // views to the rows.
+  const bytes = p.sc === undefined && __rt._flat_of.has(p.buf);
+  if (p.sc < es || (bytes && es > 1)) {
+    let q = bytes ? p : __rt.unscale(p, p.sc, null);
+    let level = bytes ? 1 : p.sc;
+    for (let flat; level < es && (flat = __rt._flat_of.get(q.buf)) !== undefined && q.off % flat.n === 0;) {
+      q = { buf: flat.rows, off: q.off / flat.n };
+      level *= flat.n;
+    }
+    if (level === es) return __rt.window(q, n);
+  }
+  if (block !== undefined && (block.fresh || block.es === size)) {
+    const q = __rt._retype(p, block, size, mk === undefined ? () => new Array(n).fill(0)
+      : typeof mk === "function" ? () => Array.from({ length: n }, mk) : mk);
+    block.n = n;
