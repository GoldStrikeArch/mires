@@ -0,0 +1,124 @@
+//! Arrays of arrays on the stack, read and written across their row boundaries.
+//!
+//! An array of arrays is nested JavaScript arrays, one per row, for every element type, and
+//! `<[[T; N]]>::as_flattened` builds its `&[T]` of `M * N` elements as
+//! `from_raw_parts(self.as_ptr().cast::<T>(), M * N)`. So the cast from `*const [T; N]` to `*const T`
+//! decides everything: a slot into a buffer of several rows comes back as a slot into the rows'
+//! flattened view (`runtime/shim.js`, `__rt.unwindow` and `_flat_view`), whose element `i` is the
+//! place `rows[i / N][i % N]`. It used to step into the first row and stop there, so `flat[2]` of
+//! `[[1u32, 2], [3, 4]]` read `undefined`, and a write through `as_flattened_mut` was lost.
+//!
+//! Covered: `u8`, `u32`, `u64`, `i64`, `f64`, a small struct and a reference element; a slice of
+//! rows from a later row; a nested flatten; one row and rows of one; writes, `sort_unstable`,
+//! `copy_from_slice`, `reverse`, `fill`, `copy_within` through `as_flattened_mut`; `iter().flatten()`,
+//! `concat`, `chunks_exact`; `as_chunks` / `as_chunks_mut` at the rows' width, which hand the rows
+//! back; and zero-length rows, zero rows and zero-sized elements.
+
+#![no_std]
+#![no_main]
+
+extern crate alloc;
+
+#[path = "prelude.rs"]
+mod prelude;
+use prelude::*;
+
+use core::hint::black_box as bb;
+
+#[derive(Clone, Copy, PartialEq)]
+struct P { a: i32, b: u8 }
+
+#[inline(never)] fn s_u8(v: &[u8]) -> u32 { v.iter().fold(0u32, |x, y| x * 10 + *y as u32) }
+#[inline(never)] fn s_u32(v: &[u32]) -> u32 { v.iter().fold(0u32, |x, y| x * 10 + y) }
+#[inline(never)] fn s_u64(v: &[u64]) -> u64 { v.iter().fold(0u64, |x, y| x * 10 + y) }
+#[inline(never)] fn s_i64(v: &[i64]) -> i64 { v.iter().enumerate().map(|(i, x)| x * (i as i64 + 1)).sum() }
+#[inline(never)] fn s_f64(v: &[f64]) -> f64 { v.iter().enumerate().map(|(i, x)| x * (i as f64 + 1.0)).sum() }
+#[inline(never)] fn s_p(v: &[P]) -> i32 { v.iter().map(|p| p.a * 10 + p.b as i32).sum() }
+#[inline(never)] fn s_ref(v: &[&u32]) -> u32 { v.iter().fold(0u32, |x, y| x * 10 + **y) }
+#[inline(never)] fn at_u32(v: &[u32], i: usize) -> u32 { v[i] }
+#[inline(never)] fn bump_u64(v: &mut [u64]) { v[2] = 70; v[3] += 100; v.swap(0, 5); }
+#[inline(never)] fn bump_u8(v: &mut [u8]) { for x in v.iter_mut() { *x += 1; } v[3] = 9; }
+#[inline(never)] fn bump_p(v: &mut [P]) { v[2].a = 40; v[3] = P { a: 50, b: 5 }; }
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    let a8 = bb([[1u8, 2], [3, 4], [5, 6]]);
+    print_u32(s_u8(a8.as_flattened()));
+    let a32 = bb([[1u32, 2, 3], [4, 5, 6]]);
+    print_u32(s_u32(a32.as_flattened()));
+    print_u32(at_u32(a32.as_flattened(), bb(4)));
+    let a64 = bb([[1u64, 2], [3, 4], [5, 6]]);
+    print_u64(s_u64(a64.as_flattened()));
+    let ai64 = bb([[-1i64, 2], [-3, 4]]);
+    print_i64(s_i64(ai64.as_flattened()));
+    let af = bb([[0.5f64, 1.5], [2.5, 3.5]]);
+    print_f64(s_f64(af.as_flattened()));
+    let ap = bb([[P { a: 1, b: 2 }, P { a: 3, b: 4 }], [P { a: 5, b: 6 }, P { a: 7, b: 8 }]]);
+    print_i32(s_p(ap.as_flattened()));
+    let (x, y, z, w) = (11u32, 22u32, 33u32, 44u32);
+    let ar = bb([[&x, &y], [&z, &w]]);
+    print_u32(s_ref(ar.as_flattened()));
+    // A slice of rows starting at a later row, and a nested flatten.
+    let grid = bb([[1u32, 2, 3], [4, 5, 6], [7, 8, 9]]);
+    print_u32(s_u32(grid[1..].as_flattened()));
+    print_u32(s_u32(grid[..2].as_flattened()));
+    let cube = bb([[[1u64, 2], [3, 4]], [[5, 6], [7, 8]]]);
+    let line = cube.as_flattened().as_flattened();
+    print_usize(line.len());
+    print_u64(s_u64(line));
+    // One row, and rows of one.
+    print_u32(s_u32(bb([[4u32, 2]]).as_flattened()));
+    print_u32(s_u32(bb([[7u32], [8], [9]]).as_flattened()));
+    // Writes through as_flattened_mut are the rows' own.
+    let mut m64 = bb([[1u64, 2], [3, 4], [5, 6]]);
+    bump_u64(m64.as_flattened_mut());
+    for r in &m64 { print_u64(r[0] * 1000 + r[1]); }
+    let mut m8 = bb([[1u8, 2], [3, 4]]);
+    bump_u8(m8.as_flattened_mut());
+    print_u32(m8[0][0] as u32 * 1000 + m8[0][1] as u32 * 100 + m8[1][0] as u32 * 10 + m8[1][1] as u32);
+    let mut mp = bb([[P { a: 0, b: 0 }; 2]; 2]);
+    bump_p(mp.as_flattened_mut());
+    print_i32(mp[1][0].a * 100 + mp[1][1].a + mp[1][1].b as i32);
+    let mut mi = bb([[5i32, -1], [3, 9], [0, 2]]);
+    mi.as_flattened_mut().sort_unstable();
+    for r in &mi { print_i32(r[0] * 100 + r[1]); }
+    let mut mf = bb([[0.0f64; 2]; 2]);
+    mf.as_flattened_mut().copy_from_slice(&[0.5, 1.5, 2.5, 3.5]);
+    print_f64(mf[1][0] * 10.0 + mf[1][1]);
+    let mut mr = bb([[1u32, 2], [3, 4]]);
+    mr.as_flattened_mut().reverse();
+    print_u32(s_u32(mr.as_flattened()));
+    mr.as_flattened_mut().fill(6);
+    mr.as_flattened_mut()[1..3].fill(7);
+    print_u32(s_u32(mr.as_flattened()));
+    let mut cw = bb([[1u32, 2, 3], [4, 5, 6]]);
+    cw.as_flattened_mut().copy_within(1..5, 2);
+    print_u32(s_u32(cw.as_flattened()));
+    // Iterating rows flattened, concatenated and chunked.
+    let t = bb([[1u32, 2], [3, 4], [5, 6]]);
+    print_u32(t.iter().flatten().fold(0, |a, b| a * 10 + b));
+    let c: alloc::vec::Vec<u32> = t.concat();
+    print_u32(s_u32(&c));
+    let mut n = 0u32;
+    for ch in t.as_flattened().chunks_exact(3) { n = n * 1000 + s_u32(ch); }
+    print_u32(n);
+    let back = t.as_flattened().as_chunks::<2>().0;
+    print_usize(back.len());
+    print_u32(back[2][1] * 10 + back[0][0]);
+    let (rows3, rest) = t.as_flattened().as_chunks::<2>();
+    print_usize(rest.len());
+    print_u32(s_u32(rows3.as_flattened()));
+    let mut tm = bb([[1u32, 2], [3, 4]]);
+    tm.as_flattened_mut().as_chunks_mut::<2>().0[1][0] = 30;
+    print_u32(tm[1][0]);
+    // Zero-length rows, zero rows, zero-sized elements.
+    let zr = bb([[0u8; 0]; 5]);
+    print_usize(zr.as_flattened().len());
+    print_usize(zr.as_flattened().iter().count());
+    let none: [[u32; 2]; 0] = bb([]);
+    print_usize(none.as_flattened().len());
+    print_usize(none.as_flattened().iter().count());
+    let zs = bb([[(); 3]; 2]);
+    print_usize(zs.as_flattened().len());
+    print_usize(zs.as_flattened().iter().count());
+}
