+  same(rt.unscale_rows(raw, 12, 3, () => 0, 4, rt.unscale_scalar, 'u32'), { buf: raw.buf, off: 0 })
+  const back = rt.unscale_rows({ buf: raw.buf, off: 24, sc: 12 }, 12, 3, () => 0, 4, rt.unscale_scalar, 'u32')
+  assert.deepEqual([back.buf === raw.buf, back.off], [true, 2])
