+    }
+    const flat = __rt._flat_of.get(p.buf);
+    if (flat !== undefined) {
+      if (flat.n === n && p.off % n === 0) return { buf: flat.rows, off: p.off / n };
+    } else if (__rt._blocks.has(p.buf) && p.off === 0 && p.buf.length === n) {
+      return __rt.box(p.buf);
+    }
