diff --git a/examples/core-tests/222_vec_of_arrays.rs b/examples/core-tests/222_vec_of_arrays.rs
new file mode 100644
index 0000000000000000000000000000000000000000..68be38cd518f565dffd07c2364904ad4c8f5abcb
--- /dev/null
+++ b/examples/core-tests/222_vec_of_arrays.rs
@@ -0,0 +1,143 @@
+//! `Vec<[T; N]>`: built by `vec!`, `push`, `extend`, `collect`, and grown past its capacity.
+//!
+//! `RawVec` keeps its buffer as a `*mut u8` and casts it to `*mut [T; N]` on every access, which is
+//! `__rt.unscale_rows`: a fresh block is typed as rows, a block of rows gives the row the pointer
+//! names, and a byte view of rows climbs back through their flattened views. `vec![..]` boxes an
+//! array of rows, so both ways of building one end with the same storage. Before, the buffer was
+//! flat, `ptr.add(len)` moved by elements rather than rows, and every `Vec<[u32; 3]>` aborted.
+//!
+//! Covered: indexing and writes, `insert`, `remove`, `swap_remove`, `truncate`, `retain`,
+//! `reverse`, `sort_by_key`, `pop`, `clear`; capacity one grown past it, and rows larger than 1024
+//! bytes (allocated one at a time); `extend_from_slice`, `extend`, `collect`, `clone`, `vec![x; n]`
+//! and its zeroed form; every element type; `iter().flatten()`, `concat`, `as_chunks`,
+//! `chunks_exact` and `into_flattened`; `spare_capacity_mut`; `into_boxed_slice`; rows of rows.
+
+#![no_std]
+#![no_main]
+
+extern crate alloc;
+
+#[path = "prelude.rs"]
+mod prelude;
+use prelude::*;
+
+use alloc::vec::Vec;
+use alloc::vec;
+use core::hint::black_box as bb;
+
+#[derive(Clone, Copy, PartialEq, PartialOrd)]
+struct P { a: i32, b: u8 }
+
+#[inline(never)] fn s_u8(v: &[u8]) -> u32 { v.iter().fold(0u32, |x, y| x * 10 + *y as u32) }
+#[inline(never)] fn s_u32(v: &[u32]) -> u32 { v.iter().fold(0u32, |x, y| x.wrapping_mul(10).wrapping_add(*y)) }
+#[inline(never)] fn s_u64(v: &[u64]) -> u64 { v.iter().fold(0u64, |x, y| x * 10 + y) }
+#[inline(never)] fn rows_u32(v: &[[u32; 3]]) -> u32 { v.iter().map(|r| r[0] * 100 + r[1] * 10 + r[2]).sum() }
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    let v: Vec<[u32; 3]> = bb(vec![[0, 100, 200], [1, 101, 201], [2, 102, 202]]);
+    print_u32(v[1][1]);
+    print_u32(rows_u32(&v));
+    let mut w: Vec<[u32; 3]> = Vec::new();
+    print_usize(w.iter().count());
+    w.push([1, 2, 3]);
+    w.push([4, 5, 6]);
+    print_u32(w[1][2]);
+    for i in 0..20u32 { w.push([i, i + 1, i + 2]); }
+    print_usize(w.len());
+    print_u32(w[21][2] + w[0][0]);
+    w[3][1] = 99;
+    print_u32(w[3][1]);
+    print_u32(s_u32(&w.as_flattened()[6..12]));
+    w.as_flattened_mut()[7] = 77;
+    print_u32(w[2][1]);
+    w.insert(0, [7, 7, 7]);
+    print_u32(w[0][0] + w[1][0]);
+    let r = w.remove(1);
+    print_u32(r[2]);
+    let sr = w.swap_remove(0);
+    print_u32(sr[0] * 1000 + w[0][2]);
+    w.truncate(5);
+    print_usize(w.len());
+    w.retain(|r| r[0] % 2 == 0);
+    print_usize(w.len());
+    print_u32(rows_u32(&w));
+    w.reverse();
+    print_u32(w[0][0]);
+    w.sort_by_key(|r| r[0]);
+    print_u32(w[0][0]);
+    let popped = w.pop().unwrap();
+    print_u32(popped[1]);
+    w.clear();
+    print_usize(w.len());
+    // Capacity one, grown past it, and rows larger than 1024 bytes (allocated one at a time).
+    let mut c1: Vec<[u64; 2]> = Vec::with_capacity(1);
+    c1.push([1, 2]);
+    print_u64(s_u64(c1.as_flattened()));
+    c1.push([3, 4]);
+    c1.push([5, 6]);
+    print_u64(s_u64(c1.as_flattened()));
+    let mut big: Vec<[u8; 1500]> = Vec::new();
+    big.push([1; 1500]);
+    big.push([2; 1500]);
+    big.push([3; 1500]);
+    big[1][1499] = 9;
+    print_u32(big[0][0] as u32 + big[1][1499] as u32 + big[2][700] as u32);
+    print_usize(big.as_flattened().len());
+    print_u32(big.as_flattened()[2999] as u32);
+    // extend, extend_from_slice, collect, clone, from_elem.
+    let mut e: Vec<[u8; 2]> = Vec::new();
+    e.extend_from_slice(&[[1, 2], [3, 4]]);
+    e.extend([[5u8, 6], [7, 8]].iter().copied());
+    e.extend(core::iter::repeat([9u8, 9]).take(2));
+    print_u32(s_u8(e.as_flattened()));
+    let col: Vec<[u32; 2]> = (0..4u32).map(|i| [i, i * i]).collect();
+    print_u32(s_u32(col.as_flattened()));
+    let cl = col.clone();
+    print_u32(cl[3][1]);
+    let fe = vec![[1u32, 2]; 3];
+    print_u32(s_u32(fe.as_flattened()));
+    let fz = vec![[0u32; 3]; 4];
+    print_u32(fz.iter().flatten().sum::<u32>() + fz.len() as u32);
+    let fz1 = vec![[0u64; 2]; 1];
+    print_usize(fz1.as_flattened().len());
+    // Elements of every kind.
+    let vi: Vec<[i64; 2]> = bb(vec![[-1, 2], [3, -4]]);
+    print_i64(vi.as_flattened().iter().sum());
+    let vf: Vec<[f64; 2]> = bb(vec![[0.5, 1.0], [1.5, 2.0]]);
+    print_f64(vf.as_flattened().iter().sum());
+    let mut vp: Vec<[P; 2]> = bb(vec![[P { a: 1, b: 1 }, P { a: 2, b: 2 }]]);
+    vp.push([P { a: 3, b: 3 }, P { a: 4, b: 4 }]);
+    vp[1][0].a = 30;
+    print_i32(vp.as_flattened().iter().map(|p| p.a).sum());
+    let (q1, q2, q3) = (1u32, 2u32, 3u32);
+    let vr: Vec<[&u32; 3]> = bb(vec![[&q1, &q2, &q3], [&q3, &q2, &q1]]);
+    print_u32(vr.as_flattened().iter().fold(0, |a, b| a * 10 + **b));
+    // Flattening, concatenating, chunking, and into_flattened.
+    let fl: Vec<[u32; 2]> = bb(vec![[1, 2], [3, 4], [5, 6]]);
+    print_u32(fl.iter().flatten().fold(0, |a, b| a * 10 + b));
+    print_u32(s_u32(&fl.concat()));
+    let ch = fl.as_flattened().as_chunks::<2>().0;
+    print_u32(ch[1][1]);
+    let mut nn = 0;
+    for c in fl.as_flattened().chunks_exact(2) { nn = nn * 100 + c[0] * 10 + c[1]; }
+    print_u32(nn);
+    let mut flat: Vec<u32> = fl.into_flattened();
+    print_usize(flat.len());
+    flat.push(7);
+    flat.push(8);
+    print_u32(s_u32(&flat));
+    let one: Vec<[u32; 2]> = bb(vec![[4, 2]]);
+    let mut of: Vec<u32> = one.into_flattened();
+    of.push(1);
+    print_u32(s_u32(&of));
+    let spare: Vec<[u32; 3]> = Vec::with_capacity(4);
+    let mut sp = spare;
+    sp.spare_capacity_mut()[0].write([7, 8, 9]);
+    unsafe { sp.set_len(1); }
+    print_u32(sp[0][2]);
+    let bs = bb(vec![[1u32, 2], [3, 4]]).into_boxed_slice();
+    print_u32(bs[1][1] + bs.len() as u32);
+    let nested: Vec<[[u32; 2]; 2]> = bb(vec![[[1, 2], [3, 4]], [[5, 6], [7, 8]]]);
+    print_u32(s_u32(nested.as_flattened().as_flattened()));
+}
