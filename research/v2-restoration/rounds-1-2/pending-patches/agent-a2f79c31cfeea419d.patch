+      let row = p.buf[0];
+      if (!Array.isArray(row)) __rt._put(p.buf, 0, (row = new Array(n)));
+      __rt._blocks.set(row, { bytes: size, es: size / n, fresh: false, zeroed: false });
+      __rt._boxes.set(row, { buf: p.buf, off: 0 });
+      __rt._row_of.set(p.buf, row);
+    }
+    return q;
+  }
+  return __rt.window(unscale === undefined ? p : unscale(p, es, mk, kind), n);
