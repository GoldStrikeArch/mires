+  const slice = rt.slice_from_parts(undefined, 0)
+  assert.deepEqual([slice.len, rt.addr(slice, 1)], [0, rt._zst_addr])
+  // The dangling pointer of a `Vec<[u32; 3]>` that never allocated is a plain slot.
+  const never = rt.unscale_rows(4, 12, 3, () => 0, 4, rt.unscale_scalar, 'u32')
+  assert.deepEqual([never.w, never.off, rt.addr(never, 12)], [undefined, 0, 4])
+})
+
+test('the width of a row is read off the rows, or off the block before any is written', () => {
+  const rt = runtime()
+  // `Vec::<[u32; 2]>::with_capacity(3)`, nothing pushed yet, cast to its elements.
+  const raw = rt.alloc(24, 4)
+  const rows = rt.unscale_rows(raw, 8, 2, () => 0, 4, rt.unscale_scalar, 'u32')
+  const p = rt.unwindow(rows)
+  assert.equal(p.buf.length, 6)
+  p.buf[p.off + 3] = 9
+  assert.equal(raw.buf[1][1], 9)
+  assert.equal(raw.buf[1].length, 2)
+  // A byte view of rows of rows climbs back through both flattened views.
+  const cube = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]]
+  const bytes = rt.unwindow(rt.unwindow({ buf: cube, off: 0 }))
+  assert.equal(bytes.buf[5], 6)
+  same(rt.unscale_rows(bytes, 4, 2, () => [0, 0], 2, rt.unscale), { buf: cube, off: 0 })
+  same(rt.unscale_rows({ buf: bytes.buf, off: 4 }, 4, 2, () => [0, 0], 2, rt.unscale), { buf: cube, off: 1 })
+})
