diff --git a/examples/core-tests/225_array_row_shapes.rs b/examples/core-tests/225_array_row_shapes.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5ed2081e72a5ddef1d00384025cf49f3b785ac30
--- /dev/null
+++ b/examples/core-tests/225_array_row_shapes.rs
@@ -0,0 +1,95 @@
+//! The shapes next to heap arrays of arrays: by-value iteration of rows, the `Vec` operations that
+//! move rows around, `Rc` of rows, rows not written yet, and rows of rows.
+//!
+//! Covered: `for r in vec_of_rows` and `for r in [[..]; M]`, `<[[T; N]; M]>::map`; `drain`,
+//! `split_off`, `append`, `extend_from_within`, `dedup`, `resize`, `to_vec`, `sort_by_key`,
+//! `contains`, `binary_search_by_key`; `Rc<[T; N]>` and `Rc<[[T; N]]>`; `Box<[MaybeUninit<[T; N]>]>`
+//! and `[MaybeUninit<[T; N]>; M]` written row by row; `swap` and `windows` over a flattened view;
+//! `Vec<[[u8; 2]; 2]>` pushed and flattened twice, and flattened into `Vec<[u8; 2]>`.
+
+#![no_std]
+#![no_main]
+
+extern crate alloc;
+
+#[path = "prelude.rs"]
+mod prelude;
+use prelude::*;
+
+use alloc::boxed::Box;
+use alloc::rc::Rc;
+use alloc::vec::Vec;
+use alloc::vec;
+use core::mem::MaybeUninit;
+use core::hint::black_box as bb;
+
+#[inline(never)] fn s_u32(v: &[u32]) -> u32 { v.iter().fold(0u32, |x, y| x.wrapping_mul(10).wrapping_add(*y)) }
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    // By-value iteration of rows, of a Vec and of an array.
+    let v: Vec<[u32; 2]> = bb(vec![[1, 2], [3, 4], [5, 6]]);
+    let mut acc = 0;
+    for r in v { acc = acc * 100 + r[0] * 10 + r[1]; }
+    print_u32(acc);
+    let mut acc2 = 0;
+    for r in bb([[1u32, 2], [3, 4]]) { acc2 = acc2 * 100 + r[0] * 10 + r[1]; }
+    print_u32(acc2);
+    let mapped = bb([[1u32, 2], [3, 4]]).map(|r| [r[1], r[0]]);
+    print_u32(s_u32(mapped.as_flattened()));
+    // drain, split_off, append, extend_from_within, dedup, resize, to_vec, sort, search.
+    let mut w: Vec<[u32; 2]> = bb((0..6u32).map(|i| [i, i]).collect());
+    let d: Vec<[u32; 2]> = w.drain(1..3).collect();
+    print_u32(s_u32(d.as_flattened()));
+    let tail = w.split_off(2);
+    print_u32(s_u32(tail.as_flattened()) * 10 + w.len() as u32);
+    let mut tail = tail;
+    w.append(&mut tail);
+    print_usize(w.len());
+    w.extend_from_within(..2);
+    print_u32(s_u32(w.as_flattened()));
+    w.push(w[5]);
+    w.dedup();
+    print_usize(w.len());
+    w.resize(8, [9, 9]);
+    print_u32(w[7][1] + w.len() as u32);
+    let tv = w[..3].to_vec();
+    print_u32(s_u32(tv.as_flattened()));
+    let mut srt: Vec<[u32; 3]> = bb(vec![[3, 1, 2], [1, 9, 9], [2, 0, 0], [1, 2, 3]]);
+    srt.sort_by_key(|r| r[0] * 100 + r[1] * 10 + r[2]);
+    print_u32(srt[0][1] * 1000 + srt[1][0] * 100 + srt[3][0]);
+    print_bool(srt.contains(&[2, 0, 0]));
+    print_bool(srt.binary_search_by_key(&200, |r| r[0] * 100 + r[1] * 10 + r[2]).is_ok());
+    print_bool(srt.iter().any(|r| r == &[3, 1, 2]));
+    // Rc of rows, and an Rc slice of rows.
+    let rc: Rc<[u32; 3]> = bb(Rc::new([7, 8, 9]));
+    print_u32(rc[2] + rc.iter().sum::<u32>());
+    let rs: Rc<[[u32; 2]]> = bb(Rc::from(vec![[1u32, 2], [3, 4]]));
+    print_u32(rs[1][0] * 10 + rs[0][1]);
+    print_u32(s_u32(rs.as_flattened()));
+    // A boxed slice of rows not yet written.
+    let mut un: Box<[MaybeUninit<[u32; 2]>]> = Box::new_uninit_slice(3);
+    for (i, slot) in un.iter_mut().enumerate() { slot.write([i as u32, i as u32 + 1]); }
+    let un = unsafe { un.assume_init() };
+    print_u32(s_u32(un.as_flattened()));
+    let mut ua: [MaybeUninit<[u32; 2]>; 2] = [MaybeUninit::uninit(); 2];
+    ua[1].write([5, 6]);
+    ua[0].write([3, 4]);
+    let ua: [[u32; 2]; 2] = unsafe { core::mem::transmute(ua) };
+    print_u32(s_u32(ua.as_flattened()));
+    // Windows over a flattened view (swap_with_slice aborts on any slice of non-byte elements, pre-existing).
+    let mut a = bb([[1u32, 2], [3, 4]]);
+    a.as_flattened_mut().swap(1, 2);
+    print_u32(s_u32(a.as_flattened()));
+    let ww: u32 = a.as_flattened().windows(3).map(|x| x[0] + x[2]).sum();
+    print_u32(ww);
+    // Rows of rows on the heap, by Vec push.
+    let mut nested: Vec<[[u8; 2]; 2]> = Vec::new();
+    nested.push([[1, 2], [3, 4]]);
+    nested.push([[5, 6], [7, 8]]);
+    nested[1][0][1] = 60;
+    print_u32(nested.as_flattened().as_flattened().iter().map(|x| *x as u32).sum());
+    let lit: Vec<[[u8; 2]; 2]> = bb(vec![[[1, 2], [3, 4]], [[5, 6], [7, 8]]]);
+    let fl: Vec<[u8; 2]> = lit.into_flattened();
+    print_u32(fl[2][1] as u32 + fl.len() as u32);
+}
