+/// Two protected calls share one chain that tests a drop flag the edges pass as constants: the
+/// edge whose constant selects the empty arm goes, the other stays.
+#[test]
+fn a_shared_chain_is_split_by_the_constant_each_edge_passes() {
+    let mut interns = world();
+    let mut b = FuncBuilder::new(item(1), signature(1, I32));
+    let x = b.param(I32, O);
+    let entry = FuncBuilder::ENTRY;
+    let second = b.block();
+    let done = b.block();
+    let chain = b.block();
+    let dropping = b.block();
+    let rethrow = b.block();
+    let flag = b.block_param(chain, I32, O);
+    let guard = b.cell(I32, true, O);
+    b.effect(entry, OpKind::CellAlloc(guard), O);
+    b.effect(entry, OpKind::CellStore { cell: guard, v: x }, O);
+    let zero = constant(&mut b, entry, 0);
+    let one = constant(&mut b, entry, 1);
+    let first = b.op(entry, call(&mut interns, "first", vec![x]), I32, O);
+    b.terminate(
+        entry,
+        RTerm::Invoke {
+            normal: (second, vec![]),
+            unwind: (chain, vec![zero]),
+        },
+    );
+    let result = b.op(second, call(&mut interns, "second", vec![first]), I32, O);
+    b.terminate(
+        second,
+        RTerm::Invoke {
+            normal: (done, vec![]),
+            unwind: (chain, vec![one]),
+        },
+    );
+    b.terminate(done, RTerm::Return(Some(result)));
+    b.terminate(
+        chain,
+        RTerm::Switch {
+            scrut: flag,
+            scrut_ty: I32,
+            cases: vec![(1, dropping, vec![])],
+            default: (rethrow, vec![]),
+        },
+    );
+    let kind = drop_guard(&mut interns, guard);
+    b.effect(dropping, kind, O);
+    b.terminate(dropping, RTerm::Goto(rethrow, vec![]));
+    b.terminate(rethrow, RTerm::Throw(None));
+    let func = b.finish();
+    let mut program = Program::new(interns);
+    program.add("entry", func, &[]);
+    let (funcs, stats) = program.run(false);
+    assert_eq!(
+        stats.removed,
+        [Removed {
+            item: JsName::new("entry".to_owned()),
+            block: 0,
+            reason: "empty-chain",
+            callee: None,
+        }]
+    );
+    assert_eq!(stats.retained_edges, 1);
+    assert_eq!(stats.chain_observable["Drop"], 1);
+    let after = funcs[&JsName::new("entry".to_owned())].as_ref().unwrap();
+    assert!(matches!(after.blocks[0].term, RTerm::Goto(..)));
+    assert!(after.has_invoke(), "the second edge keeps the shared chain");
+    let harness = r#"
+let trace, thrown, failing;
+function first(x) { trace.push('first'); if (failing === 'first') throw inputs[thrown]; return x + 1; }
+function second(x) { trace.push('second'); if (failing === 'second') throw inputs[thrown]; return x * 2; }
+function drop_guard(slot) { trace.push(['drop', slot.buf[slot.off]]); }
+function observe(entry) {
+  const out = [];
+  for (failing of [null, 'first', 'second']) for (thrown of inputs.keys()) {
+    trace = [];
+    try { out.push(['ret', entry(5), trace]); }
+    catch (error) { out.push(['threw', describe(error), trace]); }
+  }
+  return out;
+}
+"#;
+    check_same_as_baseline(
+        &program.interns,
+        program.func("entry"),
+        after,
+        &[],
+        harness,
+        1,
+    )
+    .unwrap();
+}
