+    /// The three no-throw lists -- the publisher's (`effects.rs`), this recompute's, and the
+    /// cleanup-edge witness's -- are separate literals on purpose, and must name exactly the same
+    /// intrinsics and the same quiet host markers. A name in one list only is either a removal the
+    /// recompute or the witness refuses, or a claim nothing checks.
+    #[test]
+    fn the_three_no_throw_lists_name_the_same_sets() {
+        use crate::analysis::effects::{self as effects, Rules};
+        use crate::jir::repr::RBlockId;
+        use crate::opt::witness::{CleanupProof, ProtectedOp, Witness};
+        let mut interns = Interns::new();
+        let summaries = effects::Summaries::default();
+        let one_op = |kind: OpKind| {
+            let mut b = FuncBuilder::new(
+                id(9),
+                Signature {
+                    arguments: vec![],
+                    result: TY,
+                    abi: AbiSignature::default(),
+                },
+            );
+            b.effect(FuncBuilder::ENTRY, kind, O);
+            b.terminate(FuncBuilder::ENTRY, RTerm::Return(None));
+            b.finish()
+        };
+        let witnessed = |func: &Func, interns: &Interns, protected: ProtectedOp| {
+            Witness::CleanupEdge {
+                block: RBlockId(0),
+                proof: CleanupProof::NoThrow { protected },
+            }
+            .check(func, &interns.types)
+            .is_ok()
+        };
+        let candidates = list_candidates();
+        let mut quiet_intrinsics = Vec::new();
+        let mut quiet_markers = Vec::new();
+        let mut disagreements = Vec::new();
+        for token in &candidates {
+            for name in [token.clone(), format!("{token}f32"), format!("{token}f64")] {
+                let symbol = interns.intern_str(&name);
+                let func = one_op(OpKind::Intrinsic {
+                    name: symbol,
+                    types: vec![],
+                    fallback: None,
+                    args: vec![],
+                });
+                let published = effects::intrinsic_raises_nothing(&name, Rules::ALL);
+                let recomputed = !throws(&func, Some(&interns), &summaries, None, false);
+                let witness = witnessed(&func, &interns, ProtectedOp::Intrinsic(name.clone()));
+                if published != recomputed || published != witness {
+                    disagreements.push(format!(
+                        "intrinsic {name}: effects {published}, summary_check {recomputed}, \
+                         witness {witness}"
+                    ));
+                }
+                if published {
+                    quiet_intrinsics.push(name);
+                }
+            }
+            let section = match token.strip_prefix("rcgjs.host.") {
+                Some(_) => token.clone(),
+                None => format!("rcgjs.host.{token}"),
+            };
+            let symbol = interns.intern_str(&section);
+            let func = one_op(OpKind::Call {
+                callee: Callee::Direct {
+                    item: id(0),
+                    link_name: symbol,
+                },
+                function: None,
+                args: vec![],
+                track_caller: None,
+                semantic: CallSemantic::Ordinary,
+                host: Some(HostPayload::Marker {
+                    section: symbol,
+                    def: id(0).definition,
+                    template: None,
+                    helpers: Vec::new(),
+                }),
+            });
+            let published = effects::host_operation_raises_nothing(&section, Rules::ALL);
+            let recomputed = !throws(&func, Some(&interns), &summaries, None, false);
+            let witness = witnessed(&func, &interns, ProtectedOp::HostOperation(section.clone()));
+            if published != recomputed || published != witness {
+                disagreements.push(format!(
+                    "marker {section}: effects {published}, summary_check {recomputed}, witness \
+                     {witness}"
+                ));
+            }
+            if published {
+                quiet_markers.push(section);
+            }
+        }
+        assert!(disagreements.is_empty(), "{disagreements:#?}");
+        // The sweep saw the lists at all: the families each list is known to hold.
+        for expected in ["abort", "ctpop", "caller_location", "sqrtf64"] {
+            assert!(
+                quiet_intrinsics.iter().any(|name| name == expected),
+                "{expected}"
+            );
+        }
+        for expected in [
+            "rcgjs.host.undefined",
+            "rcgjs.host.callback1",
+            "rcgjs.host.u8arrayfrombytes",
+        ] {
+            assert!(
+                quiet_markers.iter().any(|name| name == expected),
+                "{expected}"
+            );
+        }
+    }
 }
