+// ---------------------------------------------------------------------------------------------
+// Stage 4'a (iv): markers that create a closure, and a drop-free `try`
+// ---------------------------------------------------------------------------------------------
+
+fn marker_with(interns: &mut Interns, section: &str, args: Vec<ValueId>) -> OpKind {
+    let mut kind = marker(interns, section);
+    if let OpKind::Call { args: slot, .. } = &mut kind {
+        *slot = args;
+    }
+    kind
+}
+
+/// `entry(env, this, list)`: a guard cell, `f = callback1(env) [unwind: c]`, then
+/// `r = invoke(f, this, list) [unwind: c]`, `return r`; `c` drops the guard and rethrows.
+fn callback_then_invoke(interns: &mut Interns) -> Func {
+    let mut sig = signature(3, I32);
+    sig.arguments = vec![CLOSURE, I32, I32];
+    let mut b = FuncBuilder::new(item(1), sig);
+    let env = b.param(CLOSURE, O);
+    let this = b.param(I32, O);
+    let list = b.param(I32, O);
+    let entry = FuncBuilder::ENTRY;
+    let second = b.block();
+    let done = b.block();
+    let chain = b.block();
+    let guard = b.cell(I32, true, O);
+    b.effect(entry, OpKind::CellAlloc(guard), O);
+    let seven = constant(&mut b, entry, 7);
+    b.effect(
+        entry,
+        OpKind::CellStore {
+            cell: guard,
+            v: seven,
+        },
+        O,
+    );
+    let f = b.op(
+        entry,
+        marker_with(interns, "rcgjs.host.callback1", vec![env]),
+        I32,
+        O,
+    );
+    b.terminate(
+        entry,
+        RTerm::Invoke {
+            normal: (second, vec![]),
+            unwind: (chain, vec![]),
+        },
+    );
+    let result = b.op(
+        second,
+        marker_with(interns, "rcgjs.host.invoke", vec![f, this, list]),
+        I32,
+        O,
+    );
+    b.terminate(
+        second,
+        RTerm::Invoke {
+            normal: (done, vec![]),
+            unwind: (chain, vec![]),
+        },
+    );
+    b.terminate(done, RTerm::Return(Some(result)));
+    let kind = drop_guard(interns, guard);
+    b.effect(chain, kind, O);
+    b.terminate(chain, RTerm::Throw(None));
+    b.finish()
+}
+
+/// The callback's body throws what the host is told to; `invoke` runs it through
+/// `Reflect.apply`, so a throw there is a host throw inside the retained edge.
+const CALLBACK_HARNESS: &str = r#"
+let trace, thrown;
+function cb_body(env, a) { trace.push(['cb', env.tag, a]); if (thrown !== null) throw inputs[thrown]; return a + 1; }
+function drop_guard(slot) { trace.push(['drop', slot.buf[slot.off]]); }
+function observe(entry) {
+  const out = [];
+  for (thrown of [null, ...inputs.keys()]) {
+    trace = [];
+    try { out.push(['ret', entry({ tag: 'env' }, null, { buf: [41], off: 0, len: 1 }), trace]); }
+    catch (error) { out.push(['threw', describe(error), __rt.is_abort(error), trace]); }
+  }
+  return out;
+}
+"#;
+
+#[test]
+fn creating_a_callback_is_deprotected_while_invoking_it_stays_protected() {
+    let mut interns = world();
+    let func = callback_then_invoke(&mut interns);
+    let mut program = Program::new(interns);
+    program.add("entry", func, &[]);
+    let (funcs, stats) = program.run(false);
+    let after = funcs[&JsName::new("entry".to_owned())].as_ref().unwrap();
+    // Every host throw inside `invoke` still drops the guard, in every cell, exactly as before:
+    // checked on whatever the pass printed, before the counts say why.
+    let kept = after
+        .blocks
+        .iter()
+        .filter(|block| matches!(block.term, RTerm::Invoke { .. }))
+        .count();
+    check_same_as_baseline_with(
+        &program.interns,
+        program.func("entry"),
+        after,
+        &[],
+        &closure_items("cb_body", 1),
+        CALLBACK_HARNESS,
+        kept,
+    )
+    .unwrap();
+    assert_eq!(kept, 1, "the invoke keeps its edge");
+    assert_eq!(
+        stats.removed,
+        [Removed {
+            item: JsName::new("entry".to_owned()),
+            block: 0,
+            reason: NO_THROW_MARKER,
+            callee: None,
+        }]
+    );
+    assert_eq!(stats.removed_new_classes["marker"], 1);
+    assert_eq!(stats.retained_edges, 1);
+    assert_eq!(stats.retained_leaves["host-marker rcgjs.host.invoke"], 1);
+}
+
+/// Mutation: with `invoke` treated as non-throwing too, the host's throw skips the destructor,
