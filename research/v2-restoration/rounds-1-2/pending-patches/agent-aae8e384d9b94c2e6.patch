+#[cfg(test)]
+thread_local! {
+    /// Mutation knob: treat `Drop` as unobservable. The drop-chain test must then fail, which is
+    /// what shows the emission harness can see a destructor go missing.
+    static DROP_UNOBSERVABLE: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
