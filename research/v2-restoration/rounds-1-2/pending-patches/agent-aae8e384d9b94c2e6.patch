+
+/// `entry(x: param)`: a guard cell, `r = op [unwind: drop guard; rethrow]`, `return r` (or
+/// `return x` when the op has no result).
+fn protected_value(
+    interns: &mut Interns,
+    param: TypeId,
+    result: Option<TypeId>,
+    op: impl FnOnce(&mut Interns, &mut FuncBuilder, ValueId) -> OpKind,
+) -> Func {
+    let mut sig = signature(1, result.unwrap_or(param));
+    sig.arguments = vec![param];
+    let mut b = FuncBuilder::new(item(1), sig);
+    let x = b.param(param, O);
+    let entry = FuncBuilder::ENTRY;
+    let normal = b.block();
+    let chain = b.block();
+    let guard = b.cell(I32, true, O);
+    b.effect(entry, OpKind::CellAlloc(guard), O);
+    let seven = constant(&mut b, entry, 7);
+    b.effect(
+        entry,
+        OpKind::CellStore {
+            cell: guard,
+            v: seven,
+        },
+        O,
+    );
+    let kind = op(interns, &mut b, x);
+    let value = match result {
+        Some(ty) => b.op(entry, kind, ty, O),
+        None => {
+            b.effect(entry, kind, O);
+            x
+        }
+    };
+    b.terminate(
+        entry,
+        RTerm::Invoke {
+            normal: (normal, vec![]),
+            unwind: (chain, vec![]),
+        },
+    );
+    b.terminate(normal, RTerm::Return(Some(value)));
+    let kind = drop_guard(interns, guard);
+    b.effect(chain, kind, O);
+    b.terminate(chain, RTerm::Throw(None));
+    b.finish()
+}
+
+fn intrinsic_of(
+    interns: &mut Interns,
+    name: &str,
+    types: Vec<TypeId>,
+    args: Vec<ValueId>,
+) -> OpKind {
+    OpKind::Intrinsic {
+        name: interns.intern_str(name),
+        types,
+        fallback: None,
+        args,
+    }
+}
+
+type ValueOp = fn(&mut Interns, &mut FuncBuilder, ValueId) -> OpKind;
+
+/// One positive per audited family, run through every emission cell: the edge goes as
+/// `no-throw-intrinsic` and every cell observes what the protected baseline did.
+#[test]
+fn an_audited_intrinsic_of_every_family_is_deprotected() {
+    let cases: [(&str, TypeId, Option<TypeId>, &str, ValueOp); 8] = [
+        ("layout", I32, Some(I32), "4", |interns, _, _| {
+            intrinsic_of(interns, "size_of", vec![I32], vec![])
+        }),
+        ("validity", I32, None, "4", |interns, _, _| {
+            intrinsic_of(interns, "assert_inhabited", vec![I32], vec![])
+        }),
+        ("bits", I32, Some(I32), "-1", |interns, _, x| {
+            intrinsic_of(interns, "ctpop", vec![I32], vec![x])
+        }),
+        ("bits-bigint", I64, Some(I32), "-5n", |interns, _, x| {
+            intrinsic_of(interns, "ctpop", vec![I64], vec![x])
+        }),
+        (
+            "saturating",
+            I32,
+            Some(I32),
+            "2147483000",
+            |interns, _, x| intrinsic_of(interns, "saturating_add", vec![I32], vec![x, x]),
+        ),
+        ("wrapping", I32, Some(I32), "65537", |interns, _, x| {
+            intrinsic_of(interns, "wrapping_mul", vec![I32], vec![x, x])
+        }),
+        ("rotate", I32, Some(I32), "-7", |interns, _, x| {
+            intrinsic_of(interns, "rotate_left", vec![I32], vec![x, x])
+        }),
+        ("float", F64, Some(F64), "2.25", |interns, _, x| {
+            intrinsic_of(interns, "sqrtf64", vec![], vec![x])
+        }),
+    ];
+    for (family, param, result, input, op) in cases {
+        let mut interns = world();
+        let func = protected_value(&mut interns, param, result, op);
+        let mut program = Program::new(interns);
+        program.add("entry", func, &[]);
+        let (funcs, stats) = program.run(false);
+        assert_eq!(reasons(&stats), [NO_THROW_INTRINSIC], "{family}");
+        let after = funcs[&JsName::new("entry".to_owned())].as_ref().unwrap();
+        let harness = format!(
+            r#"
+let trace;
+function drop_guard(slot) {{ trace.push(['drop', slot.buf[slot.off]]); }}
+function observe(entry) {{ trace = []; return [String(entry({input})), trace]; }}
+"#
+        );
+        check_same_as_baseline(
+            &program.interns,
+            program.func("entry"),
+            after,
+            &[],
+            &harness,
+            0,
+        )
+        .unwrap_or_else(|why| panic!("{family}: {why}"));
+    }
+}
