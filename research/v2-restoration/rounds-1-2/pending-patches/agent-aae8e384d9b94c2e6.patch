+        CleanupProof::EmptyChain { ops, terms } => {
+            if let Some(op) = ops.iter().find(|op| !chain_op_unobservable(op)) {
+                return Err(format!("the chain runs an observable operation: {op:?}"));
+            }
+            if let Some(term) = terms.iter().find(|term| {
+                !matches!(
+                    term,
+                    RTerm::Goto(..) | RTerm::Switch { .. } | RTerm::Throw(None)
+                )
+            }) {
+                return Err(format!(
+                    "the chain ends in an observable terminator: {term:?}"
+                ));
+            }
+            if !terms.iter().any(|term| matches!(term, RTerm::Throw(None))) {
+                return Err("the chain never reaches the rethrow".to_owned());
+            }
+            Ok(())
+        }
+        CleanupProof::NoThrow { protected } => match protected {
+            ProtectedOp::Rust { .. } | ProtectedOp::Registry | ProtectedOp::Nop => Ok(()),
+            // Like a direct call, the claim rests on the defining body's summary; a symbol the
+            // interns could not spell names no body at all.
+            ProtectedOp::Foreign { symbol: Some(_) } => Ok(()),
+            ProtectedOp::Foreign { symbol: None } => {
+                Err("a foreign call whose symbol is not spelled".to_owned())
+            }
+            ProtectedOp::Drop { dynamic: false, .. } => Ok(()),
+            ProtectedOp::Drop { dynamic: true, .. } => {
+                Err("dynamic drop glue can run any destructor".to_owned())
+            }
+            ProtectedOp::Intrinsic(name) if quiet_intrinsic(name) => Ok(()),
+            ProtectedOp::HostOperation(section)
+                if matches!(
+                    section.strip_prefix("rcgjs.host."),
+                    Some(
+                        "undefined"
+                            | "null"
+                            | "isundefined"
+                            | "isnull"
+                            | "truthy"
+                            | "stricteq"
+                            | "isboolean"
+                            | "isnumber"
+                            | "isbigint"
+                            | "isstring"
+                            | "isfunction"
+                            | "isobject"
+                            | "isinteger"
+                            | "erase"
+                            // The byte export: `__rt.u8array_from_bytes` turns every failure into
+                            // a registered abort (Stage 5e).
+                            | "u8arrayfrombytes"
+                            // Closure creation (Stage 4'a): the thunk is built, never called.
+                            | "callback0"
+                            | "callback1"
+                            | "callback2"
+                            | "callback3"
+                            | "callback4"
+                            | "localwaker"
+                    )
+                ) =>
+            {
+                Ok(())
+            }
+            ProtectedOp::HostOperation(section) => {
+                Err(format!("the host operation `{section}` may throw"))
+            }
+            // `__rt.host_try` catches what the closure raises; only drop glue in its `finally`
+            // can escape it.
+            ProtectedOp::HostTry { closure } => {
+                let peeled = table.peeled(*closure);
+                match table
+                    .get(peeled)
+                    .map(|descriptor| descriptor.layout.needs_drop)
+                {
+                    Some(false) => Ok(()),
+                    Some(true) => Err("a `try` closure with drop glue may throw".to_owned()),
+                    None => Err("a `try` closure of a type the table does not know".to_owned()),
+                }
+            }
+            ProtectedOp::Intrinsic(name) => Err(format!("the intrinsic `{name}` may throw")),
+            ProtectedOp::Host {
+                trusted_contract: true,
+            } => Ok(()),
+            ProtectedOp::Host {
+                trusted_contract: false,
+            } => Err("an untrusted host call may throw".to_owned()),
+        },
+    }
+}
