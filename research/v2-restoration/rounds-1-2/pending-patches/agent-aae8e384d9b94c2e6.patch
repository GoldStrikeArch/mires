+/// Whether a chain operation is invisible when the chain only rethrows: it writes nothing, calls
+/// nothing, and raises nothing on Rust-valid operands. BigInt `Div`/`Rem` raise a `RangeError` on a
+/// zero divisor whose guard sits outside the chain, so they are not.
+fn chain_op_unobservable(op: &OpKind) -> bool {
+    match op {
+        OpKind::Const(_)
+        | OpKind::Move(_)
+        | OpKind::Copy(_)
+        | OpKind::Aggregate { .. }
+        | OpKind::Field { .. }
+        | OpKind::Discriminant(_)
+        | OpKind::CellLoad(_)
+        | OpKind::Unary { .. }
+        | OpKind::BorrowView { .. }
+        | OpKind::RawView { .. }
+        | OpKind::SliceView { .. } => true,
+        OpKind::Binary { op, .. } => {
+            !matches!(op, BinaryOp::Offset | BinaryOp::Div | BinaryOp::Rem)
+        }
+        OpKind::Cast { kind, .. } => matches!(
+            kind,
+            CastKind::IntToInt | CastKind::FloatToFloat | CastKind::IntToFloat | CastKind::Subtype
+        ),
+        _ => false,
+    }
+}
