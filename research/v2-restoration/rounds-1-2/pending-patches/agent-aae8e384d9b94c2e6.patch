+    fn a_foreign_definition_that_may_throw_invalidates_a_quiet_caller() {
+        let mut interns = Interns::new();
+        let symbol = interns.intern_str("handler");
+        let mut b = FuncBuilder::new(
+            id(9),
+            Signature {
+                arguments: vec![],
+                result: TY,
+                abi: AbiSignature::default(),
+            },
+        );
+        b.effect(
+            FuncBuilder::ENTRY,
+            OpKind::Call {
+                callee: Callee::Foreign {
+                    definition: id(0).definition,
+                    symbol,
+                },
+                function: None,
+                args: vec![],
+                track_caller: None,
+                semantic: CallSemantic::Ordinary,
+                host: None,
+            },
+            O,
+        );
+        b.terminate(FuncBuilder::ENTRY, RTerm::Return(None));
+        let caller = b.finish();
+        let mut b = FuncBuilder::new(
+            id(8),
+            Signature {
+                arguments: vec![],
+                result: TY,
+                abi: AbiSignature::default(),
+            },
+        );
+        b.terminate(FuncBuilder::ENTRY, RTerm::Return(None));
+        let handler = b.finish();
+        let funcs: BTreeMap<JsName, Result<Func, Decline>> = [
+            (JsName::new("caller".to_owned()), Ok(caller)),
+            (JsName::new("handler".to_owned()), Ok(handler)),
+        ]
+        .into_iter()
+        .collect();
+        let interns_map: BTreeMap<JsName, &Interns> =
+            funcs.keys().map(|name| (name.clone(), &interns)).collect();
+        let graph = callgraph::build(&funcs, &interns_map);
+        let mut summaries = effects::compute(&funcs, &interns_map, &graph);
+        let caller = JsName::new("caller".to_owned());
+        let handler = JsName::new("handler".to_owned());
+        assert!(!summaries.get(&caller).unwrap().may_throw);
+        let mut claim = summaries.get(&handler).unwrap().clone();
+        claim.may_throw = true;
+        claim.purity = effects::Purity::Effect;
+        summaries.insert(handler.clone(), claim);
+        let violations = enforce(&mut summaries, &funcs, &interns_map, &graph);
+        assert!(violations.iter().any(|violation| violation.name == caller));
+    }
