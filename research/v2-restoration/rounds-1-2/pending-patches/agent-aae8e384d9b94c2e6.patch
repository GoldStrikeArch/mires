+pub fn host_operation_raises_nothing(section: &str, rules: Rules) -> bool {
+    use rcgjs_object::host::HostOperation as Op;
+    let Some(marker) = section.strip_prefix(crate::lower::js::host::HOST_PREFIX) else {
+        return false;
+    };
+    // -- Every marker `HostOperation::emit` lowers: its own declared contract,
+    // `HostOperation::may_throw`, is the one table (value-only operations, the byte export).
+    // It is not a Stage 4'a rule, so every `rules` reads it.
+    if let Some(operation) = Op::from_marker(marker) {
+        return !operation.may_throw();
+    }
+    // -- The closure-creation markers (Stage 4'a), which are not `HostOperation`s: they take a
+    // closure, not values, and `lower/js/host.rs::host_marker` lowers them itself, so
+    // `HostOperation::may_throw` has no entry for them. `host_marker` prints the
+    // thunk `closure_thunk` builds, and nothing that calls it: an optional assignment of the
+    // environment to a temporary, then an arrow `(...$aN) => body(env, ...$aN)`, or, in a body
+    // with a cycle, the snapshot `(($c) => (...$aN) => body($c, ...$aN))(env)` -- an immediately
+    // called arrow that only returns an arrow. `localwaker` wraps it in
+    // `__rt.host_local_waker(f)`, which builds an object literal and reads or once assigns an
+    // ordinary property of its own function object. None of them runs host or Rust code, so
+    // de-protecting the creation cannot move when the environment is captured: the same
+    // statements run at the same point, only outside the `try`. Running the thunk later is the
+    // host's call (`invoke`), which stays protected. Rejected: `promise` (`new Promise(..)` looks
+    // up a global the host may replace), `microtask` (`queueMicrotask`), `task`
+    // (`new MessageChannel()`), `settled` (reads `value.then`, a host getter).
+    rules.markers
