+/// The pass's `entry`, printed in every cell, against a handler whose host call throws: every
+/// cell must run the guard's destructor on the way out.
+fn handler_destructor_runs(program: &Program, funcs: &BTreeMap<JsName, Result<Func, Decline>>) {
+    let after = funcs[&JsName::new("entry".to_owned())].as_ref().unwrap();
+    let entries = matrix(&program.interns, after, &[]);
+    let harness = format!(
+        "{THROWN}{}{}",
+        handler_stub(true),
+        r#"
+for (const [label, entry] of entries) {
+  trace = []; thrown = 0;
+  try { entry(3); throw new Error('returned'); } catch (error) { if (error !== inputs[0]) throw error; }
+  if (!trace.some((step) => Array.isArray(step) && step[0] === 'drop')) {
+    throw new Error(`${label} skipped the destructor: ${JSON.stringify(trace)}`);
+  }
+}
+console.log('ok');
+"#
+    );
+    assert_eq!(node(&entries, &harness).unwrap(), "ok");
+}
