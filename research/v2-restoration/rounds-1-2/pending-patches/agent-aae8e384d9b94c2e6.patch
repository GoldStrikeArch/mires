+                            pair.0.fold(&mut escaped);
+                            escaped.flag(pair.1);
+                        }
+                        let pair = black_box(a.overflowing_mul(b));
+                        pair.0.fold(&mut escaped);
+                        escaped.flag(pair.1);
+                    }
+                }
+                round += 1;
+            }
+            print_str($label);
+            print_u32(overflowing.0);
+            print_u32(checked.0);
+            print_u32(wrapping.0);
+            print_u32(saturating.0);
+            print_u32(escaped.0);
+            let mut flags = 0u32;
+            for (i, &(a, b)) in black_box(&$edges).iter().enumerate() {
+                let a: $t = a;
+                let b: $t = b;
+                let (r, o) = a.overflowing_add(b);
