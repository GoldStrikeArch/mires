+/// Mutation 2: with `Drop` treated as unobservable, the drop chain is "removed" and the harness
+/// sees the destructor go missing. The independent witness refuses the same rewrite.
+#[test]
+fn treating_drop_as_unobservable_is_caught_by_the_harness_and_the_witness() {
+    let mut interns = world();
+    let func = guarded(&mut interns, |interns, cell, _| drop_guard(interns, cell));
+    func.verify(&interns.types).unwrap();
+    DROP_UNOBSERVABLE.with(|knob| knob.set(true));
+    let block = &func.blocks[0];
+    let proof = empty_chain(&func, block);
+    DROP_UNOBSERVABLE.with(|knob| knob.set(false));
+    let (ops, terms) = proof.expect("the knob admits the drop");
+    let decisions = [Decision {
+        block: RBlockId(0),
+        verdict: Verdict::Remove {
+            reason: "empty-chain",
+            callee: None,
+            proof: CleanupProof::EmptyChain { ops, terms },
+            classes: 0,
+        },
+    }];
+    let (after, witnesses) = rewrite(&func, &decisions).expect("a removal");
+    after.verify(&interns.types).unwrap();
+    let detected = check_same_as_baseline(&interns, &func, &after, &[], GUARD_HARNESS, 0);
+    let why = detected.expect_err("the harness must see the missing destructor");
+    assert!(
+        why.contains("observed") && why.contains("\"drop\""),
+        "{why}"
+    );
+    assert!(crate::opt::witness::check_all(&witnesses, &after, &interns.types).is_err());
+}
