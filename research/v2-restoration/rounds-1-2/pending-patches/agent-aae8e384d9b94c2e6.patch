+    let ([closure], Some(types)) = (args, types) else {
+        return false;
+    };
+    let Some(value) = func.values.get(closure.0 as usize) else {
+        return false;
+    };
+    types
+        .get(types.peeled(value.ty))
+        .is_some_and(|descriptor| !descriptor.layout.needs_drop)
