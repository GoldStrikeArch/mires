+++ b/scripts/cleanup-edges-test.sh
@@ -0,0 +1,130 @@
+#!/usr/bin/env bash
+# Cleanup-edge removal (jsc-link/src/plan/cleanup.rs): the lane sidecar's `cleanup` block for the
+# cleanup fixtures, with the O group's `cleanup` pass on and off.
+#
+#   scripts/cleanup-edges-test.sh            # compare against scripts/fixtures/cleanup-edges/
+#   CLEANUP_EDGES_BLESS=1 scripts/cleanup-edges-test.sh   # rewrite the expectations
+#
+# Each fixture is linked twice under the release-balanced profile: with every JIR pass (`on`) and
+# with every pass but `cleanup` (`off`, through `RCGJS_JIR_PASSES`). Both programs must behave
+# exactly as the fixture's own check requires. The `on` block must equal the checked-in JSON and
+# remove at least one edge with fewer `try` statements than `off`; the `off` block must remove
+# nothing. `abort_guard` (this directory's fixture) aborts under a live Drop guard twice -- a
+# bounds-check panic whose handler only aborts, and a malformed byte export: both programs abort
+# with the guard undropped, and the `on` block shows the removals in `pick` and `export_bytes`.
+set -euo pipefail
+root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
+cd "$root"
+source scripts/integration-lock.sh
+work="$root/build/cleanup-edges"
+expected="$root/scripts/fixtures/cleanup-edges"
+core_fixture=${CLEANUP_EDGES_CORE_FIXTURE:-02_result}
+mkdir -p "$work/proc-macro" "$expected"
+if [ "${SKIP_BUILD:-0}" != 1 ]; then bash scripts/build.sh --locked >"$work/build.log"; fi
+cargo build -p js-extern-macro --locked >"$work/macro.log" 2>&1
+case "$(uname -s)" in Darwin) ext=dylib ;; *) ext=so ;; esac
+macro="$root/target/debug/libjs_extern_macro.$ext"
+ln -sf "$macro" "$work/proc-macro/libjs_extern_macro.$ext"
+node scripts/make-esm-shim.mjs "$work/shim.mjs"
+export JS_EXTRA_ARGS="js-profile=release-balanced js-cleanup=on js-opt=on"
+SKIP_BUILD=1 bash scripts/build_sysroot.sh >"$work/sysroot.log" 2>&1
+bash scripts/compile_core.sh mires-js/src/lib.rs "$work/libmires_js.rlib" --crate-type rlib \
+  --crate-name mires_js --extern "js_extern_macro=$macro" >"$work/library.log" 2>&1
+
+all_but_cleanup='constprop,inline,devirt,pea,host-args,slice-iter,range,dce'
+# The sidecar's `cleanup` block, pretty-printed one key per line so a mismatch diffs readably.
+block() {
+  node -e '
+    const sidecar = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
+    if (!sidecar.cleanup) throw new Error("the sidecar has no cleanup block");
+    process.stdout.write(JSON.stringify(sidecar.cleanup, null, 1) + "\n");
+  ' "$1.lane.json"
+}
+removed() { node -e 'console.log(JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).removed.length)' "$1"; }
+tries() { { grep -o 'try *{' "$1" || true; } | wc -l | tr -d ' '; }
+
+failures=0
+check() {
+  local name=$1 on=$2 off=$3
+  block "$on" >"$work/$name-on.json"
+  block "$off" >"$work/$name-off.json"
+  if [ "${CLEANUP_EDGES_BLESS:-0}" = 1 ]; then
+    cp "$work/$name-on.json" "$expected/$name.json"
+    echo "$name: blessed $expected/$name.json"
+  fi
+  if ! diff -u "$expected/$name.json" "$work/$name-on.json" >"$work/$name.diff"; then
+    echo "$name: cleanup block differs from $expected/$name.json:" >&2
+    sed 's/^/  /' "$work/$name.diff" >&2
+    failures=$((failures + 1))
+  fi
+  local removed_on removed_off tries_on tries_off
+  removed_on=$(removed "$work/$name-on.json")
+  removed_off=$(removed "$work/$name-off.json")
+  tries_on=$(tries "$on")
+  tries_off=$(tries "$off")
+  echo "$name: removed $removed_on edges (off: $removed_off); try statements $tries_on (off: $tries_off)"
+  if [ "$removed_off" != 0 ] || [ "$removed_on" = 0 ] || [ "$tries_on" -ge "$tries_off" ]; then
+    echo "$name: expected removals with the pass on, none with it off, and fewer try statements" >&2
+    failures=$((failures + 1))
+  fi
+}
+
+for pass in on off; do
+  if [ "$pass" = on ]; then passes=''; else passes=$all_but_cleanup; fi
+  program="$work/active_poll_cleanup-$pass.mjs"
+  env ${passes:+RCGJS_JIR_PASSES=$passes} \
+    JS_EXTRA_ARGS="$JS_EXTRA_ARGS js-lane=jir js-modules=esm js-shim-module=./shim.mjs" \
+    bash scripts/compile_core.sh examples/active_poll_cleanup.rs "$program" \
+    --extern "mires_js=$work/libmires_js.rlib" --search "$work/proc-macro" >"$program.compile.log" 2>&1
+  node scripts/active-poll-cleanup-check.mjs "$program" >"$program.result.json"
+  echo "active_poll_cleanup/$pass: active-call/drop cases passed"
+
+  program="$work/$core_fixture-$pass.js"
+  env ${passes:+RCGJS_JIR_PASSES=$passes} JS_EXTRA_ARGS="$JS_EXTRA_ARGS js-lane=jir" \
+    bash scripts/compile_core.sh "examples/core-tests/$core_fixture.rs" "$program" \
+    --extern "mires_js=$work/libmires_js.rlib" --search "$work/proc-macro" >"$program.compile.log" 2>&1
+  cat runtime/shim.js "$program" scripts/entry.js | node - >"$program.out"
+  diff -u "examples/core-tests/$core_fixture.expected" "$program.out"
+  echo "$core_fixture/$pass: output matches its expectation"
+
+  # Protected operations under a live Drop guard that can raise nothing but an abort: a
+  # bounds-check panic whose handler only aborts (Stage 4'a), and the byte export (Stage 5e). Each
+  # program must abort with the guard NOT dropped, identically with the pass on and off.
+  program="$work/abort_guard-$pass.js"
+  env ${passes:+RCGJS_JIR_PASSES=$passes} JS_EXTRA_ARGS="$JS_EXTRA_ARGS js-lane=jir" \
+    bash scripts/compile_core.sh "$expected/abort_guard.rs" "$program" \
+    --extern "mires_js=$work/libmires_js.rlib" --search "$work/proc-macro" >"$program.compile.log" 2>&1
+  for entry in rust_entry bytes_entry; do
+    if [ "$entry" = rust_entry ]; then
+      call='rust_entry();'
+      golden="$expected/abort_guard.expected"
+    else
+      call='bytes_entry(false); bytes_entry(true); __rt.js_log_i32(999);'
+      golden="$expected/abort_guard.bytes.expected"
+    fi
+    if { cat runtime/shim.js "$program"; echo "$call"; } | node - >"$program.$entry.out" 2>"$program.$entry.err"; then
+      echo "abort_guard/$pass/$entry: expected the program to abort" >&2
+      exit 1
+    fi
+    grep -q 'rust abort\|rustc_codegen_js:' "$program.$entry.err"
+    diff -u "$golden" "$program.$entry.out"
+    echo "abort_guard/$pass/$entry: aborts with the guard undropped, output matches"
+  done
+done
+
+check active_poll_cleanup "$work/active_poll_cleanup-on.mjs" "$work/active_poll_cleanup-off.mjs"
+check "$core_fixture" "$work/$core_fixture-on.js" "$work/$core_fixture-off.js"
+check abort_guard "$work/abort_guard-on.js" "$work/abort_guard-off.js"
+# The edges around the panicking call in `pick` and the byte export in `export_bytes` are the
+# ones the no-throw proofs removed.
+node -e '
+  const block = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
+  for (const [name, reason] of [["pick", /^no-throw-/], ["export_bytes", /^no-throw/]]) {
