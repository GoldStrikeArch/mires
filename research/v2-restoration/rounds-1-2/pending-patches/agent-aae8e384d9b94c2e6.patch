+    let harness = r#"
+let trace;
+function drop_guard(slot) { trace.push(['drop', slot.buf[slot.off]]); }
+function observe(entry) {
+  trace = [];
+  try { return ['ret', String(entry(5n)), trace]; }
+  catch (error) { return ['threw', error instanceof RangeError, __rt.is_abort(error), trace]; }
+}
+"#;
+    let why = check_same_as_baseline(&program.interns, &func, &forced, &[], harness, 0)
+        .expect_err("the harness must see the destructor go missing");
