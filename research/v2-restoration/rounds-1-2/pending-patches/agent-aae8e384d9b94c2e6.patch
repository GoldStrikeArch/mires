diff --git a/scripts/fixtures/cleanup-edges/abort_guard.rs b/scripts/fixtures/cleanup-edges/abort_guard.rs
new file mode 100644
index 0000000000000000000000000000000000000000..d9c418f7fc76d978e2ade5a290c1f984c7d7dd77
--- /dev/null
+++ b/scripts/fixtures/cleanup-edges/abort_guard.rs
@@ -0,0 +1,98 @@
+//! Protected operations under a live `Drop` guard that can raise nothing but an abort.
+//!
+//! * `rust_entry`: `pick` keeps a `Guard` alive across the call of `element`, which indexes out
+//!   of bounds. Under a release profile that call is a protected operation whose cleanup edge
+//!   drops the guard. Its panic path is `panic_bounds_check` -> `panic_fmt` -> the
+//!   `#[panic_handler]` through the foreign `rust_begin_unwind` symbol, and the handler here only
+//!   aborts, so the edge can be removed (Stage 4'a). The program prints the first pick, drops its
+//!   guard, then aborts inside the second pick WITHOUT dropping that guard -- what Rust does under
+//!   `panic=abort` -- and exits non-zero.
+//! * `bytes_entry`: `export_bytes` keeps a `Guard` alive across `JsUint8Array::from_slice`, whose
+//!   host operation turns every failure into a registered abort (`HostOperation::may_throw`), so
+//!   its edge can be removed too. A well-formed slice is copied and the guard dropped as usual; a
+//!   malformed record (`u64` storage viewed as sixteen bytes) aborts without running the guard's
+//!   destructor.
+//!
+//! Both behave identically with the cleanup pass on and off: an abort never runs cleanup.
+
+#![no_std]
+#![no_main]
+#![feature(core_intrinsics)]
+#![allow(internal_features)]
+
+extern crate alloc;
+
+use alloc::vec;
+use alloc::vec::Vec;
+
+use mires_js::JsUint8Array;
+
+unsafe extern "C" {
+    fn js_log_i32(x: i32);
+    fn js_log_str(s: &str);
+}
+
+struct Guard(i32);
+
+impl Drop for Guard {
+    fn drop(&mut self) {
+        unsafe {
+            js_log_str("dropped");
+            js_log_i32(self.0);
+        }
+    }
+}
+
+/// The bounds check itself. An `Assert` is never a protected operation; the call of a body that
+/// may panic is.
+#[inline(never)]
+fn element(values: &[i32], index: usize) -> i32 {
+    values[index]
+}
+
+#[inline(never)]
+fn pick(values: &[i32], index: usize) -> i32 {
+    let guard = Guard(index as i32);
+    let value = element(values, index);
+    unsafe { js_log_i32(value) };
+    drop(guard);
+    value
+}
+
+/// The byte export under a guard: three real bytes, or two `u64`s viewed as sixteen bytes.
+#[inline(never)]
+fn export_bytes(malformed: bool) -> JsUint8Array {
+    let guard = Guard(if malformed { 16 } else { 3 });
+    let words: Vec<u64> = vec![0x0102_0304_0506_0708, 9];
+    let small = [5u8, 6, 7];
+    let bytes: &[u8] = if malformed {
+        // SAFETY: sixteen initialized bytes in Rust; this backend's value model holds two
+        // elements behind them, which the export refuses with a registered abort.
+        unsafe { core::slice::from_raw_parts(words.as_ptr().cast::<u8>(), 16) }
+    } else {
+        &small
+    };
+    let view = JsUint8Array::from_slice(bytes);
+    drop(guard);
+    view
+}
+
+#[panic_handler]
+fn panic(_: &core::panic::PanicInfo<'_>) -> ! {
+    core::intrinsics::abort()
+}
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    let values = [1, 2, 3];
+    unsafe { js_log_i32(pick(&values, 1) * 10) };
+    // Not reached past the bounds check: the handler aborts.
+    unsafe { js_log_i32(pick(&values, 7) * 10) };
+    unsafe { js_log_i32(999) };
+}
+
+#[unsafe(no_mangle)]
+pub fn bytes_entry(malformed: bool) {
+    let view = export_bytes(malformed);
+    unsafe { js_log_i32(view.len() as i32) };
+}
