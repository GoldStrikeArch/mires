+                        let (r, o) = a.overflowing_sub(b);
+                        r.fold(&mut overflowing);
+                        overflowing.flag(o);
+                        let (r, o) = a.overflowing_mul(b);
+                        r.fold(&mut overflowing);
+                        overflowing.flag(o);
