+// ---------------------------------------------------------------------------------------------
+// Stage 4'a (i): a foreign symbol resolved to the body that defines it
+// ---------------------------------------------------------------------------------------------
+
+fn foreign_call(interns: &mut Interns, symbol: &str, args: Vec<ValueId>) -> OpKind {
+    OpKind::Call {
+        callee: Callee::Foreign {
+            definition: item(95).definition,
+            symbol: interns.intern_str(symbol),
+        },
+        function: None,
+        args,
+        track_caller: None,
+        semantic: CallSemantic::Ordinary,
+        host: None,
+    }
+}
+
+/// `entry(x)`: a guard cell, `r = <symbol>(x) [unwind: drop guard; rethrow]`, `return r`.
+fn protected_foreign(interns: &mut Interns, symbol: &str) -> Func {
+    let mut b = FuncBuilder::new(item(1), signature(1, I32));
+    let x = b.param(I32, O);
+    let entry = FuncBuilder::ENTRY;
+    let normal = b.block();
+    let chain = b.block();
+    let guard = b.cell(I32, true, O);
+    b.effect(entry, OpKind::CellAlloc(guard), O);
+    b.effect(entry, OpKind::CellStore { cell: guard, v: x }, O);
+    let result = b.op(entry, foreign_call(interns, symbol, vec![x]), I32, O);
+    b.terminate(
+        entry,
+        RTerm::Invoke {
+            normal: (normal, vec![]),
+            unwind: (chain, vec![]),
+        },
+    );
+    b.terminate(normal, RTerm::Return(Some(result)));
+    let kind = drop_guard(interns, guard);
+    b.effect(chain, kind, O);
+    b.terminate(chain, RTerm::Throw(None));
+    b.finish()
+}
+
+/// A handler body of one `i32` parameter: `abort()`; a host call first when `host`; an endless
+/// loop instead when `spin`; a direct call of `back` first when given.
+fn handler(interns: &mut Interns, host: bool, spin: bool, back: Option<&str>) -> Func {
+    let mut b = FuncBuilder::new(item(72), signature(1, UNIT));
+    let x = b.param(I32, O);
+    let entry = FuncBuilder::ENTRY;
+    if host {
+        let mut report = call(interns, "report_panic", vec![]);
+        if let OpKind::Call { semantic, .. } = &mut report {
+            *semantic = CallSemantic::Host;
+        }
+        b.effect(entry, report, O);
+    }
+    if let Some(back) = back {
+        b.effect(entry, call(interns, back, vec![x]), O);
+    }
+    if spin {
+        // `loop {}`: the shape a `#[panic_handler]` that never returns prints as `for(;;){}`.
+        let spin = b.block();
+        b.terminate(entry, RTerm::Goto(spin, vec![]));
+        b.terminate(spin, RTerm::Goto(spin, vec![]));
+        return b.finish();
+    }
+    let kind = intrinsic(interns, "abort");
+    b.effect(entry, kind, O);
+    b.terminate(entry, RTerm::Unreachable);
+    b.finish()
+}
+
+/// The handler as the program runs it: it aborts, after a host call that may throw when `host`.
+fn handler_stub(host: bool) -> String {
+    format!(
+        r#"
+let trace, thrown;
+function report_panic() {{ trace.push('report'); if (thrown !== null) throw inputs[thrown]; }}
+function {HANDLER}(x) {{ trace.push(['handler', x]); {host}__rt.js_abort('panic'); }}
+function drop_guard(slot) {{ trace.push(['drop', slot.buf[slot.off]]); }}
+function observe(entry) {{
+  const out = [];
+  for (thrown of [null, ...inputs.keys()]) {{
+    trace = [];
+    try {{ out.push(['ret', entry(3), trace]); }}
+    catch (error) {{ out.push(['threw', describe(error), __rt.is_abort(error), trace]); }}
+  }}
+  return out;
+}}
+"#,
+        host = if host { "report_panic(); " } else { "" }
+    )
+}
+
+/// `entry` protecting a call of [`HANDLER`], and the definitions `define` builds: a body, or
+/// `None` for an item the lane built no body for.
+fn foreign_program(define: impl FnOnce(&mut Interns) -> Vec<(String, Option<Func>)>) -> Program {
+    let mut interns = world();
+    let entry = protected_foreign(&mut interns, HANDLER);
+    let definitions = define(&mut interns);
+    let mut program = Program::new(interns);
+    program.add("entry", entry, &[HANDLER]);
+    for (name, body) in definitions {
+        match body {
+            Some(body) => program.add(&name, body, &[]),
+            None => {
+                program.funcs.insert(
+                    JsName::new(name),
+                    Err(Decline::Encode(
+                        crate::jir::decline::EncodeDecline::Synthesized,
+                    )),
+                );
+            }
+        }
+    }
+    program
+}
