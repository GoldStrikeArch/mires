+/// A cycle through the foreign edge: the handler calls back into the protected caller. The call
+/// graph has no edge for the foreign call, so the descent keeps the cycle at `true` -- sound,
+/// whether or not something in it throws -- and the recompute confirms it.
+#[test]
+fn a_cycle_through_a_foreign_edge_keeps_its_protection() {
+    for host in [true, false] {
+        // The guard's glue is a quiet body: the cycle is all that is left to decide `entry`.
+        let program = foreign_program(|interns| {
+            let mut glue = FuncBuilder::new(item(80), signature(1, UNIT));
+            let _slot = glue.param(I32, O);
+            glue.terminate(FuncBuilder::ENTRY, RTerm::Return(None));
+            vec![
+                (
+                    HANDLER.to_owned(),
+                    Some(handler(interns, host, false, Some("entry"))),
+                ),
+                ("drop_guard".to_owned(), Some(glue.finish())),
+            ]
+        });
+        for name in ["entry", HANDLER] {
+            let summary = program.summary_of(name, false);
+            assert!(summary.may_throw, "{name} (host {host})");
+            assert!(!summary.is_top(), "{name} (host {host})");
+        }
+        let (funcs, stats) = program.run(false);
+        assert!(stats.removed.is_empty(), "host {host}");
+        assert_eq!(stats.retained[CALLEE_MAY_THROW], 1);
+        if host {
+            assert_eq!(stats.retained_leaves["host-other report_panic"], 1);
+        }
+        assert_eq!(
+            funcs[&JsName::new("entry".to_owned())].as_ref().unwrap(),
+            program.func("entry")
+        );
+    }
+}
