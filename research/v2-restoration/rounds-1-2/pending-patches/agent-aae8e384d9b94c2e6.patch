+/// `entry(a, b, n)`: a guard cell, `r = compare_bytes(a, b, n) [unwind: drop guard; rethrow]`,
+/// `return r`.
+fn protected_compare_bytes(interns: &mut Interns) -> Func {
+    let mut b = FuncBuilder::new(item(1), signature(3, I32));
+    let left = b.param(I32, O);
+    let right = b.param(I32, O);
+    let count = b.param(I32, O);
+    let entry = FuncBuilder::ENTRY;
+    let normal = b.block();
+    let chain = b.block();
+    let guard = b.cell(I32, true, O);
+    b.effect(entry, OpKind::CellAlloc(guard), O);
+    let seven = constant(&mut b, entry, 7);
+    b.effect(
+        entry,
+        OpKind::CellStore {
+            cell: guard,
+            v: seven,
+        },
+        O,
+    );
+    let kind = intrinsic_of(interns, "compare_bytes", vec![], vec![left, right, count]);
+    let result = b.op(entry, kind, I32, O);
+    b.terminate(
+        entry,
+        RTerm::Invoke {
+            normal: (normal, vec![]),
+            unwind: (chain, vec![]),
+        },
+    );
+    b.terminate(normal, RTerm::Return(Some(result)));
+    let kind = drop_guard(interns, guard);
+    b.effect(chain, kind, O);
+    b.terminate(chain, RTerm::Throw(None));
+    b.finish()
+}
+
+/// `__rt.compare_bytes` over buffers a Rust-valid program can hand it: the bytes of a reinterpreting
+/// view over `[u64]` (BigInt elements) against real bytes, which is `left - right` on a BigInt and
+/// a Number; host values behind a scaled view, which `left < right` hands to `valueOf`; and two
+/// equal byte buffers.
+const COMPARE_BYTES_HARNESS: &str = r#"
+let trace;
+const sentinel = new Error('host valueOf ran');
+const hostile = { valueOf() { trace.push('valueOf'); throw sentinel; } };
+const cases = [
+  [{ buf: [1n, 2n], off: 0 }, { buf: [1, 2], off: 0 }, 2],
+  [{ buf: [hostile], off: 0, sc: 1 }, { buf: [{}], off: 0, sc: 1 }, 1],
+  [{ buf: [3, 4], off: 0 }, { buf: [3, 4], off: 0 }, 2],
+];
+function drop_guard(slot) { trace.push(['drop', slot.buf[slot.off]]); }
+function observe(entry) {
+  return cases.map(([a, b, n]) => {
+    trace = [];
+    try { return ['ret', entry(a, b, n), trace]; }
+    catch (error) {
+      return ['threw', error instanceof TypeError, error === sentinel, __rt.is_abort(error), trace];
+    }
+  });
+}
+"#;
+
+/// `compare_bytes` is rejected: over a reinterpreting view its helper raises a `TypeError` (and a
+/// host `valueOf` runs), so the edge stays and the guard's destructor runs before the exception
+/// leaves.
+#[test]
+fn compare_bytes_over_mixed_buffers_stays_protected_and_drops_the_guard() {
+    let mut interns = world();
+    let func = protected_compare_bytes(&mut interns);
+    let mut program = Program::new(interns);
+    program.add("entry", func, &[]);
+    let (funcs, stats) = program.run(false);
+    assert!(stats.removed.is_empty());
+    assert_eq!(stats.retained_sole_causes["intrinsic"], 1);
+    assert_eq!(stats.retained_leaves["intrinsic compare_bytes"], 1);
+    let after = funcs[&JsName::new("entry".to_owned())].as_ref().unwrap();
+    assert!(after.has_invoke());
+    let entries = matrix(&program.interns, after, &[]);
+    let harness = format!(
+        "{COMPARE_BYTES_HARNESS}{}",
+        r#"
+for (const [label, entry] of entries) {
+  const [mixed, host, equal] = observe(entry);
+  const dropped = (seen) => JSON.stringify(seen[seen.length - 1]).includes('["drop",7]');
+  if (!(mixed[0] === 'threw' && mixed[1] && !mixed[3] && dropped(mixed))) {
+    throw new Error(`${label}: mixed buffers ${JSON.stringify(mixed)}`);
+  }
+  if (!(host[0] === 'threw' && host[2] && JSON.stringify(host[4]) === '["valueOf",["drop",7]]')) {
+    throw new Error(`${label}: host values ${JSON.stringify(host)}`);
+  }
+  if (JSON.stringify(equal) !== '["ret",0,[]]') throw new Error(`${label}: equal ${JSON.stringify(equal)}`);
+}
+console.log('ok');
+"#
+    );
+    assert_eq!(node(&entries, &harness).unwrap(), "ok");
+}
