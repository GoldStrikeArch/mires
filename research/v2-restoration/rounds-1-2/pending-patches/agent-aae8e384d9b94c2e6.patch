+/// A rejected intrinsic: BigInt `unchecked_div` by zero raises a `RangeError` the retained edge
+/// runs the destructor for. Forcing the removal anyway is what the harness and the witness see.
+#[test]
+fn bigint_division_stays_protected_and_forcing_it_loses_the_destructor() {
+    let mut interns = world();
+    let func = protected_value(&mut interns, I64, Some(I64), |interns, b, x| {
+        let zero = b.op(
+            FuncBuilder::ENTRY,
+            OpKind::Const(ConstTree::Scalar { bits: 0, bytes: 8 }),
+            I64,
+            O,
+        );
+        intrinsic_of(interns, "unchecked_div", vec![I64], vec![x, zero])
+    });
+    let mut program = Program::new(interns);
+    program.add("entry", func.clone(), &[]);
+    let (_, stats) = program.run(false);
+    assert!(stats.removed.is_empty());
+    assert_eq!(stats.retained_sole_causes["intrinsic"], 1);
+    assert_eq!(stats.retained_leaves["intrinsic unchecked_div"], 1);
+    let decisions = [Decision {
+        block: RBlockId(0),
+        verdict: Verdict::Remove {
+            reason: NO_THROW_INTRINSIC,
+            callee: None,
+            proof: CleanupProof::NoThrow {
+                protected: ProtectedOp::Intrinsic("unchecked_div".to_owned()),
