+/// One edge's verdict.
+#[derive(Clone, Debug)]
+pub enum Verdict {
+    /// The edge goes: `reason` is the sidecar's ([`REMOVED_REASONS`]), `callee` the protected Rust
+    /// body where it has a name, `classes` the Stage 4'a proof classes it needed
+    /// ([`NEW_CLASSES`], one bit each).
+    Remove {
+        reason: &'static str,
+        callee: Option<String>,
+        proof: CleanupProof,
+        classes: u8,
+    },
+    /// The edge stays: why the chain is not empty, why the protected operation may throw, the
+    /// root causes behind that ([`CAUSE_KINDS`]), and the protected Rust body where named.
+    Retain {
+        chain: ChainBlocked,
+        throw: &'static str,
+        causes: Causes,
+        /// The named leaf causes behind `causes` (`ThrowReasons`).
+        leaves: BTreeSet<String>,
+        callee: Option<String>,
+    },
+}
