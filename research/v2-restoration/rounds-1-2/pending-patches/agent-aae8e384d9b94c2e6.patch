+/// Mutation 3: a recursive pair, one member of which calls a host function, throws as a whole.
+#[test]
+fn a_recursive_pair_with_a_host_call_may_throw_throughout() {
+    let mut interns = world();
+    let pair = |interns: &mut Interns, other: &str, host: bool| {
+        let mut b = FuncBuilder::new(item(60), signature(1, UNIT));
+        let x = b.param(I32, O);
+        let entry = FuncBuilder::ENTRY;
+        if host {
+            let mut log = call(interns, "log", vec![x]);
+            if let OpKind::Call { semantic, .. } = &mut log {
+                *semantic = CallSemantic::Host;
+            }
+            b.effect(entry, log, O);
+        }
+        b.effect(entry, call(interns, other, vec![x]), O);
+        b.terminate(entry, RTerm::Return(None));
+        b.finish()
+    };
+    let even = pair(&mut interns, "odd", false);
+    let odd = pair(&mut interns, "even", true);
+    let quiet_even = pair(&mut interns, "quiet_odd", false);
+    let quiet_odd = pair(&mut interns, "quiet_even", false);
+    let mut program = Program::new(interns);
+    program.add("even", even, &[]);
+    program.add("odd", odd, &[]);
+    program.add("quiet_even", quiet_even, &[]);
+    program.add("quiet_odd", quiet_odd, &[]);
+    assert!(program.summary_of("even", false).may_throw);
+    assert!(program.summary_of("odd", false).may_throw);
+    // Without the host call the same shape converges to "cannot throw", not to top.
+    assert!(!program.summary_of("quiet_even", false).may_throw);
+    assert!(!program.summary_of("quiet_odd", false).may_throw);
+    assert!(!program.summary_of("quiet_even", false).is_top());
+}
