+/// The witness's own list of intrinsics that raise nothing but a registered abort: the hints and
+/// aborts, the layout and type queries, and the Stage 4'a integer and float families. Division,
+/// unchecked shifts, float-to-int casts, `compare_bytes` and pointer intrinsics are absent on
+/// purpose.
+fn quiet_intrinsic(name: &str) -> bool {
+    if let Some(base) = name
+        .strip_suffix("f32")
+        .or_else(|| name.strip_suffix("f64"))
+    {
+        return matches!(
+            base,
+            "sqrt"
+                | "floor"
+                | "ceil"
+                | "trunc"
+                | "round"
+                | "round_ties_even_"
+                | "copysign"
+                | "minimum"
+                | "maximum"
+                | "minimum_number_nsz_"
+                | "maximum_number_nsz_"
+                | "pow"
+                | "powi"
+                | "exp"
+                | "exp2"
+                | "log"
+                | "log2"
+                | "log10"
+                | "sin"
+                | "cos"
+                | "fma"
+                | "fmuladd"
+        );
+    }
+    matches!(
+        name,
+        "abort"
+            | "unreachable"
+            | "assume"
+            | "cold_path"
+            | "likely"
+            | "unlikely"
+            | "black_box"
+            | "forget"
+            | "breakpoint"
+            | "prefetch_read_data"
+            | "prefetch_write_data"
+            | "prefetch_read_instruction"
+            | "prefetch_write_instruction"
+            | "is_val_statically_known"
+            | "ub_checks"
+            | "contract_checks"
+            | "overflow_checks"
+            | "size_of"
+            | "align_of"
+            | "size_of_val"
+            | "align_of_val"
+            | "needs_drop"
+            | "type_id"
+            | "type_name"
+            | "variant_count"
+            | "caller_location"
+            | "assert_inhabited"
+            | "assert_zero_valid"
+            | "assert_mem_uninitialized_valid"
+            | "ctpop"
+            | "ctlz"
+            | "ctlz_nonzero"
+            | "cttz"
+            | "cttz_nonzero"
+            | "bswap"
+            | "bitreverse"
+            | "rotate_left"
+            | "rotate_right"
+            | "wrapping_add"
+            | "wrapping_sub"
+            | "wrapping_mul"
+            | "unchecked_add"
+            | "unchecked_sub"
+            | "unchecked_mul"
+            | "add_with_overflow"
+            | "sub_with_overflow"
+            | "mul_with_overflow"
+            | "saturating_add"
+            | "saturating_sub"
+    )
+}
