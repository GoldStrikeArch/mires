+#[test]
+fn a_foreign_symbol_without_exactly_one_quiet_definition_stays_protected() {
+    let foreign_leaf = format!("foreign {HANDLER}");
+    // Nothing defines the symbol: the call is a `ReferenceError` or someone else's code.
+    let undefined = foreign_program(|_| vec![]);
+    // The item exists but the lane built no body for it (the allocator shims are this case).
+    let bodiless = foreign_program(|_| vec![(HANDLER.to_owned(), None)]);
+    for program in [undefined, bodiless] {
+        let (funcs, stats) = program.run(false);
+        assert!(stats.removed.is_empty());
+        assert_eq!(stats.retained[CALLEE_MAY_THROW], 1);
+        assert_eq!(stats.retained_sole_causes["foreign"], 1);
+        assert_eq!(stats.retained_leaves[&foreign_leaf], 1);
+        assert_eq!(
+            funcs[&JsName::new("entry".to_owned())].as_ref().unwrap(),
+            program.func("entry")
+        );
+    }
+    // The definition reaches a host function: explained through it, and the guard still runs.
+    let host = foreign_program(|interns| {
+        vec![(
+            HANDLER.to_owned(),
+            Some(handler(interns, true, false, None)),
+        )]
+    });
+    assert!(host.summary_of(HANDLER, false).may_throw);
+    let (funcs, stats) = host.run(false);
+    handler_destructor_runs(&host, &funcs);
+    assert!(stats.removed.is_empty());
+    assert_eq!(stats.retained_sole_causes["host-other"], 1);
+    assert_eq!(stats.retained_leaves["host-other report_panic"], 1);
+    // Two candidate definitions: the exact symbol and a namer-shaped item ending in it (what a
+    // suffix match, the panic path's rule, would also accept). Only the exact name is what the
+    // printed identifier binds, so only its body decides -- either way round.
+    let sibling = format!("crate${HANDLER}$h0123456789abcdef");
+    for exact_throws in [true, false] {
+        let program = foreign_program(|interns| {
+            vec![
+                (
+                    HANDLER.to_owned(),
+                    Some(handler(interns, exact_throws, false, None)),
+                ),
+                (
+                    sibling.clone(),
+                    Some(handler(interns, !exact_throws, false, None)),
+                ),
+            ]
+        });
+        let (funcs, stats) = program.run(false);
+        if exact_throws {
+            // What the pass printed must still drop the guard when the handler's host throws.
+            handler_destructor_runs(&program, &funcs);
+        }
+        assert_eq!(
+            stats.removed.len(),
+            usize::from(!exact_throws),
+            "exact throws {exact_throws}"
+        );
+        assert_eq!(stats.retained_edges, u32::from(exact_throws));
+    }
+}
