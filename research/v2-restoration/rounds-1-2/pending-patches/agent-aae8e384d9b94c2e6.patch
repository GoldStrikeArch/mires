+    /// Every name a no-throw list could hold: each identifier-shaped string literal in the three
+    /// lists' files and in the lowerings they describe, so a name added to any one list is a
+    /// candidate here.
+    fn list_candidates() -> std::collections::BTreeSet<String> {
+        let sources = [
+            include_str!("effects.rs"),
+            include_str!("summary_check.rs"),
+            include_str!("../opt/witness.rs"),
+            include_str!("../lower/js/intrinsics.rs"),
+            include_str!("../lower/js/host.rs"),
+            include_str!("../../../rcgjs-object/src/host.rs"),
+        ];
+        let mut names = std::collections::BTreeSet::new();
+        for source in sources {
+            for (index, piece) in source.split('"').enumerate() {
+                let shaped = !piece.is_empty()
+                    && piece.bytes().all(|b| {
+                        b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'_' || b == b'.'
+                    });
+                if index % 2 == 1 && shaped {
+                    names.insert(piece.to_owned());
+                }
+            }
+        }
+        names
+    }
