+/// Stage 3c: a protected `rcgjs.host.undefined` or `cold_path` prints no statement, raises nothing,
+/// and loses its `try`; a host operation that runs host code, or an intrinsic outside the list,
+/// keeps it.
+#[test]
+fn a_protected_operation_that_prints_nothing_loses_its_try() {
+    let harness = r#"
+let trace;
+function drop_guard(slot) { trace.push(['drop', slot.buf[slot.off]]); }
+function observe(entry) { trace = []; return [entry(4), trace]; }
+"#;
+    for (quiet, cause, op) in [
+        (
+            true,
+            "",
+            &(|interns: &mut Interns| marker(interns, "rcgjs.host.undefined"))
+                as &dyn Fn(&mut Interns) -> OpKind,
+        ),
+        (true, "", &|interns: &mut Interns| {
+            intrinsic(interns, "cold_path")
+        }),
+        (false, "host-marker", &|interns: &mut Interns| {
+            marker(interns, "rcgjs.host.add")
+        }),
+        (false, "intrinsic", &|interns: &mut Interns| {
+            intrinsic(interns, "unchecked_div")
