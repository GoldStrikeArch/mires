+/// A direct call of `callee` with `args`, for its effect.
+fn call_op(callee: StrId, args: Vec<ValueId>) -> OpKind {
+    OpKind::Call {
+        callee: Callee::Direct {
+            item: item(2),
+            link_name: callee,
+        },
+        function: None,
+        args,
+        track_caller: None,
+        semantic: CallSemantic::Ordinary,
+        host: None,
