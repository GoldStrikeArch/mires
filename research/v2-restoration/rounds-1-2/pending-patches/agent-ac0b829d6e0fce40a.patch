new file mode 100644
index 0000000000000000000000000000000000000000..6ddbdf741a73957b561030c07b1c3135e5f1cc64
--- /dev/null
+++ b/examples/core-tests/252_track_caller_methods.rs
@@ -0,0 +1,159 @@
+//! `#[track_caller]` methods: inherent, by value, declared on a trait (so every impl inherits it),
+//! a default method, `#[track_caller]` on an impl only, calls through `dyn Trait` and through a
+//! generic, a tracked `const fn`, and tracked generic functions instantiated several ways.
+//!
+//! Through `dyn Trait` a method tracks its caller only when the *trait* says so: an impl that adds
+//! `#[track_caller]` on its own is called through rustc's `ReifyShim` in the vtable, which reports
+//! the impl method's own definition. A trait method taken as a `fn` pointer on `dyn Trait` itself
+//! has no body to name, only the `ReifyShim` that makes the virtual call: the JIR lane once named
+//! the missing body and the link step refused the program.
+
+#![no_std]
+#![no_main]
+
+extern crate alloc;
+
+#[path = "prelude.rs"]
+mod prelude;
+use prelude::*;
+
+use alloc::string::String;
+use core::hint::black_box;
+use core::panic::Location;
+
+#[track_caller]
+fn lc() -> u32 {
+    let l = Location::caller();
+    l.line() * 1000 + l.column()
+}
+
+struct S(u32);
+impl S {
+    #[track_caller]
+    fn inherent(&self) -> u32 {
+        lc() + self.0
+    }
+    #[track_caller]
+    fn by_value(self) -> u32 {
+        Location::caller().line() + self.0
+    }
+}
+
+trait Tracked {
+    #[track_caller]
+    fn t(&self) -> u32;
+    #[track_caller]
+    fn d(&self) -> u32 {
+        lc()
+    }
+    fn plain(&self) -> u32;
+}
+impl Tracked for S {
+    fn t(&self) -> u32 {
+        Location::caller().line()
+    }
+    fn plain(&self) -> u32 {
+        7
+    }
+}
+struct U;
+impl Tracked for U {
+    #[track_caller]
+    fn t(&self) -> u32 {
+        lc()
+    }
+    #[track_caller]
+    fn d(&self) -> u32 {
+        Location::caller().column()
+    }
+    #[track_caller]
+    fn plain(&self) -> u32 {
+        Location::caller().line()
+    }
+}
+
+trait Plain {
+    fn p(&self) -> u32;
+}
+impl Plain for S {
+    #[track_caller]
+    fn p(&self) -> u32 {
+        Location::caller().line()
+    }
+}
+
+#[track_caller]
+const fn cf() -> u32 {
+    Location::caller().line()
+}
+
+#[track_caller]
+fn generic<T: Copy + Into<u64>>(x: T) -> u64 {
+    x.into() + Location::caller().line() as u64
+}
+#[track_caller]
+fn generic_len<T: AsRef<str>>(x: T) -> u32 {
+    x.as_ref().len() as u32 + lc()
+}
+
+fn via_dyn(t: &dyn Tracked) -> u32 {
+    t.t() + t.d() + t.plain()
+}
+fn via_dyn_plain(t: &dyn Plain) -> u32 {
+    t.p()
+}
+fn via_generic<X: Tracked>(t: &X) -> u32 {
+    t.t() + t.d()
+}
+#[track_caller]
+fn tracked_via_dyn(t: &dyn Tracked) -> u32 {
+    t.t() + t.d()
+}
+#[track_caller]
+fn tracked_via_generic<X: Tracked>(t: &X) -> u32 {
+    t.t() + t.d()
+}
+
+const K: u32 = cf();
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    let s = S(1);
+    print_u32(s.inherent());
+    print_u32(S(2).by_value());
+    print_u32(s.t());
+    print_u32(s.d());
