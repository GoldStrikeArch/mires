new file mode 100644
index 0000000000000000000000000000000000000000..125c5a5897e314efc803494c16de29639721ebdf
--- /dev/null
+++ b/examples/core-tests/251_track_caller_pointers.rs
@@ -0,0 +1,96 @@
+//! A `#[track_caller]` function called through a function pointer, and through the `Fn` traits.
+//!
+//! A `fn` pointer call cannot pass the hidden location argument, so rustc reifies a tracked
+//! function into a `ReifyShim` that supplies one: the location of the function's own definition.
+//! That is what a call through the pointer reports, wherever the pointer was made or stored. Called
+//! through `Fn::call` on the function item itself, the location is the one rustc's `FnPtrShim` in
+//! `core` supplies.
+//!
+//! The JIR lane once named the function itself for the pointer, so every call through it passed no
+//! location and threw reading `Location::line` of `undefined`.
+
+#![no_std]
+#![no_main]
+
+extern crate alloc;
+
+#[path = "prelude.rs"]
+mod prelude;
+use prelude::*;
+
+use alloc::boxed::Box;
+use core::hint::black_box;
+use core::panic::Location;
+
+#[track_caller]
+fn here() -> u32 {
+    let l = Location::caller();
+    print_str(l.file());
+    print_u32(l.column());
+    l.line()
+}
+#[track_caller]
+fn there(x: u32) -> u32 {
+    let l = Location::caller();
+    print_u32(l.column());
+    l.line() * 1000 + x
+}
+
+struct Holder {
+    f: fn() -> u32,
+    g: fn(u32) -> u32,
+}
+static TABLE: [fn() -> u32; 2] = [here, here];
+static G: fn(u32) -> u32 = there;
+const C: fn() -> u32 = here;
+
+fn call_generic<F: Fn() -> u32>(f: F) -> u32 {
+    f()
+}
+fn call_generic_mut<F: FnMut() -> u32>(mut f: F) -> u32 {
+    f()
+}
+fn call_generic_once<F: FnOnce(u32) -> u32>(f: F) -> u32 {
+    f(7)
+}
+fn call_dyn(f: &dyn Fn() -> u32) -> u32 {
+    f()
+}
+fn call_box(f: Box<dyn Fn() -> u32>) -> u32 {
+    f()
+}
+fn call_box_once(f: Box<dyn FnOnce(u32) -> u32>) -> u32 {
+    f(9)
+}
+fn call_ptr(f: fn() -> u32) -> u32 {
+    f()
+}
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    let f: fn() -> u32 = here;
+    print_u32(f());
+    print_u32(black_box(f)());
+    let h = Holder { f: here, g: there };
+    print_u32((h.f)());
+    print_u32((h.g)(5));
+    let h = black_box(h);
+    print_u32((h.f)());
+    print_u32((h.g)(6));
+    print_u32(TABLE[black_box(1)]());
+    print_u32(G(3));
+    print_u32(C());
+    print_u32(call_generic(here));
+    print_u32(call_generic(f));
+    print_u32(call_generic_mut(here));
+    print_u32(call_generic_once(there));
+    print_u32(call_dyn(&f));
+    print_u32(call_box(Box::new(here)));
+    print_u32(call_box(Box::new(f)));
+    print_u32(call_box_once(Box::new(there)));
+    print_u32(call_ptr(here));
+    print_u32(call_ptr(black_box(here)));
+    // The direct calls, for contrast: the location of each call.
+    print_u32(here());
+    print_u32(there(1));
+}
