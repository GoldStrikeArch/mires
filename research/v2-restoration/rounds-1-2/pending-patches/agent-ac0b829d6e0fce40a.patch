@@ -0,0 +1,40 @@
+//! A panic reached through a chain of `#[track_caller]` functions, called directly and then
+//! through a `fn` pointer stored in a struct.
+//!
+//! `Option::expect` is `#[track_caller]` too, so the location the panic handler prints is the
+//! outermost caller that does not track its own: for the pointer call that is the `ReifyShim`
+//! rustc builds for `outer`, which reports `outer`'s own definition. The JIR lane once called
+//! `outer` itself through the pointer with no location, and the program threw a `TypeError` instead
+//! of panicking.
+
+#![no_std]
+#![no_main]
+
+#[path = "prelude.rs"]
+mod prelude;
+use prelude::*;
+
+use core::hint::black_box;
+
+#[track_caller]
+fn inner(o: Option<u32>) -> u32 {
+    o.expect("inner")
+}
+#[track_caller]
+fn outer(o: Option<u32>) -> u32 {
+    inner(o) + 1
+}
+
+struct H {
+    f: fn(Option<u32>) -> u32,
+}
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    let h = black_box(H { f: outer });
+    print_u32(outer(black_box(Some(3))));
+    print_u32((h.f)(black_box(Some(4))));
+    // Not reached past this: the handler prints the location and aborts.
+    print_u32((h.f)(black_box(None)));
+    print_u32(999);
+}
