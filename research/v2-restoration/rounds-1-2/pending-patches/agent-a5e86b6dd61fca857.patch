+/// The variant a tag that holds a pointer into an allocation names.
+///
+/// This is rustc's own rule (`InterpCx::read_discriminant`): a pointer with provenance can only be
+/// told apart from the niche values when the niche is the single value zero and the pointer cannot
+/// be null, and then it is the untagged variant, whose payload the pointer is. That covers every
+/// pointer niche rustc lays out — a reference, `NonNull`, `Box` and a function pointer each have
+/// exactly the one invalid value `0` — and anything else is refused rather than guessed: a direct
+/// tag, several niche variants, a niche that does not start at zero, a tag holding only part of a
+/// pointer, or a pointer that may be null.
+///
+/// `bits` are the tag's bytes, which for a pointer are its offset into the allocation it names.
+fn pointer_tag(
+    tcx: TyCtxt<'_>,
+    alloc: &Allocation,
+    tag_offset: Size,
+    tag_size: Size,
+    bits: u128,
+    tag_encoding: &TagEncoding<VariantIdx>,
+) -> Result<VariantIdx, TagError> {
+    let TagEncoding::Niche {
+        untagged_variant,
+        niche_variants,
+        niche_start,
+    } = tag_encoding
+    else {
+        return Err(TagError::Unreadable);
+    };
+    if *niche_start != 0
+        || niche_variants.start != niche_variants.last
+        || tag_size != tcx.data_layout.pointer_size()
+    {
+        return Err(TagError::Unreadable);
+    }
+    let Some(provenance) = alloc.provenance().get_ptr(tag_offset) else {
+        return Err(TagError::Unreadable);
+    };
+    let Ok(offset) = u64::try_from(bits) else {
+        return Err(TagError::Unreadable);
+    };
+    match may_be_null(tcx, provenance.alloc_id(), Size::from_bytes(offset)) {
+        false => Ok(*untagged_variant),
+        true => Err(TagError::Unreadable),
+    }
+}
+
+/// Whether the pointer `offset` bytes into `alloc_id` may be null (`InterpCx::scalar_may_be_null`).
+///
+/// An allocation's base address is not known, but it is never null and no in-bounds pointer (one
+/// past the end included) wraps around to null; a pointer that is not a multiple of the
+/// allocation's alignment cannot be null either. A type id is a fake allocation whose offset *is*
+/// the value, and is treated as possibly null, as rustc treats it.
+fn may_be_null(tcx: TyCtxt<'_>, alloc_id: AllocId, offset: Size) -> bool {
+    let global = tcx.global_alloc(alloc_id);
+    if matches!(global, GlobalAlloc::TypeId { .. }) {
+        return true;
+    }
+    let (size, align) = global.size_and_align(tcx, typing_env());
+    offset > size && offset.bytes().is_multiple_of(align.bytes())
+}
