new file mode 100644
index 0000000000000000000000000000000000000000..c401767c6d423cb84507c72d9d2e8f96d1924f31
--- /dev/null
+++ b/examples/core-tests/240_niche_pointer_constants.rs
@@ -0,0 +1,149 @@
+//! A pointer niche in constant data reads back as the variant it holds, wherever the data lives.
+//!
+//! `Option<&T>` is one pointer: `None` is the null pointer and `Some(r)` is `r`. In a constant
+//! allocation the bytes of a pointer are only its offset into the allocation it names — the
+//! allocation itself is the provenance recorded beside them — so `Some(&7)`, whose `7` sits at the
+//! start of its own allocation, has exactly the bytes of `None`. Its variant comes from the
+//! provenance, never from those bytes (rustc's own rule, `InterpCx::read_discriminant`), and the
+//! decoder used to read the bytes and answer `None`.
+//!
+//! Every place constant data can live is exercised, with both variants: a `const` used directly
+//! and through `black_box` (a register-sized `ConstValue::Scalar` holding the pointer), a
+//! `static`, a `static mut` read back and rewritten, a promoted `&Some(..)`, an associated
+//! constant, a trait constant read in a generic function, `static` and `const` tables of options
+//! and of structs holding them, and, as the control, the same values built at run time.
+
+#![no_std]
+#![no_main]
+
+#[path = "prelude.rs"]
+mod prelude;
+use prelude::*;
+
+use core::hint::black_box;
+
+#[inline(never)]
+fn idx(i: usize) -> usize {
+    black_box(i)
+}
+
+#[inline(never)]
+fn show(o: Option<&u32>) {
+    match o {
+        Some(v) => print_u32(*v),
+        None => print_str("none"),
+    }
+}
+
+const C_SOME: Option<&u32> = Some(&5);
+const C_NONE: Option<&u32> = None;
+static S_SOME: Option<&u32> = Some(&6);
+static S_NONE: Option<&u32> = None;
+static mut SM: Option<&u32> = Some(&7);
+static TARGET: u32 = 70;
+static S_TO_STATIC: Option<&u32> = Some(&TARGET);
+const C_TO_STATIC: Option<&u32> = Some(&TARGET);
+
+struct Holder;
+impl Holder {
+    const A: Option<&'static u32> = Some(&10);
+    const N: Option<&'static u32> = None;
+}
+
+trait Scale {
+    const V: Option<&'static u32>;
+}
+struct KA;
+struct KB;
+impl Scale for KA {
+    const V: Option<&'static u32> = Some(&11);
+}
+impl Scale for KB {
+    const V: Option<&'static u32> = None;
+}
+#[inline(never)]
+fn get<T: Scale>() -> Option<&'static u32> {
+    T::V
+}
+
+const TABLE: [Option<&u32>; 3] = [Some(&1), None, Some(&3)];
+static STABLE: [Option<&u32>; 3] = [None, Some(&22), Some(&23)];
+
+struct Row {
+    id: u32,
+    v: Option<&'static u32>,
+}
+const ROWS: &[Row] = &[
+    Row { id: 1, v: Some(&31) },
+    Row { id: 2, v: None },
+    Row { id: 3, v: Some(&33) },
+];
+static SROWS: [Row; 2] = [Row { id: 4, v: None }, Row { id: 5, v: Some(&35) }];
+
+#[unsafe(no_mangle)]
+pub fn rust_entry() {
+    print_str("const");
+    show(C_SOME);
+    show(C_NONE);
+    show(black_box(C_SOME));
+    show(black_box(C_NONE));
+    print_bool(C_SOME.is_some());
+
+    print_str("static");
+    show(S_SOME);
+    show(S_NONE);
+    show(*black_box(&S_SOME));
+    show(*black_box(&S_NONE));
+    show(S_TO_STATIC);
+    show(C_TO_STATIC);
+    print_bool(core::ptr::eq(S_TO_STATIC.unwrap(), &TARGET));
+    print_bool(core::ptr::eq(C_TO_STATIC.unwrap(), &TARGET));
+
+    print_str("static mut");
+    unsafe {
+        show(*black_box(&raw const SM));
+        SM = None;
+        show(*black_box(&raw const SM));
+        SM = Some(&8);
+        show(*black_box(&raw const SM));
+    }
+
+    print_str("promoted");
+    let p: &'static Option<&'static u32> = &Some(&9);
+    show(*p);
+    show(*black_box(p));
+    let q: &'static Option<&'static u32> = &None;
+    show(*black_box(q));
+
+    print_str("associated and generic");
+    show(Holder::A);
+    show(Holder::N);
+    show(black_box(Holder::A));
+    show(get::<KA>());
+    show(get::<KB>());
+
+    print_str("tables");
+    for i in 0..3 {
+        show(TABLE[idx(i)]);
+    }
+    for i in 0..3 {
+        show(STABLE[idx(i)]);
+    }
+    for i in 0..3 {
+        let r = &ROWS[idx(i)];
+        print_u32(r.id);
+        show(r.v);
+    }
+    for r in SROWS.iter() {
+        print_u32(r.id);
+        show(r.v);
+    }
+
+    print_str("run time");
+    let x = 41u32;
+    show(black_box(Some(&x)));
+    show(black_box(None));
+    let lt = [Some(&x), None];
+    show(black_box(lt)[idx(0)]);
+    show(black_box(lt)[idx(1)]);
+}
