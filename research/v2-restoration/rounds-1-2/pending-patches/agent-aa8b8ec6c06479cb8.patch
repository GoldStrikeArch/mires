@@ -99,7 +101,7 @@ for pass in 1 2 3; do
 				cp "$from/$spec" "$dir/$spec"
 				missing=1
 			fi
-		done < <(sed -n 's/^import .*from "\(\.\/[^"]*\)";$/\1/p' "$file")
+		done < <(sed -n 's/^import.*from *"\(\.\/[^"]*\)";$/\1/p' "$file")
 	done
 	[ "$missing" -eq 0 ] && break
 done
