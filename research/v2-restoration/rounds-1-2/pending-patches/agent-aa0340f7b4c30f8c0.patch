+/// Whether the destructor ran when the declared-non-throwing host function threw anyway, in
+/// every cell (all cells must agree).
+fn host_destructor_ran(program: &Program, func: &Func) -> bool {
+    let entries = matrix(&program.interns, func, &[]);
+    let harness = r#"
+const thrown = new Error('the host broke its contract');
+let trace;
+globalThis.hostThrow = () => { trace.push('host'); throw thrown; };
+function drop_guard(slot) { trace.push(['drop', slot.buf[slot.off]]); }
+const ran = new Set();
+for (const [label, entry] of entries) {
+  trace = [];
+  try { entry(); throw new Error(`${label} returned`); } catch (error) {
+    if (error !== thrown) throw error;
+  }
+  ran.add(trace.some((step) => Array.isArray(step) && step[0] === 'drop'));
+}
+if (ran.size !== 1) throw new Error('cells disagree');
+console.log([...ran][0]);
+"#;
+    node(&entries, harness).unwrap() == "true"
+}
+
+#[test]
+fn host_contract_trust_is_off_by_default_and_detectably_unsafe_when_on() {
+    let program = host_program();
+    // Off: the declaration is not taken at its word, the edge stays, the destructor runs.
+    let (funcs, stats) = program.run(false);
+    assert!(stats.removed.is_empty());
+    assert_eq!(stats.retained[HOST_CONTRACT_UNTRUSTED], 1);
+    assert_eq!(stats.retained_sole_causes["host-contract-untrusted"], 1);
+    let kept = funcs[&JsName::new("entry".to_owned())].as_ref().unwrap();
+    assert!(
+        host_destructor_ran(&program, kept),
+        "the trace must be present"
+    );
+    // On: the edge goes as `no-throw-host-contract`, and a host that throws anyway skips the
+    // destructor -- the harness can see what the opt-in gives up.
+    let (funcs, stats) = program.run(true);
+    assert_eq!(reasons(&stats), ["no-throw-host-contract"]);
+    let trusted = funcs[&JsName::new("entry".to_owned())].as_ref().unwrap();
+    assert!(!trusted.has_invoke());
+    assert!(
+        !host_destructor_ran(&program, trusted),
+        "the trace must be missing"
+    );
+    // A fallible declaration, or one with a `throws` slot, is never trusted.
+    let fallible = |declaration: &mut Descriptor| declaration.fallible = true;
+    let throws = |declaration: &mut Descriptor| {
+        declaration.slots = vec![(
+            crate::descriptor::Slot::Result,
+            crate::descriptor::SlotFacts::default().with(crate::descriptor::Fact::Throws),
+        )];
+    };
+    for change in [&fallible as &dyn Fn(&mut Descriptor), &throws] {
+        let mut untrusted = host_program();
+        let interns = &mut untrusted.interns;
+        let body = std::str::from_utf8(&interns.bytes[0]).unwrap().to_owned();
+        let mut declaration = Descriptor::decode(&body).unwrap();
+        change(&mut declaration);
+        let encoded = declaration.encode();
+        interns.bytes[0] = encoded
+            .strip_prefix(crate::descriptor::PREFIX)
+            .unwrap()
+            .as_bytes()
+            .to_vec();
+        let (_, stats) = untrusted.run(true);
+        assert!(stats.removed.is_empty());
+        assert_eq!(stats.retained[CALLEE_MAY_THROW], 1);
+        assert_eq!(stats.retained_sole_causes["host-extern"], 1);
+    }
+}
