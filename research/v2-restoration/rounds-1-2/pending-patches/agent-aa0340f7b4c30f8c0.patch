+        interns
+            .and_then(|interns| interns.str(id))
+            .map(|name| JsName::new(name.to_owned()))
+    };
+    match kind {
+        OpKind::Zombie(_) => Some(ThrowCause::Opaque(OpaqueCause::Zombie)),
+        OpKind::Host { .. } => Some(ThrowCause::host(HostKind::Marker)),
+        OpKind::Intrinsic { name, .. } => match interns.and_then(|interns| interns.str(*name)) {
