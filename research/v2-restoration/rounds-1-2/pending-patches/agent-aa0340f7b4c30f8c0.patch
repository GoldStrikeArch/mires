+core_fixture=${CLEANUP_EDGES_CORE_FIXTURE:-02_result}
+mkdir -p "$work/proc-macro" "$expected"
+if [ "${SKIP_BUILD:-0}" != 1 ]; then bash scripts/build.sh --locked >"$work/build.log"; fi
+cargo build -p js-extern-macro --locked >"$work/macro.log" 2>&1
+case "$(uname -s)" in Darwin) ext=dylib ;; *) ext=so ;; esac
+macro="$root/target/debug/libjs_extern_macro.$ext"
+ln -sf "$macro" "$work/proc-macro/libjs_extern_macro.$ext"
+node scripts/make-esm-shim.mjs "$work/shim.mjs"
+export JS_EXTRA_ARGS="js-profile=release-balanced js-cleanup=on js-opt=on"
