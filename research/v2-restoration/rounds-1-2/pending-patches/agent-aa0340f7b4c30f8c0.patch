+/// The panic function: `abort()`, or a host call before it when `host` is set.
+fn panic_fn(interns: &mut Interns, host: bool) -> Func {
+    let mut b = FuncBuilder::new(item(70), signature(2, UNIT));
+    let _index = b.param(I32, O);
+    let _length = b.param(I32, O);
+    let entry = FuncBuilder::ENTRY;
+    if host {
+        let mut report = call(interns, "report_panic", vec![]);
+        if let OpKind::Call { semantic, .. } = &mut report {
+            *semantic = CallSemantic::Host;
+        }
+        b.effect(entry, report, O);
+    }
+    let abort = interns.intern_str("abort");
+    b.effect(
+        entry,
+        OpKind::Intrinsic {
+            name: abort,
+            types: vec![],
+            fallback: None,
+            args: vec![],
+        },
+        O,
+    );
+    b.terminate(entry, RTerm::Unreachable);
+    b.finish()
+}
+
+/// `callee(i, n) { assert!(i < n); return i + n }`: arithmetic and one bounds check.
+fn asserting_callee() -> Func {
+    let mut b = FuncBuilder::new(item(71), signature(2, I32));
+    let index = b.param(I32, O);
+    let length = b.param(I32, O);
+    let entry = FuncBuilder::ENTRY;
+    let inside = b.op(
+        entry,
+        OpKind::Binary {
+            op: BinaryOp::Lt,
+            l: index,
+            r: length,
+            ty: I32,
+        },
+        BOOL,
+        O,
+    );
+    b.effect(
+        entry,
+        OpKind::Assert {
+            cond: inside,
+            expected: true,
+            msg: RAssertMessage::BoundsCheck { length, index },
+        },
+        O,
+    );
+    let sum = b.op(
+        entry,
+        OpKind::Binary {
+            op: BinaryOp::Add,
+            l: index,
+            r: length,
+            ty: I32,
+        },
+        I32,
+        O,
+    );
+    b.terminate(entry, RTerm::Return(Some(sum)));
+    b.finish()
+}
+
+/// `entry(x)`: a guard cell, `r = callee(x, 3) [unwind: drop guard; rethrow]`.
+fn protected_callee(interns: &mut Interns) -> Func {
+    let mut b = FuncBuilder::new(item(1), signature(1, I32));
+    let x = b.param(I32, O);
+    let entry = FuncBuilder::ENTRY;
+    let normal = b.block();
+    let chain = b.block();
+    let guard = b.cell(I32, true, O);
+    b.effect(entry, OpKind::CellAlloc(guard), O);
+    b.effect(entry, OpKind::CellStore { cell: guard, v: x }, O);
+    let three = constant(&mut b, entry, 3);
+    let result = b.op(entry, call(interns, "callee", vec![x, three]), I32, O);
+    b.terminate(
+        entry,
+        RTerm::Invoke {
+            normal: (normal, vec![]),
+            unwind: (chain, vec![]),
+        },
+    );
+    b.terminate(normal, RTerm::Return(Some(result)));
+    let kind = drop_guard(interns, guard);
+    b.effect(chain, kind, O);
+    b.terminate(chain, RTerm::Throw(None));
+    b.finish()
+}
+
+fn panic_program(host: bool) -> Program {
+    let mut interns = world();
+    let entry = protected_callee(&mut interns);
+    let panic = panic_fn(&mut interns, host);
+    let mut program = Program::new(interns);
+    program.add("entry", entry, &[]);
+    program.add("callee", asserting_callee(), &[PANIC]);
+    program.add(PANIC, panic, &[]);
+    program
+}
+
+/// The callee as the program would run it: a failed bounds check reaches the panic function,
+/// which aborts (or, with `host`, first calls a host function that may throw anything).
+fn callee_stub(host: bool) -> String {
+    format!(
+        r#"
+let trace, thrown;
+function report_panic() {{ trace.push('report'); if (thrown !== null) throw inputs[thrown]; }}
+function callee(i, n) {{
+  trace.push(['callee', i]);
+  if (!(i < n)) {{ {host}__rt.js_abort('index out of bounds'); }}
+  return i + n;
+}}
+function drop_guard(slot) {{ trace.push(['drop', slot.buf[slot.off]]); }}
+function observe(entry) {{
+  const out = [];
+  for (thrown of [null, ...inputs.keys()]) for (const x of [0, 2, 3, 9]) {{
+    trace = [];
+    try {{ out.push(['ret', entry(x), trace]); }}
+    catch (error) {{ out.push(['threw', describe(error), __rt.is_abort(error), trace]); }}
+  }}
+  return out;
+}}
+"#,
+        host = if host { "report_panic(); " } else { "" }
+    )
+}
+
+#[test]
+fn a_callee_that_can_only_abort_is_deprotected() {
+    let program = panic_program(false);
