+#[test]
+fn a_shared_chain_is_split_by_the_constant_each_edge_passes() {
+    let mut interns = world();
+    let mut b = FuncBuilder::new(item(1), signature(1, I32));
+    let x = b.param(I32, O);
+    let entry = FuncBuilder::ENTRY;
+    let second = b.block();
+    let done = b.block();
+    let chain = b.block();
+    let dropping = b.block();
+    let rethrow = b.block();
+    let flag = b.block_param(chain, I32, O);
+    let guard = b.cell(I32, true, O);
+    b.effect(entry, OpKind::CellAlloc(guard), O);
+    b.effect(entry, OpKind::CellStore { cell: guard, v: x }, O);
+    let zero = constant(&mut b, entry, 0);
+    let one = constant(&mut b, entry, 1);
+    let first = b.op(entry, call(&mut interns, "first", vec![x]), I32, O);
+    b.terminate(
+        entry,
+        RTerm::Invoke {
+            normal: (second, vec![]),
+            unwind: (chain, vec![zero]),
+        },
+    );
+    let result = b.op(second, call(&mut interns, "second", vec![first]), I32, O);
+    b.terminate(
+        second,
+        RTerm::Invoke {
+            normal: (done, vec![]),
+            unwind: (chain, vec![one]),
+        },
+    );
+    b.terminate(done, RTerm::Return(Some(result)));
+    b.terminate(
+        chain,
+        RTerm::Switch {
+            scrut: flag,
+            scrut_ty: I32,
+            cases: vec![(1, dropping, vec![])],
+            default: (rethrow, vec![]),
+        },
+    );
+    let kind = drop_guard(&mut interns, guard);
+    b.effect(dropping, kind, O);
+    b.terminate(dropping, RTerm::Goto(rethrow, vec![]));
+    b.terminate(rethrow, RTerm::Throw(None));
+    let func = b.finish();
+    let mut program = Program::new(interns);
+    program.add("entry", func, &[]);
+    let (funcs, stats) = program.run(false);
