+/// Why the chain behind one unwind edge is not empty.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum ChainBlocked {
+    /// It runs this operation or ends in this terminator.
+    Observable(&'static str),
+    /// It reaches one block twice (a loop, or two arms joining).
+    Unbounded,
+}
+
+impl ChainBlocked {
+    fn key(&self) -> &'static str {
+        match self {
+            ChainBlocked::Observable(_) => CHAIN_OBSERVABLE,
+            ChainBlocked::Unbounded => CHAIN_UNBOUNDED,
+        }
+    }
+}
