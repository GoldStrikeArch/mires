+            DropGlue::None => None,
+            DropGlue::Direct { link_name, .. } => match link(*link_name) {
+                Some(name) => body(name),
+                None => Some(ThrowCause::Opaque(OpaqueCause::Unspellable)),
+            },
+            DropGlue::Dynamic => Some(ThrowCause::Opaque(OpaqueCause::DynamicDrop)),
+        },
+        OpKind::Call {
+            callee,
+            semantic,
+            host,
+            ..
+        } => {
+            // A marker is lowered as a host operation, with or without its payload
+            // (`lower/js/host.rs::family`), whatever its empty Rust body says.
+            let marker = match (host, callee) {
+                (Some(HostPayload::Marker { section, .. }), _) => {
+                    interns.and_then(|interns| interns.str(*section))
+                }
+                (None, Callee::Direct { link_name, .. }) => interns
+                    .and_then(|interns| interns.str(*link_name))
+                    .filter(|name| crate::lower::js::host::is_marker_name(name)),
+                _ => None,
+            };
+            if let Some(marker) = marker {
+                return (!host_operation_raises_nothing(marker))
+                    .then_some(ThrowCause::host(HostKind::Marker));
+            }
+            match classify(graph, interns, callee, semantic, host) {
+                CallKind::Nop => None,
+                CallKind::Registry(entry) => entry
+                    .effects
+                    .can_throw
+                    .then_some(ThrowCause::Opaque(OpaqueCause::Registry)),
+                CallKind::Host(Some(descriptor)) => Some(ThrowCause::Host {
+                    kind: HostKind::Extern,
+                    trustable: !descriptor.fallible
+                        && descriptor
+                            .slots
+                            .iter()
+                            .all(|(_, facts)| !facts.has(Fact::Throws)),
+                }),
+                CallKind::Host(None) => Some(ThrowCause::host(HostKind::Other)),
+                CallKind::Direct(Some(name)) => body(name),
+                CallKind::GlobalAllocator => Some(ThrowCause::Opaque(OpaqueCause::Allocator)),
+                CallKind::Direct(None) => Some(ThrowCause::Opaque(OpaqueCause::Unspellable)),
+                // Any dispatch throws: the reified-target bound comes from the casts the scan
+                // sees, and a pointer a constant or a static spells is not one of them.
+                CallKind::Indirect(_) => Some(ThrowCause::Opaque(OpaqueCause::Indirect)),
+                CallKind::Virtual => Some(ThrowCause::Opaque(OpaqueCause::Virtual)),
+                CallKind::Opaque => Some(ThrowCause::Opaque(OpaqueCause::Foreign)),
+            }
+        }
+        _ => None,
+    }
+}
