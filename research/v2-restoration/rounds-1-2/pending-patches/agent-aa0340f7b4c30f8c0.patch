+        OpKind::Materialize(_) => "Materialize",
+        OpKind::Convert { .. } => "Convert",
+        OpKind::Zombie(_) => "Zombie",
+        OpKind::SpillRead(_) => "SpillRead",
+        OpKind::SpillWrite { .. } => "SpillWrite",
+    }
+}
+
+/// What the classifier reads: the published summaries and the facts they were computed under.
+pub struct Context<'a> {
+    pub graph: &'a Callgraph,
+    pub interns: &'a BTreeMap<JsName, &'a Interns>,
+    pub summaries: &'a Summaries,
+    pub facts: ThrowFacts<'a>,
+    /// Under `js-cleanup-trust-host-contract=on`, the summaries computed without the trust: what
+    /// tells a `no-throw-host-contract` removal from a plain `no-throw` one. `None` otherwise.
+    pub untrusted: Option<&'a Summaries>,
+}
+
+/// One edge's verdict.
+#[derive(Clone, Debug)]
+pub enum Verdict {
+    /// The edge goes: `reason` is the sidecar's (`empty-chain`, `no-throw`,
+    /// `no-throw-host-contract`), `callee` the protected Rust body where it has a name.
+    Remove {
+        reason: &'static str,
+        callee: Option<String>,
+        proof: CleanupProof,
+    },
+    /// The edge stays: why the chain is not empty, why the protected operation may throw, the
+    /// root causes behind that ([`CAUSE_KINDS`]), and the protected Rust body where named.
+    Retain {
+        chain: ChainBlocked,
+        throw: &'static str,
+        causes: Causes,
+        /// The named leaf causes behind `causes` (`ThrowReasons`).
+        leaves: BTreeSet<String>,
+        callee: Option<String>,
+    },
+}
+
+/// The verdict on the edge of the `Invoke` ending `block`.
+#[derive(Clone, Debug)]
+pub struct Decision {
+    pub block: RBlockId,
+    pub verdict: Verdict,
+}
+
+/// The root-cause kinds a retained edge is explained by, in the order the sidecar prints them:
+/// what a may-throw callee chain bottoms out in. An edge counts once under every kind its
+/// protected operation transitively depends on (`retained_causes`), and once more when that kind
+/// is its only one (`retained_sole_causes`): what lifting that one kind alone would unblock.
+pub const CAUSE_KINDS: [&str; 16] = [
+    "host-extern",
+    "host-contract-untrusted",
+    "host-marker",
+    "host-other",
+    "allocator",
+    "registry",
+    "intrinsic",
+    "zombie",
+    "indirect",
+    "virtual",
+    "dynamic-drop",
+    "foreign",
+    "unspellable",
+    "explicit-throw",
+    "panic-path-unknown",
+    "missing-summary",
+];
+
+/// A set of [`CAUSE_KINDS`], one bit each.
+type Causes = u32;
+
+fn cause_bit(kind: &str) -> Causes {
+    let index = CAUSE_KINDS
+        .iter()
+        .position(|known| *known == kind)
+        .expect("a known cause kind");
+    1 << index
+}
+
+/// The sidecar's retained reason for a cause set: an edge is blocked by the hardest of its
+/// causes -- a genuine throw over a missing summary over an unresolved panic path over an
+/// untrusted declaration.
+fn reason_of(causes: Causes) -> &'static str {
+    let soft = cause_bit("host-contract-untrusted")
+        | cause_bit("panic-path-unknown")
+        | cause_bit("missing-summary");
+    if causes & !soft != 0 || causes == 0 {
+        CALLEE_MAY_THROW
+    } else if causes & cause_bit("missing-summary") != 0 {
+        MISSING_SUMMARY
+    } else if causes & cause_bit("panic-path-unknown") != 0 {
+        PANIC_PATH_UNKNOWN
+    } else {
+        HOST_CONTRACT_UNTRUSTED
+    }
+}
+
+/// The leaf causes each body may throw for, by name: the retained edges' explanations.
+///
+/// A leaf is a counting cause that is not a usable Rust body -- a host binding, an intrinsic, a
+/// foreign symbol, an unresolved panic path, a missing summary -- named, with its kind among
+/// [`CAUSE_KINDS`]. A body's set is the union over its ops, through the bodies it reaches. Sets
+/// only grow and are bounded, so sweeping the bodies callees first until nothing grows
+/// terminates; the sweep repeats because a failed `Assert` reaches its panic function through the
+/// item's references, which the call graph's order does not follow.
+pub struct ThrowReasons {
+    /// Every leaf seen, with its kind's bit.
+    leaves: Vec<(String, Causes)>,
+    index: BTreeMap<String, usize>,
+    by_name: BTreeMap<JsName, BTreeSet<usize>>,
+}
+
+impl ThrowReasons {
+    pub fn of(cx: &Context<'_>, funcs: &BTreeMap<JsName, Result<Func, Decline>>) -> ThrowReasons {
+        let mut reasons = ThrowReasons {
+            leaves: Vec::new(),
+            index: BTreeMap::new(),
+            by_name: BTreeMap::new(),
+        };
+        loop {
+            let mut changed = false;
+            for name in cx.graph.sccs.iter().flatten() {
+                let Some(Ok(func)) = funcs.get(name) else {
+                    continue;
+                };
+                if !cx.summaries.get(name).is_some_and(|s| s.may_throw) {
+                    continue;
+                }
+                let mut set = reasons.by_name.get(name).cloned().unwrap_or_default();
+                let before = set.len();
+                for block in &func.blocks {
+                    if matches!(block.term, RTerm::Throw(Some(_))) {
+                        set.insert(reasons.leaf("explicit-throw", "explicit-throw".to_owned()));
+                    }
+                    for op in &block.ops {
+                        if let Some(cause) = throw_cause(cx, name, &op.kind) {
+                            set.extend(reasons.explain(cx, name, &op.kind, &cause));
+                        }
+                    }
+                }
+                if set.len() != before {
+                    reasons.by_name.insert(name.clone(), set);
+                    changed = true;
+                }
+            }
+            if !changed {
+                return reasons;
+            }
+        }
+    }
+
+    fn leaf(&mut self, kind: &str, label: String) -> usize {
+        if let Some(index) = self.index.get(&label) {
+            return *index;
+        }
+        self.leaves.push((label.clone(), cause_bit(kind)));
+        self.index.insert(label, self.leaves.len() - 1);
+        self.leaves.len() - 1
+    }
+
+    /// The leaves behind one counting cause of the op `kind` in the body `name`.
+    fn explain(
+        &mut self,
+        cx: &Context<'_>,
+        name: &JsName,
+        kind: &OpKind,
+        cause: &ThrowCause,
+    ) -> BTreeSet<usize> {
+        use crate::analysis::effects::{HostKind, OpaqueCause};
+        let interns = cx.interns.get(name).copied();
+        let spelled = |id| {
+            interns
+                .and_then(|interns| interns.str(id))
+                .unwrap_or("?")
+                .to_owned()
+        };
+        // What the op names: the callee or glue link name, the marker, the intrinsic.
+        let named = || match kind {
+            OpKind::Call {
+                host: Some(crate::jir::semantic::HostPayload::Marker { section, .. }),
+                ..
+            } => spelled(*section),
+            OpKind::Call { callee, .. } => match callee {
+                Callee::Direct { link_name, .. } => spelled(*link_name),
+                Callee::Foreign { symbol, .. } => spelled(*symbol),
+                Callee::Runtime { member } => format!("__rt.{}", spelled(*member)),
+                Callee::Intrinsic { name, .. } => spelled(*name),
+                Callee::Indirect { .. } | Callee::Virtual { .. } | Callee::Nop => String::new(),
+            },
+            OpKind::Intrinsic { name, .. } => spelled(*name),
+            OpKind::Drop {
+                glue: DropGlue::Direct { link_name, .. },
+                ..
+            } => spelled(*link_name),
+            OpKind::Assert { msg, .. } => crate::analysis::effects::panic_lang_fn(msg)
+                .unwrap_or("?")
+                .to_owned(),
+            OpKind::Zombie(message) => spelled(*message),
+            _ => String::new(),
+        };
+        let (kind, label) = match cause {
+            ThrowCause::Host {
+                trustable: true, ..
+            } => ("host-contract-untrusted", named()),
+            ThrowCause::Host { kind, .. } => match kind {
+                HostKind::Extern => ("host-extern", named()),
+                HostKind::Marker => ("host-marker", named()),
+                HostKind::Other => ("host-other", named()),
+            },
+            ThrowCause::Opaque(opaque) => match opaque {
+                OpaqueCause::Zombie => ("zombie", String::new()),
+                OpaqueCause::Intrinsic => ("intrinsic", named()),
+                OpaqueCause::Allocator => ("allocator", String::new()),
+                OpaqueCause::Registry => (
+                    "registry",
+                    match kind {
+                        OpKind::Call {
+                            semantic: CallSemantic::Standard(operation),
+                            ..
+                        } => format!("{operation:?}"),
+                        _ => String::new(),
+                    },
+                ),
+                OpaqueCause::Indirect => ("indirect", String::new()),
+                OpaqueCause::Virtual => ("virtual", String::new()),
+                OpaqueCause::DynamicDrop => ("dynamic-drop", String::new()),
+                OpaqueCause::Foreign => ("foreign", named()),
+                OpaqueCause::Unspellable => ("unspellable", String::new()),
+            },
+            ThrowCause::PanicUnknown => ("panic-path-unknown", named()),
+            ThrowCause::Body {
+                name: body,
+                missing,
+            } => {
+                if !missing && cx.summaries.usable(body).is_some() {
+                    // A body that may throw has its leaves by the time its callers are
+                    // explained, or sits in the caller's own component and is still growing.
+                    return self.by_name.get(body).cloned().unwrap_or_default();
+                }
+                ("missing-summary", body.as_str().to_owned())
+            }
+        };
+        let label = match label.is_empty() {
+            true => kind.to_owned(),
+            false => format!("{kind} {label}"),
+        };
+        BTreeSet::from([self.leaf(kind, label)])
+    }
+
+    /// The kinds a set of leaves is made of.
+    fn kinds(&self, leaves: &BTreeSet<usize>) -> Causes {
+        leaves
+            .iter()
+            .fold(0, |kinds, leaf| kinds | self.leaves[*leaf].1)
+    }
+}
+
+/// The cause of `kind` in `name` that counts under the trust switch, or `None`.
+fn throw_cause(cx: &Context<'_>, name: &JsName, kind: &OpKind) -> Option<ThrowCause> {
+    cx.summaries
+        .throw_cause(
+            cx.graph,
+            cx.interns.get(name).copied(),
+            &cx.facts,
+            name,
+            kind,
+        )
+        .filter(|cause| cause.counts(cx.facts.trust_host_contract))
+}
+
+/// What a protected operation was, for the witness, and the Rust body it names; `None` for one no
+/// proof may admit. A host call can only have been proven under `trust`.
+fn protected_op(
+    interns: Option<&Interns>,
+    kind: &OpKind,
+    trust: bool,
+) -> Option<(ProtectedOp, Option<String>)> {
+    let spelled = |id| {
+        interns
+            .and_then(|interns| interns.str(id))
+            .map(str::to_owned)
+    };
+    Some(match kind {
+        OpKind::Call {
+            callee,
+            semantic,
+            host,
+            ..
+        } => {
+            let marker = match (host, callee) {
+                (Some(crate::jir::semantic::HostPayload::Marker { section, .. }), _) => {
+                    spelled(*section)
+                }
+                (None, Callee::Direct { link_name, .. }) => {
+                    spelled(*link_name).filter(|name| crate::lower::js::host::is_marker_name(name))
+                }
+                _ => None,
+            };
+            if let Some(marker) = marker {
+                return Some((ProtectedOp::HostOperation(marker), None));
+            }
+            if let CallSemantic::Standard(operation) = semantic {
+                if crate::lower::semantic_ops::registry(*operation).is_some() {
+                    return Some((ProtectedOp::Registry, None));
+                }
+            }
+            if host.is_some()
+                || matches!(
+                    semantic,
+                    CallSemantic::Host | CallSemantic::ViewAbi | CallSemantic::RawJavaScript
+                )
+            {
+                return Some((
+                    ProtectedOp::Host {
+                        trusted_contract: trust,
+                    },
+                    None,
+                ));
+            }
+            match callee {
+                Callee::Nop => (ProtectedOp::Nop, None),
+                Callee::Direct { link_name, .. } => {
+                    let name = spelled(*link_name);
+                    (
+                        ProtectedOp::Rust {
+                            callee: name.clone(),
+                        },
+                        name,
+                    )
+                }
+                _ => return None,
+            }
+        }
+        OpKind::Drop { glue, .. } => match glue {
+            DropGlue::None => (
+                ProtectedOp::Drop {
+                    glue: None,
+                    dynamic: false,
+                },
+                None,
+            ),
+            DropGlue::Direct { link_name, .. } => {
+                let name = spelled(*link_name);
+                (
+                    ProtectedOp::Drop {
+                        glue: name.clone(),
+                        dynamic: false,
+                    },
+                    name,
+                )
+            }
+            DropGlue::Dynamic => return None,
+        },
+        OpKind::Intrinsic { name, .. } => (ProtectedOp::Intrinsic(spelled(*name)?), None),
+        _ => return None,
+    })
+}
+
+/// The name a retained protected operation reaches, for the sidecar's `retained_callees`: the
+/// direct callee or drop glue, or the intrinsic.
+fn callee_name(interns: Option<&Interns>, kind: &OpKind) -> Option<String> {
+    let spelled = |id| interns.and_then(|interns| interns.str(id));
+    match kind {
+        OpKind::Call {
+            callee: Callee::Direct { link_name, .. },
+            ..
+        } => spelled(*link_name).map(str::to_owned),
+        OpKind::Drop {
+            glue: DropGlue::Direct { link_name, .. },
+            ..
+        } => spelled(*link_name).map(str::to_owned),
+        OpKind::Intrinsic { name, .. } => spelled(*name).map(|name| format!("intrinsic {name}")),
+        _ => None,
+    }
+}
+
+/// Classifies every cleanup edge of `func`.
+pub fn classify(
+    cx: &Context<'_>,
+    reasons: &mut ThrowReasons,
+    name: &JsName,
+    func: &Func,
+) -> Vec<Decision> {
+    let interns = cx.interns.get(name).copied();
+    let mut decisions = Vec::new();
+    for block in &func.blocks {
+        if !matches!(block.term, RTerm::Invoke { .. }) {
+            continue;
+        }
+        let verdict = match empty_chain(func, block) {
+            Ok((ops, terms)) => Verdict::Remove {
+                reason: "empty-chain",
+                callee: None,
+                proof: CleanupProof::EmptyChain { ops, terms },
+            },
+            Err(chain) => match block.ops.last() {
+                Some(op) => no_throw(cx, reasons, name, interns, op, chain),
+                None => Verdict::Retain {
+                    chain,
+                    throw: CALLEE_MAY_THROW,
+                    causes: 0,
+                    leaves: BTreeSet::new(),
+                    callee: None,
+                },
+            },
+        };
+        decisions.push(Decision {
+            block: block.id,
+            verdict,
+        });
+    }
+    decisions
+}
+
+/// **NoThrow** for the protected operation `op`, after the chain proof failed with `chain`.
+fn no_throw(
+    cx: &Context<'_>,
+    reasons: &mut ThrowReasons,
+    name: &JsName,
+    interns: Option<&Interns>,
+    op: &Op,
+    chain: ChainBlocked,
+) -> Verdict {
+    if let Some(cause) = throw_cause(cx, name, &op.kind) {
+        let leaves = reasons.explain(cx, name, &op.kind, &cause);
+        let causes = reasons.kinds(&leaves);
+        return Verdict::Retain {
+            chain,
+            throw: reason_of(causes),
+            causes,
+            leaves: leaves
+                .into_iter()
+                .map(|leaf| reasons.leaves[leaf].0.clone())
+                .collect(),
+            callee: callee_name(interns, &op.kind),
+        };
+    }
+    let Some((protected, callee)) = protected_op(interns, &op.kind, cx.facts.trust_host_contract)
+    else {
+        return Verdict::Retain {
+            chain,
+            throw: CALLEE_MAY_THROW,
+            causes: 0,
+            leaves: BTreeSet::new(),
+            callee: callee_name(interns, &op.kind),
+        };
+    };
+    // Without the trust, would the operation still be proven? Only then is it a plain removal.
+    let untrusted = cx.untrusted.is_none_or(|untrusted| {
+        untrusted
+            .throw_cause(cx.graph, interns, &cx.facts, name, &op.kind)
+            .is_none()
+    });
+    Verdict::Remove {
+        reason: if untrusted {
+            "no-throw"
+        } else {
+            "no-throw-host-contract"
+        },
+        callee,
+        proof: CleanupProof::NoThrow { protected },
+    }
+}
+
+/// `func` with every removable edge turned into a `Goto` and the chains it orphaned pruned, and
+/// the witnesses of the rewrite; `None` when nothing is removable.
+pub fn rewrite(func: &Func, decisions: &[Decision]) -> Option<(Func, Vec<Witness>)> {
+    let mut rewritten = func.clone();
+    let mut witnesses = Vec::new();
+    for decision in decisions {
+        let Verdict::Remove { proof, .. } = &decision.verdict else {
+            continue;
+        };
+        let block = &mut rewritten.blocks[decision.block.0 as usize];
+        let RTerm::Invoke { normal, .. } = &block.term else {
+            continue;
+        };
+        block.term = RTerm::Goto(normal.0, normal.1.clone());
+        witnesses.push(Witness::CleanupEdge {
+            block: decision.block,
+            proof: proof.clone(),
+        });
+    }
+    if witnesses.is_empty() {
+        return None;
+    }
+    crate::opt::dce::prune_unreachable(&mut rewritten);
+    Some((rewritten, witnesses))
+}
+
+/// One removed edge, for the sidecar.
+#[derive(Clone, Debug, Eq, Ord, PartialEq, PartialOrd)]
+pub struct Removed {
+    pub item: JsName,
+    pub block: u32,
+    pub reason: &'static str,
+    pub callee: Option<String>,
+}
+
+/// The pass's accounting: the sidecar's `cleanup` block.
+#[derive(Clone, Debug, Default)]
+pub struct CleanupStats {
+    pub removed: Vec<Removed>,
+    /// Every retained edge counts once among the chain reasons and once among the throw reasons;
+    /// an edge whose rewrite failed verification counts under `cleanup.verify-failed` alone.
+    pub retained: BTreeMap<&'static str, u32>,
+    pub retained_edges: u32,
+    /// The first observable operation or terminator of each retained edge's chain, by kind.
+    pub chain_observable: BTreeMap<&'static str, u32>,
+    /// Retained edges by every root-cause kind behind them, and by the kind when it is the only
+    /// one ([`CAUSE_KINDS`]).
+    pub retained_causes: BTreeMap<&'static str, u32>,
+    pub retained_sole_causes: BTreeMap<&'static str, u32>,
+    /// Retained edges by the protected operation's callee, drop glue, or intrinsic.
+    pub retained_callees: BTreeMap<String, u32>,
+    /// Retained edges by every named leaf cause they transitively depend on: which host binding,
+    /// intrinsic, foreign symbol, panic function or summary-less body blocks them.
+    pub retained_leaves: BTreeMap<String, u32>,
+    /// `__rt` members the rewritten items stopped referencing and nothing else printed reaches.
+    pub helpers_dropped: BTreeSet<String>,
+    /// Items rewritten, and the cleanup-edge witnesses recorded and failed.
+    pub items: BTreeSet<JsName>,
+    pub witnesses_recorded: u32,
+    pub witnesses_failed: u32,
+}
+
+impl CleanupStats {
+    /// The sidecar's `cleanup` object.
+    pub fn to_json(&self) -> String {
+        let mut out = String::from("{\"removed\":[");
+        for (index, removed) in self.removed.iter().enumerate() {
+            if index > 0 {
+                out.push(',');
+            }
+            out.push_str("{\"item\":");
+            push_string(&mut out, removed.item.as_str());
+            let _ = write!(out, ",\"block\":{},\"reason\":", removed.block);
+            push_string(&mut out, removed.reason);
+            if let Some(callee) = &removed.callee {
+                out.push_str(",\"callee\":");
+                push_string(&mut out, callee);
+            }
+            out.push('}');
+        }
+        out.push_str("],\"removed_by_reason\":{");
+        for (index, reason) in ["empty-chain", "no-throw", "no-throw-host-contract"]
+            .iter()
+            .enumerate()
+        {
+            if index > 0 {
+                out.push(',');
+            }
+            let count = self.removed.iter().filter(|r| r.reason == *reason).count();
+            push_string(&mut out, reason);
+            let _ = write!(out, ":{count}");
+        }
+        let _ = write!(
+            out,
+            "}},\"retained_edges\":{},\"retained\":{{",
+            self.retained_edges
+        );
+        for (index, key) in RETAINED_KEYS.iter().enumerate() {
+            if index > 0 {
+                out.push(',');
+            }
+            push_string(&mut out, key);
+            let _ = write!(out, ":{}", self.retained.get(key).copied().unwrap_or(0));
+        }
+        out.push_str("},\"chain_observable\":{");
+        for (index, (kind, count)) in self.chain_observable.iter().enumerate() {
+            if index > 0 {
+                out.push(',');
+            }
+            push_string(&mut out, kind);
+            let _ = write!(out, ":{count}");
+        }
+        for (key, counts) in [
+            ("retained_causes", &self.retained_causes),
+            ("retained_sole_causes", &self.retained_sole_causes),
+        ] {
+            let _ = write!(out, "}},\"{key}\":{{");
+            for (index, kind) in CAUSE_KINDS.iter().enumerate() {
+                if index > 0 {
+                    out.push(',');
+                }
+                push_string(&mut out, kind);
+                let _ = write!(out, ":{}", counts.get(kind).copied().unwrap_or(0));
+            }
+        }
+        // The heaviest first, then by name; the long tail is left to the counts above.
+        out.push('}');
+        for (key, counts) in [
+            ("retained_callees", &self.retained_callees),
+            ("retained_leaves", &self.retained_leaves),
+        ] {
+            let mut rows: Vec<(&String, &u32)> = counts.iter().collect();
+            rows.sort_by(|a, b| b.1.cmp(a.1).then_with(|| a.0.cmp(b.0)));
+            let _ = write!(out, ",\"{key}\":[");
+            for (index, (name, count)) in rows.into_iter().take(RETAINED_CALLEES).enumerate() {
+                if index > 0 {
+                    out.push(',');
+                }
+                out.push('[');
+                push_string(&mut out, name);
+                let _ = write!(out, ",{count}]");
+            }
+            out.push(']');
+        }
+        out.push_str(",\"helpers_dropped\":[");
+        for (index, helper) in self.helpers_dropped.iter().enumerate() {
+            if index > 0 {
+                out.push(',');
+            }
+            push_string(&mut out, helper);
+        }
+        out.push_str("]}");
+        out
+    }
+
+    fn retain(
+        &mut self,
+        chain: &ChainBlocked,
+        throw: &'static str,
+        causes: Causes,
+        callee: &Option<String>,
+    ) {
+        self.retained_edges += 1;
+        *self.retained.entry(chain.key()).or_default() += 1;
+        *self.retained.entry(throw).or_default() += 1;
+        for (index, kind) in CAUSE_KINDS.iter().enumerate() {
+            if causes & (1 << index) != 0 {
+                *self.retained_causes.entry(kind).or_default() += 1;
+                if causes == 1 << index {
+                    *self.retained_sole_causes.entry(kind).or_default() += 1;
+                }
+            }
+        }
+        if let Some(callee) = callee {
+            *self.retained_callees.entry(callee.clone()).or_default() += 1;
+        }
+        let kind = match chain {
+            ChainBlocked::Observable(kind) => kind,
+            ChainBlocked::Unbounded => "(unbounded)",
+        };
+        *self.chain_observable.entry(kind).or_default() += 1;
+    }
+}
+
+fn push_string(out: &mut String, text: &str) {
+    out.push('"');
+    for c in text.chars() {
+        match c {
+            '"' => out.push_str("\\\""),
+            '\\' => out.push_str("\\\\"),
+            c if u32::from(c) < 0x20 => {
+                let _ = write!(out, "\\u{:04x}", u32::from(c));
+            }
+            c => out.push(c),
+        }
+    }
+    out.push('"');
+}
+
+/// Runs the pass over every func with a protected operation, in place.
+///
+/// `lower_text` prints one item's body the way phase C would (`None` where it cannot): the
+/// before/after `__rt` member sets of each rewritten item are what `helpers_dropped` starts from,
+/// and the lane intersects them with what the final program still reaches.
+pub fn run(
+    funcs: &mut BTreeMap<JsName, Result<Func, Decline>>,
+    cx: &Context<'_>,
+    lower_text: &dyn Fn(&JsName, &Func) -> Option<String>,
+) -> CleanupStats {
+    let mut stats = CleanupStats::default();
+    if !funcs
+        .values()
+        .any(|func| func.as_ref().is_ok_and(Func::has_invoke))
+    {
+        return stats;
+    }
+    let mut reasons = ThrowReasons::of(cx, funcs);
+    let fault = std::env::var("RCGJS_WITNESS_FAULT")
+        .is_ok_and(|target| target == "1" || target == "cleanup");
+    let names: Vec<JsName> = funcs.keys().cloned().collect();
+    for name in names {
+        let Some(Ok(func)) = funcs.get(&name) else {
+            continue;
+        };
+        if !func.has_invoke() {
+            continue;
+        }
+        let decisions = classify(cx, &mut reasons, &name, func);
+        for decision in &decisions {
+            if let Verdict::Retain {
+                chain,
+                throw,
+                causes,
+                leaves,
+                callee,
+            } = &decision.verdict
+            {
+                stats.retain(chain, throw, *causes, callee);
+                for leaf in leaves {
+                    *stats.retained_leaves.entry(leaf.clone()).or_default() += 1;
+                }
+            }
+        }
+        let Some((rewritten, mut witnesses)) = rewrite(func, &decisions) else {
+            continue;
+        };
+        let Some(table) = cx.interns.get(&name).map(|interns| &interns.types) else {
+            continue;
+        };
+        stats.witnesses_recorded += witnesses.len() as u32;
+        if fault {
+            for witness in &mut witnesses {
+                if let Witness::CleanupEdge { proof, .. } = witness {
+                    *proof = CleanupProof::NoThrow {
+                        protected: ProtectedOp::Host {
+                            trusted_contract: false,
+                        },
+                    };
+                }
+            }
+        }
+        let verified = rewritten
+            .verify_carriers(table, crate::opt::observed_carriers(&rewritten))
+            .is_ok();
+        let checked = !(crate::opt::witness::enabled() || fault)
+            || crate::opt::witness::check_all(&witnesses, &rewritten, table).is_ok();
+        if !verified || !checked {
+            if verified {
+                stats.witnesses_failed += 1;
+            }
+            let failed = decisions
+                .iter()
+                .filter(|decision| matches!(decision.verdict, Verdict::Remove { .. }))
+                .count() as u32;
+            *stats.retained.entry(VERIFY_FAILED).or_default() += failed;
+            continue;
+        }
+        for decision in &decisions {
+            if let Verdict::Remove { reason, callee, .. } = &decision.verdict {
+                stats.removed.push(Removed {
+                    item: name.clone(),
+                    block: decision.block.0,
+                    reason,
+                    callee: callee.clone(),
+                });
+            }
+        }
+        if let (Some(before), Some(after)) =
+            (lower_text(&name, func), lower_text(&name, &rewritten))
+        {
+            let after = crate::plan::cost::runtime_members(&after);
+            stats.helpers_dropped.extend(
+                crate::plan::cost::runtime_members(&before)
+                    .into_iter()
+                    .filter(|member| !after.contains(member)),
+            );
+        }
+        stats.items.insert(name.clone());
+        funcs.insert(name, Ok(rewritten));
+    }
+    stats.removed.sort();
+    stats
+}
