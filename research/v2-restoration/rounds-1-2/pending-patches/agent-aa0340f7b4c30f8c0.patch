+        spell(1, &[(0, "a"), (1, "b")]),
+        "function f(a, b) {\n  return (Math.imul(a, b) | 0) !== a * b;\n}\n"
+    );
+    assert_eq!(
+        spell(1, &[(0, "a"), (1, "b"), (2, "p")]),
+        "function f(a, b) {\n  let p;\n  p = (Math.imul(a, b) | 0) !== a * b;\n  return p;\n}\n"
+    );
