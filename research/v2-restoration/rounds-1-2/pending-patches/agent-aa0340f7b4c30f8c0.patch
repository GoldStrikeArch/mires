+#!/usr/bin/env bash
+# Cleanup-edge removal (jsc-link/src/plan/cleanup.rs): the lane sidecar's `cleanup` block for the
+# cleanup fixtures, with the O group's `cleanup` pass on and off.
+#
+#   scripts/cleanup-edges-test.sh            # compare against scripts/fixtures/cleanup-edges/
+#   CLEANUP_EDGES_BLESS=1 scripts/cleanup-edges-test.sh   # rewrite the expectations
+#
+# Each fixture is linked twice under the release-balanced profile: with every JIR pass (`on`) and
+# with every pass but `cleanup` (`off`, through `RCGJS_JIR_PASSES`). Both programs must behave
+# exactly as the fixture's own check requires. The `on` block must equal the checked-in JSON and
+# remove at least one edge with fewer `try` statements than `off`; the `off` block must remove
+# nothing.
+set -euo pipefail
+root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
+cd "$root"
+source scripts/integration-lock.sh
+work="$root/build/cleanup-edges"
