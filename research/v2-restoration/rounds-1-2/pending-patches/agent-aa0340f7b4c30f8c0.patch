+                    name.as_str(),
+                    "abort"
+                        | "unreachable"
+                        | "assume"
+                        | "cold_path"
+                        | "likely"
+                        | "unlikely"
+                        | "black_box"
+                        | "forget"
+                        | "breakpoint"
+                        | "prefetch_read_data"
+                        | "prefetch_write_data"
+                        | "prefetch_read_instruction"
+                        | "prefetch_write_instruction"
+                        | "is_val_statically_known"
+                        | "ub_checks"
+                        | "contract_checks"
+                        | "overflow_checks"
+                ) =>
+            {
+                Ok(())
+            }
+            ProtectedOp::HostOperation(section)
+                if matches!(
+                    section.strip_prefix("rcgjs.host."),
+                    Some(
+                        "undefined"
+                            | "null"
+                            | "isundefined"
+                            | "isnull"
+                            | "truthy"
+                            | "stricteq"
+                            | "isboolean"
+                            | "isnumber"
+                            | "isbigint"
+                            | "isstring"
+                            | "isfunction"
+                            | "isobject"
+                            | "isinteger"
+                            | "erase"
+                    )
+                ) =>
