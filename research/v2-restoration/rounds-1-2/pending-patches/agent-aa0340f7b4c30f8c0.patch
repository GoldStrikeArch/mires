+/// `entry(x)`: a guard cell, `op [unwind: drop guard; rethrow]`, `return x`, for a protected op
+/// that prints nothing (Stage 3c: the `try` around it guarded no statement at all).
+fn protected_quiet_op(interns: &mut Interns, op: impl FnOnce(&mut Interns) -> OpKind) -> Func {
+    let mut b = FuncBuilder::new(item(1), signature(1, I32));
+    let x = b.param(I32, O);
+    let entry = FuncBuilder::ENTRY;
+    let normal = b.block();
+    let chain = b.block();
+    let guard = b.cell(I32, true, O);
+    b.effect(entry, OpKind::CellAlloc(guard), O);
+    b.effect(entry, OpKind::CellStore { cell: guard, v: x }, O);
+    let kind = op(interns);
+    b.effect(entry, kind, O);
+    b.terminate(
+        entry,
+        RTerm::Invoke {
+            normal: (normal, vec![]),
+            unwind: (chain, vec![]),
+        },
+    );
+    b.terminate(normal, RTerm::Return(Some(x)));
+    let kind = drop_guard(interns, guard);
+    b.effect(chain, kind, O);
+    b.terminate(chain, RTerm::Throw(None));
+    b.finish()
+}
+
+fn marker(interns: &mut Interns, section: &str) -> OpKind {
+    let mut kind = call(interns, section, vec![]);
+    if let OpKind::Call { host, .. } = &mut kind {
+        *host = Some(HostPayload::Marker {
+            section: interns.intern_str(section),
+            def: item(50).definition,
+            template: None,
+            helpers: Vec::new(),
+        });
+    }
+    kind
+}
