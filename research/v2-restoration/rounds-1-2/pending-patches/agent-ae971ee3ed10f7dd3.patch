+                    body_may_throw(cx, name, func, done)
+                }
+                _ => continue,
+            };
+            if !throws {
+                if let Some(summary) = done.get_mut(name) {
+                    summary.may_throw = false;
+                    changed = true;
+                }
+            }
+        }
+        if !changed {
+            return;
+        }
+    }
