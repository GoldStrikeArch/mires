+// ---------------------------------------------------------------------------------------------
+// `may_throw` (Stage 3b): which operations may raise a JavaScript exception other than a
+// registered abort.
+// ---------------------------------------------------------------------------------------------
+
+/// What the `may_throw` transfer reads beyond the bodies themselves.
+///
+/// The default knows no item's references, so every `Assert` that can fire has an unknown panic
+/// path, and trusts no host declaration: the fail-closed answer.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct ThrowFacts<'a> {
+    /// Each body's baseline references (`ItemSummary::deps`): where a failed `Assert`'s panic
+    /// lang function is found, exactly as `lower/js/emit.rs::assert_failure` finds it.
+    pub deps: Option<&'a BTreeMap<JsName, &'a [String]>>,
+    /// `js-cleanup-trust-host-contract=on`: a `#[js_extern]` declared non-fallible with no
+    /// `throws` slot is taken at its word.
+    pub trust_host_contract: bool,
+}
+
+impl<'a> ThrowFacts<'a> {
+    fn deps_of(&self, name: &JsName) -> Option<&'a [String]> {
+        self.deps.and_then(|deps| deps.get(name).copied())
+    }
+}
+
+/// The intrinsics whose native lowering (`lower/js/intrinsics.rs::control`) raises nothing but a
+/// registered abort: `abort` is `__rt.js_abort`, `unreachable` a `throw_abort`, and the hints and
+/// compile-time queries print nothing, their operand, or a literal. Every other intrinsic may
+/// throw.
+pub const NON_THROWING_INTRINSICS: &[&str] = &[
+    "abort",
+    "unreachable",
+    "assume",
+    "cold_path",
+    "likely",
+    "unlikely",
+    "black_box",
+    "forget",
+    "breakpoint",
+    "prefetch_read_data",
+    "prefetch_write_data",
+    "prefetch_read_instruction",
+    "prefetch_write_instruction",
+    "is_val_statically_known",
+    "ub_checks",
+    "contract_checks",
+    "overflow_checks",
+];
+
+/// Whether a `rcgjs.host.*` marker section names a host operation whose lowering
+/// (`rcgjs_object::host::HostOperation::emit`) is an expression over operands already evaluated
+/// that cannot raise: a literal, a strict comparison, `typeof`, `!!`, `Number.isInteger`, or the
+/// operand itself. `add` and `bigintrange` reach `valueOf` on host values; `invoke` and
+/// `construct` run host code.
+pub fn host_operation_raises_nothing(section: &str) -> bool {
+    use rcgjs_object::host::HostOperation as Op;
+    let Some(marker) = section.strip_prefix(crate::lower::js::host::HOST_PREFIX) else {
+        return false;
+    };
+    matches!(
+        Op::from_marker(marker),
+        Some(
+            Op::Undefined
+                | Op::Null
+                | Op::IsUndefined
+                | Op::IsNull
+                | Op::Truthy
+                | Op::StrictEq
+                | Op::TypeIs(_)
+                | Op::IsObject
+                | Op::IsInteger
+                | Op::Erase
+        )
+    )
+}
+
+/// Why one operation may raise a JavaScript exception other than a registered abort: the
+/// `may_throw` transfer's per-op answer, shared with the cleanup-edge classifier so a retained
+/// edge can say why.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum ThrowCause {
+    /// A host call. `trustable` when it is a `#[js_extern]` declaration that is non-fallible and
+    /// whose slots never say `throws`; it counts unless [`ThrowFacts::trust_host_contract`] is on.
+    Host { kind: HostKind, trustable: bool },
+    /// Compiler-known code that may still throw, or a call nothing can see through.
+    Opaque(OpaqueCause),
+    /// A Rust body -- a callee, drop glue, or the panic function a failed `Assert` calls --
+    /// whose summary says it may throw; `missing` when there is no summary at all.
+    Body { name: JsName, missing: bool },
+    /// A failed `Assert` whose panic function the item's references do not name exactly once.
+    PanicUnknown,
+}
+
+impl ThrowCause {
+    /// Whether this cause makes the operation throwing under the trust switch.
+    pub fn counts(&self, trust_host_contract: bool) -> bool {
+        !matches!(self, ThrowCause::Host { trustable: true, .. } if trust_host_contract)
+    }
+
+    fn host(kind: HostKind) -> ThrowCause {
+        ThrowCause::Host {
+            kind,
+            trustable: false,
+        }
+    }
+}
+
+/// Which kind of host call a [`ThrowCause::Host`] is.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum HostKind {
+    /// A `#[js_extern]` declaration with a decodable descriptor.
+    Extern,
+    /// A `rcgjs.host.*`/`rcgjs.tc.*`/`rcgjs.map.*` marker or host operation that runs host code.
+    Marker,
+    /// Raw JavaScript, a `js!{}` block, a view-ABI or keyed-list boundary, or an undecodable
+    /// declaration.
+    Other,
+}
+
+/// What an [`ThrowCause::Opaque`] operation is.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum OpaqueCause {
+    /// A construct the lowering could not translate.
+    Zombie,
+    /// An intrinsic outside [`NON_THROWING_INTRINSICS`].
+    Intrinsic,
+    /// The global allocator.
+    Allocator,
+    /// A registry operation whose contract says it can throw.
+    Registry,
+    /// A call through a function pointer.
+    Indirect,
+    /// A call through a vtable.
+    Virtual,
+    /// Drop glue through a vtable.
+    DynamicDrop,
+    /// A foreign symbol, a runtime member, or an intrinsic named as a callee.
+    Foreign,
+    /// A direct callee or drop glue whose name the interns cannot spell.
+    Unspellable,
+}
+
+/// Where a failed `Assert` goes, resolved exactly as `lower/js/emit.rs::assert_failure` does.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum PanicPath {
+    /// The emitter prints nothing for the check (an optional overflow check).
+    Silent,
+    /// The one reference whose name ends in the panic lang function's.
+    Function(JsName),
+    /// No reference, or more than one, names it.
+    Unknown,
+}
+
+/// The panic lang function a failed `Assert` calls, spelled as `lower/js/emit.rs::panic_function`
+/// spells it, or `None` for the arithmetic overflow checks `emit.rs::assert_stmts` prints nothing
+/// for (the suite compiles with `-Coverflow-checks` off).
+pub fn panic_lang_fn(msg: &RAssertMessage) -> Option<&'static str> {
+    use CoroutineDesugaring::{Async, AsyncGen, Gen};
+    let coroutine = |kind: &CoroutineKind, names: [&'static str; 4]| match kind {
+        CoroutineKind::Desugared { kind: Async, .. } => names[0],
+        CoroutineKind::Desugared { kind: AsyncGen, .. } => names[1],
+        CoroutineKind::Desugared { kind: Gen, .. } => names[2],
+        CoroutineKind::Coroutine { .. } => names[3],
+    };
+    Some(match msg {
+        RAssertMessage::Overflow { op, .. } => match op {
+            BinaryOp::Add | BinaryOp::Sub | BinaryOp::Mul | BinaryOp::Shl | BinaryOp::Shr => {
+                return None;
+            }
+            BinaryOp::Div => "panic_const_div_overflow",
+            BinaryOp::Rem => "panic_const_rem_overflow",
+            _ => "panic_const_generic_overflow",
+        },
+        RAssertMessage::OverflowNeg(_) => "panic_const_neg_overflow",
+        RAssertMessage::DivisionByZero(_) => "panic_const_div_by_zero",
+        RAssertMessage::RemainderByZero(_) => "panic_const_rem_by_zero",
+        RAssertMessage::ResumedAfterReturn(kind) => coroutine(
+            kind,
+            [
+                "panic_const_async_fn_resumed",
+                "panic_const_async_gen_fn_resumed",
+                "panic_const_gen_fn_none",
+                "panic_const_coroutine_resumed",
+            ],
+        ),
+        RAssertMessage::ResumedAfterPanic(kind) => coroutine(
+            kind,
+            [
+                "panic_const_async_fn_resumed_panic",
+                "panic_const_async_gen_fn_resumed_panic",
+                "panic_const_gen_fn_none_panic",
+                "panic_const_coroutine_resumed_panic",
+            ],
+        ),
+        RAssertMessage::ResumedAfterDrop(kind) => coroutine(
+            kind,
+            [
+                "panic_const_async_fn_resumed_drop",
+                "panic_const_async_gen_fn_resumed_drop",
+                "panic_const_gen_fn_none_drop",
+                "panic_const_coroutine_resumed_drop",
+            ],
+        ),
+        RAssertMessage::NullPointer => "panic_null_pointer_dereference",
+        RAssertMessage::NullReference => "panic_null_reference_construction",
+        RAssertMessage::BoundsCheck { .. } => "panic_bounds_check",
+        RAssertMessage::MisalignedPointer { .. } => "panic_misaligned_pointer_dereference",
+        RAssertMessage::InvalidEnum(_) => "panic_invalid_enum_construction",
+    })
+}
+
+/// Resolves a failed `Assert`'s panic function among `deps`, as `emit.rs::assert_failure` does:
+/// the one reference named `<lang_fn>$h<16 hex>` or `...$<lang_fn>$h<16 hex>`.
+pub fn panic_path(msg: &RAssertMessage, deps: Option<&[String]>) -> PanicPath {
+    let Some(lang_fn) = panic_lang_fn(msg) else {
+        return PanicPath::Silent;
+    };
+    let names = |dep: &&String| {
+        dep.rsplit_once("$h").is_some_and(|(stem, hash)| {
+            hash.len() == 16
+                && hash.bytes().all(|b| b.is_ascii_hexdigit())
+                && (stem == lang_fn
+                    || stem
+                        .strip_suffix(lang_fn)
+                        .is_some_and(|prefix| prefix.ends_with('$')))
+        })
+    };
+    let mut candidates = deps.into_iter().flatten().filter(names);
+    match (candidates.next(), candidates.next()) {
+        (Some(name), None) => PanicPath::Function(JsName::new(name.clone())),
+        _ => PanicPath::Unknown,
+    }
+}
+
+/// The per-op `may_throw` transfer: why `kind` may raise a JavaScript exception other than a
+/// registered abort, given `current` summaries and the enclosing body's references `deps`.
+///
+/// A Rust body answers through its summary (absent is [`ThrowCause::Body`] with `missing`);
+/// everything that runs JavaScript the compiler did not write is a cause; the operations the
+/// emitter spells as plain JavaScript over Rust-valid values raise nothing.
+fn throw_cause(
+    graph: &Callgraph,
+    interns: Option<&Interns>,
+    deps: Option<&[String]>,
+    kind: &OpKind,
+    current: &BTreeMap<JsName, Summary>,
+) -> Option<ThrowCause> {
+    let body = |name: JsName| match current.get(&name) {
+        Some(summary) if !summary.may_throw => None,
+        Some(_) => Some(ThrowCause::Body {
+            name,
+            missing: false,
+        }),
+        None => Some(ThrowCause::Body {
+            name,
+            missing: true,
+        }),
+    };
+    let link = |id: StrId| {
+        interns
+            .and_then(|interns| interns.str(id))
+            .map(|name| JsName::new(name.to_owned()))
+    };
+    match kind {
+        OpKind::Zombie(_) => Some(ThrowCause::Opaque(OpaqueCause::Zombie)),
+        OpKind::Host { .. } => Some(ThrowCause::host(HostKind::Marker)),
+        OpKind::Intrinsic { name, .. } => match interns.and_then(|interns| interns.str(*name)) {
+            Some(name) if NON_THROWING_INTRINSICS.contains(&name) => None,
+            _ => Some(ThrowCause::Opaque(OpaqueCause::Intrinsic)),
+        },
+        OpKind::Assert { msg, .. } => match panic_path(msg, deps) {
+            PanicPath::Silent => None,
+            PanicPath::Function(name) => body(name),
+            PanicPath::Unknown => Some(ThrowCause::PanicUnknown),
+        },
+        OpKind::Drop { glue, .. } => match glue {
+            DropGlue::None => None,
