+    b.effect(entry, OpKind::CellAlloc(guard), O);
+    b.effect(entry, OpKind::CellStore { cell: guard, v: x }, O);
+    let zero = constant(&mut b, entry, 0);
+    let one = constant(&mut b, entry, 1);
+    let first = b.op(entry, call(&mut interns, "first", vec![x]), I32, O);
+    b.terminate(
+        entry,
+        RTerm::Invoke {
+            normal: (second, vec![]),
+            unwind: (chain, vec![zero]),
+        },
+    );
+    let result = b.op(second, call(&mut interns, "second", vec![first]), I32, O);
+    b.terminate(
+        second,
+        RTerm::Invoke {
+            normal: (done, vec![]),
+            unwind: (chain, vec![one]),
+        },
+    );
+    b.terminate(done, RTerm::Return(Some(result)));
+    b.terminate(
+        chain,
+        RTerm::Switch {
+            scrut: flag,
+            scrut_ty: I32,
+            cases: vec![(1, dropping, vec![])],
+            default: (rethrow, vec![]),
