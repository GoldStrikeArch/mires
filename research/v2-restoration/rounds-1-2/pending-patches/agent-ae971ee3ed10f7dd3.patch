+/// `entry(x)`: a guard cell, `op [unwind: drop guard; rethrow]`, `return x`, for a protected op
+/// that prints nothing (Stage 3c: the `try` around it guarded no statement at all).
+fn protected_quiet_op(interns: &mut Interns, op: impl FnOnce(&mut Interns) -> OpKind) -> Func {
+    let mut b = FuncBuilder::new(item(1), signature(1, I32));
+    let x = b.param(I32, O);
+    let entry = FuncBuilder::ENTRY;
+    let normal = b.block();
+    let chain = b.block();
+    let guard = b.cell(I32, true, O);
+    b.effect(entry, OpKind::CellAlloc(guard), O);
+    b.effect(entry, OpKind::CellStore { cell: guard, v: x }, O);
+    let kind = op(interns);
+    b.effect(entry, kind, O);
+    b.terminate(
+        entry,
+        RTerm::Invoke {
+            normal: (normal, vec![]),
+            unwind: (chain, vec![]),
+        },
+    );
+    b.terminate(normal, RTerm::Return(Some(x)));
+    let kind = drop_guard(interns, guard);
+    b.effect(chain, kind, O);
+    b.terminate(chain, RTerm::Throw(None));
+    b.finish()
+}
+
+fn marker(interns: &mut Interns, section: &str) -> OpKind {
+    let mut kind = call(interns, section, vec![]);
+    if let OpKind::Call { host, .. } = &mut kind {
+        *host = Some(HostPayload::Marker {
+            section: interns.intern_str(section),
+            def: item(50).definition,
+            template: None,
+            helpers: Vec::new(),
+        });
+    }
+    kind
+}
+
+fn intrinsic(interns: &mut Interns, name: &str) -> OpKind {
+    OpKind::Intrinsic {
+        name: interns.intern_str(name),
+        types: vec![],
+        fallback: None,
+        args: vec![],
+    }
+}
+
+/// Stage 3c: a protected `rcgjs.host.undefined` or `cold_path` prints no statement, raises nothing,
+/// and loses its `try`; a host operation that runs host code, or an intrinsic outside the list,
+/// keeps it.
+#[test]
+fn a_protected_operation_that_prints_nothing_loses_its_try() {
+    let harness = r#"
+let trace;
+function drop_guard(slot) { trace.push(['drop', slot.buf[slot.off]]); }
+function observe(entry) { trace = []; return [entry(4), trace]; }
+"#;
+    for (quiet, cause, op) in [
+        (
+            true,
+            "",
+            &(|interns: &mut Interns| marker(interns, "rcgjs.host.undefined"))
+                as &dyn Fn(&mut Interns) -> OpKind,
+        ),
+        (true, "", &|interns: &mut Interns| {
+            intrinsic(interns, "cold_path")
+        }),
+        (false, "host-marker", &|interns: &mut Interns| {
+            marker(interns, "rcgjs.host.add")
+        }),
+        (false, "intrinsic", &|interns: &mut Interns| {
+            intrinsic(interns, "ctpop")
+        }),
+    ] {
+        let mut interns = world();
+        let func = protected_quiet_op(&mut interns, op);
+        let mut program = Program::new(interns);
+        program.add("entry", func, &[]);
+        let (funcs, stats) = program.run(false);
+        let after = funcs[&JsName::new("entry".to_owned())].as_ref().unwrap();
+        if !quiet {
+            assert!(stats.removed.is_empty());
+            assert_eq!(stats.retained[CALLEE_MAY_THROW], 1);
+            assert_eq!(stats.retained_sole_causes[cause], 1);
+            continue;
+        }
+        assert_eq!(reasons(&stats), ["no-throw"]);
+        assert!(!after.has_invoke());
+        check_same_as_baseline(
+            &program.interns,
+            program.func("entry"),
+            after,
+            &[],
+            harness,
+            0,
+        )
+        .unwrap();
+    }
+}
