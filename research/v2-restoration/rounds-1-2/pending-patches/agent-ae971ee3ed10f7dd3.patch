+    let after = funcs[&JsName::new("entry".to_owned())].as_ref().unwrap();
+    assert!(matches!(after.blocks[0].term, RTerm::Goto(..)));
+    assert!(after.has_invoke(), "the second edge keeps the shared chain");
+    let harness = r#"
+let trace, thrown, failing;
+function first(x) { trace.push('first'); if (failing === 'first') throw inputs[thrown]; return x + 1; }
+function second(x) { trace.push('second'); if (failing === 'second') throw inputs[thrown]; return x * 2; }
+function drop_guard(slot) { trace.push(['drop', slot.buf[slot.off]]); }
+function observe(entry) {
+  const out = [];
+  for (failing of [null, 'first', 'second']) for (thrown of inputs.keys()) {
+    trace = [];
+    try { out.push(['ret', entry(5), trace]); }
+    catch (error) { out.push(['threw', describe(error), trace]); }
+  }
+  return out;
+}
+"#;
+    check_same_as_baseline(
+        &program.interns,
