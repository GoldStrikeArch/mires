+#[test]
+fn a_panic_path_the_references_do_not_name_is_unknown() {
+    let mut interns = world();
+    let entry = protected_callee(&mut interns);
+    let panic = panic_fn(&mut interns, false);
+    let mut program = Program::new(interns);
+    program.add("entry", entry, &[]);
+    // `callee` names no panic function among its references: the emitter would not find one.
+    program.add("callee", asserting_callee(), &[]);
+    program.add(PANIC, panic, &[]);
+    assert!(program.summary_of("callee", false).may_throw);
+    let (_, stats) = program.run(false);
+    assert!(stats.removed.is_empty());
