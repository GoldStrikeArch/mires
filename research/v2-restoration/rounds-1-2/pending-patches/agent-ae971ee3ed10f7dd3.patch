+//! Cleanup-edge removal, through classification and through Node.
+//!
+//! The emission harness mirrors `lower/js/tests/invoke.rs::check_emission` (every cell of the
+//! structure x optimizer x rename x style matrix), which is private to the emitter's test module:
+//! each case prints the original and the rewritten body in every cell and runs them all in one
+//! Node process against the same host stubs, so "equal to baseline" is checked cell by cell.
+
+use std::collections::BTreeMap;
+
+use std::io::Write as _;
+use std::process::{Command, Stdio};
+
+use rcgjs_object::jir::summary::{Availability, ItemClass, ItemSummary, SemanticKey};
+use rcgjs_object::object::{BlobRef, ItemKind, Linkage};
+
+use super::*;
+use crate::analysis::{callgraph, effects};
+use crate::descriptor::{Descriptor, Shape};
+use crate::jir::interns::Interns;
+use crate::jir::origin::OriginId;
+use crate::jir::repr::{FuncBuilder, RAssertMessage, Root};
+use crate::jir::semantic::{
+    AbiSignature, Body, BodyKind, BodySemantic, CallSemantic, Callee, ConstTree, DefinitionId,
+    DropGlue, HostPayload, ItemId, Signature,
+};
+use crate::jir::types::{
+    IntFacts, IntRepr, JsFacts, LayoutFacts, TypeDescriptor, TypeId, TypeKind, TypeMeta,
+};
+use crate::jsast;
+use crate::opts::Opts;
+
+const RUNTIME: &str = include_str!("../../../../runtime/shim.js");
+const O: OriginId = OriginId(0);
+const UNIT: TypeId = TypeId(1);
+const BOOL: TypeId = TypeId(2);
+const I32: TypeId = TypeId(3);
+const PANIC: &str = "core$panicking$panic_bounds_check$h0123456789abcdef";
+
+fn descriptor(id: TypeId, kind: TypeKind, size: u64) -> TypeDescriptor {
+    TypeDescriptor {
+        id,
+        name: None,
+        kind,
+        layout: LayoutFacts {
+            size: Some(size),
+            unsized_prefix: None,
+            align: Some(size.clamp(1, 4)),
+            sized: true,
+            zst: size == 0,
+            one_zst: size == 0,
+            needs_drop: false,
+            has_own_drop: false,
+        },
+        meta: TypeMeta::default(),
+        js: JsFacts {
+            int: None,
+            is_indirect: size == 0,
+            needs_clone: false,
+            crosses_transparent_union: false,
+            transparent: None,
+            peeled: id,
+            unsized_tail: None,
+            enum_repr: None,
+            is_primitive_enum: false,
+            pointer_form: None,
+            byte_element: false,
+            fields: Vec::new(),
+        },
+    }
+}
+
+fn world() -> Interns {
+    let mut interns = Interns::new();
+    interns.intern_type(descriptor(UNIT, TypeKind::Tuple(Vec::new()), 0));
+    interns.intern_type(descriptor(BOOL, TypeKind::Bool, 1));
+    let mut int = descriptor(
+        I32,
+        TypeKind::Integer {
+            signed: true,
+            bits: 32,
+        },
+        4,
+    );
+    int.js.int = Some(IntFacts {
+        signed: true,
+        bits: 32,
+        repr: IntRepr::Number,
+    });
+    interns.intern_type(int);
+    interns
+}
+
+fn item(n: u64) -> ItemId {
+    ItemId {
+        definition: DefinitionId {
+            crate_id: 1,
+            local_hash: n,
+        },
+        instantiation: u128::from(n),
+    }
+}
+
+fn signature(arguments: usize, result: TypeId) -> Signature {
+    Signature {
+        abi: AbiSignature {
+            parameters: arguments as u16,
+            spread: None,
+            caller_location: false,
+        },
+        arguments: vec![I32; arguments],
+        result,
+    }
+}
+
+fn summary(deps: &[String]) -> ItemSummary {
+    ItemSummary {
+        key: SemanticKey {
+            link_name: "entry".to_owned(),
+            item: None,
+        },
+        body_hash: None,
+        semantic_hash: None,
+        availability: Availability::Available,
+        deps: deps.to_vec(),
+        abi: None,
+        physical: None,
+        kind: ItemKind::Fn,
+        linkage: Linkage::internal(),
+        order: None,
+        dts: false,
+        fallback: BlobRef {
+            offset: 0,
+            clen: 0,
+            ulen: 0,
+        },
+        body: None,
+        origin: None,
+        estimated_bytes: 0,
+        class: ItemClass::default(),
+    }
+}
+
+fn call(interns: &mut Interns, name: &str, args: Vec<ValueId>) -> OpKind {
+    OpKind::Call {
+        callee: Callee::Direct {
+            item: item(90),
+            link_name: interns.intern_str(name),
+        },
+        function: None,
+        args,
+        track_caller: None,
+        semantic: CallSemantic::Ordinary,
+        host: None,
+    }
+}
+
+fn constant(b: &mut FuncBuilder, block: RBlockId, bits: u128) -> ValueId {
+    b.op(
+        block,
+        OpKind::Const(ConstTree::Scalar { bits, bytes: 4 }),
+        I32,
+        O,
+    )
+}
+
+fn drop_guard(interns: &mut Interns, cell: crate::jir::repr::CellId) -> OpKind {
+    OpKind::Drop {
+        root: Root::Cell(cell),
+        path: vec![],
+        glue: DropGlue::Direct {
+            item: item(80),
+            link_name: interns.intern_str("drop_guard"),
+        },
+    }
+}
+
+/// A program: its bodies, the interns they share, and each body's references.
+struct Program {
+    interns: Interns,
+    funcs: BTreeMap<JsName, Result<Func, Decline>>,
+    deps: BTreeMap<JsName, Vec<String>>,
+}
+
+impl Program {
+    fn new(interns: Interns) -> Program {
+        Program {
+            interns,
+            funcs: BTreeMap::new(),
+            deps: BTreeMap::new(),
+        }
+    }
+
+    fn add(&mut self, name: &str, func: Func, deps: &[&str]) {
+        func.verify(&self.interns.types)
+            .unwrap_or_else(|err| panic!("{name}: {err}"));
+        let name = JsName::new(name.to_owned());
+        self.deps.insert(
+            name.clone(),
+            deps.iter().map(|dep| (*dep).to_owned()).collect(),
+        );
+        self.funcs.insert(name, Ok(func));
+    }
+
+    fn func(&self, name: &str) -> &Func {
+        self.funcs[&JsName::new(name.to_owned())].as_ref().unwrap()
+    }
+
+    /// Runs the pass over a copy, the lane's way; returns the rewritten bodies and the stats.
+    fn run(&self, trust: bool) -> (BTreeMap<JsName, Result<Func, Decline>>, CleanupStats) {
+        let interns: BTreeMap<JsName, &Interns> = self
+            .funcs
+            .keys()
+            .map(|name| (name.clone(), &self.interns))
+            .collect();
+        let deps: BTreeMap<JsName, &[String]> = self
+            .deps
+            .iter()
+            .map(|(name, deps)| (name.clone(), &deps[..]))
+            .collect();
+        let graph = callgraph::build(&self.funcs, &interns);
+        let facts = ThrowFacts {
+            deps: Some(&deps),
+            trust_host_contract: trust,
+        };
+        let summaries = effects::compute_with(&self.funcs, &interns, &graph, facts);
+        let untrusted = trust.then(|| {
+            let facts = ThrowFacts {
+                trust_host_contract: false,
+                ..facts
+            };
+            effects::compute_with(&self.funcs, &interns, &graph, facts)
+        });
+        let cx = Context {
+            graph: &graph,
+            interns: &interns,
+            summaries: &summaries,
+            facts,
+            untrusted: untrusted.as_ref(),
+        };
+        let mut funcs = self.funcs.clone();
+        let stats = run(&mut funcs, &cx, &|_, _| None);
+        // The group ends revalidated: the rewrite only ever shrinks what a body does.
+        let mut published = summaries.clone();
+        let violations = crate::analysis::summary_check::enforce_with(
+            &mut published,
+            &funcs,
+            &interns,
+            &graph,
+            &facts,
+        );
+        assert!(violations.is_empty(), "{violations:?}");
+        (funcs, stats)
+    }
+
+    fn summary_of(&self, name: &str, trust: bool) -> effects::Summary {
+        let interns: BTreeMap<JsName, &Interns> = self
+            .funcs
+            .keys()
+            .map(|name| (name.clone(), &self.interns))
+            .collect();
+        let deps: BTreeMap<JsName, &[String]> = self
+            .deps
+            .iter()
+            .map(|(name, deps)| (name.clone(), &deps[..]))
+            .collect();
+        let graph = callgraph::build(&self.funcs, &interns);
+        let facts = ThrowFacts {
+            deps: Some(&deps),
+            trust_host_contract: trust,
+        };
+        effects::compute_with(&self.funcs, &interns, &graph, facts)
+            .get(&JsName::new(name.to_owned()))
+            .cloned()
+            .expect("summarized")
+    }
+}
+
+fn reasons(stats: &CleanupStats) -> Vec<&'static str> {
+    stats.removed.iter().map(|removed| removed.reason).collect()
+}
+
+/// Every cell of the emission matrix for `func`: `(label, declaration source)`.
+fn matrix(interns: &Interns, func: &Func, deps: &[String]) -> Vec<(String, String)> {
+    use rcgjs_object::opts::{EcmaTarget, OptimizerMode};
+    use rcgjs_object::{minify, optimizer, sroa};
+    let summary = summary(deps);
+    let name = JsName::new("entry".to_owned());
+    let body = Body {
+        item: item(1),
+        kind: BodyKind::Function,
+        semantic: BodySemantic::Ordinary,
+        signature: func.sig.clone(),
+        locals: Vec::new(),
+        blocks: Vec::new(),
+    };
+    let mut out = Vec::new();
+    for dispatch in [false, true] {
+        for mode in [OptimizerMode::Off, OptimizerMode::Report, OptimizerMode::On] {
+            for rename in [false, true] {
+                for style in [jsast::Style::Readable, jsast::Style::Compact] {
+                    let opts = Opts {
+                        optimizer: mode,
+                        ..Opts::default()
+                    };
+                    let mut optimized = func.clone();
+                    crate::opt::optimize(
+                        &mut optimized,
+                        &interns.types,
+                        interns,
+                        &opts,
+                        &mut crate::opt::OptStats::default(),
+                    )
+                    .unwrap();
+                    let plan =
+                        crate::lower::fuse::plan(&optimized, None, &interns.types, interns, &opts);
+                    let structured = crate::lower::structure::structure(
+                        &optimized,
+                        &plan,
+                        &interns.types,
+                        dispatch,
+                    )
+                    .unwrap();
+                    let input = crate::lower::LowerInput {
+                        name: &name,
+                        summary: &summary,
+                        body: &body,
+                        origins: None,
+                        interns,
+                        table: &interns.types,
+                        opts: &opts,
+                        items: crate::lower::js::host::EMPTY_ITEMS,
+                        drop_glue: crate::lower::js::host::EMPTY_DROP_GLUE,
+                        vtables: &crate::lower::js::unsize::EMPTY_VTABLES,
+                        spills: &[],
+                        abi: None,
+                        physical: None,
+                        call_retargets: crate::lower::EMPTY_CALL_RETARGETS,
+                    };
+                    let lowered = crate::lower::js::function::lower(
+                        &input,
+                        &optimized,
+                        &plan,
+                        structured.region,
+                    )
+                    .unwrap();
+                    let mut decl =
+                        sroa::analyze_jir(optimizer::analyze(lowered.decl, mode).decl, mode).decl;
+                    if rename {
+                        minify::shorten_locals_for_measurement(&mut decl);
+                    }
+                    out.push((
+                        format!("{dispatch}-{mode:?}-{rename}-{style:?}"),
+                        jsast::stmt_to_string_styled_for_target(&decl, style, EcmaTarget::Es2018),
+                    ));
+                }
+            }
+        }
+    }
+    out
+}
+
+/// Runs `harness` over every `(label, source)` in one Node process. Each source is wrapped in its
+/// own scope and contributes `entry` to `entries` as `[label, entry]`.
+fn node(entries: &[(String, String)], harness: &str) -> Result<String, String> {
+    let mut program = format!("{RUNTIME}\nconst entries = [\n");
+    for (label, source) in entries {
+        let _ = writeln!(
+            program,
+            "[{label:?}, (() => {{\n{source}\nreturn entry;\n}})()],"
+        );
+    }
+    program.push_str("];\n");
+    program.push_str(harness);
+    let mut child = Command::new("node")
+        .arg("-")
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("Node is required");
+    child
+        .stdin
+        .take()
+        .unwrap()
+        .write_all(program.as_bytes())
+        .unwrap();
+    let output = child.wait_with_output().unwrap();
+    let stdout = String::from_utf8_lossy(&output.stdout).trim().to_owned();
+    if output.status.success() {
+        Ok(stdout)
+    } else {
+        Err(format!(
+            "{stdout}\n{}",
+            String::from_utf8_lossy(&output.stderr)
+        ))
+    }
+}
+
+/// What every harness shares: an `observe(entry)` the case defines runs one entry over all its
+/// inputs; every entry, baseline and rewritten, must observe exactly what the first baseline cell
+/// did.
+const SAME_AS_BASELINE: &str = r#"
+let reference;
+for (const [label, entry] of entries) {
+  const seen = JSON.stringify(observe(entry));
+  if (reference === undefined) reference = seen;
+  else if (seen !== reference) throw new Error(`${label} observed ${seen}, baseline ${reference}`);
+}
+console.log(entries.length);
+"#;
+
+/// Inputs a host stub throws: ordinary values of every kind, a registered abort, and an
+/// unregistered error that only looks like one. `describe` names the identity caught.
+const THROWN: &str = r#"
+let abort; try { __rt.js_abort('panic'); } catch (error) { abort = error; }
+const lookalike = new Error('rust abort: panic');
+const inputs = [undefined, null, 0, -0, NaN, 'text', Symbol('s'), {}, lookalike, abort];
+function describe(value) {
+  const index = inputs.findIndex((input) => Object.is(input, value));
+  return index < 0 ? 'unknown' : `input${index}`;
+}
+"#;
+
+/// The `try` statements a printed declaration holds, in either style.
+fn tries(source: &str) -> usize {
+    source.matches("try {").count() + source.matches("try{").count()
+}
+
+/// Checks a positive case: every rewritten cell prints no `try`, every baseline cell does, and
+/// every cell observes what the baseline did.
+fn check_same_as_baseline(
+    interns: &Interns,
+    before: &Func,
+    after: &Func,
+    deps: &[String],
+    harness: &str,
+    expect_try_after: usize,
+) -> Result<(), String> {
+    let base = matrix(interns, before, deps);
+    let new = matrix(interns, after, deps);
+    for (label, source) in &base {
+        if tries(source) == 0 {
+            return Err(format!("baseline {label} has no try:\n{source}"));
+        }
+    }
+    for (label, source) in &new {
+        let tries = tries(source);
+        if tries != expect_try_after {
+            return Err(format!(
+                "rewritten {label} has {tries} try, expected {expect_try_after}:\n{source}"
+            ));
+        }
+    }
+    let entries: Vec<(String, String)> = base
+        .into_iter()
+        .map(|(label, source)| (format!("base/{label}"), source))
+        .chain(
+            new.into_iter()
+                .map(|(label, source)| (format!("new/{label}"), source)),
+        )
+        .collect();
+    let out = node(&entries, &format!("{THROWN}{harness}{SAME_AS_BASELINE}"))?;
+    if out == entries.len().to_string() {
+        Ok(())
+    } else {
+        Err(format!("unexpected output {out}"))
+    }
+}
