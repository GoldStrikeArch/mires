+            ProtectedOp::HostOperation(section) => {
+                Err(format!("the host operation `{section}` may throw"))
+            }
+            ProtectedOp::Intrinsic(name) => Err(format!("the intrinsic `{name}` may throw")),
+            ProtectedOp::Host {
+                trusted_contract: true,
+            } => Ok(()),
+            ProtectedOp::Host {
+                trusted_contract: false,
+            } => Err("an untrusted host call may throw".to_owned()),
+        },
+    }
+}
