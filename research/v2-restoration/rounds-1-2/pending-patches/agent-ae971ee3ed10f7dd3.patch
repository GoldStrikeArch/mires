+    );
+    let kind = drop_guard(&mut interns, guard);
+    b.effect(dropping, kind, O);
+    b.terminate(dropping, RTerm::Goto(rethrow, vec![]));
+    b.terminate(rethrow, RTerm::Throw(None));
+    let func = b.finish();
+    let mut program = Program::new(interns);
