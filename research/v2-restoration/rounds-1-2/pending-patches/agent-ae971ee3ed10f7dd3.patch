+/// Lowers `may_throw` wherever the transfer, re-run against the current map, finds no cause.
+fn refine_may_throw(cx: &Cx<'_>, done: &mut BTreeMap<JsName, Summary>) {
+    loop {
+        let mut changed = false;
+        for name in cx.graph.sccs.iter().flatten() {
+            let Some(func) = cx.func_of(name) else {
+                continue;
