index 0000000000000000000000000000000000000000..bfac4dcc39322a8afd00e29b204d748c251fb403
--- /dev/null
+++ b/jsc-link/src/lower/js/store.rs
@@ -0,0 +1,597 @@
+//! Whole-value stores of aggregates, written through into the storage object a place already
+//! holds (CONTRACT.md, "Storage identity").
+//!
+//! An aggregate place's storage is the one JavaScript object that sits in it, so assigning a whole
+//! value to the place copies the value *into* that object rather than putting another object in
+//! its place. The copy is spelled out here, field by field, from the type: one assignment per
+//! scalar, pointer or reference leaf, a descent into every nested owned struct, tuple, closure
+//! environment or array of aggregates (whose objects stay where they are too), and for an enum its
+//! tag and the union of its variants' payload keys. When the new value is a fresh aggregate the store is the only use
+//! of, its field values are written straight into the existing object and the aggregate itself is
+//! never built, which is what keeps a write-through store as cheap as the rebinding it replaces.
+//! A type too large or too irregular to spell is handed to `__rt.overwrite` (flat) or `__rt._deep`
+//! (nested), whose shape argument is a constant string the runtime parses once.
+
+use rcgjs_object::jir::repr::{Carrier, OpKind, ValueId};
+use rcgjs_object::jir::types::{EnumRepr, FieldKey, NominalForm, TypeId, TypeKind};
+use rcgjs_object::jsast::{self, Expr, Stmt};
+
+use super::value::{self, TAG};
+use super::{JsCx, Res};
+
+/// How many leaf assignments a field-wise store spells before it calls the runtime instead.
+const MAX_LEAVES: usize = 8;
+/// How deep a field-wise store descends into nested aggregates.
+const MAX_DEPTH: u32 = 6;
+
+/// Where a whole-value store's new value comes from.
+#[derive(Clone, Debug)]
+pub enum StoreSrc {
+    /// One expression for the whole value.
+    Value(Expr),
+    /// An SSA value: decomposed when it is a fresh aggregate this store is the only use of.
+    Ssa(ValueId),
+}
+
+/// One key of a path from an object to one of its leaves.
+#[derive(Clone, Debug)]
+enum Step {
+    Name(String),
+    Index(u32),
+}
+
+/// Where a leaf's new value is read from.
+#[derive(Clone, Debug)]
+enum From {
+    /// A path into the source value (`Root::Source`) or into a named SSA value.
+    Read(Root, Vec<Step>),
+    /// The expression of an SSA value (a field of a fresh aggregate).
+    Value(ValueId),
+    /// A literal: an enum's tag, `undefined` for the keys another variant left.
+    Literal(Expr),
+}
+
+#[derive(Clone, Debug)]
+enum Root {
+    Source,
+    Value(ValueId),
+}
+
+/// One assignment of a field-wise store.
+#[derive(Clone, Debug)]
+enum Leaf {
+    /// `dst.path = from`.
+    Set(Vec<Step>, From),
+    /// `__rt.overwrite(dst.path, from)`: an array or a union, kept in place without descending.
+    Overwrite(Vec<Step>, From),
+}
+
+fn at(base: Expr, path: &[Step]) -> Expr {
+    path.iter().fold(base, |base, step| match step {
+        Step::Name(name) => jsast::member(base, name.clone()),
+        Step::Index(index) => jsast::index(base, jsast::num(*index as f64)),
+    })
+}
+
+fn joined(path: &[Step], step: Step) -> Vec<Step> {
+    let mut path = path.to_vec();
+    path.push(step);
+    path
+}
+
+/// Whether an expression may be read more than once and after other stores without changing
+/// meaning: a name or a literal.
+fn atomic(expr: &Expr) -> bool {
+    matches!(
+        expr,
+        Expr::Ident(_)
+            | Expr::Num(_)
+            | Expr::RawNum(_)
+            | Expr::BigInt(_)
+            | Expr::Str(_)
+            | Expr::Bool(_)
+            | Expr::Undefined
+            | Expr::Null
+    )
+}
+
+impl<'a> JsCx<'a> {
+    /// Whether a whole-value store of a `ty` writes through into the place's storage object:
+    /// an aggregate with an object of its own.
+    pub fn owns_object(&self, ty: TypeId) -> bool {
+        let table = self.table;
+        table.needs_clone(ty)
+            && table.is_indirect(ty)
+            && !table.is_zst(ty)
+            && table.get(ty).is_some_and(|d| d.layout.sized)
+    }
+
+    /// The statements that store the whole aggregate `src` of type `ty` into `dst`, an expression
+    /// naming the storage object the place already holds, written through (see the module
+    /// documentation). `dst` must name an object: the caller knows the place is initialized.
+    pub fn store_into(&self, ty: TypeId, dst: Expr, src: StoreSrc) -> Res<Vec<Stmt>> {
+        let table = self.table;
+        if table.is_zst(ty) {
+            return Ok(Vec::new());
+        }
+        // A copy whose only use is this store needs no copy: the leaves are copied one by one
+        // anyway, provided none of them would share an object with the original.
+        let mut source = src.clone();
+        if let StoreSrc::Ssa(v) = src {
+            if let Some(from) = self.copied_from(v) {
+                let mut leaves = Vec::new();
+                let mut shares = false;
+                if self.plan_leaves(
+                    ty,
+                    &From::Read(Root::Value(from), Vec::new()),
+                    &[],
+                    &mut leaves,
+                    &mut shares,
+                    0,
+                ) && !shares
+                    && leaves.len() <= MAX_LEAVES
+                {
+                    return self.emit_leaves(dst, None, leaves);
+                }
+                source = StoreSrc::Value(self.expr_of(v)?);
+            }
+        }
+        let root = match &source {
+            StoreSrc::Ssa(v) if self.fresh_aggregate(*v, ty) => From::Value(*v),
+            _ => From::Read(Root::Source, Vec::new()),
+        };
+        let mut leaves = Vec::new();
+        let mut shares = false;
+        if self.plan_leaves(ty, &root, &[], &mut leaves, &mut shares, 0)
+            && leaves.len() <= MAX_LEAVES
+        {
+            let source = match source {
+                StoreSrc::Value(expr) => Some(expr),
+                StoreSrc::Ssa(v) if !matches!(root, From::Value(_)) => Some(self.expr_of(v)?),
+                StoreSrc::Ssa(_) => None,
+            };
+            return self.emit_leaves(dst, source, leaves);
+        }
+        let value = match source {
+            StoreSrc::Value(expr) => expr,
+            StoreSrc::Ssa(v) => self.expr_of(v)?,
+        };
+        Ok(vec![jsast::expr_stmt(self.runtime_store(ty, dst, value))])
+    }
+
+    /// The runtime spelling of a whole-value store the field-wise one gave up on.
+    pub fn runtime_store(&self, ty: TypeId, dst: Expr, value: Expr) -> Expr {
+        match self.write_shape(ty) {
+            Some(shape) => jsast::rt_call("_deep", vec![dst, value, jsast::string(shape)]),
+            None => jsast::rt_call("overwrite", vec![dst, value]),
+        }
+    }
+
+    /// The source of `v` when `v` is an inline `Copy` this store is the only use of.
+    fn copied_from(&self, v: ValueId) -> Option<ValueId> {
+        if !self.is_inline(v) {
+            return None;
+        }
+        match self.def_of(v)?.kind {
+            OpKind::Copy(from)
+                if self.func.values[from.0 as usize].carrier == Carrier::Baseline =>
+            {
+                Some(from)
+            }
+            _ => None,
+        }
+    }
+
+    /// Whether `v` is a fresh aggregate of `ty` (behind renames) that this store is the only use
+    /// of, so its fields can be written straight into the destination.
+    fn fresh_aggregate(&self, v: ValueId, ty: TypeId) -> bool {
+        let table = self.table;
+        let mut v = v;
+        for _ in 0..4 {
+            if !self.is_inline(v) || self.func.values[v.0 as usize].carrier != Carrier::Baseline {
+                return false;
+            }
+            match self.def_of(v).map(|op| &op.kind) {
+                Some(OpKind::Move(inner)) => v = *inner,
+                Some(OpKind::Aggregate {
+                    ty: aggregate,
+                    active_field: None,
+                    ..
+                }) => return table.peeled(*aggregate) == table.peeled(ty),
+                _ => return false,
+            }
+        }
+        false
+    }
+
+    /// The fields and variant of the fresh aggregate behind `v` ([`JsCx::fresh_aggregate`]).
+    fn fresh_fields(&self, v: ValueId) -> Option<(u32, Vec<ValueId>)> {
+        let mut v = v;
+        for _ in 0..4 {
+            match &self.def_of(v)?.kind {
+                OpKind::Move(inner) => v = *inner,
+                OpKind::Aggregate {
+                    variant, fields, ..
+                } => return Some((*variant, fields.clone())),
+                _ => return None,
+            }
+        }
+        None
+    }
+
+    /// Where the value of one field of `from` comes from.
+    fn field_from(&self, from: &From, step: Step, index: usize, field_ty: TypeId) -> Option<From> {
+        Some(match from {
+            From::Read(root, path) => From::Read(root.clone(), joined(path, step)),
+            From::Value(v) => {
+                let (_, fields) = self.fresh_fields(*v)?;
+                let field = *fields.get(index)?;
+                if self.owns_object(field_ty) && !self.fresh_aggregate(field, field_ty) {
+                    // An aggregate moved into the fresh one: read its leaves (it is evaluated
+                    // once, `emit_leaves`).
+                    From::Read(Root::Value(field), Vec::new())
+                } else {
+                    From::Value(field)
+                }
+            }
+            From::Literal(_) => return None,
+        })
+    }
+
+    /// Plans the leaf assignments that store `from` (a value of `ty`) at `path` in the
+    /// destination. `false` when the type has no field-wise spelling. `shares` is set when a leaf
+    /// would make the destination share an owned object with the source.
+    fn plan_leaves(
+        &self,
+        ty: TypeId,
+        from: &From,
+        path: &[Step],
+        leaves: &mut Vec<Leaf>,
+        shares: &mut bool,
+        depth: u32,
+    ) -> bool {
+        let table = self.table;
+        if depth > MAX_DEPTH || leaves.len() > MAX_LEAVES {
+            return false;
+        }
+        let peeled = table.peeled(ty);
+        if table.is_zst(peeled) {
+            return true;
+        }
+        // A fresh value of the wrong shape (a leaf that is a whole fresh aggregate) is written as
+        // the aggregate's own fields below; anything else whole is one assignment.
+        let Some(descriptor) = table.get(peeled) else {
+            return false;
+        };
+        match &descriptor.kind {
+            TypeKind::Adt {
+                form: NominalForm::Struct,
+                ..
+            }
+            | TypeKind::Tuple(_)
+            | TypeKind::Closure { .. } => {
+                for (index, field) in descriptor.js.fields.iter().enumerate() {
+                    if table.is_zst(field.ty) {
+                        continue;
+                    }
+                    let step = match field.key {
+                        FieldKey::Name(name) => match self.interns.str(name) {
+                            Some(name) => Step::Name(name.to_owned()),
+                            None => return false,
+                        },
+                        FieldKey::Index(index) => Step::Index(index),
+                        FieldKey::Transparent => return false,
+                    };
+                    let Some(child) = self.field_from(from, step.clone(), index, field.ty) else {
+                        return false;
+                    };
+                    let child_path = joined(path, step);
+                    if !self.plan_field(field.ty, child, child_path, leaves, shares, depth) {
+                        return false;
+                    }
+                }
+                true
+            }
+            TypeKind::Adt {
+                form: NominalForm::Enum,
+                variants,
+                ..
+            } if matches!(
+                table.enum_repr(peeled),
+                Some(EnumRepr::Tag { fieldless: false })
+            ) =>
+            {
+                // The tag and every payload key any variant uses; the keys the new variant does
+                // not use are cleared, so nothing another variant left stays reachable.
+                let mut keys: Vec<String> = Vec::new();
+                for variant in variants {
+                    for field in &variant.fields {
+                        if table.is_zst(field.ty) {
+                            continue;
+                        }
+                        let Some(key) = value::key_name(self.interns, field.key) else {
+                            return false;
+                        };
+                        if !keys.contains(&key) {
+                            keys.push(key);
+                        }
+                    }
+                }
+                match from {
+                    From::Read(root, source) => {
+                        for key in std::iter::once(TAG.to_owned()).chain(keys) {
+                            let step = Step::Name(key);
+                            leaves.push(Leaf::Set(
+                                joined(path, step.clone()),
+                                From::Read(root.clone(), joined(source, step)),
+                            ));
+                        }
+                        // A payload is shared with the source exactly when it owns an object.
+                        if variants.iter().any(|variant| {
+                            variant
+                                .fields
+                                .iter()
+                                .any(|field| self.owns_object(field.ty))
+                        }) {
+                            *shares = true;
+                        }
+                    }
+                    From::Value(v) => {
+                        let Some((variant, fields)) = self.fresh_fields(*v) else {
+                            return false;
+                        };
+                        let Some(tag) = value::variant_tag(table, self.interns, peeled, variant)
+                        else {
+                            return false;
+                        };
+                        let Some(descriptor) = variants.get(variant as usize) else {
+                            return false;
+                        };
+                        leaves.push(Leaf::Set(
+                            joined(path, Step::Name(TAG.to_owned())),
+                            From::Literal(tag),
+                        ));
+                        let mut written = Vec::new();
+                        for (field, value) in descriptor.fields.iter().zip(fields) {
+                            if table.is_zst(field.ty) {
+                                continue;
+                            }
+                            let Some(key) = value::key_name(self.interns, field.key) else {
+                                return false;
+                            };
+                            leaves.push(Leaf::Set(
+                                joined(path, Step::Name(key.clone())),
+                                From::Value(value),
+                            ));
+                            written.push(key);
+                        }
+                        for key in keys.into_iter().filter(|key| !written.contains(key)) {
+                            leaves.push(Leaf::Set(
+                                joined(path, Step::Name(key)),
+                                From::Literal(jsast::undefined()),
+                            ));
+                        }
+                    }
+                    From::Literal(_) => return false,
+                }
+                leaves.len() <= MAX_LEAVES
+            }
+            TypeKind::Array { element, length } => match from {
+                From::Value(v) => {
+                    let Some((_, fields)) = self.fresh_fields(*v) else {
+                        return false;
+                    };
+                    if fields.len() as u64 != *length {
+                        return false;
+                    }
+                    for (index, _) in fields.iter().enumerate() {
+                        let step = Step::Index(index as u32);
+                        let Some(child) = self.field_from(from, step.clone(), index, *element)
+                        else {
+                            return false;
+                        };
+                        if !self.plan_field(
+                            *element,
+                            child,
+                            joined(path, step),
+                            leaves,
+                            shares,
+                            depth,
+                        ) {
+                            return false;
+                        }
+                    }
+                    true
+                }
+                // Elements that are aggregates keep their objects: each is written into, which
+                // the runtime does (`_deep`) for an array too long to spell here. Elements that
+                // are values are copied into the array that is already there.
+                From::Read(root, source) if self.owns_object(*element) => {
+                    for index in 0..*length {
+                        let step = Step::Index(index as u32);
+                        let child = From::Read(root.clone(), joined(source, step.clone()));
+                        if !self.plan_field(
+                            *element,
+                            child,
+                            joined(path, step),
+                            leaves,
+                            shares,
+                            depth,
+                        ) {
+                            return false;
+                        }
+                    }
+                    true
+                }
+                _ => {
+                    leaves.push(Leaf::Overwrite(path.to_vec(), from.clone()));
+                    true
+                }
+            },
+            _ => false,
+        }
+    }
+
+    /// Plans one field: a nested owned aggregate is descended into, anything else is one leaf.
+    fn plan_field(
+        &self,
+        field_ty: TypeId,
+        from: From,
+        path: Vec<Step>,
+        leaves: &mut Vec<Leaf>,
+        shares: &mut bool,
+        depth: u32,
+    ) -> bool {
+        let table = self.table;
+        if !self.owns_object(field_ty) {
+            leaves.push(Leaf::Set(path, from));
+            return leaves.len() <= MAX_LEAVES;
+        }
+        let peeled = table.peeled(field_ty);
+        let descends = match table.get(peeled).map(|d| &d.kind) {
+            Some(
+                TypeKind::Adt {
+                    form: NominalForm::Struct,
+                    ..
+                }
+                | TypeKind::Tuple(_)
+                | TypeKind::Closure { .. }
+                | TypeKind::Array { .. },
+            ) => true,
+            Some(TypeKind::Adt {
+                form: NominalForm::Enum,
+                ..
+            }) => matches!(
+                table.enum_repr(peeled),
+                Some(EnumRepr::Tag { fieldless: false })
+            ),
+            _ => false,
+        };
+        if descends {
+            return self.plan_leaves(field_ty, &from, &path, leaves, shares, depth + 1);
+        }
+        // A union, a coroutine: overwritten in place, never descended into.
+        match from {
+            From::Value(_) | From::Read(..) => leaves.push(Leaf::Overwrite(path, from)),
+            From::Literal(_) => return false,
+        }
+        *shares = true;
+        leaves.len() <= MAX_LEAVES
+    }
+
+    /// Spells a planned field-wise store: every source expression that is not a name or a
+    /// literal is evaluated into a temporary first, in field order, so that no leaf reads what an
+    /// earlier leaf already overwrote; then the assignments.
+    fn emit_leaves(&self, dst: Expr, source: Option<Expr>, leaves: Vec<Leaf>) -> Res<Vec<Stmt>> {
+        let mut out = Vec::new();
+        let source = match source {
+            Some(expr) if !atomic(&expr) => {
+                let (stmt, name) = self.temp(expr);
+                out.push(stmt);
+                Some(name)
+            }
+            other => other,
+        };
+        let mut roots: Vec<(ValueId, Expr)> = Vec::new();
+        let mut values: Vec<Expr> = Vec::with_capacity(leaves.len());
+        for leaf in &leaves {
+            let (Leaf::Set(_, from) | Leaf::Overwrite(_, from)) = leaf;
+            let expr = match from {
+                From::Read(Root::Source, path) => {
+                    at(source.clone().unwrap_or_else(jsast::undefined), path)
+                }
+                From::Read(Root::Value(v), path) => {
+                    let root = match roots.iter().find(|(root, _)| root == v) {
+                        Some((_, expr)) => expr.clone(),
+                        None => {
+                            let expr = self.expr_of(*v)?;
+                            let expr = if atomic(&expr) {
+                                expr
+                            } else {
+                                let (stmt, name) = self.temp(expr);
+                                out.push(stmt);
+                                name
+                            };
+                            roots.push((*v, expr.clone()));
+                            expr
+                        }
+                    };
+                    at(root, path)
+                }
+                From::Value(v) => {
+                    let expr = self.expr_of(*v)?;
+                    if atomic(&expr) {
+                        expr
+                    } else {
+                        let (stmt, name) = self.temp(expr);
+                        out.push(stmt);
+                        name
+                    }
+                }
+                From::Literal(expr) => expr.clone(),
+            };
+            values.push(expr);
+        }
+        let dst = if atomic(&dst) || leaves.len() <= 1 {
+            dst
+        } else {
+            let (stmt, name) = self.temp(dst);
+            out.push(stmt);
+            name
+        };
+        for (leaf, value) in leaves.iter().zip(values) {
+            match leaf {
+                Leaf::Set(path, _) => out.push(jsast::assign_stmt(at(dst.clone(), path), value)),
+                Leaf::Overwrite(path, _) => out.push(jsast::expr_stmt(jsast::rt_call(
+                    "overwrite",
+                    vec![at(dst.clone(), path), value],
+                ))),
+            }
+        }
+        Ok(out)
+    }
+
+    /// The statements that exchange the contents of the two storage objects `x` and `y` of type
+    /// `ty` in place, leaf by leaf, or `None` when the type has no field-wise spelling
+    /// (`typed_swap_nonoverlapping`).
+    pub fn swap_into(&self, ty: TypeId, x: Expr, y: Expr) -> Res<Option<Vec<Stmt>>> {
+        let mut leaves = Vec::new();
+        let mut shares = false;
+        if !self.plan_leaves(
+            ty,
+            &From::Read(Root::Source, Vec::new()),
+            &[],
+            &mut leaves,
+            &mut shares,
+            0,
+        ) || leaves.len() > MAX_LEAVES
+            || leaves
+                .iter()
+                .any(|leaf| matches!(leaf, Leaf::Overwrite(..)))
+        {
+            return Ok(None);
+        }
+        let mut out = Vec::new();
+        let name = |expr: Expr, out: &mut Vec<Stmt>| {
+            if atomic(&expr) {
+                expr
+            } else {
+                let (stmt, name) = self.temp(expr);
+                out.push(stmt);
+                name
+            }
+        };
+        let x = name(x, &mut out);
+        let y = name(y, &mut out);
+        let (_, spare) = self.temp(jsast::undefined());
+        for leaf in &leaves {
+            let Leaf::Set(path, _) = leaf else {
+                return Ok(None);
+            };
+            out.push(jsast::assign_stmt(spare.clone(), at(x.clone(), path)));
+            out.push(jsast::assign_stmt(at(x.clone(), path), at(y.clone(), path)));
+            out.push(jsast::assign_stmt(at(y.clone(), path), spare.clone()));
+        }
+        Ok(Some(out))
+    }
+}
