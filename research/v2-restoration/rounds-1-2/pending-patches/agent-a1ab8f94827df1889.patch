@@ -0,0 +1,397 @@
+//! Storage identity of aggregate places (CONTRACT.md, "Storage identity").
+//!
+//! An aggregate place keeps one address for its whole storage lifetime, whatever is stored into
+//! it, and a field at layout offset zero shares its container's address. Every line below prints
+//! a relation between addresses -- an equality, an ordering, a difference that is a layout offset
+//! -- or a value, never an address itself, so the expectation is the native program's on any
+//! target. The cases are the ones the identity repair names: a whole value assigned over a field,
+//! a dropped value replaced in place and a moved-out place reinitialized (the moved value must
+//! keep its own contents), zero-offset projections through nested structs, stores through
+//! `&mut`, `mem::replace` and `mem::swap`, interior mutation through a `Cell`, elements of a
+//! slice, closures that capture a field by reference, a local whose field is borrowed and that is
+//! then assigned again whole, and places that hold pointers (references, raw pointers, `Option<&T>`,
+//! `Box`), whose moves rebind and never write into what they point at.
+#![no_std]
+#![no_main]
+
+extern crate alloc;
+
+#[path = "prelude.rs"]
+mod prelude;
+
+use alloc::boxed::Box;
+use alloc::vec;
+use alloc::vec::Vec;
+use core::cell::Cell;
+use core::hint::black_box;
+use core::mem;
+use core::ptr;
+use prelude::*;
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct H {
+    head: u32,
+    tail: u32,
+}
+
+#[repr(C)]
+struct Outer {
+    n: u32,
+    h: H,
+}
+
+fn a<T>(r: &T) -> usize {
+    r as *const T as usize
+}
+
+#[inline(never)]
+fn mk(head: u32) -> H {
+    black_box(H { head, tail: head + 1 })
+}
+
+// A whole value assigned over an aggregate field keeps the field's storage.
+#[inline(never)]
+fn e_field_assigned() {
+    let mut o = black_box(Outer { n: 1, h: mk(10) });
+    let before = a(&o.h);
+    let raw = &raw const o.h;
+    o.h = mk(20);
+    print_bool(before == a(&o.h));
+    print_bool(ptr::eq(raw, &o.h));
+    print_bool(raw as usize == before);
+    // The first field shares the struct's address, the second sits at its layout offset.
+    print_bool(a(&o.h.head) == a(&o.h));
+    print_bool(a(&o.h.tail) != a(&o.h));
+    print_bool(a(&o.h.tail) - a(&o.h) == mem::offset_of!(H, tail));
+    print_bool(a(&o.h.head) < a(&o.h.tail));
+    print_bool(ptr::addr_eq(&o.h, &o.h.head));
+    print_bool(!ptr::addr_eq(&o.h, &o.h.tail));
+    // A raw pointer taken before the store reads the new value.
+    print_u32(unsafe { (*raw).head } + o.n);
+}
+
+struct Logged<'a> {
+    v: u32,
+    log: &'a Cell<u32>,
+}
+
+impl Drop for Logged<'_> {
+    fn drop(&mut self) {
+        self.log.set(self.log.get() * 10 + self.v);
+    }
+}
+
+struct Holder<'a> {
+    k: u32,
+    d: Logged<'a>,
+}
+
+// The same place reused: a value dropped and replaced in place, a value moved out and the place
+// reinitialized, and a whole local assigned again.
+#[inline(never)]
+fn e_reused_place() {
+    let log = Cell::new(0);
+    let mut o = black_box(Holder { k: 1, d: Logged { v: 1, log: &log } });
+    let before = a(&o.d);
+    o.d = Logged { v: 2, log: &log };
+    print_bool(before == a(&o.d));
+    print_u32(log.get());
+    let moved = o.d;
+    o.d = Logged { v: 3, log: &log };
+    print_bool(before == a(&o.d));
+    print_u32(moved.v * 10 + o.d.v);
+    drop(moved);
+    print_u32(log.get());
+    print_u32(o.k);
+
+    let mut local = mk(4);
+    let first = a(&local);
+    local = mk(5);
+    print_bool(first == a(&local));
+    let taken = local;
+    local = mk(6);
+    print_bool(first == a(&local));
+    print_u32(taken.head * 10 + local.head);
+}
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct C3 {
+    x: u32,
+    y: u32,
+}
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct B3 {
+    c: C3,
+    z: u32,
+}
+
+#[repr(C)]
+#[derive(Clone, Copy)]
+struct A3 {
+    b: B3,
+    w: u32,
+}
+
+#[inline(never)]
+fn mk3(seed: u32) -> A3 {
+    black_box(A3 {
+        b: B3 { c: C3 { x: seed, y: seed + 1 }, z: seed + 2 },
+        w: seed + 3,
+    })
+}
+
+// Zero-offset projections through nested structs: the struct, its first field, that field's
+// first field and the scalar at the bottom all share one address, before and after stores.
+#[inline(never)]
+fn e_nested_zero_offset() {
+    let mut s = mk3(1);
+    let top = a(&s);
+    print_bool(top == a(&s.b));
+    print_bool(top == a(&s.b.c));
+    print_bool(top == a(&s.b.c.x));
+    print_bool(a(&s.b.c.y) - a(&s.b.c) == mem::offset_of!(C3, y));
+    print_bool(a(&s.w) != top);
+    print_bool(a(&s.b.z) != top);
+    print_bool(ptr::addr_eq(&s, &s.b.c.x));
+    print_bool(ptr::addr_eq(&s.b, &s.b.c));
+    print_bool(!ptr::addr_eq(&s.b, &s.b.c.y));
+    print_bool(ptr::eq(&s as *const A3 as *const B3, &s.b));
+    s.b = mk3(10).b;
+    print_bool(top == a(&s.b.c.x));
+    s = mk3(20);
+    print_bool(top == a(&s));
+    print_bool(top == a(&s.b.c));
+    print_u32(s.b.c.x + s.b.c.y + s.b.z + s.w);
+}
+
+#[inline(never)]
+fn set_field(o: &mut Outer, h: H) {
+    o.h = h;
+}
+
+#[inline(never)]
+fn set_through(r: &mut H, h: H) {
+    *r = h;
+}
+
+// Stores through `&mut`: a direct reborrow, a field assigned in a callee, and a whole value
+// stored through a `&mut H` in a callee all reach the one place.
+#[inline(never)]
+fn e_mut_borrows() {
+    let mut o = black_box(Outer { n: 2, h: mk(1) });
+    let before = a(&o.h);
+    {
+        let r = &mut o.h;
+        *r = mk(2);
+        print_bool(a(r) == before);
+    }
+    set_field(&mut o, mk(3));
+    print_bool(a(&o.h) == before);
+    set_through(&mut o.h, mk(4));
+    print_bool(a(&o.h) == before);
+    print_bool(&mut o.h as *mut H as usize == &o.h as *const H as usize);
+    print_u32(o.h.head + o.h.tail + o.n);
+}
+
+// `mem::replace` and `mem::swap` move values between places; the places stay where they are.
+#[inline(never)]
+fn e_replace_swap() {
+    let mut o = black_box(Outer { n: 3, h: mk(1) });
+    let mut p = black_box(Outer { n: 4, h: mk(7) });
+    let (at_o, at_p) = (a(&o.h), a(&p.h));
+    let old = mem::replace(&mut o.h, mk(2));
+    print_bool(a(&o.h) == at_o);
+    print_u32(old.head * 10 + o.h.head);
+    mem::swap(&mut o.h, &mut p.h);
+    print_bool(a(&o.h) == at_o);
+    print_bool(a(&p.h) == at_p);
+    print_bool(at_o != at_p);
+    print_u32(o.h.head * 10 + p.h.head);
+    unsafe { ptr::write(&mut o.h, mk(9)) };
+    print_bool(a(&o.h) == at_o);
+    print_u32(o.h.tail + o.n + p.n);
+}
+
+struct WithCell {
+    n: u32,
+    c: Cell<H>,
+}
+
+// Interior mutation of an aggregate through a `Cell`, alone and as a field behind `&`.
+#[inline(never)]
+fn e_cell() {
+    let c = Cell::new(mk(1));
+    let at = c.as_ptr() as usize;
+    print_bool(at == a(&c));
+    c.set(mk(2));
+    print_bool(c.as_ptr() as usize == at);
+    let old = c.replace(mk(3));
+    print_bool(a(&c) == at);
+    print_u32(old.head * 10 + c.get().head);
+
+    let w = black_box(WithCell { n: 5, c: Cell::new(mk(4)) });
+    let shared = &w;
+    let field = a(&shared.c);
+    shared.c.set(mk(6));
+    print_bool(a(&w.c) == field);
+    print_bool(w.c.as_ptr() as usize == field);
+    print_u32(w.c.get().head + w.n);
+}
+
+// Elements of a slice of aggregates. Raw pointers into the slice (an element place, `as_ptr`,
+// pointer arithmetic) agree and step by the element size; references to an element (indexing,
+// iteration, one passed through a call) agree with each other; an element assigned in place keeps
+// its identity under both. CONTRACT.md, "Storage identity", says why the two families are not
+// compared with each other.
+#[inline(never)]
+fn e_slice() {
+    let mut arr = black_box([mk(1), mk(2), mk(3)]);
+    let s = &mut arr[..];
+    let base = s.as_ptr();
+    let second = &raw const s[1];
+    print_bool(ptr::eq(second, base.wrapping_add(1)));
+    print_bool(second as usize - base as usize == mem::size_of::<H>());
+    print_bool(base < second);
+    let by_ref = a(&s[1]);
+    s[1] = mk(20);
+    print_bool(ptr::eq(&raw const s[1], second));
+    print_bool(a(&s[1]) == by_ref);
+    let mut n = 0u32;
+    for (i, e) in s.iter().enumerate() {
+        if ptr::eq(e, &s[i]) && ptr::eq(&raw const s[i], base.wrapping_add(i)) {
+            n += 1;
+        }
+    }
+    print_u32(n);
+    let first = black_box(&s[0]) as *const H;
+    let again = black_box(&s[0]) as *const H;
+    print_bool(ptr::eq(first, again));
+    print_bool(ptr::eq(first, &s[0]));
+    print_bool(first as usize == a(&s[0]));
+    print_u32(s[1].head + s[2].tail);
+}
+
+// Closures capturing a field by reference see the field's one address, before and after the
+// field is replaced, and a store through a `&mut` capture keeps it.
+#[inline(never)]
+fn e_closures() {
+    let mut o = black_box(Outer { n: 6, h: mk(1) });
+    let outside = a(&o.h);
+    let look = || &o.h as *const H as usize;
+    print_bool(look() == outside);
+    o.h = mk(2);
+    let look_again = || a(&o.h);
+    print_bool(look_again() == outside);
+    let mut store = |h: H| o.h = h;
+    store(mk(3));
+    store(mk(4));
+    print_bool(a(&o.h) == outside);
+    print_u32(o.h.head + o.n);
+}
+
+#[repr(C)]
+struct Pair(H, u32);
+
+// A local whose *field* is borrowed (never the local itself) and that is then assigned again
+// whole: the field keeps its address, a raw pointer taken before the store reads the new value,
+// and a field after an aggregate first field still sits at its layout offset.
+#[inline(never)]
+fn e_field_borrowed_local() {
+    let mut o = black_box(Outer { n: 1, h: mk(1) });
+    let p = a(&o.h);
+    o = black_box(Outer { n: 2, h: mk(3) });
+    print_bool(p == a(&o.h));
