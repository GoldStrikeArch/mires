+        let first = path
+            .iter()
+            .position(|proj| matches!(proj, Projection::Deref))?;
+        Some(path[first + 1..].to_vec())
+    };
+    match (behind_deref(&outer_path), behind_deref(&inner_path)) {
+        (Some(a), Some(b)) => prefix(&a, &b),
+        _ => false,
+    }
