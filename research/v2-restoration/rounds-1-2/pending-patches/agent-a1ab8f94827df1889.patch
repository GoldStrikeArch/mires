+fn place_prefix(outer: &Place, inner: &Place) -> bool {
+    // A downcast and a type-only cast name no storage of their own.
+    let storage = |place: &Place| -> Vec<Projection> {
+        place
+            .projection
+            .iter()
+            .copied()
+            .filter(|proj| {
+                !matches!(
+                    proj,
+                    Projection::Downcast { .. }
+                        | Projection::OpaqueCast(_)
+                        | Projection::UnwrapUnsafeBinder(_)
+                )
+            })
+            .collect()
+    };
