+// touches what they point at.
+#[inline(never)]
+fn e_pointer_values() {
+    let h = mk(1);
+    let h2 = mk(2);
+    let h3 = mk(3);
+    let mut refs: [&H; 2] = black_box([&h, &h2]);
+    refs.swap(0, 1);
