+        (Projection::Field { field: x, .. }, Projection::Field { field: y, .. }) => x == y,
+        (Projection::Deref, Projection::Deref) => true,
+        (
+            Projection::Index(_) | Projection::ConstantIndex { .. } | Projection::Subslice { .. },
+            Projection::Index(_) | Projection::ConstantIndex { .. } | Projection::Subslice { .. },
+        ) => true,
+        _ => false,
+    };
+    let prefix = |a: &[Projection], b: &[Projection]| {
+        a.len() <= b.len() && a.iter().zip(b).all(|(x, y)| same(x, y))
+    };
+    let (outer_path, inner_path) = (storage(outer), storage(inner));
+    if outer.local == inner.local && prefix(&outer_path, &inner_path) {
+        return true;
+    }
