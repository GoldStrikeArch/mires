+    print_u32(h2.head);
+    print_u32(refs[0].head);
+    print_bool(ptr::eq(refs[0], &h2));
+    unsafe { ptr::write(&mut refs[1], &h3) };
+    print_u32(h.head * 10 + refs[1].head);
+    let mut v: Vec<&H> = vec![&h, &h2, &h3];
+    v.reverse();
+    print_u32(h.head + h.tail);
+    print_u32(h3.head + h3.tail);
+    print_bool(ptr::eq(v[0], &h3));
+    v.sort_by_key(|r| r.head);
+    print_u32(v[0].head);
+    print_u32(h.head);
+    let mut raws: Vec<*const H> = vec![&h, &h3];
+    raws.swap(0, 1);
+    print_bool(ptr::eq(raws[0], &h3) && ptr::eq(raws[1], &h));
+    print_u32(h.head * 10 + h3.head);
+    let mut some = black_box(Some(&h));
+    let mut other = black_box(Some(&h2));
+    mem::swap(&mut some, &mut other);
+    print_u32(some.map_or(0, |r| r.head) * 10 + other.map_or(0, |r| r.head));
+    print_u32(h.head * 10 + h2.head);
+    let mut boxes = vec![Box::new(mk(4)), Box::new(mk(5))];
+    let first = &*boxes[0] as *const H;
+    boxes.swap(0, 1);
+    print_bool(ptr::eq(&*boxes[1], first));
+    print_u32(boxes[0].head * 10 + boxes[1].head);
+}
