+
+    /// Which conversions consume the baseline heap block they read, and so give its synthetic
+    /// address granule back (`__rt.convert_block_nv`, `__rt.convert_block_str`), and which leave
+    /// it to its owner. Leaving the baseline for a native carrier consumes the block: the planner
+    /// commits that direction only for a dead, unaliased source or a value being dropped, and the
+    /// native carrier's drop is the engine's, so no `dealloc` ever releases the block. Every
+    /// other spelling either builds a fresh block (into the baseline), touches no heap block (the
+    /// native-to-native ones), or borrows a block that stays live and owned elsewhere (a slice
+    /// view, a boxed pointer kept as it is): those must never release.
+    #[test]
+    fn exactly_the_conversions_that_consume_a_block_release_it() {
+        const CARRIERS: [Carrier; 6] = [
+            Carrier::Baseline,
+            Carrier::HostString,
+            Carrier::StringBuilder,
+            Carrier::NativeVec,
+            Carrier::SliceView,
+            Carrier::NativeBox,
+        ];
+        const RELEASING: [&str; 2] = ["__rt.convert_block_nv(", "__rt.convert_block_str("];
+        let (table, interns) = table();
+        let mut consuming = Vec::new();
+        let mut checked = 0;
+        for ty in [STRING, VEC_U32, SLICE_REF] {
+            for from in CARRIERS {
+                for to in CARRIERS {
+                    if from == to {
+                        continue;
+                    }
+                    let Ok(expr) = convert(&table, &interns, jsast::id("v"), ty, from, to) else {
+                        continue;
+                    };
+                    let text = jsast::expr_to_string(&expr);
+                    let releases = RELEASING.iter().any(|helper| text.contains(helper));
+                    let consumes = from == Carrier::Baseline
+                        && matches!(
+                            to,
+                            Carrier::HostString | Carrier::StringBuilder | Carrier::NativeVec
+                        );
+                    assert_eq!(releases, consumes, "{from:?} -> {to:?}: {text}");
+                    // A consuming decode is never the plain read-only `bytes_str`.
+                    assert!(!(consumes && text.contains("__rt.bytes_str(")), "{text}");
+                    if consumes {
+                        consuming.push((from, to));
+                    }
+                    checked += 1;
+                }
+            }
+        }
+        assert_eq!(
+            consuming,
+            [
+                (Carrier::Baseline, Carrier::HostString),
+                (Carrier::Baseline, Carrier::StringBuilder),
+                (Carrier::Baseline, Carrier::NativeVec),
+            ]
+        );
+        assert!(checked >= 12, "only {checked} spellings were checked");
+    }
 }
 
