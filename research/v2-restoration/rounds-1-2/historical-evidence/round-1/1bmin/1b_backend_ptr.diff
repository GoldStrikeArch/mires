+/// The keys from an aggregate down to the innermost owned aggregate at layout offset zero, joined
+/// by `.` into one constant string, which `__rt.box_chain`/`__rt.anchor` record (`jsc-link`'s
+/// `zero_offset_chain`). `None` for an aggregate whose first field is a scalar or a pointer; an
+/// enum or an array ends the chain.
+pub(crate) fn zero_offset_chain<'tcx>(tcx: TyCtxt<'tcx>, ty: Ty<'tcx>) -> Option<Expr> {
+    let mut chain = Vec::new();
+    let mut current = peel_pattern(peel_transparent(tcx, ty));
+    for _ in 0..CAST_DEPTH {
+        let next = product_fields(tcx, current)
+            .into_iter()
+            .find(|(key, field_ty, offset)| {
+                *offset == 0
+                    && !matches!(key, crate::value::FieldKey::Transparent)
+                    && owns_object(tcx, *field_ty)
+            });
+        let Some((key, field_ty, _)) = next else {
+            break;
+        };
+        chain.push(match key {
+            crate::value::FieldKey::Name(name) => name,
+            crate::value::FieldKey::Index(index) => index.to_string(),
+            crate::value::FieldKey::Transparent => break,
+        });
+        current = peel_pattern(peel_transparent(tcx, field_ty));
+    }
+    (!chain.is_empty()).then(|| jsast::string(chain.join(".")))
+}
+
+/// The owned aggregate fields a runtime write-through descends into (`__rt._deep`,
+/// `__rt._put_deep`), as the constant string `jsc-link`'s `write_shape` spells: comma separated
+/// keys of the fields whose value is an owned aggregate, each followed by `(..)` with its nested
+/// ones or `[..]` for an array of aggregates; `[..]` alone for an array of aggregates. `None`
+/// when there is nothing to descend into. An enum or a union is never descended into.
+pub(crate) fn write_shape<'tcx>(tcx: TyCtxt<'tcx>, ty: Ty<'tcx>) -> Option<String> {
+    write_shape_at(tcx, ty, 0)
+}
+
+fn write_shape_at<'tcx>(tcx: TyCtxt<'tcx>, ty: Ty<'tcx>, depth: u32) -> Option<String> {
+    if depth >= CAST_DEPTH {
+        return None;
+    }
+    let ty = peel_pattern(peel_transparent(tcx, ty));
+    if let ty::Array(element, _) = ty.kind() {
+        if !owns_object(tcx, *element) {
+            return None;
+        }
+        return Some(format!(
+            "[{}]",
+            write_shape_at(tcx, *element, depth + 1).unwrap_or_default()
+        ));
+    }
+    let mut entries: Vec<String> = Vec::new();
+    for (key, field_ty, _) in product_fields(tcx, ty) {
+        if !owns_object(tcx, field_ty) {
+            continue;
+        }
+        let key = match key {
+            crate::value::FieldKey::Name(name) => name,
+            crate::value::FieldKey::Index(index) => index.to_string(),
+            crate::value::FieldKey::Transparent => continue,
+        };
+        let peeled = peel_pattern(peel_transparent(tcx, field_ty));
+        let inner = match peeled.kind() {
+            ty::Array(..) => write_shape_at(tcx, field_ty, depth + 1).unwrap_or_default(),
+            _ => write_shape_at(tcx, field_ty, depth + 1)
+                .map(|inner| format!("({inner})"))
+                .unwrap_or_default(),
+        };
+        entries.push(format!("{key}{inner}"));
+    }
+    (!entries.is_empty()).then(|| entries.join(","))
+}
+
+/// The raw pointer to the aggregate `object` of type `pointee` when nothing says where it lives:
+/// `__rt.box`, one slot per object, or `__rt.box_chain` when the type has a zero-offset chain to
+/// record.
+pub(crate) fn object_raw<'tcx>(tcx: TyCtxt<'tcx>, pointee: Ty<'tcx>, object: Expr) -> Expr {
+    match zero_offset_chain(tcx, pointee) {
+        Some(chain) => jsast::rt_call("box_chain", vec![object, chain]),
+        None => jsast::rt_call("box", vec![object]),
+    }
 }
 
