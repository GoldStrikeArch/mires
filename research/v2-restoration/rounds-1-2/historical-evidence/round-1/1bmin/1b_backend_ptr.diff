+// ---------------------------------------------------------------------------------------------
+// Storage identity (CONTRACT.md, "Storage identity")
+// ---------------------------------------------------------------------------------------------
+
+/// Whether a value of `ty` is an aggregate with a JavaScript object of its own: the storage a
+/// place of the type holds, written through rather than rebound (`jsc-link`'s
+/// `JsCx::owns_object` asks the same of the type table).
+pub(crate) fn owns_object<'tcx>(tcx: TyCtxt<'tcx>, ty: Ty<'tcx>) -> bool {
+    crate::value::needs_clone(tcx, ty)
+        && is_indirect(tcx, ty)
+        && !is_zst(tcx, ty)
+        && ty.is_sized(tcx, typing_env())
+}
