+/// The layout byte offset of field `field` of `ty`, read under `variant` for an enum.
+pub(crate) fn field_offset<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    ty: Ty<'tcx>,
+    variant: Option<rustc_abi::VariantIdx>,
+    field: rustc_abi::FieldIdx,
+) -> u64 {
+    let Ok(layout) = tcx.layout_of(typing_env().as_query_input(ty)) else {
+        return 0;
+    };
+    let layout = match variant {
+        Some(variant) => layout.for_variant(
+            &rustc_middle::ty::layout::LayoutCx::new(tcx, typing_env()),
+            variant,
+        ),
+        None => layout,
     };
-    vec![jsast::expr_stmt(call)]
+    if field.as_usize() >= layout.fields.count() {
+        return 0;
+    }
+    layout.fields.offset(field.as_usize()).bytes()
+}
+
+/// Every field of a struct, tuple or closure environment: its JavaScript key, type and layout
+/// offset. Empty for anything else, an enum or a union included.
+pub(crate) fn product_fields<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    ty: Ty<'tcx>,
+) -> Vec<(crate::value::FieldKey, Ty<'tcx>, u64)> {
+    let Ok(layout) = tcx.layout_of(typing_env().as_query_input(ty)) else {
+        return Vec::new();
+    };
+    let types: Vec<Ty<'tcx>> = match ty.kind() {
+        ty::Adt(definition, arguments) if definition.is_struct() => definition
+            .non_enum_variant()
+            .fields
+            .iter()
+            .map(|field| tcx.normalize_erasing_regions(typing_env(), field.ty(tcx, arguments)))
+            .collect(),
+        ty::Tuple(fields) => fields.iter().collect(),
+        ty::Closure(_, arguments) => arguments.as_closure().upvar_tys().iter().collect(),
+        _ => return Vec::new(),
+    };
+    types
+        .into_iter()
+        .enumerate()
+        .filter(|(index, _)| *index < layout.fields.count())
+        .filter_map(|(index, field_ty)| {
+            let field = rustc_abi::FieldIdx::from_usize(index);
+            let key = crate::value::field_key(tcx, ty, None, field)?;
+            Some((key, field_ty, layout.fields.offset(index).bytes()))
+        })
+        .collect()
+}
